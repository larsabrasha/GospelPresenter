@page "/admin/users/{UserId}"
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@implements IDisposable

@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using CommunityToolkit.Mvvm.Messaging
@using GospelPresenter.Shared.State

@layout AdminLayout

@inject IUserService UserService
@inject IProfileImageService ProfileImageService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ActiveOrganizationState OrgState
@inject ToastService ToastService

<PageContainer>
    <DetailHeader @ref="header" BackHref="/admin/users" Title="@user?.Name" Class="px-5"/>

    @if (user is null)
    {
        <div class="px-7 text-neutral-400">@L["Common.Loading"]</div>
    }
    else
    {
        <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 p-5 space-y-4">
            <div>
                <label class="block text-sm font-medium mb-1">@L["UserDetail.ProfileImage"]</label>
                <div class="flex items-center gap-4">
                    <label class="cursor-pointer group relative">
                        <ProfileAvatar ImageUrl="@(user.ProfileImage ?? user.ProfileImageSmall)" Name="@user.Name"
                                       Size="lg" Class="group-hover:brightness-75 transition"/>
                        <InputFile OnChange="OnProfileImageSelected" accept="image/jpeg,image/png,image/webp,image/gif"
                                   class="hidden"/>
                    </label>
                    <div class="flex flex-col items-start gap-1">
                        <AppButton Variant="ButtonVariant.Secondary" AsLabel>
                            @(string.IsNullOrEmpty(user.ProfileImage ?? user.ProfileImageSmall) ? L["Common.ChooseImage"] : L["Common.ChangeImage"])
                            <InputFile OnChange="OnProfileImageSelected" accept="image/jpeg,image/png,image/webp,image/gif"
                                       class="hidden"/>
                        </AppButton>
                        @if (!string.IsNullOrEmpty(user.ProfileImage ?? user.ProfileImageSmall))
                        {
                            <AppButton Variant="ButtonVariant.Danger" OnClick="ConfirmRemoveProfileImage"
                                       Class="text-left">
                                @L["Common.RemoveImage"]
                            </AppButton>
                        }
                        @if (imageError is not null)
                        {
                            <div class="text-sm text-red-500 dark:text-red-400">@imageError</div>
                        }
                    </div>
                </div>
            </div>
            <FloatingInput Id="user-name" Label="@L["Common.Name"]" Value="@editName" OnInput="HandleNameChanged"/>
            <div>
                <FloatingInput Id="user-email" Label="@L["Common.Email"]" Type="email" HasError="@(emailError is not null)"
                               Value="@editEmail" OnInput="HandleEmailChanged"/>
                @if (emailError is not null)
                {
                    <div class="text-sm text-red-500 dark:text-red-400 mt-1">@emailError</div>
                }
            </div>
            <div>
                <FloatingSelect Id="user-role" Label="@L["Common.Role"]"
                                Value="@editRole" OnChange="HandleRoleChanged" Disabled="@IsCurrentUser">
                    @foreach (var role in AllowedRoles)
                    {
                        <option value="@role">@RoleDisplayName(role)</option>
                    }
                </FloatingSelect>
                @if (IsCurrentUser)
                {
                    <div class="text-sm text-neutral-500 mt-1">@L["Users.CannotChangeOwnRole"]</div>
                }
            </div>
        </div>

        <!-- Inloggningsmetoder -->
        <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 p-5 space-y-4">
            <div class="font-semibold">@L["UserDetail.Login"]</div>

            @if (logins is null)
            {
                <div class="text-neutral-400">@L["Common.Loading"]</div>
            }
            else if (logins.Count == 0)
            {
                @if (invite is null)
                {
                    <div class="flex flex-col items-center text-center py-4 select-none">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 200 160" class="w-32 h-auto mb-3 text-neutral-300 dark:text-neutral-600">
                            <!-- Key shape -->
                            <circle cx="80" cy="70" r="24" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                            <circle cx="80" cy="70" r="10" stroke="currentColor" stroke-width="2" fill="none" opacity="0.4"/>
                            <!-- Key shaft -->
                            <line x1="104" y1="70" x2="155" y2="70" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <!-- Key teeth -->
                            <line x1="140" y1="70" x2="140" y2="82" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <line x1="150" y1="70" x2="150" y2="78" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <!-- Plus circle -->
                            <circle cx="155" cy="120" r="16" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                            <line x1="155" y1="112" x2="155" y2="128" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                            <line x1="147" y1="120" x2="163" y2="120" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                        </svg>
                        <p class="text-sm text-neutral-400 dark:text-neutral-500 leading-relaxed">@((MarkupString)L["UserDetail.NoLoginMethods"].Value)</p>
                    </div>
                }

                @if (invite is not null)
                {
                    var inviteUrl = GetInviteUrl(invite.Token);
                    <div class="p-4 bg-white dark:bg-neutral-700 rounded-xl border border-neutral-200 dark:border-neutral-600 space-y-2 @(invite.IsExpired ? "opacity-60" : "")">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 text-neutral-400">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"/>
                                </svg>
                                <span class="text-sm font-medium">@L["UserDetail.InviteLink"]</span>
                                @if (invite.IsExpired)
                                {
                                    <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-600 dark:bg-red-900/40 dark:text-red-400">@L["UserDetail.Expired"]</span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-400">@L["UserDetail.Active"]</span>
                                }
                            </div>
                            <AppButton Variant="ButtonVariant.Danger" OnClick="ConfirmDeleteInvite"
                                       Class="px-3 py-1.5">
                                @L["Common.Delete"]
                            </AppButton>
                        </div>
                        @if (!invite.IsExpired)
                        {
                            <div class="text-xs text-neutral-500 dark:text-neutral-400">
                                @L["UserDetail.ExpiresIn", FormatTimeLeft(invite.ExpiresAt)]
                            </div>
                            <div class="flex items-center gap-2">
                                <input type="text" readonly value="@inviteUrl"
                                       class="flex-1 px-3 py-2 rounded-lg bg-neutral-100 dark:bg-neutral-600 text-sm border border-neutral-200 dark:border-neutral-500 select-all"/>
                                <button class="px-3 self-stretch rounded-lg bg-neutral-200 dark:bg-neutral-500 cursor-pointer hover:bg-neutral-300 dark:hover:bg-neutral-400"
                                        title="@L["UserDetail.Copy"]"
                                        @onclick="() => CopyToClipboard(inviteUrl)">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                                        <path d="M7 3.5A1.5 1.5 0 0 1 8.5 2h3.879a1.5 1.5 0 0 1 1.06.44l3.122 3.12A1.5 1.5 0 0 1 17 6.622V12.5a1.5 1.5 0 0 1-1.5 1.5h-1v-3.379a3 3 0 0 0-.879-2.121L10.5 5.379A3 3 0 0 0 8.379 4.5H7v-1Z"/>
                                        <path d="M4.5 6A1.5 1.5 0 0 0 3 7.5v9A1.5 1.5 0 0 0 4.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L9.44 6.439A1.5 1.5 0 0 0 8.378 6H4.5Z"/>
                                    </svg>
                                </button>
                            </div>
                        }
                    </div>
                }
                @if (invite is null || invite.IsExpired)
                {
                    <div class="flex justify-center">
                        <AppButton Variant="ButtonVariant.Primary" OnClick="CreateInvite">
                            @L["UserDetail.CreateInviteLink"]
                        </AppButton>
                    </div>
                }
            }
            else
            {
                @foreach (var login in logins)
                {
                    <div class="flex items-center justify-between p-3 bg-white dark:bg-neutral-700 rounded-xl border border-neutral-200 dark:border-neutral-600">
                        <div>
                            <div class="font-medium text-sm">@ProviderDisplayName(login.Provider)</div>
                            <div class="text-xs text-neutral-500 dark:text-neutral-400 font-mono">@login.ProviderSubjectId</div>
                        </div>
                        @{ var loginToDelete = login; }
                        <AppButton Variant="ButtonVariant.Danger" OnClick="() => ConfirmDeleteLogin(loginToDelete)"
                                   Class="px-3 py-1.5">
                            @L["Common.Delete"]
                        </AppButton>
                    </div>
                }

            }
        </div>
        @if (!IsCurrentUser)
        {
            <div class="flex justify-end">
                <AppButton Variant="ButtonVariant.Danger" OnClick="ConfirmDeleteUser">
                    @L["UserDetail.DeleteUser"]
                </AppButton>
            </div>
        }
    }
</PageContainer>

@if (confirmAction is not null)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-lg" OnClose="CloseConfirmDialog">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@confirmTitle</div>
            <p>@confirmMessage</p>
            <div class="flex justify-end gap-3">
                <AppButton Variant="ButtonVariant.Cancel" OnClick="CloseConfirmDialog">
                    @L["Common.Cancel"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Danger" Filled OnClick="ExecuteConfirmAction">
                    @confirmButtonText
                </AppButton>
            </div>
        </div>
    </Dialog>
}

@if (showCropDialog)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-sm" OnClose="CloseCropDialog">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg text-center">@L["Common.CropImage"]</div>
            <div class="relative mx-auto w-64 h-64 rounded-full overflow-hidden cursor-grab active:cursor-grabbing select-none touch-none"
                 id="image-cropper"
                 style="background: repeating-conic-gradient(#d1d5db 0% 25%, white 0% 50%) 0 0 / 16px 16px;">
                <img alt="" class="absolute top-0 left-0 origin-top-left pointer-events-none max-w-none" />
            </div>
            <input type="range" min="0" max="100" value="5"
                   @oninput="OnZoomSliderChanged"
                   class="w-full accent-sky-500" />
            <div class="flex justify-end gap-3">
                <AppButton Variant="ButtonVariant.Cancel" OnClick="CloseCropDialog">
                    @L["Common.Cancel"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Primary" OnClick="ConfirmCrop">
                    @L["Common.Confirm"]
                </AppButton>
            </div>
        </div>
    </Dialog>
}

@code {
    [Parameter] public string UserId { get; set; } = "";
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string? currentUserId;
    private User? user;
    private List<UserLogin>? logins;
    private Invite? invite;
    private string editName = "";
    private string editEmail = "";
    private string? emailError;
    private string? imageError;
    private UserRole editRole;
    private Func<Task>? confirmAction;
    private string confirmTitle = "";
    private string confirmMessage = "";
    private string confirmButtonText = "";

    private bool IsCurrentUser => currentUserId is not null && currentUserId == UserId;

    private IEnumerable<UserRole> AllowedRoles => OrgState.HasPermission(Permission.AssignSuperAdminRole)
        ? Enum.GetValues<UserRole>()
        : Enum.GetValues<UserRole>().Where(r => r != UserRole.SuperAdmin);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            currentUserId = state.User.FindFirst("user_id")?.Value;
        }

        try
        {
            user = await UserService.GetByIdAsync(UserId, OrgState.ToCallerContext());
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("/admin/users");
            return;
        }

        if (user == null)
        {
            NavigationManager.NavigateTo("/admin/users");
            return;
        }
        editName = user.Name;
        editEmail = user.Email;
        editRole = user.Role;
        await Task.WhenAll(LoadLogins(), LoadInvite());
    }

    private readonly Utils.Debouncer saveDebounce = new();
    private DetailHeader? header;

    public void Dispose() => saveDebounce.Dispose();

    private void HandleNameChanged(ChangeEventArgs e)
    {
        editName = e.Value?.ToString() ?? "";
        saveDebounce.Run(SaveUser);
    }

    private async Task HandleRoleChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<UserRole>(e.Value?.ToString(), out var role))
        {
            editRole = role;
            await SaveUser();
        }
    }

    private void HandleEmailChanged(ChangeEventArgs e)
    {
        editEmail = e.Value?.ToString() ?? "";
        saveDebounce.Run(SaveUser);
    }

    private async Task SaveUser()
    {
        if (string.IsNullOrWhiteSpace(editName)) return;
        emailError = null;

        if (!string.IsNullOrWhiteSpace(editEmail) && !GospelPresenter.Shared.Utils.EmailValidation.IsValidEmail(editEmail.Trim()))
        {
            emailError = L["Users.InvalidEmail"];
            return;
        }

        if (!string.IsNullOrWhiteSpace(editEmail) && await UserService.IsEmailTakenAsync(editEmail.Trim(), UserId))
        {
            emailError = L["Users.EmailTaken"];
            return;
        }

        await UserService.UpdateUserAsync(UserId, editName.Trim(), editEmail.Trim(), editRole, OrgState.ToCallerContext());
        user!.Name = editName.Trim();
        user.Email = editEmail.Trim();
        user.Role = editRole;
        SyncNavbar();
        header?.ShowSaved();
    }

    private void ShowConfirm(string title, string message, Func<Task> action, string? buttonText = null)
    {
        confirmTitle = title;
        confirmMessage = message;
        confirmButtonText = buttonText ?? L["Common.Delete"];
        confirmAction = action;
    }

    private void CloseConfirmDialog() => confirmAction = null;

    private async Task ExecuteConfirmAction()
    {
        if (confirmAction is not null)
            await confirmAction();
        confirmAction = null;
    }

    private void ConfirmDeleteUser() => ShowConfirm(
        L["UserDetail.DeleteUser"],
        L["UserDetail.ConfirmDeleteUser", user?.Name ?? ""],
        async () => { await UserService.DeleteUserAsync(UserId, OrgState.ToCallerContext()); NavigationManager.NavigateTo("/admin/users"); });

    private void ConfirmRemoveProfileImage() => ShowConfirm(
        L["Profile.RemoveProfileImage"],
        L["Profile.ConfirmRemoveProfileImage"],
        RemoveProfileImage);

    private void ConfirmDeleteInvite() => ShowConfirm(
        L["UserDetail.DeleteInvite"],
        L["UserDetail.ConfirmDeleteInvite"],
        DeleteInvite);

    private void ConfirmDeleteLogin(UserLogin login) => ShowConfirm(
        L["UserDetail.DeleteLinkedAccount"],
        L["UserDetail.ConfirmDeleteLogin", ProviderDisplayName(login.Provider)],
        async () => { await UserService.DeleteLoginAsync(login.Id, OrgState.ToCallerContext()); await LoadLogins(); });

    private async Task LoadLogins()
    {
        logins = await UserService.GetLoginsForUserAsync(UserId, OrgState.ToCallerContext());
    }

    private async Task LoadInvite()
    {
        var invites = await UserService.GetInvitesForUserAsync(UserId, OrgState.ToCallerContext());
        invite = invites.FirstOrDefault();
    }

private async Task CreateInvite()
    {
        invite = await UserService.CreateInviteAsync(UserId, OrgState.ToCallerContext());
    }

    private async Task DeleteInvite()
    {
        if (invite is null) return;
        await UserService.DeleteInviteAsync(invite.Id, OrgState.ToCallerContext());
        invite = null;
    }

    private string GetInviteUrl(string token)
    {
        var baseUrl = NavigationManager.BaseUri.TrimEnd('/');
        return $"{baseUrl}/invite/{token}";
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            var success = await JSRuntime.InvokeAsync<bool>("copyToClipboard", text);
            if (success)
            {
                ToastService.Show(L["Toast.LinkCopied"]);
            }
        }
        catch { }
    }

    private static string ProviderDisplayName(string provider) => provider switch
    {
        "google" => "Google",
        "oidc" => "Pocket ID",
        _ => provider
    };

    private string RoleDisplayName(UserRole role) => role switch
    {
        UserRole.SuperAdmin => L["Users.Superadmin"],
        UserRole.Admin => L["Users.Admin"],
        UserRole.User => L["Users.User"],
        _ => role.ToString()
    };

    private const long MaxImageSize = 10 * 1024 * 1024;
    private static readonly HashSet<string> AllowedImageTypes = ["image/jpeg", "image/png", "image/webp", "image/gif"];
    private bool showCropDialog;

    private async Task OnProfileImageSelected(InputFileChangeEventArgs e)
    {
        imageError = null;
        var file = e.File;
        if (!AllowedImageTypes.Contains(file.ContentType))
        {
            imageError = L["Profile.UnsupportedFormat"];
            return;
        }
        if (file.Size > MaxImageSize)
        {
            imageError = L["Profile.ImageTooLarge"];
            return;
        }

        using var stream = file.OpenReadStream(MaxImageSize);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var base64 = Convert.ToBase64String(ms.ToArray());
        var dataUrl = $"data:{file.ContentType};base64,{base64}";

        showCropDialog = true;
        StateHasChanged();
        await Task.Delay(50);
        await JSRuntime.InvokeVoidAsync("initImageCropper", "image-cropper", dataUrl);
    }

    private async Task OnZoomSliderChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var value))
            await JSRuntime.InvokeVoidAsync("setImageCropperZoom", "image-cropper", value);
    }

    private async Task CloseCropDialog()
    {
        showCropDialog = false;
        await JSRuntime.InvokeVoidAsync("destroyImageCropper", "image-cropper");
    }

    private async Task ConfirmCrop()
    {
        var croppedDataUrl = await JSRuntime.InvokeAsync<string>("getImageCropResult", "image-cropper");
        showCropDialog = false;
        await JSRuntime.InvokeVoidAsync("destroyImageCropper", "image-cropper");

        if (string.IsNullOrEmpty(croppedDataUrl)) return;

        var base64Data = croppedDataUrl.Substring(croppedDataUrl.IndexOf(',') + 1);
        var imageBytes = Convert.FromBase64String(base64Data);
        var (fullDataUri, smallDataUri) = ProfileImageService.Resize(imageBytes, "image/webp");

        await UserService.UpdateProfileImageAsync(UserId, fullDataUri, smallDataUri, OrgState.ToCallerContext());
        user = await UserService.GetByIdAsync(UserId, OrgState.ToCallerContext());
        SyncNavbar();
    }

    private async Task RemoveProfileImage()
    {
        imageError = null;
        await UserService.UpdateProfileImageAsync(UserId, null, null, OrgState.ToCallerContext());
        user = await UserService.GetByIdAsync(UserId, OrgState.ToCallerContext());
        SyncNavbar();
    }

    private void SyncNavbar()
    {
        if (UserId == currentUserId)
            WeakReferenceMessenger.Default.Send(new CurrentUserChangedMessage());
    }

    private string FormatTimeLeft(DateTime expiresAt)
    {
        var days = (int)Math.Ceiling((expiresAt - DateTime.UtcNow).TotalDays);
        if (days <= 0) return L["UserDetail.LessThanADay"];
        return $"{days} {(days == 1 ? L["UserDetail.DaySingular"] : L["UserDetail.DayPlural"])}";
    }

}
