@page "/admin/songs/trash"
@attribute [Authorize(Roles = "Admin,SuperAdmin")]

@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.Authorization

@layout AdminLayout

@inject ISongService SongService
@inject ActiveOrganizationState OrgState

<div class="flex flex-col p-3 pt-8 w-full sm:w-180 mx-auto space-y-5">
    <div class="relative flex items-center justify-center px-5">
        <a href="/admin/songs"
           class="absolute left-0 flex items-center gap-2 px-4 py-2.5 rounded-full text-sm text-neutral-500 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-700 hover:text-neutral-700 dark:hover:text-neutral-200">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
            </svg>
            @L["Common.Back"]
        </a>
        <div class="text-xl font-bold dark:text-neutral-100">@L["SongTrash.Title"]</div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 overflow-hidden">
        @if (trashedSongs is null)
        {
            <div class="px-5 py-4 text-neutral-400 text-sm">@L["Common.Loading"]</div>
        }
        else if (trashedSongs.Count == 0)
        {
            <div class="px-5 py-4 text-neutral-400 text-sm">@L["SongTrash.Empty"]</div>
        }
        else
        {
            <div class="px-5 pt-4 pb-2 flex items-center justify-between">
                <div class="font-semibold">@trashedSongs.Count @(trashedSongs.Count == 1 ? L["SongTrash.SongSingular"] : L["SongTrash.SongPlural"])</div>
                <div class="flex items-center gap-2">
                    <button class="px-4 py-2 rounded-full text-sm text-sky-600 dark:text-sky-400 cursor-pointer hover:bg-sky-50 dark:hover:bg-sky-900/30"
                            @onclick="ConfirmRestoreAll">
                        @L["SongTrash.RestoreAll"]
                    </button>
                    <button class="px-4 py-2 rounded-full text-sm text-red-600 dark:text-red-400 cursor-pointer hover:bg-red-50 dark:hover:bg-red-900/30"
                            @onclick="ConfirmEmptyTrash">
                        @L["SongTrash.EmptyTrash"]
                    </button>
                </div>
            </div>

            <div>
                @foreach (var song in trashedSongs)
                {
                    <div class="flex items-center gap-3 px-5 py-3 border-b border-neutral-200 dark:border-neutral-700 last:border-b-0">
                        <div class="flex-1 min-w-0">
                            <div class="font-medium truncate">@song.Name</div>
                            <div class="text-xs text-neutral-400 truncate">
                                @if (!string.IsNullOrEmpty(song.Author))
                                {
                                    <span>@song.Author</span>
                                    <span class="mx-1">&middot;</span>
                                }
                                @if (song.DaysRemaining == 0)
                                {
                                    <span class="text-red-500 dark:text-red-400">@L["SongTrash.DeletesSoon"]</span>
                                }
                                else if (song.DaysRemaining == 1)
                                {
                                    <span class="text-red-500 dark:text-red-400">@L["SongTrash.OneDayLeft"]</span>
                                }
                                else
                                {
                                    <span>@L["SongTrash.DaysLeft", song.DaysRemaining]</span>
                                }
                            </div>
                        </div>
                        <button class="px-3 py-1.5 rounded-full text-sm text-sky-600 dark:text-sky-400 cursor-pointer hover:bg-sky-50 dark:hover:bg-sky-900/30"
                                @onclick="() => ConfirmRestore(song)">
                            @L["SongTrash.Restore"]
                        </button>
                        <button class="p-1.5 rounded-lg text-red-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-900/30 cursor-pointer"
                                @onclick="() => ConfirmPermanentDelete(song)">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                            </svg>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (confirmMessage is not null)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-md" OnClose="CancelConfirm">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@confirmTitle</div>
            <p class="text-sm text-neutral-600 dark:text-neutral-300">
                @confirmMessage
            </p>
            <div class="flex justify-end gap-3">
                <button class="px-4 py-2.5 rounded-full cursor-pointer hover:bg-neutral-100 dark:hover:bg-neutral-700"
                        @onclick="CancelConfirm">
                    @L["Common.Cancel"]
                </button>
                <button class="px-4 py-2.5 rounded-full text-white cursor-pointer disabled:opacity-50 @(confirmIsDestructive ? "bg-red-500 hover:bg-red-600" : "bg-sky-500 hover:bg-sky-600")"
                        disabled="@isProcessing"
                        @onclick="ExecuteConfirm">
                    @(isProcessing ? confirmButtonBusy : confirmButtonText)
                </button>
            </div>
        </div>
    </Dialog>
}

@code {

    private List<TrashedSong>? trashedSongs;
    private MarkupString? confirmMessage;
    private string confirmTitle = "";
    private string confirmButtonText = "";
    private string confirmButtonBusy = "";
    private bool confirmIsDestructive;
    private Func<Task>? confirmAction;
    private bool isProcessing;
    private string? organizationId;

    protected override async Task OnInitializedAsync()
    {
        organizationId = OrgState.ActiveOrganizationId;
        if (organizationId is null) return;
        trashedSongs = await SongService.GetTrashedSongsAsync(organizationId, OrgState.ToCallerContext());
    }

    private void ConfirmRestore(TrashedSong song)
    {
        confirmTitle = L["SongTrash.Restore"];
        confirmMessage = new MarkupString(L["SongTrash.ConfirmRestore", System.Net.WebUtility.HtmlEncode(song.Name)]);
        confirmButtonText = L["SongTrash.Restore"];
        confirmButtonBusy = L["SongTrash.Restoring"];
        confirmIsDestructive = false;
        confirmAction = async () =>
        {
            await SongService.RestoreFromTrashAsync(song.Id, organizationId!, OrgState.ToCallerContext());
            trashedSongs = await SongService.GetTrashedSongsAsync(organizationId!, OrgState.ToCallerContext());
        };
    }

    private void ConfirmRestoreAll()
    {
        confirmTitle = L["SongTrash.RestoreAll"];
        confirmMessage = new MarkupString(L["SongTrash.ConfirmRestore", trashedSongs!.Count].Value);
        confirmButtonText = L["SongTrash.RestoreAll"];
        confirmButtonBusy = L["SongTrash.Restoring"];
        confirmIsDestructive = false;
        confirmAction = async () =>
        {
            await SongService.RestoreAllFromTrashAsync(organizationId!, OrgState.ToCallerContext());
            trashedSongs = await SongService.GetTrashedSongsAsync(organizationId!, OrgState.ToCallerContext());
        };
    }

    private void ConfirmPermanentDelete(TrashedSong song)
    {
        confirmTitle = L["SongTrash.DeletePermanently"];
        confirmMessage = new MarkupString(L["SongTrash.ConfirmPermanentDelete", System.Net.WebUtility.HtmlEncode(song.Name)]);
        confirmButtonText = L["SongTrash.DeletePermanently"];
        confirmButtonBusy = L["Common.Deleting"];
        confirmIsDestructive = true;
        confirmAction = async () =>
        {
            await SongService.PermanentlyDeleteSongAsync(song.Id, organizationId!, OrgState.ToCallerContext());
            trashedSongs = await SongService.GetTrashedSongsAsync(organizationId!, OrgState.ToCallerContext());
        };
    }

    private void ConfirmEmptyTrash()
    {
        confirmTitle = L["SongTrash.EmptyTrash"];
        confirmMessage = new MarkupString(L["SongTrash.ConfirmEmptyTrash", trashedSongs!.Count].Value);
        confirmButtonText = L["SongTrash.DeletePermanently"];
        confirmButtonBusy = L["Common.Deleting"];
        confirmIsDestructive = true;
        confirmAction = async () =>
        {
            await SongService.EmptyTrashAsync(organizationId!, OrgState.ToCallerContext());
            trashedSongs = await SongService.GetTrashedSongsAsync(organizationId!, OrgState.ToCallerContext());
        };
    }

    private void CancelConfirm()
    {
        confirmMessage = null;
        confirmAction = null;
    }

    private async Task ExecuteConfirm()
    {
        if (isProcessing || confirmAction is null) return;
        isProcessing = true;
        await confirmAction();
        isProcessing = false;
        confirmMessage = null;
        confirmAction = null;
    }
}
