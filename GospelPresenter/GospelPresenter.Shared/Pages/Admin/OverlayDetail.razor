@page "/admin/overlays/{OverlayId}"
@attribute [Authorize(Policy = ManageOverlays)]

@using GospelPresenter.Shared.Components.Presentations
@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.Authorization

@layout AdminLayout

@inject IPresentationService PresentationService
@inject NavigationManager NavigationManager
@inject ActiveOrganizationState OrgState

<PageContainer>
    <DetailHeader @ref="header" BackHref="/admin/overlays" Title="@overlay?.Title" Class="px-5"/>

    @if (overlay is null)
    {
        <div class="px-7 text-neutral-400">@L["Common.Loading"]</div>
    }
    else
    {
        <OverlayEditor Overlay="@overlay"
                       Class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t-[0.5px] border-white dark:border-neutral-700 p-5"
                       OnChanged="HandleChanged"
                       OnSaved="() => header?.ShowSaved()"/>
        <div class="flex justify-end">
            <AppButton Variant="ButtonVariant.Danger" OnClick="ConfirmDelete">
                @L["Common.Delete"]
            </AppButton>
        </div>
    }
</PageContainer>

@if (deleteConfirmMessage is not null)
{
    <ConfirmDeleteDialog Message="deleteConfirmMessage.Value"
                         IsDeleting="isDeleting"
                         OnConfirm="ExecuteDelete"
                         OnClose="() => deleteConfirmMessage = null"/>
}

@code {
    [Parameter] public string OverlayId { get; set; } = "";

    private OverlaySlide? overlay;
    private string? organizationId;
    private DetailHeader? header;
    private MarkupString? deleteConfirmMessage;
    private bool isDeleting;

    protected override async Task OnInitializedAsync()
    {
        organizationId = OrgState.ActiveOrganizationId;
        if (organizationId is null)
        {
            NavigationManager.NavigateTo("/admin/overlays");
            return;
        }

        overlay = await PresentationService.GetOverlayByIdAsync(OverlayId, organizationId, OrgState.ToCallerContext());
        if (overlay is null)
        {
            NavigationManager.NavigateTo("/admin/overlays");
        }
    }

    private async Task HandleChanged(OverlaySlide changed)
    {
        if (organizationId is null) return;
        await PresentationService.UpdateOverlayAsync(organizationId, changed, OrgState.ToCallerContext());
    }

    private void ConfirmDelete()
    {
        deleteConfirmMessage = new MarkupString(L["Overlays.ConfirmDelete", System.Net.WebUtility.HtmlEncode(overlay?.Title ?? "")]);
    }

    private async Task ExecuteDelete()
    {
        if (isDeleting || overlay is null || organizationId is null) return;
        isDeleting = true;
        try
        {
            await PresentationService.RemoveOverlayAsync(organizationId, overlay.Id, OrgState.ToCallerContext());
            NavigationManager.NavigateTo("/admin/overlays");
        }
        finally
        {
            isDeleting = false;
        }
    }
}
