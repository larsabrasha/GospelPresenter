@page "/admin/images"
@attribute [Authorize(Policy = ManageOrganizationImages)]

@using GospelPresenter.Shared.Components.Presentations
@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging

@implements IDisposable

@layout AdminLayout

@inject IOrganizationImageService OrganizationImageService
@inject IJSRuntime JsRuntime
@inject IServiceProvider Services
@inject ActiveOrganizationState OrgState
@inject ILogger<Images> Logger

<PageContainer>
    <div class="px-5 flex items-center justify-between">
        <div class="text-xl font-bold dark:text-neutral-100">@L["Images.Title"]</div>
        <AppButton Variant="ButtonVariant.Primary" AsLabel="@(mediaUploader is null)" OnClick="PickAndUpload" Disabled="@(isUploading || organizationId is null)"
                   Class="inline-flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/>
            </svg>
            @L["ImageTab.Upload"]
            @if (mediaUploader is null)
            {
                <input @ref="fileInput" type="file" @onchange="HandleFilesSelected" accept="@AppConstraints.ImageAccept" multiple class="hidden"/>
            }
        </AppButton>
    </div>

    @if (isUploading || uploadError is not null)
    {
        <div class="px-5 flex items-center gap-3 text-sm">
            @if (isUploading)
            {
                <span class="text-neutral-500 dark:text-neutral-400">@L["ImageTab.UploadingProgress", uploadedCount, uploadTotalCount]</span>
            }
            @if (uploadError is not null)
            {
                <span class="text-red-500 dark:text-red-400">@uploadError</span>
            }
        </div>
    }

    <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t-[0.5px] border-white dark:border-neutral-700">
        <div class="px-5 pt-4 pb-2 space-y-3">
            <div class="font-semibold">
                @L["Images.AllImages"] (@images.Count)
            </div>
            @if (images.Count > 0)
            {
                <div class="relative">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-neutral-400 pointer-events-none">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
                    </svg>
                    <input type="text"
                           maxlength="@AppConstraints.SearchMaxLength"
                           class="w-full py-2 pl-10 pr-4 rounded-full border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-700 text-neutral-900 dark:text-neutral-100 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 @(string.IsNullOrEmpty(searchQuery) ? "" : "!pr-9")"
                           placeholder="@L["Common.Search"]"
                           value="@searchQuery"
                           @oninput="OnSearchInput"/>
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <AppButton Variant="ButtonVariant.Icon" Class="absolute right-2.5 top-1/2 -translate-y-1/2 size-6"
                                   OnClick="ClearSearch">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                            </svg>
                        </AppButton>
                    }
                </div>
            }
        </div>

        @if (isLoading)
        {
            <div class="px-5 py-4 text-neutral-400 text-sm">@L["ImageTab.LoadingImages"]</div>
        }
        else if (images.Count == 0)
        {
            <div class="flex flex-col items-center justify-center text-center text-sm py-12 px-6 select-none">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-12 mb-3 text-neutral-300 dark:text-neutral-600">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
                </svg>
                <p class="font-medium text-neutral-500 dark:text-neutral-400 mb-1">@L["Images.NoImages"]</p>
                <p class="text-xs text-neutral-400 dark:text-neutral-500 max-w-xs leading-relaxed">@L["Images.NoImagesHint"]</p>
            </div>
        }
        else if (displayedImages.Count == 0)
        {
            <div class="px-5 py-4 text-neutral-400 text-sm">@L["Images.NoImagesFound"]</div>
        }
        else
        {
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-1 p-3">
                @foreach (var image in displayedImages)
                {
                    <div class="relative p-2 flex flex-col items-center min-w-0">
                        <div class="relative rounded-lg">
                            <img src="@ImageUrlHelper.OrgImageUrl(image.Id, "thumb")"
                                 alt="@image.FileName"
                                 class="block max-w-full max-h-32 rounded-lg"/>
                            <div class="absolute top-1 right-1">
                                <Dropdown MenuClass="right-0 min-w-36">
                                    <Trigger>
                                        <button class="size-7 flex items-center justify-center rounded-full bg-black/60 text-white cursor-pointer hover:bg-black/80">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
                                                <path d="M3 10a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0ZM8.5 10a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0ZM15.5 8.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"/>
                                            </svg>
                                        </button>
                                    </Trigger>
                                    <Menu>
                                        <button class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-neutral-100 dark:hover:bg-neutral-700 cursor-pointer"
                                                @onclick="() => ConfirmDelete(image)">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                                            </svg>
                                            @L["Common.Delete"]
                                        </button>
                                    </Menu>
                                </Dropdown>
                            </div>
                        </div>
                        <p class="text-xs text-neutral-500 dark:text-neutral-400 truncate mt-1 text-center w-full">@image.FileName</p>
                    </div>
                }
            </div>
        }
    </div>
</PageContainer>

@if (imageToDelete is not null)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-sm" OnClose="CancelDelete">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["ImageTab.DeleteImage"]</div>
            <div><LocalizedEmphasis Key="ImageTab.ConfirmDelete" Value="@imageToDelete.FileName"/></div>
            <div class="flex justify-end gap-3">
                <AppButton Variant="ButtonVariant.Cancel" OnClick="CancelDelete">
                    @L["Common.Cancel"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Danger" Filled OnClick="DeleteImage">
                    @L["Common.Delete"]
                </AppButton>
            </div>
        </div>
    </Dialog>
}

@code {
    private string? organizationId;
    private List<OrganizationImage> images = [];
    private List<OrganizationImage> displayedImages = [];
    private string searchQuery = "";
    private bool isLoading = true;
    private bool isUploading;
    private int uploadedCount;
    private int uploadTotalCount;
    private int failedCount;
    private string? uploadError;
    private OrganizationImage? imageToDelete;
    private ElementReference fileInput;
    private DotNetObjectReference<Images>? dotNetRef;

    private IMediaUploader? mediaUploader;

    // Only the device app registers an uploader; the web keeps the file input.
    protected override void OnInitialized() =>
        mediaUploader = Services.GetService(typeof(IMediaUploader)) as IMediaUploader;

    protected override async Task OnInitializedAsync()
    {
        organizationId = OrgState.ActiveOrganizationId;

        if (organizationId is not null)
        {
            images = await OrganizationImageService.GetImagesAsync(organizationId, OrgState.ToCallerContext());
            displayedImages = images.ToList();
        }

        isLoading = false;
    }

    /// <summary>The device path: the picker and the ingest both live behind the seam.</summary>
    private async Task PickAndUpload()
    {
        if (mediaUploader is null || isUploading || organizationId is null) return;
        uploadError = null;
        failedCount = 0;
        isUploading = true;
        StateHasChanged();

        await mediaUploader.PickAndUploadAsync(
            new MediaUploadTarget(MediaUploadKind.OrganizationImage, organizationId),
            new MediaUploadCallbacks(OnUploadStarted, OnFileUploaded, OnFileUploadFailed, OnAllUploadsComplete));
    }

    private async Task HandleFilesSelected()
    {
        if (isUploading || organizationId is null) return;
        uploadError = null;
        failedCount = 0;
        isUploading = true;
        StateHasChanged();

        dotNetRef ??= DotNetObjectReference.Create(this);
        await JsRuntime.InvokeVoidAsync("uploadFiles", fileInput, "/api/upload/org-image", organizationId, dotNetRef, AppConstraints.MaxImageFileSizeBytes, AppConstraints.AllowedImageTypes);
    }

    [JSInvokable]
    public void OnUploadStarted(int totalCount)
    {
        uploadedCount = 0;
        uploadTotalCount = totalCount;
    }

    [JSInvokable]
    public void OnFileUploaded(string json)
    {
        var result = System.Text.Json.JsonSerializer.Deserialize<UploadResult>(json, UploadResult.JsonOptions);
        if (result is null) return;
        var image = new OrganizationImage
        {
            Id = result.Id,
            FileName = result.FileName,
            ContentType = result.ContentType
        };
        images.Insert(0, image);
        ApplySearchFilter();
        uploadedCount++;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnFileUploadFailed(string fileName)
    {
        Logger.LogError("Failed to upload image {FileName}", fileName);
        uploadedCount++;
        failedCount++;
        uploadError = L["ImageTab.UploadErrorCount", failedCount];
        StateHasChanged();
    }

    [JSInvokable]
    public void OnAllUploadsComplete()
    {
        isUploading = false;
        StateHasChanged();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplySearchFilter();
    }

    private void ClearSearch()
    {
        searchQuery = "";
        ApplySearchFilter();
    }

    private void ApplySearchFilter()
    {
        displayedImages = string.IsNullOrWhiteSpace(searchQuery)
            ? images.ToList()
            : images.Where(i => i.FileName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void ConfirmDelete(OrganizationImage image)
    {
        imageToDelete = image;
    }

    private void CancelDelete()
    {
        imageToDelete = null;
    }

    private async Task DeleteImage()
    {
        if (imageToDelete is null || organizationId is null) return;

        await OrganizationImageService.DeleteImageAsync(imageToDelete.Id, organizationId, OrgState.ToCallerContext());
        images.Remove(imageToDelete);
        ApplySearchFilter();
        imageToDelete = null;
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }
}
