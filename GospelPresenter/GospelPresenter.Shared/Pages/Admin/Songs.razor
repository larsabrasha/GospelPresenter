@page "/admin/songs"
@attribute [Authorize(Policy = ManageSongs)]
@using GospelPresenter.Shared.Components.Presentations
@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using GospelPresenter.Shared.Utils
@using Microsoft.AspNetCore.Authorization

@layout AdminLayout

@inject ISongService SongService
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager
@inject ActiveOrganizationState OrgState

<PageContainer>
    <AdminPageHeader Title="@L["Songs.Title"].Value" Class="px-5">
        <PrimaryAction>
            <AppButton Variant="ButtonVariant.Primary" OnClick="CreateSong" Loading="creating" Class="flex items-center gap-1.5">
                <PlusSymbol Class="size-4"/>
                @L["Songs.Create"]
            </AppButton>
        </PrimaryAction>
    </AdminPageHeader>

    @* Importing is its own section with its own action, which is why AdminPageHeader is per section
       rather than per page. *@
    <AdminPanel Class="p-5 space-y-4">
        <div class="font-semibold">@L["Songs.ImportProPresenter"]</div>
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
            @((MarkupString)L["Songs.ImportDescription"].Value)
        </p>

        <AppButton Variant="ButtonVariant.Primary" AsLabel Class="inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"/>
            </svg>
            @(isImporting ? L["Songs.Importing"] : L["Songs.ChooseFiles"])
            <input @ref="fileInput" type="file" @onchange="OnFilesSelected" multiple accept=".pro" class="hidden" disabled="@isImporting"/>
        </AppButton>

        @if (isImporting)
        {
            @* Importing three files finishes before the eye registers a progress bar, so the same
               delay that guards the loading line guards this one. *@
            <div class="space-y-2 delayed-appear">
                <div class="text-sm text-neutral-600 dark:text-neutral-300">
                    @importProgressText
                </div>
                <div class="w-full bg-neutral-200 dark:bg-neutral-700 rounded-full h-2 overflow-hidden">
                    <div class="bg-sky-500 h-2 rounded-full w-1/3 animate-pulse"></div>
                </div>
            </div>
        }
        else if (importMessage is not null)
        {
            <div class="text-sm @(importError ? "text-red-500 dark:text-red-400" : "text-green-600 dark:text-green-400")">
                @importMessage
            </div>
        }
    </AdminPanel>

    <AdminPanel>
        <AdminListToolbar Label="@L["Songs.AllSongs"].Value"
                          Total="OrgSongs.Count"
                          Shown="displayedSongs.Count"
                          Searchable="true"
                          Search="@searchQuery"
                          SearchChanged="OnSearchChanged">
            <Actions>
                @if (OrgSongs.Count > AppConstraints.SortControlMinItems)
                {
                    <SortDropdown TSort="SongSortOrder"
                                  Value="sort"
                                  ValueChanged="OnSortChanged"
                                  LabelPrefix="Songs"
                                  Default="SongSortOrder.NameAsc"/>
                }
                <AppButton Variant="ButtonVariant.Neutral" Href="/admin/songs/trash" Class="flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                    </svg>
                    @L["Songs.Trash"]
                </AppButton>
            </Actions>
        </AdminListToolbar>

        <AdminList Items="displayedSongs" TotalCount="OrgSongs.Count" OnClearSearch="ClearSearch">
            <Empty>
                <AdminEmptyState Title="@L["Songs.NoSongsImported"].Value">
                    <Illustration>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 200 160" class="w-full h-auto">
                            <rect x="30" y="26" width="92" height="114" rx="8" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                            <line x1="48" y1="54" x2="104" y2="54" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.4"/>
                            <line x1="48" y1="70" x2="96" y2="70" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
                            <line x1="48" y1="86" x2="100" y2="86" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.25"/>
                            <line x1="48" y1="102" x2="88" y2="102" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.2"/>
                            <path d="M136 108V44l30-9v64" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="128" cy="112" r="9" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                            <circle cx="158" cy="103" r="9" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                        </svg>
                    </Illustration>
                    <Description>@L["Songs.NoSongsHint"]</Description>
                    <Action>
                        <AppButton Variant="ButtonVariant.Primary" OnClick="CreateSong" Loading="creating" Class="flex items-center gap-1.5">
                            <PlusSymbol Class="size-4"/>
                            @L["Songs.Create"]
                        </AppButton>
                    </Action>
                </AdminEmptyState>
            </Empty>
            <NoResults>
                <AdminNoResults Message="@L["Songs.NoSongsFound"].Value" OnClear="ClearSearch"/>
            </NoResults>
            <Row Context="song">
                <AdminListRow Href="@($"/admin/songs/{song.Id}")">
                    <div class="font-medium truncate">@((MarkupString)Highlight(song.Name))</div>
                    <div class="text-xs text-neutral-400 truncate">
                        @(string.IsNullOrEmpty(song.Author) ? (MarkupString)" " : (MarkupString)Highlight(song.Author))
                    </div>
                </AdminListRow>
            </Row>
        </AdminList>
    </AdminPanel>
</PageContainer>

@if (duplicateNames is not null)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-lg" OnClose="CancelImport">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["Songs.DuplicatesFound"]</div>
            <p class="text-sm text-neutral-600 dark:text-neutral-300">
                @((MarkupString)L["Songs.DuplicatesCount", duplicateNames.Count, pendingFileCount].Value)
            </p>
            <div class="max-h-48 overflow-y-auto text-sm space-y-1">
                @foreach (var name in duplicateNames)
                {
                    <div class="px-3 py-1.5 bg-neutral-100 dark:bg-neutral-700 rounded-lg truncate">@name</div>
                }
            </div>
            <div class="flex justify-end gap-3 pt-2">
                <AppButton Variant="ButtonVariant.Cancel" OnClick="CancelImport">
                    @L["Common.Cancel"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Neutral" OnClick="() => FinishImport(false)">
                    @L["Songs.SkipDuplicates"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Primary" OnClick="() => FinishImport(true)">
                    @L["Songs.ReplaceDuplicates"]
                </AppButton>
            </div>
        </div>
    </Dialog>
}

@if (showNameDialog)
{
    <NameDialog Title="@L["Songs.CreateTitle"]"
                Name="@newSongName"
                SaveText="@L["Common.Create"]"
                SaveLoadingText="@L["Common.Creating"]"
                OnSave="HandleCreateSong"
                OnClose="() => showNameDialog = false"/>
}

@code {
    private bool isImporting;
    private string? importMessage;
    private string? importProgressText;
    private bool importError;
    private string? organizationId;
    private bool hasPendingDuplicates;
    private int pendingFileCount;
    private List<string>? duplicateNames;
    private string searchQuery = "";
    private string[] searchTerms = [];
    private SongSortOrder sort = SongSortOrder.NameAsc;
    private List<Song> displayedSongs = [];
    private ElementReference fileInput;

    private IReadOnlyList<Song> OrgSongs => organizationId is not null
        ? SongService.GetSongsByOrganization(organizationId, OrgState.ToCallerContext())
        : [];

    protected override void OnInitialized()
    {
        organizationId = OrgState.ActiveOrganizationId;
        RefreshDisplayedSongs();
    }

    private async Task OnFilesSelected()
    {
        if (isImporting || organizationId is null) return;
        isImporting = true;
        importMessage = null;
        importError = false;
        importProgressText = L["Songs.ProcessingFiles"];
        StateHasChanged();

        await DoImport(replaceExisting: false);
    }

    private async Task DoImport(bool replaceExisting)
    {
        try
        {
            var result = await JsRuntime.InvokeAsync<SongImportResponse?>(
                "uploadAllFiles", fileInput, "/api/upload/import-songs", organizationId, replaceExisting);

            if (result is null)
                throw new InvalidOperationException("Upload failed");

            if (result.Duplicates is { Count: > 0 })
            {
                duplicateNames = result.Duplicates;
                pendingFileCount = result.FileCount;
                hasPendingDuplicates = true;
                isImporting = false;
                return;
            }

            importMessage = FormatImportResult(new ImportResult(result.Imported, result.Replaced, result.Skipped));
            RefreshDisplayedSongs();
        }
        catch (Exception ex)
        {
            importMessage = L["Songs.ImportError", ex.Message];
            importError = true;
        }
        finally
        {
            isImporting = false;
        }
    }

    private void CancelImport()
    {
        hasPendingDuplicates = false;
        duplicateNames = null;
    }

    private async Task FinishImport(bool replaceExisting)
    {
        if (!hasPendingDuplicates || organizationId is null) return;

        hasPendingDuplicates = false;
        duplicateNames = null;
        isImporting = true;
        importProgressText = L["Songs.SavingSongs"];
        StateHasChanged();

        await DoImport(replaceExisting);
    }

    private string FormatImportResult(ImportResult result)
    {
        var parts = new List<string>();
        if (result.Imported > 0)
            parts.Add(result.Imported == 1
                ? L["Songs.ImportedSingular", result.Imported]
                : L["Songs.ImportedPlural", result.Imported]);
        if (result.Replaced > 0)
            parts.Add(result.Replaced == 1
                ? L["Songs.ReplacedSingular", result.Replaced]
                : L["Songs.ReplacedPlural", result.Replaced]);
        if (result.Skipped > 0)
            parts.Add(result.Skipped == 1
                ? L["Songs.SkippedSingular", result.Skipped]
                : L["Songs.SkippedPlural", result.Skipped]);

        if (parts.Count == 0)
            return L["Songs.NoSongsImportable"];

        return string.Join(", ", parts) + ".";
    }

    /// <summary>
    /// Search narrows, sort orders — and the chosen sort applies to search results too rather than
    /// letting relevance quietly override it. A control that stops working the moment you type in the
    /// box beside it is worse than no control.
    /// </summary>
    private void RefreshDisplayedSongs()
    {
        var matches = string.IsNullOrWhiteSpace(searchQuery)
            ? OrgSongs
            : SongService.SearchByOrganization(searchQuery, organizationId!, OrgState.ToCallerContext());

        displayedSongs = matches.Sort(sort).ToList();
    }

    private void OnSearchChanged(string value)
    {
        searchQuery = value;
        searchTerms = string.IsNullOrWhiteSpace(searchQuery)
            ? []
            : searchQuery.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        RefreshDisplayedSongs();
    }

    private void OnSortChanged(SongSortOrder value)
    {
        sort = value;
        RefreshDisplayedSongs();
    }

    private void ClearSearch() => OnSearchChanged("");

    private bool showNameDialog;
    private string newSongName = "";
    private bool creating;

    private void CreateSong()
    {
        newSongName = "";
        showNameDialog = true;
    }

    private async Task HandleCreateSong(string name)
    {
        if (organizationId is null) return;

        creating = true;
        try
        {
            var song = await SongService.CreateSongAsync(name, null, null, null, null, [], organizationId, OrgState.ToCallerContext());
            NavigationManager.NavigateTo($"/admin/songs/{song.Id}");
        }
        finally
        {
            creating = false;
            showNameDialog = false;
        }
    }

    private string Highlight(string text) => SearchHighlighter.Highlight(text, searchTerms);

    private record SongImportResponse(int Imported = 0, int Skipped = 0, int Replaced = 0, int FileCount = 0, List<string>? Duplicates = null);
}
