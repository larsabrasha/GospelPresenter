@page "/admin/songs"
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@implements IDisposable

@using GospelPresenter.Shared.Components.Presentations
@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using GospelPresenter.Shared.Utils
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms

@layout AdminLayout

@inject ISongService SongService
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager
@inject ActiveOrganizationState OrgState

<PageContainer>
    <div class="px-5 flex items-center justify-between">
        <div class="text-xl font-bold dark:text-neutral-100">@L["Songs.Title"]</div>
        @if (displayedSongs.Count > 0)
        {
            <AppButton Variant="ButtonVariant.Primary" OnClick="CreateSong" Loading="creating" Class="flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                @L["Songs.Create"]
            </AppButton>
        }
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 overflow-hidden p-5 space-y-4">
        <div class="font-semibold">@L["Songs.ImportProPresenter"]</div>
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
            @((MarkupString)L["Songs.ImportDescription"].Value)
        </p>

        <AppButton Variant="ButtonVariant.Primary" AsLabel Class="inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"/>
            </svg>
            @(isImporting ? L["Songs.Importing"] : L["Songs.ChooseFiles"])
            <InputFile OnChange="OnFilesSelected" multiple accept=".pro" class="hidden" disabled="@isImporting"/>
        </AppButton>

        @if (isImporting)
        {
            <div class="space-y-2">
                <div class="text-sm text-neutral-600 dark:text-neutral-300">
                    @importProgressText
                </div>
                <div class="w-full bg-neutral-200 dark:bg-neutral-700 rounded-full h-2 overflow-hidden">
                    @if (importTotal > 0)
                    {
                        <div class="bg-sky-500 h-2 rounded-full transition-all duration-200"
                             style="width: @((int)(100.0 * importProgress / importTotal))%"></div>
                    }
                    else
                    {
                        <div class="bg-sky-500 h-2 rounded-full w-1/3 animate-pulse"></div>
                    }
                </div>
            </div>
        }
        else if (importMessage is not null)
        {
            <div class="text-sm @(importError ? "text-red-500 dark:text-red-400" : "text-green-600 dark:text-green-400")">
                @importMessage
            </div>
        }
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 overflow-hidden">
        <div class="px-5 pt-4 pb-2 space-y-3">
            <div class="flex items-center justify-between">
                <div class="font-semibold">
                    @L["Songs.AllSongs"] (@OrgSongs.Count)
                </div>
                <AppButton Variant="ButtonVariant.Neutral" Href="/admin/songs/trash" Class="flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                    </svg>
                    @L["Songs.Trash"]
                </AppButton>
            </div>
            @if (OrgSongs.Count > 0)
            {
                <div class="relative">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-neutral-400 pointer-events-none">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
                    </svg>
                    <input type="text"
                           class="w-full py-2 pl-10 pr-4 rounded-full border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-700 text-neutral-900 dark:text-neutral-100 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 @(string.IsNullOrEmpty(searchQuery) ? "" : "!pr-9")"
                           placeholder="@L["Common.Search"]"
                           value="@searchQuery"
                           @oninput="OnSearchInput"/>
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <AppButton Variant="ButtonVariant.Icon" Class="absolute right-2.5 top-1/2 -translate-y-1/2 size-6"
                                   OnClick="ClearSearch">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                            </svg>
                        </AppButton>
                    }
                </div>
            }
        </div>

        @if (OrgSongs.Count == 0)
        {
            <div class="px-5 py-4 text-neutral-400 text-sm">@L["Songs.NoSongsImported"]</div>
        }
        else if (displayedSongs.Count == 0)
        {
            <div class="px-5 py-4 text-neutral-400 text-sm">@L["Songs.NoSongsFound"]</div>
        }
        else
        {
            <div>
                @foreach (var song in displayedSongs)
                {
                    <a href="/admin/songs/@song.Id"
                       class="flex items-center gap-3 px-5 py-3 border-b border-neutral-200 dark:border-neutral-700 last:border-b-0 hover:bg-neutral-100 dark:hover:bg-neutral-700/50 no-underline text-inherit">
                        <div class="flex-1 min-w-0">
                            <div class="font-medium truncate">@((MarkupString)Highlight(song.Name))</div>
                            <div class="text-xs text-neutral-400 truncate">
                                @(string.IsNullOrEmpty(song.Author) ? (MarkupString)"\u00a0" : (MarkupString)Highlight(song.Author))
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</PageContainer>

@if (duplicateNames is not null)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-lg" OnClose="CancelImport">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["Songs.DuplicatesFound"]</div>
            <p class="text-sm text-neutral-600 dark:text-neutral-300">
                @((MarkupString)L["Songs.DuplicatesCount", duplicateNames.Count, pendingFiles!.Count].Value)
            </p>
            <div class="max-h-48 overflow-y-auto text-sm space-y-1">
                @foreach (var name in duplicateNames)
                {
                    <div class="px-3 py-1.5 bg-neutral-100 dark:bg-neutral-700 rounded-lg truncate">@name</div>
                }
            </div>
            <div class="flex justify-end gap-3 pt-2">
                <AppButton Variant="ButtonVariant.Cancel" OnClick="CancelImport">
                    @L["Common.Cancel"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Neutral" OnClick="() => FinishImport(false)">
                    @L["Songs.SkipDuplicates"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Primary" OnClick="() => FinishImport(true)">
                    @L["Songs.ReplaceDuplicates"]
                </AppButton>
            </div>
        </div>
    </Dialog>
}

@if (showNameDialog)
{
    <NameDialog Title="@L["Songs.Create"]"
                Name="@newSongName"
                SaveText="@L["Common.Create"]"
                SaveLoadingText="@L["Common.Creating"]"
                OnSave="HandleCreateSong"
                OnClose="() => showNameDialog = false"/>
}

@code {
    private bool isImporting;
    private string? importMessage;
    private string? importProgressText;
    private int importProgress;
    private int importTotal;
    private bool importError;
    private string? organizationId;
    private List<(string FileName, byte[] Data)>? pendingFiles;
    private List<string>? duplicateNames;
    private string searchQuery = "";
    private string[] searchTerms = [];
    private List<Song> displayedSongs = [];
    private readonly Debouncer searchDebounce = new(150);


    private IReadOnlyList<Song> OrgSongs => organizationId is not null
        ? SongService.GetSongsByOrganization(organizationId, OrgState.ToCallerContext())
        : [];

    protected override void OnInitialized()
    {
        organizationId = OrgState.ActiveOrganizationId;
        displayedSongs = OrgSongs.ToList();
    }

    public void Dispose() => searchDebounce.Dispose();

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        if (isImporting || organizationId is null) return;
        isImporting = true;
        importMessage = null;
        importError = false;

        var proFiles = e.GetMultipleFiles(1000)
            .Where(f => f.Name.EndsWith(".pro", StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (proFiles.Count == 0)
        {
            importMessage = L["Songs.NoProFiles"];
            importError = true;
            isImporting = false;
            return;
        }

        importTotal = proFiles.Count;
        importProgress = 0;
        importProgressText = L["Songs.ReadingFiles", 0, importTotal];

        try
        {
            // Read files from browser streams (must happen on the sync context)
            var files = new List<(string FileName, byte[] Data)>();
            foreach (var file in proFiles)
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                files.Add((file.Name, ms.ToArray()));
                importProgress++;
                importProgressText = L["Songs.ReadingFiles", importProgress, importTotal];
                StateHasChanged();
            }

            // Parse and check duplicates on a background thread
            importProgressText = L["Songs.ProcessingFiles"];
            importTotal = 0;
            StateHasChanged();

            var orgId = organizationId;
            var caller = OrgState.ToCallerContext();

            var parsedNames = await Task.Run(() => files
                .Select(f => ProPresenterParser.Parse(f.Data, Path.GetFileNameWithoutExtension(f.FileName)))
                .Where(s => s is not null)
                .Select(s => s!.Name)
                .ToList());

            var duplicates = await SongService.FindDuplicateNamesAsync(parsedNames, orgId, caller);

            if (duplicates.Count > 0)
            {
                pendingFiles = files;
                duplicateNames = duplicates;
                isImporting = false;
                return;
            }

            importProgressText = L["Songs.SavingSongs"];
            StateHasChanged();

            var result = await SongService.ImportProPresenterFilesAsync(files, orgId, caller);
            importMessage = FormatImportResult(result);
            RefreshDisplayedSongs();
        }
        catch (Exception ex)
        {
            importMessage = L["Songs.ImportError", ex.Message];
            importError = true;
        }
        finally
        {
            isImporting = false;
        }
    }

    private void CancelImport()
    {
        pendingFiles = null;
        duplicateNames = null;
    }

    private async Task FinishImport(bool replaceExisting)
    {
        if (pendingFiles is null || organizationId is null) return;

        var files = pendingFiles;
        pendingFiles = null;
        duplicateNames = null;
        isImporting = true;
        importTotal = 0;
        importProgressText = L["Songs.SavingSongs"];

        try
        {
            var result = await SongService.ImportProPresenterFilesAsync(files, organizationId, OrgState.ToCallerContext(), replaceExisting);
            importMessage = FormatImportResult(result);
            RefreshDisplayedSongs();
        }
        catch (Exception ex)
        {
            importMessage = L["Songs.ImportError", ex.Message];
            importError = true;
        }
        finally
        {
            isImporting = false;
        }
    }

    private string FormatImportResult(ImportResult result)
    {
        var parts = new List<string>();
        if (result.Imported > 0)
            parts.Add(result.Imported == 1
                ? L["Songs.ImportedSingular", result.Imported]
                : L["Songs.ImportedPlural", result.Imported]);
        if (result.Replaced > 0)
            parts.Add(result.Replaced == 1
                ? L["Songs.ReplacedSingular", result.Replaced]
                : L["Songs.ReplacedPlural", result.Replaced]);
        if (result.Skipped > 0)
            parts.Add(result.Skipped == 1
                ? L["Songs.SkippedSingular", result.Skipped]
                : L["Songs.SkippedPlural", result.Skipped]);

        if (parts.Count == 0)
            return L["Songs.NoSongsImportable"];

        return string.Join(", ", parts) + ".";
    }

    private void RefreshDisplayedSongs()
    {
        displayedSongs = string.IsNullOrWhiteSpace(searchQuery)
            ? OrgSongs.ToList()
            : SongService.SearchByOrganization(searchQuery, organizationId!, OrgState.ToCallerContext()).ToList();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        searchTerms = string.IsNullOrWhiteSpace(searchQuery)
            ? []
            : searchQuery.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        searchDebounce.Run(() =>
        {
            displayedSongs = string.IsNullOrWhiteSpace(searchQuery)
                ? OrgSongs.ToList()
                : SongService.SearchByOrganization(searchQuery, organizationId!, OrgState.ToCallerContext()).ToList();
            return Task.CompletedTask;
        });
    }

    private void ClearSearch()
    {
        searchQuery = "";
        searchTerms = [];
        displayedSongs = OrgSongs.ToList();
    }

    private bool showNameDialog;
    private string newSongName = "";
    private bool creating;

    private void CreateSong()
    {
        newSongName = "";
        showNameDialog = true;
    }

    private async Task HandleCreateSong(string name)
    {
        if (organizationId is null) return;

        creating = true;
        try
        {
            var song = await SongService.CreateSongAsync(name, null, null, null, null, [], organizationId, OrgState.ToCallerContext());
            NavigationManager.NavigateTo($"/admin/songs/{song.Id}");
        }
        finally
        {
            creating = false;
            showNameDialog = false;
        }
    }

    private string Highlight(string text) => SearchHighlighter.Highlight(text, searchTerms);
}
