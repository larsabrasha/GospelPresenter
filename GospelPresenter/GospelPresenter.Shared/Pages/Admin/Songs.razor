@page "/admin/songs"
@attribute [Authorize(Policy = ManageSongs)]
@using GospelPresenter.Shared.Components.Presentations
@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using GospelPresenter.Shared.Utils
@using Microsoft.AspNetCore.Authorization

@layout AdminLayout

@inject ISongService SongService
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager
@inject ActiveOrganizationState OrgState
@inject IAppCapabilities Capabilities

@* RefreshDisplayedSongs, not a plain reload: it keeps whatever the user has typed in the search
   box, so a sync landing mid-search re-filters rather than dumping them back to the full library. *@
<RefreshOnSync Reload="RefreshDisplayedSongs"/>

<PageContainer>
<DropZone Class="flex flex-col space-y-5" Label="@L["DropZone.HintSongs"]"
          Accept=".pro" MaxFileSize="AppConstraints.MaxSongImportFileSizeBytes" OnFilesDropped="ImportDropped">
    <div class="px-5 flex items-center justify-between">
        <div class="text-xl font-bold dark:text-neutral-100">@L["Songs.Title"]</div>
        @if (displayedSongs.Count > 0)
        {
            <AppButton Variant="ButtonVariant.Primary" OnClick="CreateSong" Loading="creating" Class="flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                @L["Songs.Create"]
            </AppButton>
        }
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t-[0.5px] border-white dark:border-neutral-700 overflow-hidden p-5 space-y-4">
        <div class="font-semibold">@L["Songs.ImportProPresenter"]</div>
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
            @((MarkupString)L["Songs.ImportDescription"].Value)
        </p>

        <AppButton Variant="ButtonVariant.Primary" AsLabel Class="inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/>
            </svg>
            @(isImporting ? L["Songs.Importing"] : L["Songs.ChooseFiles"])
            <input @ref="fileInput" type="file" @onchange="OnFilesSelected" multiple accept=".pro" class="hidden" disabled="@isImporting"/>
        </AppButton>
        <DropHint Text="@L["DropZone.AffordanceSongs"]" Class="hidden sm:inline ml-3"/>

        @if (isImporting)
        {
            <div class="space-y-2">
                <div class="text-sm text-neutral-600 dark:text-neutral-300">
                    @importProgressText
                </div>
                <div class="w-full bg-neutral-200 dark:bg-neutral-700 rounded-full h-2 overflow-hidden">
                    <div class="bg-sky-500 h-2 rounded-full w-1/3 animate-pulse"></div>
                </div>
            </div>
        }
        else if (importMessage is not null)
        {
            <div class="text-sm @(importError ? "text-red-500 dark:text-red-400" : "text-green-600 dark:text-green-400")">
                @importMessage
            </div>
        }
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t-[0.5px] border-white dark:border-neutral-700 overflow-hidden">
        <div class="px-5 pt-4 pb-2 space-y-3">
            <div class="flex items-center justify-between">
                <div class="font-semibold">
                    @L["Songs.AllSongs"] (@OrgSongs.Count)
                </div>
                <AppButton Variant="ButtonVariant.Neutral" Href="/trash?kind=Song" Class="flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                    </svg>
                    @L["Trash.Title"]
                </AppButton>
            </div>
            @if (OrgSongs.Count > 0)
            {
                <div class="relative">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-neutral-400 pointer-events-none">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
                    </svg>
                    <input type="text"
                           maxlength="@AppConstraints.SearchMaxLength"
                           class="w-full py-2 pl-10 pr-4 rounded-full border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-700 text-neutral-900 dark:text-neutral-100 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 @(string.IsNullOrEmpty(searchQuery) ? "" : "!pr-9")"
                           placeholder="@L["Common.Search"]"
                           value="@searchQuery"
                           @oninput="OnSearchInput"/>
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <AppButton Variant="ButtonVariant.Icon" Class="absolute right-2.5 top-1/2 -translate-y-1/2 size-6"
                                   OnClick="ClearSearch">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                            </svg>
                        </AppButton>
                    }
                </div>
            }
        </div>

        @if (OrgSongs.Count == 0)
        {
            <div class="flex flex-col items-center justify-center text-center text-sm py-12 px-6 select-none">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-12 mb-3 text-neutral-300 dark:text-neutral-600">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m9 9 10.5-3m0 6.553v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 1 1-.99-3.467l2.31-.66a2.25 2.25 0 0 0 1.632-2.163Zm0 0V2.25L9 5.25v10.303m0 0v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 0 1-.99-3.467l2.31-.66A2.25 2.25 0 0 0 9 15.553Z"/>
                </svg>
                <p class="font-medium text-neutral-500 dark:text-neutral-400 mb-1">@L["Songs.NoSongsImported"]</p>
                <p class="text-xs text-neutral-400 dark:text-neutral-500 max-w-xs leading-relaxed">@L["Songs.NoSongsHint"]</p>
            </div>
        }
        else if (displayedSongs.Count == 0)
        {
            <div class="px-5 py-4 text-neutral-400 text-sm">@L["Songs.NoSongsFound"]</div>
        }
        else
        {
            <div>
                @foreach (var song in displayedSongs)
                {
                    <a href="/admin/songs/@song.Id"
                       class="flex items-center gap-3 px-5 py-3 border-b border-neutral-200 dark:border-neutral-700 last:border-b-0 hover:bg-neutral-100 dark:hover:bg-neutral-700/50 no-underline text-inherit">
                        <div class="flex-1 min-w-0">
                            <div class="font-medium truncate">@((MarkupString)Highlight(song.Name))</div>
                            <div class="text-xs text-neutral-400 truncate">
                                @(string.IsNullOrEmpty(song.Author) ? (MarkupString)"\u00a0" : (MarkupString)Highlight(song.Author))
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</DropZone>
</PageContainer>

@if (duplicateNames is not null)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-lg" OnClose="CancelImport">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["Songs.DuplicatesFound"]</div>
            <p class="text-sm text-neutral-600 dark:text-neutral-300">
                @((MarkupString)L["Songs.DuplicatesCount", duplicateNames.Count, pendingFileCount].Value)
            </p>
            <div class="max-h-48 overflow-y-auto text-sm space-y-1">
                @foreach (var name in duplicateNames)
                {
                    <div class="px-3 py-1.5 bg-neutral-100 dark:bg-neutral-700 rounded-lg truncate">@name</div>
                }
            </div>
            <div class="flex justify-end gap-3 pt-2">
                <AppButton Variant="ButtonVariant.Cancel" OnClick="CancelImport">
                    @L["Common.Cancel"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Neutral" OnClick="() => FinishImport(false)">
                    @L["Songs.SkipDuplicates"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Primary" OnClick="() => FinishImport(true)">
                    @L["Songs.ReplaceDuplicates"]
                </AppButton>
            </div>
        </div>
    </Dialog>
}

@if (showNameDialog)
{
    <NameDialog Title="@L["Songs.CreateTitle"]"
                Name="@newSongName"
                SaveText="@L["Common.Create"]"
                SaveLoadingText="@L["Common.Creating"]"
                OnSave="HandleCreateSong"
                OnClose="() => showNameDialog = false"/>
}

@code {
    private bool isImporting;
    private string? importMessage;
    private string? importProgressText;
    private bool importError;
    private string? organizationId;
    private bool hasPendingDuplicates;
    private int pendingFileCount;
    private List<string>? duplicateNames;
    private string searchQuery = "";
    private string[] searchTerms = [];
    private List<Song> displayedSongs = [];
    private ElementReference fileInput;

    // Held between the two halves of the duplicate question, so answering it does not depend on
    // the browser still holding the files.
    private List<(string FileName, byte[] Data)> filesToImport = [];


    private IReadOnlyList<Song> OrgSongs => organizationId is not null
        ? SongService.GetSongsByOrganization(organizationId, OrgState.ToCallerContext())
        : [];

    protected override void OnInitialized()
    {
        organizationId = OrgState.ActiveOrganizationId;
        displayedSongs = OrgSongs.ToList();
    }

    private async Task OnFilesSelected()
    {
        if (isImporting || organizationId is null) return;
        if (!await BeginImport()) return;

        if (!Capabilities.UploadEndpoints)
        {
            filesToImport = await ReadFileInputAsync();
            await ImportHere(replaceExisting: false);
            return;
        }

        await PostToEndpoint(replaceExisting: false);
    }

    /// <summary>
    /// A drop where there is no file input to feed: the device apps. The browser held the files
    /// and hands them over one at a time, which is all that differs from picking them.
    /// </summary>
    private async Task ImportDropped(IReadOnlyList<DroppedFile> files)
    {
        if (isImporting || organizationId is null) return;
        if (!await BeginImport()) return;

        filesToImport = [];
        foreach (var file in files.Where(f => IsProFile(f.FileName)))
            filesToImport.Add((file.FileName, await ReadAllBytesAsync(file)));

        await ImportHere(replaceExisting: false);
    }

    private Task<bool> BeginImport()
    {
        isImporting = true;
        importMessage = null;
        importError = false;
        importProgressText = L["Songs.ProcessingFiles"];
        StateHasChanged();
        return Task.FromResult(true);
    }

    /// <summary>Reads the files the input holds, which is what the web posts to the endpoint.</summary>
    private async Task<List<(string FileName, byte[] Data)>> ReadFileInputAsync()
    {
        var files = new List<(string, byte[])>();
        var names = await JsRuntime.InvokeAsync<string[]>("gospelPresenter.fileInputNames", fileInput);

        for (var position = 0; position < names.Length; position++)
        {
            if (!IsProFile(names[position])) continue;
            var content = await JsRuntime.InvokeAsync<IJSStreamReference>(
                "gospelPresenter.takeFileInputFile", fileInput, position);
            files.Add((names[position], await ReadAllBytesAsync(content)));
        }

        await JsRuntime.InvokeVoidAsync("gospelPresenter.clearFileInput", fileInput);
        return files;
    }

    private static async Task<byte[]> ReadAllBytesAsync(DroppedFile file)
    {
        using var buffer = new MemoryStream();
        await using (var source = await file.Open())
            await source.CopyToAsync(buffer);
        return buffer.ToArray();
    }

    private static async Task<byte[]> ReadAllBytesAsync(IJSStreamReference content)
    {
        using var buffer = new MemoryStream();
        await using (var source = await content.OpenReadStreamAsync(AppConstraints.MaxSongImportFileSizeBytes))
            await source.CopyToAsync(buffer);
        return buffer.ToArray();
    }

    private static bool IsProFile(string fileName) =>
        fileName.EndsWith(".pro", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// The import itself, run against the domain services in this process. The endpoint does the
    /// same three steps; this is the route for a host that serves no endpoints.
    /// </summary>
    private async Task ImportHere(bool replaceExisting)
    {
        try
        {
            if (filesToImport.Count == 0)
            {
                importMessage = L["Songs.NoProFiles"];
                importError = true;
                return;
            }

            var caller = OrgState.ToCallerContext();

            if (!replaceExisting)
            {
                var names = filesToImport
                    .Select(file => TryParse(file.Data, file.FileName))
                    .Where(song => song is not null)
                    .Select(song => song!.Name)
                    .ToList();

                var duplicates = await SongService.FindDuplicateNamesAsync(names, organizationId!, caller);
                if (duplicates.Count > 0)
                {
                    duplicateNames = duplicates;
                    pendingFileCount = filesToImport.Count;
                    hasPendingDuplicates = true;
                    return;
                }
            }

            var result = await SongService.ImportProPresenterFilesAsync(
                filesToImport, organizationId!, caller, replaceExisting);

            filesToImport = [];
            importMessage = FormatImportResult(result);
            RefreshDisplayedSongs();
        }
        catch (Exception ex)
        {
            importMessage = L["Songs.ImportError", ex.Message];
            importError = true;
        }
        finally
        {
            isImporting = false;
        }
    }

    /// <summary>The web's route: the browser posts the files, which is one request for the lot.</summary>
    private async Task PostToEndpoint(bool replaceExisting)
    {
        try
        {
            var result = await JsRuntime.InvokeAsync<SongImportResponse?>(
                "uploadAllFiles", fileInput, "/api/upload/import-songs", organizationId, replaceExisting);

            if (result is null)
                throw new InvalidOperationException("Upload failed");

            if (result.Duplicates is { Count: > 0 })
            {
                duplicateNames = result.Duplicates;
                pendingFileCount = result.FileCount;
                hasPendingDuplicates = true;
                isImporting = false;
                return;
            }

            importMessage = FormatImportResult(new ImportResult(result.Imported, result.Replaced, result.Skipped, result.Failed));
            RefreshDisplayedSongs();
        }
        catch (Exception ex)
        {
            importMessage = L["Songs.ImportError", ex.Message];
            importError = true;
        }
        finally
        {
            isImporting = false;
        }
    }

    /// <summary>A corrupt file must not fail the duplicate check for the whole batch.</summary>
    private static Song? TryParse(byte[] data, string fileName)
    {
        try
        {
            return ProPresenterParser.Parse(data, Path.GetFileNameWithoutExtension(fileName));
        }
        catch
        {
            return null;
        }
    }

    private void CancelImport()
    {
        hasPendingDuplicates = false;
        duplicateNames = null;
    }

    private async Task FinishImport(bool replaceExisting)
    {
        if (!hasPendingDuplicates || organizationId is null) return;

        hasPendingDuplicates = false;
        duplicateNames = null;
        isImporting = true;
        importProgressText = L["Songs.SavingSongs"];
        StateHasChanged();

        if (!Capabilities.UploadEndpoints)
            await ImportHere(replaceExisting);
        else
            await PostToEndpoint(replaceExisting);
    }

    private string FormatImportResult(ImportResult result)
    {
        var parts = new List<string>();
        if (result.Imported > 0)
            parts.Add(result.Imported == 1
                ? L["Songs.ImportedSingular", result.Imported]
                : L["Songs.ImportedPlural", result.Imported]);
        if (result.Replaced > 0)
            parts.Add(result.Replaced == 1
                ? L["Songs.ReplacedSingular", result.Replaced]
                : L["Songs.ReplacedPlural", result.Replaced]);
        if (result.Skipped > 0)
            parts.Add(result.Skipped == 1
                ? L["Songs.SkippedSingular", result.Skipped]
                : L["Songs.SkippedPlural", result.Skipped]);
        if (result.Failed > 0)
            parts.Add(result.Failed == 1
                ? L["Songs.FailedSingular", result.Failed]
                : L["Songs.FailedPlural", result.Failed]);

        if (parts.Count == 0)
            return L["Songs.NoSongsImportable"];

        return string.Join(", ", parts) + ".";
    }

    private void RefreshDisplayedSongs()
    {
        displayedSongs = string.IsNullOrWhiteSpace(searchQuery)
            ? OrgSongs.ToList()
            : SongService.SearchByOrganization(searchQuery, organizationId!, OrgState.ToCallerContext()).ToList();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        searchTerms = string.IsNullOrWhiteSpace(searchQuery)
            ? []
            : searchQuery.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        displayedSongs = string.IsNullOrWhiteSpace(searchQuery)
            ? OrgSongs.ToList()
            : SongService.SearchByOrganization(searchQuery, organizationId!, OrgState.ToCallerContext()).ToList();
    }

    private void ClearSearch()
    {
        searchQuery = "";
        searchTerms = [];
        displayedSongs = OrgSongs.ToList();
    }

    private bool showNameDialog;
    private string newSongName = "";
    private bool creating;

    private void CreateSong()
    {
        newSongName = "";
        showNameDialog = true;
    }

    private async Task HandleCreateSong(string name)
    {
        if (organizationId is null) return;

        creating = true;
        try
        {
            var song = await SongService.CreateSongAsync(name, null, null, null, null, [], organizationId, OrgState.ToCallerContext());
            NavigationManager.NavigateTo($"/admin/songs/{song.Id}");
        }
        finally
        {
            creating = false;
            showNameDialog = false;
        }
    }

    private string Highlight(string text) => SearchHighlighter.Highlight(text, searchTerms);

    private record SongImportResponse(int Imported = 0, int Skipped = 0, int Replaced = 0, int Failed = 0, int FileCount = 0, List<string>? Duplicates = null);
}
