@page "/admin/audios"
@attribute [Authorize(Policy = ManageOrganizationAudios)]

@using GospelPresenter.Shared.Components.Presentations
@using GospelPresenter.Shared.Components.Symbols
@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging

@implements IDisposable

@layout AdminLayout

@inject IOrganizationAudioService OrganizationAudioService
@inject IJSRuntime JsRuntime
@inject ActiveOrganizationState OrgState
@inject ILogger<Audios> Logger

<PageContainer>
    <div class="px-5 flex items-center justify-between">
        <div class="text-xl font-bold dark:text-neutral-100">@L["Audios.Title"]</div>
        <AppButton Variant="ButtonVariant.Primary" AsLabel Disabled="@(isUploading || organizationId is null)"
                   Class="inline-flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"/>
            </svg>
            @L["AudioTab.Upload"]
            <input @ref="fileInput" type="file" @onchange="HandleFilesSelected" accept="@AppConstraints.AudioAccept" multiple class="hidden"/>
        </AppButton>
    </div>

    @if (isUploading || uploadError is not null)
    {
        <div class="px-5 flex items-center gap-3 text-sm">
            @if (isUploading)
            {
                <span class="text-neutral-500 dark:text-neutral-400">@L["AudioTab.UploadingProgress", uploadedCount, uploadTotalCount]</span>
            }
            @if (uploadError is not null)
            {
                <span class="text-red-500 dark:text-red-400">@uploadError</span>
            }
        </div>
    }

    <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t-[0.5px] border-white dark:border-neutral-700">
        <div class="px-5 pt-4 pb-2 space-y-3">
            <div class="font-semibold">
                @L["Audios.AllAudios"] (@audios.Count)
            </div>
            @if (audios.Count > 0)
            {
                <div class="relative">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-neutral-400 pointer-events-none">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
                    </svg>
                    <input type="text"
                           maxlength="@AppConstraints.SearchMaxLength"
                           class="w-full py-2 pl-10 pr-4 rounded-full border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-700 text-neutral-900 dark:text-neutral-100 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 @(string.IsNullOrEmpty(searchQuery) ? "" : "!pr-9")"
                           placeholder="@L["Common.Search"]"
                           value="@searchQuery"
                           @oninput="OnSearchInput"/>
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <AppButton Variant="ButtonVariant.Icon" Class="absolute right-2.5 top-1/2 -translate-y-1/2 size-6"
                                   OnClick="ClearSearch">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                            </svg>
                        </AppButton>
                    }
                </div>
            }
        </div>

        @if (isLoading)
        {
            <div class="px-5 py-4 text-neutral-400 text-sm">@L["AudioTab.LoadingAudio"]</div>
        }
        else if (audios.Count == 0)
        {
            <div class="flex flex-col items-center justify-center text-center text-sm py-12 px-6 select-none">
                <SpeakerWaveSymbol Class="size-12 mb-3 text-neutral-300 dark:text-neutral-600"/>
                <p class="font-medium text-neutral-500 dark:text-neutral-400 mb-1">@L["Audios.NoAudios"]</p>
                <p class="text-xs text-neutral-400 dark:text-neutral-500 max-w-xs leading-relaxed">@L["Audios.NoAudiosHint"]</p>
            </div>
        }
        else if (displayedAudios.Count == 0)
        {
            <div class="px-5 py-4 text-neutral-400 text-sm">@L["Audios.NoAudiosFound"]</div>
        }
        else
        {
            <div>
                @foreach (var audio in displayedAudios)
                {
                    <div class="flex items-center gap-3 px-5 py-3 border-b border-neutral-200 dark:border-neutral-700 last:border-b-0 last:rounded-b-xl hover:bg-neutral-100 dark:hover:bg-neutral-700/50">
                        <SpeakerWaveSymbol Class="size-5 text-neutral-400 shrink-0"/>
                        <span class="text-sm truncate flex-1">@audio.FileName</span>
                        <Dropdown MenuClass="right-0 min-w-36">
                            <Trigger>
                                <button class="size-7 flex items-center justify-center rounded-full text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 cursor-pointer">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
                                        <path d="M3 10a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0ZM8.5 10a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0ZM15.5 8.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"/>
                                    </svg>
                                </button>
                            </Trigger>
                            <Menu>
                                <button class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-neutral-100 dark:hover:bg-neutral-700 cursor-pointer"
                                        @onclick="() => ConfirmDelete(audio)">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                                    </svg>
                                    @L["Common.Remove"]
                                </button>
                            </Menu>
                        </Dropdown>
                    </div>
                }
            </div>
        }
    </div>
</PageContainer>

@if (audioToDelete is not null)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-sm" OnClose="CancelDelete">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["AudioTab.DeleteAudio"]</div>
            <div>@((MarkupString)L["AudioTab.ConfirmDelete", audioToDelete.FileName].Value)</div>
            <div class="flex justify-end gap-3">
                <AppButton Variant="ButtonVariant.Cancel" OnClick="CancelDelete">
                    @L["Common.Cancel"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Danger" Filled OnClick="DeleteAudio">
                    @L["Common.Remove"]
                </AppButton>
            </div>
        </div>
    </Dialog>
}

@code {
    private string? organizationId;
    private List<OrganizationAudio> audios = [];
    private List<OrganizationAudio> displayedAudios = [];
    private string searchQuery = "";
    private bool isLoading = true;
    private bool isUploading;
    private int uploadedCount;
    private int uploadTotalCount;
    private int failedCount;
    private string? uploadError;
    private OrganizationAudio? audioToDelete;
    private ElementReference fileInput;
    private DotNetObjectReference<Audios>? dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        organizationId = OrgState.ActiveOrganizationId;

        if (organizationId is not null)
        {
            audios = await OrganizationAudioService.GetAudiosAsync(organizationId, OrgState.ToCallerContext());
            displayedAudios = audios.ToList();
        }

        isLoading = false;
    }

    private async Task HandleFilesSelected()
    {
        if (isUploading || organizationId is null) return;
        uploadError = null;
        failedCount = 0;
        isUploading = true;
        StateHasChanged();

        dotNetRef ??= DotNetObjectReference.Create(this);
        await JsRuntime.InvokeVoidAsync("uploadFiles", fileInput, "/api/upload/org-audio", organizationId, dotNetRef, AppConstraints.MaxAudioFileSizeBytes, AppConstraints.AllowedAudioTypes);
    }

    [JSInvokable]
    public void OnUploadStarted(int totalCount)
    {
        uploadedCount = 0;
        uploadTotalCount = totalCount;
    }

    [JSInvokable]
    public void OnFileUploaded(string json)
    {
        var result = System.Text.Json.JsonSerializer.Deserialize<UploadResult>(json, UploadResult.JsonOptions);
        if (result is null) return;
        var audio = new OrganizationAudio
        {
            Id = result.Id,
            FileName = result.FileName,
            ContentType = result.ContentType
        };
        audios.Insert(0, audio);
        ApplySearchFilter();
        uploadedCount++;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnFileUploadFailed(string fileName)
    {
        Logger.LogError("Failed to upload audio {FileName}", fileName);
        uploadedCount++;
        failedCount++;
        uploadError = L["AudioTab.UploadErrorCount", failedCount];
        StateHasChanged();
    }

    [JSInvokable]
    public void OnAllUploadsComplete()
    {
        isUploading = false;
        StateHasChanged();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplySearchFilter();
    }

    private void ClearSearch()
    {
        searchQuery = "";
        ApplySearchFilter();
    }

    private void ApplySearchFilter()
    {
        displayedAudios = string.IsNullOrWhiteSpace(searchQuery)
            ? audios.ToList()
            : audios.Where(a => a.FileName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void ConfirmDelete(OrganizationAudio audio)
    {
        audioToDelete = audio;
    }

    private void CancelDelete()
    {
        audioToDelete = null;
    }

    private async Task DeleteAudio()
    {
        if (audioToDelete is null || organizationId is null) return;

        await OrganizationAudioService.DeleteAudioAsync(audioToDelete.Id, organizationId, OrgState.ToCallerContext());
        audios.Remove(audioToDelete);
        ApplySearchFilter();
        audioToDelete = null;
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }
}
