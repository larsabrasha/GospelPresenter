@page "/admin/bibles"
@attribute [Authorize(Policy = ManageBibles)]
@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.Authorization

@layout AdminLayout

@inject IBibleService BibleService
@inject IJSRuntime JsRuntime
@inject ActiveOrganizationState OrgState
@inject ToastService Toast
@inject IServiceProvider Services
@inject IAppCapabilities Capabilities

<PageContainer>
<DropZone Class="flex flex-col space-y-5" Label="@L["DropZone.HintBible"]"
          Accept=".zip" Multiple="false" MaxFileSize="AppConstraints.MaxBibleFileSizeBytes"
          OnFilesDropped="ImportDropped">
    <div class="px-5 flex items-center justify-between">
        <div class="text-xl font-bold dark:text-neutral-100">@L["Bibles.Title"]</div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t-[0.5px] border-white dark:border-neutral-700 overflow-hidden p-5 space-y-4">
        <div class="font-semibold">@L["Bibles.ImportTitle"]</div>
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
            @((MarkupString)L["Bibles.ImportDescription"].Value)
        </p>

        <AppButton Variant="ButtonVariant.Primary" AsLabel Class="inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/>
            </svg>
            @(isImporting ? L["Bibles.Importing"] : L["Bibles.ChooseFile"])
            <input @ref="fileInput" type="file" @onchange="OnFileSelected" accept=".zip" class="hidden" disabled="@isImporting"/>
        </AppButton>
        <DropHint Text="@L["DropZone.AffordanceBible"]" Class="hidden sm:inline ml-3"/>

        @if (isImporting)
        {
            <div class="space-y-2">
                <div class="text-sm text-neutral-600 dark:text-neutral-300">
                    @L["Bibles.Processing"]
                </div>
                <div class="w-full bg-neutral-200 dark:bg-neutral-700 rounded-full h-2 overflow-hidden">
                    <div class="bg-sky-500 h-2 rounded-full w-1/3 animate-pulse"></div>
                </div>
            </div>
        }
        else if (importMessage is not null)
        {
            <div class="text-sm @(importError ? "text-red-500 dark:text-red-400" : "text-green-600 dark:text-green-400")">
                @importMessage
            </div>
        }
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t-[0.5px] border-white dark:border-neutral-700 overflow-hidden">
        <div class="px-5 pt-4 pb-2">
            <div class="font-semibold">
                @L["Bibles.AllBibles"] (@orgBibles.Count)
            </div>
        </div>

        @if (orgBibles.Count == 0)
        {
            <div class="flex flex-col items-center justify-center py-12 text-neutral-400">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-16 mb-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/>
                </svg>
                <div class="text-sm">@L["Bibles.NoBibles"]</div>
            </div>
        }
        else
        {
            <div>
                @foreach (var bible in orgBibles)
                {
                    <div class="flex items-center gap-3 px-5 py-3 border-b border-neutral-200 dark:border-neutral-700 last:border-b-0">
                        <div class="flex-1 min-w-0">
                            <div class="font-medium truncate">@bible.Name</div>
                            <div class="text-xs text-neutral-400 truncate">
                                @bible.Id &middot; @bible.Verses.Count @L["Bibles.Verses"]
                            </div>
                        </div>
                        @* Offline availability: only the device app registers the store. *@
                        @if (offlineStore is not null)
                        {
                            var state = offlineStates.GetValueOrDefault(bible.Id, BibleOfflineState.NotAvailable);
                            @if (state == BibleOfflineState.NotAvailable)
                            {
                                <AppButton Variant="ButtonVariant.Secondary" OnClick="() => DownloadBible(bible.Id)"
                                           Loading="@(bibleBusy == bible.Id)" Disabled="@(bibleBusy is not null)">
                                    @L["Bibles.MakeOffline"]
                                </AppButton>
                            }
                            else if (state == BibleOfflineState.Downloaded)
                            {
                                <AppButton Variant="ButtonVariant.Neutral" OnClick="() => RemoveOfflineBible(bible.Id)"
                                           Loading="@(bibleBusy == bible.Id)" Disabled="@(bibleBusy is not null)"
                                           Title="@L["Bibles.RemoveOffline"]" Class="inline-flex items-center gap-1.5">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 text-green-500">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
                                    </svg>
                                    @L["Bibles.OfflineAvailable"]
                                </AppButton>
                            }
                            else
                            {
                                <span class="text-xs text-neutral-400">@L["Bibles.OfflineAvailable"]</span>
                            }
                        }
                        <AppButton Variant="ButtonVariant.DangerIcon" OnClick="() => ConfirmDeleteBible(bible)">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                            </svg>
                        </AppButton>
                    </div>
                }
            </div>
        }
    </div>
</DropZone>
</PageContainer>

@if (bibleToDelete is not null)
{
    <ConfirmDeleteDialog MessageKey="Bibles.ConfirmDelete" MessageValue="@bibleToDelete.Name"
                         IsDeleting="isDeleting"
                         OnConfirm="ExecuteDelete"
                         OnClose="() => bibleToDelete = null"/>
}

@code {
    private bool isImporting;
    private bool isDeleting;
    private string? importMessage;
    private bool importError;
    private string? organizationId;
    private ElementReference fileInput;
    private Bible? bibleToDelete;
    private IBibleOfflineStore? offlineStore;
    private IReadOnlyDictionary<string, BibleOfflineState> offlineStates = new Dictionary<string, BibleOfflineState>();
    private string? bibleBusy;

    private IReadOnlyList<Bible> orgBibles = [];

    protected override async Task OnInitializedAsync()
    {
        organizationId = OrgState.ActiveOrganizationId;
        offlineStore = Services.GetService(typeof(IBibleOfflineStore)) as IBibleOfflineStore;
        RefreshBibles();
        await RefreshOfflineStatesAsync();
    }

    private async Task RefreshOfflineStatesAsync()
    {
        if (offlineStore is not null && organizationId is not null)
            offlineStates = await offlineStore.GetStatesAsync(organizationId);
    }

    private async Task DownloadBible(string abbreviation)
    {
        if (offlineStore is null || organizationId is null || bibleBusy is not null) return;
        bibleBusy = abbreviation;
        try
        {
            if (await offlineStore.DownloadAsync(organizationId, abbreviation))
            {
                Toast.Show(L["Bibles.OfflineDownloaded"]);
                RefreshBibles();
            }
            else
            {
                Toast.Show(L["Bibles.OfflineDownloadFailed"]);
            }
            await RefreshOfflineStatesAsync();
        }
        finally
        {
            bibleBusy = null;
        }
    }

    private async Task RemoveOfflineBible(string abbreviation)
    {
        if (offlineStore is null || organizationId is null || bibleBusy is not null) return;
        bibleBusy = abbreviation;
        try
        {
            await offlineStore.RemoveAsync(organizationId, abbreviation);
            Toast.Show(L["Bibles.OfflineRemoved"]);
            RefreshBibles();
            await RefreshOfflineStatesAsync();
        }
        finally
        {
            bibleBusy = null;
        }
    }

    private void RefreshBibles()
    {
        orgBibles = organizationId is not null
            ? BibleService.GetBibles(organizationId)
            : [];
    }

    private async Task OnFileSelected()
    {
        if (isImporting || organizationId is null) return;
        BeginImport();

        // No endpoint to post to on the device apps: read the file here and import it locally,
        // which also means the import works with no server at all.
        if (!Capabilities.UploadEndpoints)
        {
            var names = await JsRuntime.InvokeAsync<string[]>("gospelPresenter.fileInputNames", fileInput);
            var position = Array.FindIndex(names, IsZipFile);
            if (position < 0)
            {
                FailImport(L["Bibles.OnlyZip"]);
                return;
            }

            var content = await JsRuntime.InvokeAsync<IJSStreamReference>(
                "gospelPresenter.takeFileInputFile", fileInput, position);
            await JsRuntime.InvokeVoidAsync("gospelPresenter.clearFileInput", fileInput);
            await ImportHere(async () => await content.OpenReadStreamAsync(AppConstraints.MaxBibleFileSizeBytes));
            return;
        }

        await PostToEndpoint();
    }

    /// <summary>A drop where there is no file input to feed: the device apps.</summary>
    private async Task ImportDropped(IReadOnlyList<DroppedFile> files)
    {
        if (isImporting || organizationId is null) return;

        var file = files.FirstOrDefault(f => IsZipFile(f.FileName));
        if (file is null) return;

        BeginImport();
        await ImportHere(file.Open);
    }

    private void BeginImport()
    {
        isImporting = true;
        importMessage = null;
        importError = false;
        StateHasChanged();
    }

    private void FailImport(string message)
    {
        importMessage = message;
        importError = true;
        isImporting = false;
    }

    private static bool IsZipFile(string fileName) =>
        fileName.EndsWith(".zip", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// The import itself, against the domain service in this process — the same call the endpoint
    /// makes. The zip is buffered first because reading its central directory needs to seek, and
    /// the browser hands the file over as a forward-only stream.
    /// </summary>
    private async Task ImportHere(Func<Task<Stream>> open)
    {
        try
        {
            using var zip = new MemoryStream();
            await using (var source = await open())
                await source.CopyToAsync(zip);
            zip.Position = 0;

            var result = await BibleService.ImportBibleAsync(zip, organizationId!, OrgState.ToCallerContext());

            importMessage = result.Replaced
                ? L["Bibles.ImportReplaced", result.BibleName, result.VerseCount]
                : L["Bibles.ImportSuccess", result.BibleName, result.VerseCount];
            RefreshBibles();
        }
        catch (Exception ex)
        {
            importMessage = L["Bibles.ImportError", ex.Message];
            importError = true;
        }
        finally
        {
            isImporting = false;
        }
    }

    /// <summary>The web's route: the browser posts the file to the endpoint.</summary>
    private async Task PostToEndpoint()
    {
        try
        {
            var result = await JsRuntime.InvokeAsync<BibleImportResponse?>(
                "uploadAllFiles", fileInput, "/api/upload/import-bible", organizationId, false);

            if (result is null)
                throw new InvalidOperationException("Upload failed");

            importMessage = result.Replaced
                ? L["Bibles.ImportReplaced", result.BibleName ?? "", result.VerseCount]
                : L["Bibles.ImportSuccess", result.BibleName ?? "", result.VerseCount];
            RefreshBibles();
        }
        catch (Exception ex)
        {
            importMessage = L["Bibles.ImportError", ex.Message];
            importError = true;
        }
        finally
        {
            isImporting = false;
        }
    }

    private void ConfirmDeleteBible(Bible bible) => bibleToDelete = bible;

    private async Task ExecuteDelete()
    {
        if (bibleToDelete is null || isDeleting || organizationId is null) return;

        isDeleting = true;
        StateHasChanged();

        try
        {
            await BibleService.DeleteBibleAsync(bibleToDelete.Id, organizationId, OrgState.ToCallerContext());
            RefreshBibles();
            Toast.Show(L["Bibles.Deleted"]);
        }
        finally
        {
            isDeleting = false;
            bibleToDelete = null;
        }
    }

    private record BibleImportResponse(string? BibleName = null, int VerseCount = 0, bool Replaced = false);
}
