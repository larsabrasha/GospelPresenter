@page "/admin/api-keys"
@attribute [Authorize(Roles = "SuperAdmin")]

@using GospelPresenter.Shared.Components.Symbols
@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.Authorization

@layout AdminLayout

@inject IUserService UserService
@inject ActiveOrganizationState OrgState
@inject ToastService Toast
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageContainer>
    <div class="flex items-center justify-between px-5">
        <div class="text-xl font-bold dark:text-neutral-100">@L["ApiKeys.Title"]</div>
        @if (apiKeys is not null && apiKeys.Count > 0)
        {
            <AppButton Variant="ButtonVariant.Primary" OnClick="ShowCreateDialog" Class="flex items-center">
                <PlusSymbol Class="size-4 mr-2"/>@L["ApiKeys.Create"]
            </AppButton>
        }
    </div>

    <div class="px-5 pb-2 text-sm text-neutral-500 dark:text-neutral-400 space-y-2">
        <p>@((MarkupString)L["ApiKeys.Description"].Value)</p>
        <details class="group">
            <summary class="cursor-pointer text-sky-600 dark:text-sky-400 hover:underline">
                @L["ApiKeys.SetupInstructions"]
            </summary>
            <div class="mt-2 space-y-2">
                <p>@((MarkupString)L["ApiKeys.SetupHelp"].Value)</p>
            </div>
            <div class="mt-2 bg-neutral-100 dark:bg-neutral-700 rounded-xl p-4 font-mono text-xs break-all whitespace-pre-wrap select-all">@($@"{{
  ""mcpServers"": {{
    ""gospel-presenter"": {{
      ""url"": ""{McpUrl}"",
      ""headers"": {{
        ""Authorization"": ""Bearer <API_KEY>""
      }}
    }}
  }}
}}")</div>
        </details>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 overflow-hidden">
        @if (apiKeys is null)
        {
            <div class="px-7 py-4 text-neutral-400">@L["Common.Loading"]</div>
        }
        else if (apiKeys.Count == 0)
        {
            <div class="flex flex-col items-center justify-center text-center px-6 py-12 select-none">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 200 160" class="w-48 h-auto mb-6 text-neutral-300 dark:text-neutral-600">
                    <circle cx="80" cy="70" r="24" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                    <circle cx="80" cy="70" r="10" stroke="currentColor" stroke-width="2" fill="none" opacity="0.4"/>
                    <line x1="104" y1="70" x2="155" y2="70" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <line x1="140" y1="70" x2="140" y2="82" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <line x1="150" y1="70" x2="150" y2="78" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <circle cx="155" cy="120" r="16" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                    <line x1="155" y1="112" x2="155" y2="128" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                    <line x1="147" y1="120" x2="163" y2="120" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
                <h2 class="text-lg font-semibold text-neutral-500 dark:text-neutral-400 mb-2">@L["ApiKeys.Empty"]</h2>
                <p class="text-sm text-neutral-400 dark:text-neutral-500 max-w-xs leading-relaxed mb-4">
                    @L["ApiKeys.EmptyDescription"]
                </p>
                <AppButton Variant="ButtonVariant.Primary" OnClick="ShowCreateDialog" Class="flex items-center gap-1.5">
                    <PlusSymbol Class="size-4"/>
                    @L["ApiKeys.Create"]
                </AppButton>
            </div>
        }
        else
        {
            @foreach (var key in apiKeys)
            {
                <div class="flex items-center gap-3 px-7 py-3 border-b border-neutral-200 dark:border-neutral-700 last:border-b-0">
                    <div class="flex-1 min-w-0">
                        <div class="font-medium">@key.Name</div>
                        <div class="text-xs text-neutral-400">
                            @key.User.Name &middot; @key.CreatedAt.ToString("yyyy-MM-dd")
                        </div>
                    </div>
                    <AppButton Variant="ButtonVariant.Danger" OnClick="() => ConfirmDeleteKey(key)" Class="px-3 py-1.5">
                        @L["Common.Delete"]
                    </AppButton>
                </div>
            }
        }
    </div>
</PageContainer>

@if (showCreateDialog)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-lg" OnClose="CloseDialog">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["ApiKeys.CreateTitle"]</div>
            <FloatingInput @ref="nameFloatingInput" Id="api-key-name" Label="@L["Common.Name"]"
                           Value="@editName" OnInput="(e) => editName = e.Value?.ToString() ?? string.Empty" OnKeyDown="OnDialogKeyDown"
                           MaxLength="AppConstraints.NameMaxLength"/>
            <FloatingSelect Id="api-key-user" Label="@L["ApiKeys.User"]" Value="@selectedUserId" OnChange="(e) => selectedUserId = e.Value?.ToString() ?? string.Empty">
                @if (users is not null)
                {
                    @foreach (var user in users)
                    {
                        <option value="@user.Id">@user.Name</option>
                    }
                }
            </FloatingSelect>
            <div class="flex justify-end gap-3">
                <AppButton Variant="ButtonVariant.Cancel" OnClick="CloseDialog">
                    @L["Common.Cancel"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Primary"
                           Disabled="@(isSaving || string.IsNullOrWhiteSpace(editName))"
                           OnClick="CreateKey">
                    @(isSaving ? L["Common.Creating"] : L["Common.Create"])
                </AppButton>
            </div>
        </div>
    </Dialog>
}

@if (createdKey is not null)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-lg" OnClose="() => createdKey = null">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["ApiKeys.Created"]</div>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">@L["ApiKeys.CreatedDescription"]</p>
            <div class="flex items-center gap-2">
                <input type="text" readonly value="@createdKey"
                       class="flex-1 px-3 py-2 rounded-lg bg-neutral-100 dark:bg-neutral-600 text-sm border border-neutral-200 dark:border-neutral-500 select-all"/>
                <button class="px-3 self-stretch rounded-lg bg-neutral-200 dark:bg-neutral-500 cursor-pointer hover:bg-neutral-300 dark:hover:bg-neutral-400"
                        title="@L["UserDetail.Copy"]"
                        @onclick="CopyKey">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                        <path d="M7 3.5A1.5 1.5 0 0 1 8.5 2h3.879a1.5 1.5 0 0 1 1.06.44l3.122 3.12A1.5 1.5 0 0 1 17 6.622V12.5a1.5 1.5 0 0 1-1.5 1.5h-1v-3.379a3 3 0 0 0-.879-2.121L10.5 5.379A3 3 0 0 0 8.379 4.5H7v-1Z"/>
                        <path d="M4.5 6A1.5 1.5 0 0 0 3 7.5v9A1.5 1.5 0 0 0 4.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L9.44 6.439A1.5 1.5 0 0 0 8.378 6H4.5Z"/>
                    </svg>
                </button>
            </div>
            <div class="flex justify-end">
                <AppButton Variant="ButtonVariant.Primary" OnClick="() => createdKey = null">
                    @L["Common.OK"]
                </AppButton>
            </div>
        </div>
    </Dialog>
}

@if (keyToDelete is not null)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-sm" OnClose="() => keyToDelete = null">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["ApiKeys.ConfirmDeleteTitle"]</div>
            <p>@L["ApiKeys.ConfirmDeleteMessage", keyToDelete.Name]</p>
            <div class="flex justify-end gap-3">
                <AppButton Variant="ButtonVariant.Cancel" OnClick="() => keyToDelete = null">
                    @L["Common.Cancel"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Danger" Filled OnClick="DeleteKey">
                    @L["Common.Delete"]
                </AppButton>
            </div>
        </div>
    </Dialog>
}

@code {
    private string McpUrl => new Uri(new Uri(Navigation.BaseUri), "/mcp").ToString();

    private List<McpApiKey>? apiKeys;
    private List<User>? users;
    private bool showCreateDialog;
    private bool isSaving;
    private string editName = "";
    private string selectedUserId = "";
    private string? createdKey;
    private McpApiKey? keyToDelete;
    private FloatingInput? nameFloatingInput;
    private bool shouldFocusName;

    protected override async Task OnInitializedAsync()
    {
        var orgId = OrgState.ActiveOrganizationId;
        if (orgId is null) return;

        var caller = OrgState.ToCallerContext();
        apiKeys = await UserService.GetMcpApiKeysAsync(orgId, caller);
        users = await UserService.GetUsersByOrganizationAsync(orgId, caller);
        selectedUserId = users.FirstOrDefault()?.Id ?? "";
    }

    private void ShowCreateDialog()
    {
        editName = "";
        selectedUserId = users?.FirstOrDefault()?.Id ?? "";
        showCreateDialog = true;
        shouldFocusName = true;
    }

    private void CloseDialog() => showCreateDialog = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldFocusName)
        {
            shouldFocusName = false;
            if (nameFloatingInput is not null)
                try { await nameFloatingInput.FocusAsync(); } catch { }
        }
    }

    private async Task OnDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(editName))
            await CreateKey();
        else if (e.Key == "Escape")
            CloseDialog();
    }

    private async Task CreateKey()
    {
        if (isSaving || string.IsNullOrWhiteSpace(editName) || string.IsNullOrEmpty(selectedUserId)) return;

        var orgId = OrgState.ActiveOrganizationId;
        if (orgId is null) return;

        isSaving = true;
        var result = await UserService.CreateMcpApiKeyAsync(editName.Trim(), selectedUserId, orgId, OrgState.ToCallerContext());
        createdKey = result.PlaintextKey;
        apiKeys = await UserService.GetMcpApiKeysAsync(orgId, OrgState.ToCallerContext());
        isSaving = false;
        showCreateDialog = false;
    }

    private async Task CopyKey()
    {
        if (createdKey is null) return;
        try
        {
            var success = await JSRuntime.InvokeAsync<bool>("copyToClipboard", createdKey);
            if (success)
                Toast.Show(L["Toast.KeyCopied"]);
        }
        catch { }
    }

    private void ConfirmDeleteKey(McpApiKey key) => keyToDelete = key;

    private async Task DeleteKey()
    {
        if (keyToDelete is null) return;
        await UserService.DeleteMcpApiKeyAsync(keyToDelete.Id, OrgState.ToCallerContext());
        apiKeys?.Remove(keyToDelete);
        Toast.Show(L["ApiKeys.Deleted"]);
        keyToDelete = null;
    }
}
