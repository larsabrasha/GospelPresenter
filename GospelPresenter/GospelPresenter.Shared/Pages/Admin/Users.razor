@page "/admin/users"
@attribute [Authorize(Roles = "Admin,SuperAdmin")]

@using GospelPresenter.Shared.Components.Symbols
@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.Authorization

@layout AdminLayout

@inject IUserService UserService
@inject NavigationManager NavigationManager
@inject ActiveOrganizationState OrgState

<PageContainer>
    <div class="flex items-center justify-between px-5">
        <div class="text-xl font-bold dark:text-neutral-100">@L["Users.Title"]</div>
        @if (users is not null && users.Count > 0)
        {
            <AppButton Variant="ButtonVariant.Primary" OnClick="ShowCreateDialog" Class="flex items-center gap-1.5">
                <PlusSymbol Class="size-4"/>
                @L["Users.Add"]
            </AppButton>
        }
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 overflow-hidden">
        @if (users is null)
        {
            <div class="px-7 py-4 text-neutral-400">@L["Common.Loading"]</div>
        }
        else if (users.Count == 0)
        {
            <div class="flex flex-col items-center justify-center text-center px-6 py-12 select-none">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 200 160" class="w-48 h-auto mb-6 text-neutral-300 dark:text-neutral-600">
                    <circle cx="100" cy="50" r="24" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                    <circle cx="100" cy="50" r="10" stroke="currentColor" stroke-width="2" fill="none" opacity="0.4"/>
                    <path d="M60 130c0-22.091 17.909-40 40-40s40 17.909 40 40" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
                    <circle cx="155" cy="120" r="16" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                    <line x1="155" y1="112" x2="155" y2="128" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                    <line x1="147" y1="120" x2="163" y2="120" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
                <h2 class="text-lg font-semibold text-neutral-500 dark:text-neutral-400 mb-2">@L["Users.NoUsers"]</h2>
                <p class="text-sm text-neutral-400 dark:text-neutral-500 max-w-xs leading-relaxed mb-4">
                    @L["Users.Description"]
                </p>
                <AppButton Variant="ButtonVariant.Primary" OnClick="ShowCreateDialog" Class="flex items-center gap-1.5">
                    <PlusSymbol Class="size-4"/>
                    @L["Users.Add"]
                </AppButton>
            </div>
        }
        else
        {
            @foreach (var user in users)
            {
                <a href="/admin/users/@user.Id"
                   class="flex items-center gap-3 px-7 py-3 border-b border-neutral-200 dark:border-neutral-700 last:border-b-0 hover:bg-neutral-100 dark:hover:bg-neutral-700 cursor-pointer">
                    <ProfileAvatar ImageUrl="@user.ProfileImageSmall" Name="@user.Name"/>
                    <div class="font-medium flex-1">@user.Name</div>
                    <span class="text-xs px-2 py-0.5 rounded-full @RoleBadgeClass(user.Role)">@RoleDisplayName(user.Role)</span>
                </a>
            }
        }
    </div>
</PageContainer>

@if (showCreateDialog)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-lg" OnClose="CloseDialog">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["Users.NewUser"]</div>
            <div>
                <label class="block text-sm font-medium mb-1">@L["Common.Name"]</label>
                <input @ref="nameInput"
                       type="text"
                       class="w-full px-4 py-3 rounded-xl border border-neutral-300 dark:border-neutral-600 dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-sky-500"
                       @bind="editName"
                       @bind:event="oninput"
                       @onkeydown="OnDialogKeyDown"/>
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">@L["Common.Email"]</label>
                <input type="email"
                       class="w-full px-4 py-3 rounded-xl border @(emailError is not null ? "border-red-500" : "border-neutral-300 dark:border-neutral-600") dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-sky-500"
                       @bind="editEmail"
                       @bind:event="oninput"/>
                @if (emailError is not null)
                {
                    <div class="text-sm text-red-500 dark:text-red-400 mt-1">@emailError</div>
                }
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">@L["Common.Role"]</label>
                <div class="relative">
                    <select @bind="editRole"
                            class="w-full appearance-none px-4 py-3 pr-10 rounded-xl border border-neutral-300 dark:border-neutral-600 dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-sky-500">
                        @foreach (var role in AllowedRoles)
                        {
                            <option value="@role">@RoleDisplayName(role)</option>
                        }
                    </select>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 absolute right-3.5 top-1/2 -translate-y-1/2 text-neutral-400 pointer-events-none">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                    </svg>
                </div>
                <div class="mt-2 text-xs text-neutral-500 dark:text-neutral-400 space-y-1">
                    <div><span class="font-medium">@L["Users.User"]:</span> @L["Users.RoleDescription.User"]</div>
                    <div><span class="font-medium">@L["Users.Admin"]:</span> @L["Users.RoleDescription.Admin"]</div>
                    @if (AllowedRoles.Contains(UserRole.SuperAdmin))
                    {
                        <div><span class="font-medium">@L["Users.Superadmin"]:</span> @L["Users.RoleDescription.SuperAdmin"]</div>
                    }
                </div>
            </div>
            <div class="flex justify-end gap-3">
                <AppButton Variant="ButtonVariant.Cancel" OnClick="CloseDialog">
                    @L["Common.Cancel"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Primary"
                           Disabled="@(isSaving || string.IsNullOrWhiteSpace(editName))"
                           OnClick="CreateUser">
                    @(isSaving ? L["Common.Creating"] : L["Common.Create"])
                </AppButton>
            </div>
        </div>
    </Dialog>
}

@code {
    private List<User>? users;
    private bool showCreateDialog;
    private bool isSaving;
    private string editName = "";
    private string editEmail = "";
    private string? emailError;
    private UserRole editRole = UserRole.User;
    private ElementReference nameInput;
    private bool shouldFocusName;

    private IEnumerable<UserRole> AllowedRoles => OrgState.HasPermission(Permission.AssignSuperAdminRole)
        ? Enum.GetValues<UserRole>()
        : Enum.GetValues<UserRole>().Where(r => r != UserRole.SuperAdmin);

    protected override async Task OnInitializedAsync()
    {
        var orgId = OrgState.ActiveOrganizationId;
        if (orgId is not null)
            users = await UserService.GetUsersByOrganizationAsync(orgId, OrgState.ToCallerContext());
        else if (OrgState.HasPermission(Permission.ManageOrganizations))
            users = await UserService.GetAllUsersAsync(OrgState.ToCallerContext());
        else
            users = [];
    }

    private void ShowCreateDialog()
    {
        editName = "";
        editEmail = "";
        editRole = UserRole.User;
        showCreateDialog = true;
        shouldFocusName = true;
    }

    private void CloseDialog() => showCreateDialog = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldFocusName)
        {
            shouldFocusName = false;
            try { await nameInput.FocusAsync(); } catch { }
        }
    }

    private async Task OnDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(editName))
            await CreateUser();
        else if (e.Key == "Escape")
            CloseDialog();
    }

    private async Task CreateUser()
    {
        if (isSaving || string.IsNullOrWhiteSpace(editName)) return;
        emailError = null;

        if (!string.IsNullOrWhiteSpace(editEmail) && !GospelPresenter.Shared.Utils.EmailValidation.IsValidEmail(editEmail.Trim()))
        {
            emailError = L["Users.InvalidEmail"];
            return;
        }

        if (!string.IsNullOrWhiteSpace(editEmail) && await UserService.IsEmailTakenAsync(editEmail.Trim()))
        {
            emailError = L["Users.EmailTaken"];
            return;
        }

        var orgId = OrgState.ActiveOrganizationId;
        if (orgId is null) return;

        isSaving = true;
        var user = await UserService.CreateUserAsync(editName.Trim(), editEmail.Trim(), orgId, editRole, OrgState.ToCallerContext());

        isSaving = false;
        showCreateDialog = false;
        NavigationManager.NavigateTo($"/admin/users/{user.Id}");
    }

    private string RoleDisplayName(UserRole role) => role switch
    {
        UserRole.SuperAdmin => L["Users.Superadmin"],
        UserRole.Admin => L["Users.Admin"],
        UserRole.User => L["Users.User"],
        _ => role.ToString()
    };

    private static string RoleBadgeClass(UserRole role) => role switch
    {
        UserRole.SuperAdmin => "bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-300",
        UserRole.Admin => "bg-sky-100 dark:bg-sky-900 text-sky-700 dark:text-sky-300",
        UserRole.User => "bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300",
        _ => ""
    };
}
