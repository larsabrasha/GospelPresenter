@page "/admin/songs/{SongId}"
@attribute [Authorize(Roles = "Admin,SuperAdmin")]

@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.Authorization

@layout AdminLayout

@inject ISongService SongService
@inject NavigationManager NavigationManager
@inject ActiveOrganizationState OrgState

<PageContainer Class="pb-8">
    <div class="relative flex items-center justify-center px-5">
        <AppButton Href="/admin/songs" Variant="ButtonVariant.Cancel" Class="absolute left-0 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
            </svg>
            @L["Common.Back"]
        </AppButton>
        <div class="text-xl font-bold dark:text-neutral-100 truncate max-w-[60%]">
            @songName
        </div>
        <AutoSaveIndicator @ref="saveIndicator" Class="absolute right-0"/>
    </div>

    @if (songName is null)
    {
        <div class="px-7 text-neutral-400">@L["Common.Loading"]</div>
    }
    else
    {
        <SongEditor SongId="@SongId" OnDeleted="HandleDeleted" OnSaved="HandleSaved">
            <AppButton Href="@($"/admin/songs/{SongId}/history")" Variant="ButtonVariant.Neutral"
                       Class="flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                </svg>
                @L["SongDetail.History"]
            </AppButton>
        </SongEditor>
    }
</PageContainer>

@code {
    [Parameter] public string SongId { get; set; } = "";

    private string? songName;
    private AutoSaveIndicator? saveIndicator;

    protected override void OnInitialized()
    {
        var song = SongService.GetSongById(SongId, OrgState.ActiveOrganizationId ?? "", OrgState.ToCallerContext());
        if (song is null)
        {
            NavigationManager.NavigateTo("/admin/songs");
            return;
        }
        songName = song.Name;
    }

    private void HandleSaved()
    {
        var song = SongService.GetSongById(SongId, OrgState.ActiveOrganizationId ?? "", OrgState.ToCallerContext());
        if (song is not null) songName = song.Name;
        saveIndicator?.Show();
    }

    private void HandleDeleted()
    {
        NavigationManager.NavigateTo("/admin/songs");
    }
}
