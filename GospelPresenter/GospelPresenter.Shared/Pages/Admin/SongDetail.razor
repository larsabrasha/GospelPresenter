@page "/admin/songs/{SongId}"
@attribute [Authorize(Roles = "Admin")]

@using GospelPresenter.Shared.Components.Presentations
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.Authorization

@inject ISongService SongService
@inject NavigationManager NavigationManager
@inject AppState AppState
@inject IJSRuntime JsRuntime

<div class="flex flex-col p-3 pt-8 w-full sm:w-180 mx-auto space-y-5">
    <div class="relative flex items-center justify-center px-7">
        <a href="/admin/songs"
           class="absolute left-0 flex items-center gap-2 px-4 py-2.5 rounded-full text-sm text-neutral-500 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-700 hover:text-neutral-700 dark:hover:text-neutral-200">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
            </svg>
            Tillbaka
        </a>
        <div class="text-xl font-bold dark:text-neutral-100 truncate max-w-[60%]">
            @song?.Name
        </div>
    </div>

    @if (song is null)
    {
        <div class="px-7 text-neutral-400">Laddar...</div>
    }
    else
    {
        <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 p-5 space-y-4">
            <div>
                <label class="block text-sm font-medium mb-1">Namn</label>
                <input type="text"
                       @bind="editName"
                       @bind:after="SaveSong"
                       class="w-full px-4 py-3 rounded-xl border border-neutral-300 dark:border-neutral-600 dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-sky-500"/>
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Artist</label>
                <input type="text"
                       @bind="editAuthor"
                       @bind:after="SaveSong"
                       class="w-full px-4 py-3 rounded-xl border border-neutral-300 dark:border-neutral-600 dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-sky-500"/>
            </div>
            <div>
                <button class="px-4 py-2.5 rounded-full text-sm text-red-600 cursor-pointer hover:bg-red-50 dark:hover:bg-red-900/30"
                        @onclick="ConfirmDelete">
                    Ta bort sång
                </button>
            </div>
        </div>

        @if (song.Parts.Count > 0)
        {
            <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 p-5 space-y-3">
                <div class="font-semibold">Delar (@song.Parts.Count)</div>
                <div class="flex flex-col gap-2" data-song-detail-preview>
                    @if (previewWidth > 0)
                    {
                        var scale = previewWidth / AppState.BaseSlideWidth;
                        @foreach (var part in song.Parts)
                        {
                            <SongSlide
                                ContentHtml="@(part.Content.Replace("\n", "<br>"))"
                                Label="@part.Label"
                                LabelColor="@part.LabelColor"
                                Class="border-t border-neutral-800/90 bg-black rounded-2xl overflow-hidden text-white"
                                BaseWidth="@AppState.BaseSlideWidth"
                                BaseHeight="@AppState.BaseSlideHeight"
                                Scale="@scale"/>
                        }
                    }
                </div>
            </div>
        }
    }
</div>

@if (showDeleteConfirm)
{
    <div class="fixed inset-0 bg-black/40 z-200 flex items-center justify-center p-4" @onclick="() => showDeleteConfirm = false">
        <div class="bg-white dark:bg-neutral-800 dark:text-neutral-100 rounded-2xl shadow-2xl p-6 w-full max-w-md space-y-4"
             @onclick:stopPropagation="true">
            <div class="font-semibold text-lg">Ta bort sång</div>
            <p class="text-sm text-neutral-600 dark:text-neutral-300">
                Vill du ta bort <strong>@song?.Name</strong>? Detta kan inte ångras.
            </p>
            <div class="flex justify-end gap-3">
                <button class="px-4 py-2.5 rounded-full cursor-pointer hover:bg-neutral-100 dark:hover:bg-neutral-700"
                        @onclick="() => showDeleteConfirm = false">
                    Avbryt
                </button>
                <button class="px-4 py-2.5 rounded-full bg-red-500 text-white cursor-pointer hover:bg-red-600 disabled:opacity-50"
                        disabled="@isDeleting"
                        @onclick="DeleteSong">
                    @(isDeleting ? "Tar bort..." : "Ta bort")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string SongId { get; set; } = "";

    private Song? song;
    private string editName = "";
    private string? editAuthor;
    private bool showDeleteConfirm;
    private bool isDeleting;
    private double previewWidth;

    protected override void OnInitialized()
    {
        song = SongService.GetSongById(SongId);
        if (song is null)
        {
            NavigationManager.NavigateTo("/admin/songs");
            return;
        }
        editName = song.Name;
        editAuthor = song.Author;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            previewWidth = await JsRuntime.InvokeAsync<double>("eval",
                "((el) => { if(!el) return 0; var s=getComputedStyle(el); return el.clientWidth - parseFloat(s.paddingLeft) - parseFloat(s.paddingRight) - 2; })(document.querySelector('[data-song-detail-preview]'))");
            StateHasChanged();
        }
    }

    private async Task SaveSong()
    {
        if (song is null || string.IsNullOrWhiteSpace(editName)) return;

        await SongService.UpdateSongAsync(song.Id, editName.Trim(), string.IsNullOrWhiteSpace(editAuthor) ? null : editAuthor.Trim());
        song = SongService.GetSongById(SongId);
    }

    private void ConfirmDelete()
    {
        showDeleteConfirm = true;
    }

    private async Task DeleteSong()
    {
        if (song is null || isDeleting) return;
        isDeleting = true;

        await SongService.DeleteSongAsync(song.Id);
        NavigationManager.NavigateTo("/admin/songs");
    }
}
