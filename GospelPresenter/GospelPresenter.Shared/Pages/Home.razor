@page "/"

@using GospelPresenter.Shared.Components
@using GospelPresenter.Shared.Components.Symbols

<div class="flex flex-col h-full items-center">
    <AuthorizeView>
        <Authorized>
            <Dashboard/>
        </Authorized>
        <NotAuthorized>
            <div class="flex flex-col items-center py-20">
                <LogoSymbol Class="size-20 text-sky-500"/>
                <div class="text-2xl uppercase">
                    <div><span class="text-sky-500 font-semibold">Gospel</span> <span class="text-sky-400">Presenter</span>
                    </div>
                </div>
            </div>

            <SignIn/>
        </NotAuthorized>
    </AuthorizeView>
</div>
