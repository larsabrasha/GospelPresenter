@page "/live"
@attribute [Authorize]
@layout LiveLayout

@inject AppState AppState
@inject SharedAppState SharedAppState
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager
@inject IServiceProvider ServiceProvider
@inject CircuitCulture Culture

@using System.ComponentModel
@using GospelPresenter.Shared.Components
@using GospelPresenter.Shared.Components.Presentations
@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.Localization
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.WebUtilities
@implements IDisposable

@{
    var viewportWidth = AppState.PresentationViewport?.Width ?? 0;
    var viewportHeight = AppState.PresentationViewport?.Height ?? 0;

    var widthScale = (double)viewportWidth / AppState.BaseSlideWidth;
    var heightScale = (double)viewportHeight / AppState.BaseSlideHeight;

    var scale = Math.Min(widthScale, heightScale);

    // Signed in is not enough: the session id is a query parameter, and a session belongs to an
    // organisation. A window may show a session of the viewer's own organisation and no other.
    var mayView = MayViewSession();
    var liveSlide = mayView ? SharedAppState.GetLiveSlide(sessionId) : null;
    var activeOverlay = mayView ? SharedAppState.GetActiveOverlay(sessionId) : null;
}

<div class="flex h-full bg-black text-white items-center justify-center" @onclick="RequestFullscreen">
    @if (liveSlide is not null)
    {
        <LiveDisplay
            LiveSlide="@liveSlide"
            Overlay="@activeOverlay"
            Scale="@scale"
            BaseWidth="@AppState.BaseSlideWidth"
            BaseHeight="@AppState.BaseSlideHeight"/>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string? viewerOrganizationId;
    private bool fullscreenRequested;
    private bool wakeLockRequested;
    private string sessionId = "";
    private string windowId = "";
    private string role = "Live";
    private int index;
    private string title = "";
    private GospelPresenter.Shared.Services.ILiveWindowLauncher? liveWindowLauncher;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is not null)
        {
            var state = await AuthenticationState;
            viewerOrganizationId = state.User.FindFirst("organization_id")?.Value;
        }

        // In the MAUI app this page lives in a native window; window.close() is a no-op there.
        liveWindowLauncher = ServiceProvider.GetService(typeof(GospelPresenter.Shared.Services.ILiveWindowLauncher))
            as GospelPresenter.Shared.Services.ILiveWindowLauncher;

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("session", out var session))
        {
            sessionId = session.ToString();
        }
        if (query.TryGetValue("windowId", out var wid))
        {
            windowId = wid.ToString();
        }
        // Carried in the URL so this window can say what it is when the operator's panel asks who
        // is out there — see initLiveViewListener. A window opened by an older build says nothing,
        // and the defaults make it a plain live view, which is what it was.
        if (query.TryGetValue("role", out var r))
        {
            role = r.ToString();
        }
        if (query.TryGetValue("index", out var i) && int.TryParse(i.ToString(), out var parsedIndex))
        {
            index = parsedIndex;
        }
        if (query.TryGetValue("title", out var t))
        {
            title = t.ToString();
            _ = JsRuntime.InvokeVoidAsync("gospelPresenter.setDocumentTitle", title);
        }

        _ = JsRuntime.InvokeVoidAsync("setRootElementBackgroundColor", "black");
        _ = JsRuntime.InvokeVoidAsync("initLiveViewListener", sessionId, windowId, role, index, title);

        AppState.PropertyChanged += OnAppStateChanged;
        SharedAppState.SessionChanged += OnSessionChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // This window is the projector. If the machine sleeps, the circuit goes with it and the
        // congregation is left looking at a stalled slide until someone finds the mouse.
        // OnAfterRender rather than OnInitialized: this only runs on the interactive pass, so the
        // call cannot be silently swallowed during prerendering.
        try
        {
            await JsRuntime.InvokeVoidAsync("gospelPresenter.requestWakeLock");
            wakeLockRequested = true;
        }
        catch
        {
            // Not available or denied, for example on plain HTTP or under battery saver. The
            // projector still works, the screen just sleeps as it did before.
        }
    }

    /// <summary>
    /// True while the session is not running (a black projector gives nothing away) or belongs to
    /// the viewer's organisation. A cross-organisation viewer is only ever given the black screen.
    /// </summary>
    private bool MayViewSession()
    {
        var sessionOrganizationId = SharedAppState.GetSessionOrganizationId(sessionId);
        return sessionOrganizationId is null || sessionOrganizationId == viewerOrganizationId;
    }

    private async Task RequestFullscreen()
    {
        if (fullscreenRequested) return;
        fullscreenRequested = true;
        await JsRuntime.InvokeVoidAsync("gospelPresenter.requestFullscreen");
    }

    public void Dispose()
    {
        AppState.PropertyChanged -= OnAppStateChanged;
        SharedAppState.SessionChanged -= OnSessionChanged;
        if (wakeLockRequested) _ = ReleaseWakeLockAsync();
    }

    private async Task ReleaseWakeLockAsync()
    {
        // Not awaited by Dispose: the circuit may already be gone, and the browser releases the
        // lock by itself when the window closes. This is for the navigation case.
        try { await JsRuntime.InvokeVoidAsync("gospelPresenter.releaseWakeLock"); } catch { }
    }

    /// <summary>
    /// This window is a projector for one session, so anything happening to that session concerns
    /// it — including a black screen and an overlay — and nothing happening to another one does.
    /// </summary>
    private void OnSessionChanged(SessionChange change)
    {
        if (change.SessionId != sessionId) return;

        if (SharedAppState.IsSessionExpired(sessionId) || !SharedAppState.IsPresentationActive(sessionId))
        {
            _ = InvokeAsync(async () =>
            {
                if (liveWindowLauncher is not null)
                    await liveWindowLauncher.CloseAsync(windowId);
                else
                    await JsRuntime.InvokeVoidAsync("gospelPresenter.closeWindow");
            });
            return;
        }

        _ = InvokeAsync(Culture.Restore(StateHasChanged));
    }

    private void OnAppStateChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(AppState.PresentationViewport))
            _ = InvokeAsync(StateHasChanged);
    }

}
