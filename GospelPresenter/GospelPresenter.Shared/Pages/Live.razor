@page "/live"
@layout LiveLayout

@inject AppState AppState
@inject SharedAppState SharedAppState
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

@using System.ComponentModel
@using GospelPresenter.Shared.Components
@using GospelPresenter.Shared.Components.Presentations
@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.WebUtilities
@implements IDisposable

@{
    var viewportWidth = AppState.PresentationViewport?.Width ?? 0;
    var viewportHeight = AppState.PresentationViewport?.Height ?? 0;

    var widthScale = (double)viewportWidth / AppState.BaseSlideWidth;
    var heightScale = (double)viewportHeight / AppState.BaseSlideHeight;

    var scale = Math.Min(widthScale, heightScale);

    var liveSlide = SharedAppState.GetLiveSlide(sessionId);
    var activeOverlay = SharedAppState.GetActiveOverlay(sessionId);
}

<div class="flex h-full bg-black text-white items-center justify-center" @onclick="RequestFullscreen">
    <LiveDisplay
        LiveSlide="@liveSlide"
        Overlay="@activeOverlay"
        Scale="@scale"
        BaseWidth="@AppState.BaseSlideWidth"
        BaseHeight="@AppState.BaseSlideHeight"/>
</div>

@code {

    private bool fullscreenRequested;
    private string sessionId = "";
    private string windowId = "";

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("session", out var session))
        {
            sessionId = session.ToString();
        }
        if (query.TryGetValue("windowId", out var wid))
        {
            windowId = wid.ToString();
        }
        if (query.TryGetValue("title", out var title))
        {
            JsRuntime.InvokeVoidAsync("eval", $"document.title = {System.Text.Json.JsonSerializer.Serialize(title.ToString())}");
        }

        JsRuntime.InvokeVoidAsync("setRootElementBackgroundColor", "black");
        JsRuntime.InvokeVoidAsync("initLiveViewListener", sessionId, windowId);

        AppState.PropertyChanged += OnPropertyChanged;
        SharedAppState.PropertyChanged += OnPropertyChanged;
    }

    private async Task RequestFullscreen()
    {
        if (fullscreenRequested) return;
        fullscreenRequested = true;
        await JsRuntime.InvokeVoidAsync("eval", "document.documentElement.requestFullscreen?.() || document.documentElement.webkitRequestFullscreen?.()");
    }

    public void Dispose()
    {
        AppState.PropertyChanged -= OnPropertyChanged;
        SharedAppState.PropertyChanged -= OnPropertyChanged;
    }

    private void OnPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (sender is SharedAppState && e.PropertyName == sessionId)
        {
            if (SharedAppState.IsSessionExpired(sessionId) || !SharedAppState.IsPresentationActive(sessionId))
            {
                _ = InvokeAsync(async () =>
                {
                    await JsRuntime.InvokeVoidAsync("eval", "window.close()");
                });
                return;
            }

            _ = InvokeAsync(StateHasChanged);
        }
        else if (e.PropertyName is nameof(AppState.PresentationViewport))
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

}
