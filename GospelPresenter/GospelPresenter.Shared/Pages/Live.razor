@page "/live"
@layout LiveLayout

@inject AppState AppState
@inject SharedAppState SharedAppState
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager
@inject IServiceProvider ServiceProvider
@inject CircuitCulture Culture

@using System.ComponentModel
@using GospelPresenter.Shared.Components
@using GospelPresenter.Shared.Components.Presentations
@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.Localization
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.WebUtilities
@implements IDisposable

@{
    var viewportWidth = AppState.PresentationViewport?.Width ?? 0;
    var viewportHeight = AppState.PresentationViewport?.Height ?? 0;

    var widthScale = (double)viewportWidth / AppState.BaseSlideWidth;
    var heightScale = (double)viewportHeight / AppState.BaseSlideHeight;

    var scale = Math.Min(widthScale, heightScale);

    var liveSlide = SharedAppState.GetLiveSlide(sessionId);
    var activeOverlay = SharedAppState.GetActiveOverlay(sessionId);
}

<div class="flex h-full bg-black text-white items-center justify-center" @onclick="RequestFullscreen">
    <LiveDisplay
        LiveSlide="@liveSlide"
        Overlay="@activeOverlay"
        Scale="@scale"
        BaseWidth="@AppState.BaseSlideWidth"
        BaseHeight="@AppState.BaseSlideHeight"/>
</div>

@code {

    private bool fullscreenRequested;
    private bool wakeLockRequested;
    private string sessionId = "";
    private string windowId = "";
    private GospelPresenter.Shared.Services.ILiveWindowLauncher? liveWindowLauncher;

    protected override void OnInitialized()
    {
        // In the MAUI app this page lives in a native window; window.close() is a no-op there.
        liveWindowLauncher = ServiceProvider.GetService(typeof(GospelPresenter.Shared.Services.ILiveWindowLauncher))
            as GospelPresenter.Shared.Services.ILiveWindowLauncher;

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("session", out var session))
        {
            sessionId = session.ToString();
        }
        if (query.TryGetValue("windowId", out var wid))
        {
            windowId = wid.ToString();
        }
        if (query.TryGetValue("title", out var title))
        {
            JsRuntime.InvokeVoidAsync("eval", $"document.title = {System.Text.Json.JsonSerializer.Serialize(title.ToString())}");
        }

        JsRuntime.InvokeVoidAsync("setRootElementBackgroundColor", "black");
        JsRuntime.InvokeVoidAsync("initLiveViewListener", sessionId, windowId);

        AppState.PropertyChanged += OnPropertyChanged;
        SharedAppState.PropertyChanged += OnPropertyChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // This window is the projector. If the machine sleeps, the circuit goes with it and the
        // congregation is left looking at a stalled slide until someone finds the mouse.
        // OnAfterRender rather than OnInitialized: this only runs on the interactive pass, so the
        // call cannot be silently swallowed during prerendering.
        try
        {
            await JsRuntime.InvokeVoidAsync("gospelPresenter.requestWakeLock");
            wakeLockRequested = true;
        }
        catch
        {
            // Not available or denied, for example on plain HTTP or under battery saver. The
            // projector still works, the screen just sleeps as it did before.
        }
    }

    private async Task RequestFullscreen()
    {
        if (fullscreenRequested) return;
        fullscreenRequested = true;
        await JsRuntime.InvokeVoidAsync("eval", "document.documentElement.requestFullscreen?.() || document.documentElement.webkitRequestFullscreen?.()");
    }

    public void Dispose()
    {
        AppState.PropertyChanged -= OnPropertyChanged;
        SharedAppState.PropertyChanged -= OnPropertyChanged;
        if (wakeLockRequested) _ = ReleaseWakeLockAsync();
    }

    private async Task ReleaseWakeLockAsync()
    {
        // Not awaited by Dispose: the circuit may already be gone, and the browser releases the
        // lock by itself when the window closes. This is for the navigation case.
        try { await JsRuntime.InvokeVoidAsync("gospelPresenter.releaseWakeLock"); } catch { }
    }

    private void OnPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (sender is SharedAppState && e.PropertyName == sessionId)
        {
            if (SharedAppState.IsSessionExpired(sessionId) || !SharedAppState.IsPresentationActive(sessionId))
            {
                _ = InvokeAsync(async () =>
                {
                    if (liveWindowLauncher is not null)
                        await liveWindowLauncher.CloseAsync(windowId);
                    else
                        await JsRuntime.InvokeVoidAsync("eval", "window.close()");
                });
                return;
            }

            _ = InvokeAsync(Culture.Restore(StateHasChanged));
        }
        else if (e.PropertyName is nameof(AppState.PresentationViewport))
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

}
