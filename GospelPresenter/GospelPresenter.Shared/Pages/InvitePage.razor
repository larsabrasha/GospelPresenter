@page "/invite/{Token}"
@attribute [AllowAnonymous]

@using GospelPresenter.Shared.Components.Symbols
@using GospelPresenter.Shared.Services
@using Microsoft.AspNetCore.Authorization

@inject IUserService UserService

<div class="flex flex-col h-full items-center">
    <div class="flex flex-col items-center py-20">
        <LogoSymbol Class="size-20 text-sky-500"/>
        <div class="text-2xl uppercase">
            <div><span class="text-sky-500 font-semibold">Gospel</span> <span class="text-sky-400">Presenter</span></div>
        </div>
    </div>

    @if (valid == null)
    {
        <div class="text-neutral-400">Laddar...</div>
    }
    else if (expired)
    {
        <div class="text-neutral-500 dark:text-neutral-400">Inbjudan har gått ut. Be din administratör skapa en ny.</div>
    }
    else if (valid == false)
    {
        <div class="text-red-500">Ogiltig eller redan använd inbjudan.</div>
    }
    else
    {
        <div class="text-lg dark:text-neutral-100 mb-4">Välkommen <strong>@userName</strong>! Välj hur du vill logga in:</div>

        <div class="flex flex-col p-3 w-full sm:w-140 items-center gap-3">
            <a href="/invite/@Token/signin?provider=google" class="flex items-center justify-center gap-2 w-64 px-6 py-3 rounded-full bg-white text-neutral-700 text-lg cursor-pointer hover:bg-neutral-100 border border-neutral-300">
                <svg class="w-5 h-5" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                Google
            </a>
            @if (showMore)
            {
                <a href="/invite/@Token/signin?provider=oidc" class="flex items-center justify-center gap-2 w-64 px-6 py-3 rounded-full bg-sky-500 text-white text-lg cursor-pointer hover:bg-sky-600">
                    Pocket ID
                </a>
            }
            else
            {
                <button class="text-sm text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 cursor-pointer"
                        @onclick="() => showMore = true">
                    Fler alternativ
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Token { get; set; } = "";

    private bool? valid;
    private bool expired;
    private bool showMore;
    private string? userName;

    protected override async Task OnInitializedAsync()
    {
        var invite = await UserService.GetInviteByTokenAsync(Token);
        if (invite == null)
        {
            expired = await UserService.IsInviteExpiredAsync(Token);
            valid = false;
            return;
        }
        valid = true;
        userName = invite.User.Name;
    }
}
