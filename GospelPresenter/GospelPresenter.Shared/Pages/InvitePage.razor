@page "/invite/{Token}"
@attribute [AllowAnonymous]

@using GospelPresenter.Shared.Components.Symbols
@using GospelPresenter.Shared.Services
@using Microsoft.AspNetCore.Authorization

@inject IUserService UserService
@inject IAuthProviderService AuthProviders

<div class="flex flex-col h-full items-center">
    @if (valid != false)
    {
        <div class="flex flex-col items-center py-20">
            <LogoSymbol Class="size-20 text-sky-500"/>
            <div class="text-2xl uppercase">
                <div><span class="text-sky-500 font-semibold">Gospel</span> <span class="text-sky-400">Presenter</span></div>
            </div>
        </div>
    }

    @if (valid == null)
    {
        <div class="text-neutral-400">@L["Common.Loading"]</div>
    }
    else if (expired)
    {
        <div class="flex flex-col items-center text-center px-4 pt-20 select-none">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 200 160" class="w-40 h-auto mb-4 text-neutral-300 dark:text-neutral-600">
                <!-- Envelope body -->
                <rect x="30" y="45" width="140" height="90" rx="8" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                <!-- Envelope flap -->
                <path d="M30 53 L100 95 L170 53" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.5"/>
                <!-- Clock circle -->
                <circle cx="150" cy="45" r="22" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                <!-- Clock hands -->
                <line x1="150" y1="45" x2="150" y2="33" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                <line x1="150" y1="45" x2="160" y2="48" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                <!-- Clock center dot -->
                <circle cx="150" cy="45" r="2" fill="currentColor"/>
                <!-- X mark over clock -->
                <line x1="138" y1="33" x2="162" y2="57" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.6"/>
                <line x1="162" y1="33" x2="138" y2="57" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.6"/>
            </svg>
            <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">@L["Invite.Expired"]</p>
        </div>
    }
    else if (valid == false)
    {
        <div class="flex flex-col items-center text-center px-4 pt-20 select-none">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 200 160" class="w-40 h-auto mb-4 text-neutral-300 dark:text-neutral-600">
                <!-- Envelope body -->
                <rect x="30" y="35" width="140" height="95" rx="8" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                <!-- Envelope flap -->
                <path d="M30 43 L100 88 L170 43" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.5"/>
                <!-- Content lines inside envelope -->
                <line x1="60" y1="100" x2="120" y2="100" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.25"/>
                <line x1="60" y1="112" x2="105" y2="112" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.2"/>
                <!-- X circle -->
                <circle cx="152" cy="112" r="18" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                <line x1="144" y1="104" x2="160" y2="120" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                <line x1="160" y1="104" x2="144" y2="120" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
            <p class="text-sm text-red-400 dark:text-red-400 leading-relaxed">@L["Invite.Invalid"]</p>
            <p class="text-sm text-neutral-400 dark:text-neutral-500 mt-2 leading-relaxed">@L["Invite.ContactAdmin"]</p>
        </div>
    }
    else
    {
        <div class="text-lg dark:text-neutral-100 mb-4">@((MarkupString)L["Invite.Welcome", userName].Value)</div>

        <div class="flex flex-col p-3 w-full sm:w-140 items-center gap-3">
            @{ var providers = AuthProviders.EnabledProviders; }

            @foreach (var provider in providers.Take(1))
            {
                <a href="/invite/@Token/signin?provider=@provider.Id" class="@ButtonClass(provider.Id)">
                    @if (provider.Id == "google")
                    {
                        <svg class="w-5 h-5" viewBox="0 0 24 24">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        </svg>
                    }
                    @L["SignIn.Provider", provider.DisplayName]
                </a>
            }

            @if (providers.Count > 1)
            {
                @if (showMore)
                {
                    @foreach (var provider in providers.Skip(1))
                    {
                        <a href="/invite/@Token/signin?provider=@provider.Id" class="@ButtonClass(provider.Id)">
                            @if (provider.Id == "google")
                            {
                                <svg class="w-5 h-5" viewBox="0 0 24 24">
                                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
                                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                                </svg>
                            }
                            @L["SignIn.Provider", provider.DisplayName]
                        </a>
                    }
                }
                else
                {
                    <button class="text-sm text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 cursor-pointer"
                            @onclick="() => showMore = true">
                        @L["SignIn.MoreOptions"]
                    </button>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Token { get; set; } = "";

    private bool? valid;
    private bool expired;
    private bool showMore;
    private string? userName;

    private static string ButtonClass(string providerId) => providerId switch
    {
        "google" => "flex items-center justify-center gap-2 w-64 px-6 py-3 rounded-full bg-white text-neutral-700 text-lg cursor-pointer hover:bg-neutral-100 border border-neutral-300",
        _ => "flex items-center justify-center gap-2 w-64 px-6 py-3 rounded-full bg-sky-500 text-white text-lg cursor-pointer hover:bg-sky-600",
    };

    protected override async Task OnInitializedAsync()
    {
        var invite = await UserService.GetInviteByTokenAsync(Token);
        if (invite == null)
        {
            expired = await UserService.IsInviteExpiredAsync(Token);
            valid = false;
            return;
        }
        valid = true;
        userName = invite.User.Name;
    }
}
