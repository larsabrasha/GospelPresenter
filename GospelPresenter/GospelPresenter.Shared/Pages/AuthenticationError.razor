@page "/authentication-error"
@attribute [AllowAnonymous]

<PageTitle>Authentication Error</PageTitle>

<div class="flex items-center justify-center h-full">
    <div class="text-center">
        <h1 class="text-2xl font-bold text-neutral-800 dark:text-neutral-200 mb-4">Authentication Error</h1>
        <p class="text-neutral-600 dark:text-neutral-400 mb-6">Something went wrong during sign-in. Please try again.</p>
        <a href="/" class="text-sky-500 hover:text-sky-700 underline">Back to start</a>
    </div>
</div>
