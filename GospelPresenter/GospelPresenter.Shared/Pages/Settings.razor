@page "/settings"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.Globalization

@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="flex flex-col p-3 pt-8 w-full sm:w-180 mx-auto space-y-5">
    <div class="relative flex items-center justify-center px-7">
        <div class="text-xl font-bold dark:text-neutral-100">
            @L["Settings.Title"]
        </div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 p-5 space-y-4">
        <div>
            <label class="block text-sm font-medium mb-1">@L["Settings.Theme"]</label>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mb-2">@L["Settings.ThemeDescription"]</p>
            <div class="flex flex-col gap-2">
                @foreach (var option in themeOptions)
                {
                    <button type="button"
                            @onclick="() => SetTheme(option.Value)"
                            class="@ThemeButtonClass(option.Value) w-full flex items-center gap-3 px-4 py-3 rounded-xl border text-left cursor-pointer transition">
                        @((MarkupString)option.Icon)
                        <span>@L[option.LabelKey]</span>
                        @if (option.Value == currentTheme)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 ml-auto text-sky-500">
                                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                            </svg>
                        }
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 p-5 space-y-4">
        <div>
            <label class="block text-sm font-medium mb-2">@L["Settings.Language"]</label>
            <div class="flex flex-col gap-2">
                @foreach (var lang in languages)
                {
                    <form method="post" action="/culture">
                        <AntiforgeryToken />
                        <input type="hidden" name="culture" value="@lang.Code" />
                        <input type="hidden" name="returnUrl" value="/settings" />
                        <button type="submit"
                                class="@LanguageButtonClass(lang.Code) w-full flex items-center gap-3 px-4 py-3 rounded-xl border text-left cursor-pointer transition">
                            <span>@lang.Name</span>
                            @if (lang.Code == currentCulture)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 ml-auto text-sky-500">
                                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                                </svg>
                            }
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    private string currentTheme = "system";

    private readonly record struct LanguageOption(string Code, string Name);
    private readonly record struct ThemeOption(string Value, string LabelKey, string Icon);

    private static readonly LanguageOption[] languages =
    [
        new("sv", "Svenska"),
        new("en", "English"),
    ];

    private static readonly ThemeOption[] themeOptions =
    [
        new("system", "Settings.ThemeSystem", "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" class=\"w-5 h-5 shrink-0\"><path fill-rule=\"evenodd\" d=\"M2 4.25A2.25 2.25 0 0 1 4.25 2h11.5A2.25 2.25 0 0 1 18 4.25v8.5A2.25 2.25 0 0 1 15.75 15h-3.105a3.501 3.501 0 0 0 1.1 1.677A.75.75 0 0 1 13.26 18H6.74a.75.75 0 0 1-.484-1.323A3.501 3.501 0 0 0 7.355 15H4.25A2.25 2.25 0 0 1 2 12.75v-8.5Zm1.5 0a.75.75 0 0 1 .75-.75h11.5a.75.75 0 0 1 .75.75v7.5a.75.75 0 0 1-.75.75H4.25a.75.75 0 0 1-.75-.75v-7.5Z\" clip-rule=\"evenodd\" /></svg>"),
        new("light", "Settings.ThemeLight", "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" class=\"w-5 h-5 shrink-0\"><path d=\"M10 2a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 10 2ZM10 15a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 10 15ZM10 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM15.657 5.404a.75.75 0 1 0-1.06-1.06l-1.061 1.06a.75.75 0 0 0 1.06 1.061l1.061-1.06ZM6.464 14.596a.75.75 0 1 0-1.06-1.06l-1.06 1.06a.75.75 0 0 0 1.06 1.06l1.06-1.06ZM18 10a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 18 10ZM5 10a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 5 10ZM14.596 15.657a.75.75 0 0 0 1.06-1.06l-1.06-1.061a.75.75 0 1 0-1.06 1.06l1.06 1.061ZM5.404 6.464a.75.75 0 0 0 1.06-1.06l-1.06-1.06a.75.75 0 1 0-1.06 1.06l1.06 1.06Z\" /></svg>"),
        new("dark", "Settings.ThemeDark", "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\" class=\"w-5 h-5 shrink-0\"><path fill-rule=\"evenodd\" d=\"M7.455 2.004a.75.75 0 0 1 .26.77 7 7 0 0 0 9.958 7.967.75.75 0 0 1 1.067.853A8.5 8.5 0 1 1 6.647 1.921a.75.75 0 0 1 .808.083Z\" clip-rule=\"evenodd\" /></svg>"),
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            currentTheme = await JS.InvokeAsync<string>("getTheme");
            StateHasChanged();
        }
    }

    private async Task SetTheme(string theme)
    {
        currentTheme = theme;
        await JS.InvokeVoidAsync("setTheme", theme);
    }

    private string SelectedButtonClass => "border-sky-500 bg-sky-50 dark:bg-sky-900/30 dark:border-sky-400";
    private string UnselectedButtonClass => "border-neutral-300 dark:border-neutral-600 hover:bg-neutral-100 dark:hover:bg-neutral-700";

    private string ThemeButtonClass(string value) =>
        value == currentTheme ? SelectedButtonClass : UnselectedButtonClass;

    private string LanguageButtonClass(string code) =>
        code == currentCulture ? SelectedButtonClass : UnselectedButtonClass;
}
