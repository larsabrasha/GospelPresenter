@page "/superadmin/organizations"
@attribute [Authorize(Roles = "SuperAdmin")]

@using GospelPresenter.Shared.Components
@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.Authorization

@layout AdminLayout

@inject IUserService UserService
@inject ActiveOrganizationState OrgState
@inject NavigationManager NavigationManager

<div class="flex flex-col p-3 pt-8 w-full sm:w-180 mx-auto space-y-5">
    <div class="flex items-center justify-between px-5">
        <div class="text-xl font-bold dark:text-neutral-100">@L["Orgs.Title"]</div>
        <button class="px-4 py-2.5 rounded-full bg-sky-500 text-white cursor-pointer hover:bg-sky-600 text-sm"
                @onclick="ShowCreateDialog">
            @L["Orgs.New"]
        </button>
    </div>

    <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 overflow-hidden">
        @if (organizations is null)
        {
            <div class="px-7 py-4 text-neutral-400">@L["Common.Loading"]</div>
        }
        else if (organizations.Count == 0)
        {
            <div class="flex flex-col items-center text-center py-8 px-4 select-none">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 200 160" class="w-40 h-auto mb-4 text-neutral-300 dark:text-neutral-600">
                    <rect x="30" y="20" width="60" height="50" rx="6" stroke="currentColor" stroke-width="2" fill="none"/>
                    <rect x="110" y="20" width="60" height="50" rx="6" stroke="currentColor" stroke-width="2" fill="none"/>
                    <rect x="70" y="90" width="60" height="50" rx="6" stroke="currentColor" stroke-width="2" fill="none"/>
                    <circle cx="60" cy="38" r="8" stroke="currentColor" stroke-width="2" fill="none" opacity="0.5"/>
                    <line x1="50" y1="55" x2="70" y2="55" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
                    <circle cx="140" cy="38" r="8" stroke="currentColor" stroke-width="2" fill="none" opacity="0.5"/>
                    <line x1="130" y1="55" x2="150" y2="55" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
                    <circle cx="100" cy="108" r="8" stroke="currentColor" stroke-width="2" fill="none" opacity="0.5"/>
                    <line x1="90" y1="125" x2="110" y2="125" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
                </svg>
                <p class="text-sm text-neutral-400 dark:text-neutral-500 leading-relaxed">@L["Orgs.NoOrgs"]</p>
            </div>
        }
        else
        {
            @foreach (var org in organizations)
            {
                <a href="/superadmin/organizations/@org.Id"
                   class="flex items-center gap-3 px-7 py-3 border-b border-neutral-200 dark:border-neutral-700 last:border-b-0 hover:bg-neutral-100 dark:hover:bg-neutral-700/50 no-underline text-inherit">
                    <OrganizationAvatar LogoUrl="@org.LogoSmall" Name="@org.Name"/>
                    <div class="flex-1 min-w-0">
                        <div class="font-medium">@org.Name</div>
                        <div class="text-xs text-neutral-400">@org.Users.Count @L["Orgs.UserCount"]</div>
                    </div>
                </a>
            }
        }
    </div>
</div>

@if (showCreateDialog)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-lg" OnClose="CloseDialog">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["Orgs.New"]</div>
            <div>
                <label class="block text-sm font-medium mb-1">@L["Common.Name"]</label>
                <input @ref="nameInput"
                       type="text"
                       class="w-full px-4 py-3 rounded-xl border border-neutral-300 dark:border-neutral-600 dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-sky-500"
                       @bind="newOrgName"
                       @bind:event="oninput"
                       @onkeydown="OnDialogKeyDown"/>
            </div>
            <div class="flex justify-end gap-3">
                <button class="px-4 py-2.5 rounded-full cursor-pointer hover:bg-neutral-100 dark:hover:bg-neutral-700"
                        @onclick="CloseDialog">
                    @L["Common.Cancel"]
                </button>
                <button class="px-4 py-2.5 rounded-full bg-sky-500 text-white cursor-pointer hover:bg-sky-600 disabled:opacity-50"
                        disabled="@(isCreating || string.IsNullOrWhiteSpace(newOrgName))"
                        @onclick="CreateOrganization">
                    @(isCreating ? L["Common.Creating"] : L["Common.Create"])
                </button>
            </div>
        </div>
    </Dialog>
}

@code {
    private List<Organization>? organizations;
    private bool showCreateDialog;
    private bool isCreating;
    private string newOrgName = "";
    private ElementReference nameInput;
    private bool shouldFocusName;

    protected override async Task OnInitializedAsync()
    {
        organizations = await UserService.GetAllOrganizationsAsync(OrgState.ToCallerContext());
    }

    private void ShowCreateDialog()
    {
        newOrgName = "";
        showCreateDialog = true;
        shouldFocusName = true;
    }

    private void CloseDialog() => showCreateDialog = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldFocusName)
        {
            shouldFocusName = false;
            try { await nameInput.FocusAsync(); } catch { }
        }
    }

    private async Task OnDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newOrgName))
            await CreateOrganization();
        else if (e.Key == "Escape")
            CloseDialog();
    }

    private async Task CreateOrganization()
    {
        if (isCreating || string.IsNullOrWhiteSpace(newOrgName)) return;
        isCreating = true;

        var org = await UserService.CreateOrganizationAsync(newOrgName.Trim(), OrgState.ToCallerContext());

        OrgState.SwitchOrganization(org.Id, org.Name);
        await UserService.SetUserSettingAsync(OrgState.UserId!, UserSetting.LastSelectedOrganizationId, org.Id, OrgState.ToCallerContext());
        OrgState.NotifyOrganizationsChanged();

        isCreating = false;
        showCreateDialog = false;
        NavigationManager.NavigateTo("/admin/users");
    }

}
