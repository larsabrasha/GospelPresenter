@page "/superadmin/organizations/{OrganizationId}"
@attribute [Authorize(Roles = "SuperAdmin")]

@using GospelPresenter.Shared.Components
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.Authorization

@inject IUserService UserService
@inject ActiveOrganizationState OrgState
@inject NavigationManager NavigationManager

<div class="flex flex-col p-3 pt-8 w-full sm:w-180 mx-auto space-y-5">
    <div class="relative flex items-center justify-center px-7">
        <a href="/superadmin/organizations"
           class="absolute left-0 flex items-center gap-2 px-4 py-2.5 rounded-full text-sm text-neutral-500 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-700 hover:text-neutral-700 dark:hover:text-neutral-200">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
            </svg>
            Tillbaka
        </a>
        <div class="text-xl font-bold dark:text-neutral-100">@(organization?.Name ?? "Organisation")</div>
    </div>

    @if (organization is null)
    {
        <div class="px-7 py-4 text-neutral-400">Laddar...</div>
    }
    else
    {
        <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 overflow-hidden p-5 space-y-4">
            <div class="font-semibold">Organisationsnamn</div>
            <div class="flex gap-3">
                <input type="text"
                       class="flex-1 px-4 py-3 rounded-xl border border-neutral-300 dark:border-neutral-600 dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-sky-500"
                       @bind="editName"/>
                <button class="px-4 py-2.5 rounded-full bg-sky-500 text-white cursor-pointer hover:bg-sky-600 disabled:opacity-50 text-sm"
                        disabled="@(isSaving || string.IsNullOrWhiteSpace(editName) || editName.Trim() == organization.Name)"
                        @onclick="SaveName">
                    @(isSaving ? "Sparar..." : "Spara")
                </button>
            </div>
        </div>

        <div class="flex gap-3">
            <button @onclick="SwitchToOrganization"
                    class="px-4 py-2.5 rounded-full text-sm cursor-pointer
                           @(OrgState.SelectedOrganizationId == OrganizationId
                               ? "bg-sky-100 dark:bg-sky-900/40 text-sky-700 dark:text-sky-300"
                               : "bg-sky-500 text-white hover:bg-sky-600")">
                @(OrgState.SelectedOrganizationId == OrganizationId ? "Aktiv organisation" : "Byt till denna organisation")
            </button>
            <button @onclick="ShowDeleteConfirmation"
                    class="px-4 py-2.5 rounded-full text-sm text-red-600 dark:text-red-400 cursor-pointer hover:bg-red-50 dark:hover:bg-red-900/20">
                Ta bort organisation
            </button>
        </div>

        <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 overflow-hidden">
            <div class="font-semibold px-5 pt-4 pb-2">Medlemmar (@members.Count)</div>
            @if (members.Count == 0)
            {
                <div class="flex flex-col items-center text-center py-8 px-4 select-none">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 200 120" class="w-32 h-auto mb-3 text-neutral-300 dark:text-neutral-600">
                        <circle cx="100" cy="40" r="20" stroke="currentColor" stroke-width="2" fill="none"/>
                        <path d="M65 100c0-19.33 15.67-35 35-35s35 15.67 35 35" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
                    </svg>
                    <p class="text-sm text-neutral-400 dark:text-neutral-500">Inga medlemmar ännu</p>
                </div>
            }
            else
            {
                @foreach (var user in members)
                {
                    <a href="/admin/users/@user.Id"
                       class="flex items-center gap-3 px-7 py-3 border-b border-neutral-200 dark:border-neutral-700 last:border-b-0 hover:bg-neutral-100 dark:hover:bg-neutral-700 cursor-pointer no-underline text-inherit">
                        <ProfileAvatar ImageUrl="@user.ProfileImageSmall" Name="@user.Name"/>
                        <div class="font-medium flex-1">@user.Name</div>
                        <span class="text-xs px-2 py-0.5 rounded-full @RoleBadgeClass(user.Role)">@RoleDisplayName(user.Role)</span>
                    </a>
                }
            }
        </div>
    }
</div>

@if (showDeleteDialog)
{
    <div class="fixed inset-0 bg-black/40 z-200 flex items-center justify-center p-4" @onclick="() => showDeleteDialog = false">
        <div class="bg-white dark:bg-neutral-800 dark:text-neutral-100 rounded-2xl shadow-2xl p-6 w-full max-w-lg space-y-4"
             @onclick:stopPropagation="true">
            <div class="font-semibold text-lg">Ta bort organisation</div>
            <p class="text-sm text-neutral-600 dark:text-neutral-300">
                Är du säker på att du vill ta bort <strong>@organization?.Name</strong>? Detta kan inte ångras.
                Alla användare och data som tillhör organisationen kommer att tas bort.
            </p>
            <div class="flex justify-end gap-3">
                <button class="px-4 py-2.5 rounded-full cursor-pointer hover:bg-neutral-100 dark:hover:bg-neutral-700"
                        @onclick="() => showDeleteDialog = false">
                    Avbryt
                </button>
                <button class="px-4 py-2.5 rounded-full bg-red-500 text-white cursor-pointer hover:bg-red-600 disabled:opacity-50"
                        disabled="@isDeleting"
                        @onclick="DeleteOrganization">
                    @(isDeleting ? "Tar bort..." : "Ta bort")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string OrganizationId { get; set; } = "";

    private Organization? organization;
    private List<User> members = [];
    private string editName = "";
    private bool isSaving;
    private bool showDeleteDialog;
    private bool isDeleting;

    protected override async Task OnInitializedAsync()
    {
        organization = await UserService.GetOrganizationByIdAsync(OrganizationId);
        if (organization is not null)
        {
            editName = organization.Name;
            members = await UserService.GetUsersByOrganizationAsync(OrganizationId);
        }
    }

    private async Task SaveName()
    {
        if (isSaving || string.IsNullOrWhiteSpace(editName) || organization is null) return;
        isSaving = true;

        await UserService.UpdateOrganizationAsync(OrganizationId, editName.Trim());
        organization.Name = editName.Trim();

        if (OrgState.SelectedOrganizationId == OrganizationId)
            OrgState.SwitchOrganization(OrganizationId, editName.Trim());

        isSaving = false;
    }

    private void SwitchToOrganization()
    {
        if (organization is null) return;
        OrgState.SwitchOrganization(organization.Id, organization.Name);
        NavigationManager.NavigateTo("/");
    }

    private void ShowDeleteConfirmation() => showDeleteDialog = true;

    private async Task DeleteOrganization()
    {
        if (isDeleting) return;
        isDeleting = true;

        if (OrgState.SelectedOrganizationId == OrganizationId)
            OrgState.ClearOrganization();

        await UserService.DeleteOrganizationAsync(OrganizationId);

        NavigationManager.NavigateTo("/superadmin/organizations");
    }

    private static string RoleDisplayName(UserRole role) => role switch
    {
        UserRole.SuperAdmin => "Superadmin",
        UserRole.Admin => "Admin",
        UserRole.User => "Användare",
        _ => role.ToString()
    };

    private static string RoleBadgeClass(UserRole role) => role switch
    {
        UserRole.SuperAdmin => "bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-300",
        UserRole.Admin => "bg-sky-100 dark:bg-sky-900 text-sky-700 dark:text-sky-300",
        UserRole.User => "bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300",
        _ => ""
    };
}
