@page "/admin/organizations/{OrganizationId}"
@attribute [Authorize(Policy = ManageOrganizations)]
@implements IDisposable

@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.Components
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.Authorization

@layout AdminLayout

@inject IUserService UserService
@inject IProfileImageService ProfileImageService
@inject ActiveOrganizationState OrgState
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageContainer>
    <DetailHeader @ref="header" BackHref="/admin/organizations" Title="@(organization?.Name ?? L["OrgDetail.DefaultName"])" Class="px-7"/>

    @if (organization is null)
    {
        <div class="px-7 py-4 text-neutral-400">@L["Common.Loading"]</div>
    }
    else
    {
        <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t-[0.5px] border-white dark:border-neutral-700 overflow-hidden p-5 space-y-4">
            <div>
                <label class="block text-sm font-medium mb-1">@L["OrgDetail.Logo"]</label>
                <div class="flex items-center gap-4">
                    <label class="cursor-pointer group relative" @onclick="() => ClickFileInput()" @onclick:preventDefault>
                        <OrganizationAvatar LogoUrl="@organization.LogoSmall" Name="@organization.Name" Size="lg" Class="group-hover:brightness-75 transition"/>
                    </label>
                    <div class="flex flex-col items-start gap-1">
                        <AppButton Variant="ButtonVariant.Secondary" AsLabel>
                            @(string.IsNullOrEmpty(organization.LogoSmall) ? L["OrgDetail.ChooseLogo"] : L["OrgDetail.ChangeLogo"])
                            <input @ref="fileInput" type="file" @onchange="OnLogoSelected" accept="@AppConstraints.ImageAccept" class="hidden"/>
                        </AppButton>
                        @if (!string.IsNullOrEmpty(organization.LogoSmall))
                        {
                            <AppButton Variant="ButtonVariant.Danger" OnClick="RemoveLogo"
                                       Class="text-left">
                                @L["OrgDetail.RemoveLogo"]
                            </AppButton>
                        }
                        @if (logoError is not null)
                        {
                            <div class="text-sm text-red-500 dark:text-red-400">@logoError</div>
                        }
                    </div>
                </div>
            </div>
            <FloatingInput Id="org-name" Label="@L["OrgDetail.OrgName"]" Value="@editName" OnInput="HandleNameChanged"
                           MaxLength="AppConstraints.NameMaxLength"/>
        </div>

        <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t-[0.5px] border-white dark:border-neutral-700 overflow-hidden">
            <div class="font-semibold px-5 pt-4 pb-2">@L["OrgDetail.Members"] (@members.Count)</div>
            @if (members.Count == 0)
            {
                <div class="flex flex-col items-center text-center py-8 px-4 select-none">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 200 120" class="w-32 h-auto mb-3 text-neutral-300 dark:text-neutral-600">
                        <circle cx="100" cy="40" r="20" stroke="currentColor" stroke-width="2" fill="none"/>
                        <path d="M65 100c0-19.33 15.67-35 35-35s35 15.67 35 35" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
                    </svg>
                    <p class="text-sm text-neutral-400 dark:text-neutral-500">@L["OrgDetail.NoMembers"]</p>
                </div>
            }
            else
            {
                @foreach (var user in members)
                {
                    <a href="/admin/users/@user.Id"
                       class="flex items-center gap-3 px-7 py-3 border-b border-neutral-200 dark:border-neutral-700 last:border-b-0 hover:bg-neutral-100 dark:hover:bg-neutral-700 cursor-pointer no-underline text-inherit">
                        <ProfileAvatar ImageUrl="@user.ProfileImageSmall" Name="@user.Name"/>
                        <div class="font-medium flex-1">@user.Name</div>
                        <span class="text-xs px-2 py-0.5 rounded-full @RoleBadgeClass(user.Role)">@RoleDisplayName(user.Role)</span>
                    </a>
                }
            }
        </div>
        <div class="flex justify-end">
            <AppButton Variant="ButtonVariant.Danger" OnClick="ShowDeleteConfirmation">
                @L["OrgDetail.DeleteOrg"]
            </AppButton>
        </div>
    }
</PageContainer>

@if (showDeleteDialog)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-lg" OnClose="() => showDeleteDialog = false">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["OrgDetail.DeleteOrg"]</div>
            <p class="text-sm text-neutral-600 dark:text-neutral-300">
                <LocalizedEmphasis Key="OrgDetail.ConfirmDeleteOrg" Value="@(organization?.Name ?? string.Empty)"/>
            </p>
            <div class="text-sm text-neutral-600 dark:text-neutral-300 space-y-1">
                <p class="font-medium">@L["OrgDetail.WillBeDeleted"]</p>
                <ul class="list-disc list-inside space-y-0.5 ml-1">
                    <li>@L["OrgDetail.OrgAndSettings"]</li>
                    <li>@((MarkupString)L["OrgDetail.AllMembers", members.Count].Value)</li>
                    <li>@L["OrgDetail.AllSongs"]</li>
                    <li>@L["OrgDetail.AllPresentations"]</li>
                    <li>@L["OrgDetail.AllImages"]</li>
                </ul>
            </div>
            <div class="space-y-1">
                <label class="text-sm text-neutral-600 dark:text-neutral-300">
                    <LocalizedEmphasis Key="OrgDetail.TypeToConfirm" Value="@(organization?.Name ?? string.Empty)"/>
                </label>
                <input @bind="deleteConfirmText" @bind:event="oninput"
                       class="w-full px-3 py-2 rounded-lg border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-700 text-sm focus:outline-none focus:ring-2 focus:ring-red-500"
                       placeholder="@organization?.Name" />
            </div>
            <div class="flex justify-end gap-3">
                <AppButton Variant="ButtonVariant.Cancel"
                           OnClick="() => { showDeleteDialog = false; deleteConfirmText = string.Empty; }">
                    @L["Common.Cancel"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Danger" Filled
                           Disabled="@(isDeleting || deleteConfirmText != organization?.Name)"
                           OnClick="DeleteOrganization">
                    @(isDeleting ? L["Common.Deleting"] : L["Common.Delete"])
                </AppButton>
            </div>
        </div>
    </Dialog>
}

@if (showCropDialog)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-sm" OnClose="CloseCropDialog">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg text-center">@L["OrgDetail.CropLogo"]</div>
            <div class="relative mx-auto w-64 h-64 rounded-full overflow-hidden cursor-grab active:cursor-grabbing select-none touch-none"
                 id="org-logo-cropper"
                 style="background: repeating-conic-gradient(#d1d5db 0% 25%, white 0% 50%) 0 0 / 16px 16px;">
                <img alt="" class="absolute top-0 left-0 origin-top-left pointer-events-none max-w-none" />
            </div>
            <input type="range" min="0" max="100" value="5"
                   @oninput="OnZoomSliderChanged"
                   class="w-full accent-sky-500" />
            <div class="flex justify-end gap-3">
                <AppButton Variant="ButtonVariant.Cancel" OnClick="CloseCropDialog">
                    @L["Common.Cancel"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Primary" OnClick="ConfirmCrop">
                    @L["Common.Confirm"]
                </AppButton>
            </div>
        </div>
    </Dialog>
}

@code {
    [Parameter] public string OrganizationId { get; set; } = "";

    private Organization? organization;
    private List<User> members = [];
    private string editName = "";
    private bool showDeleteDialog;
    private bool isDeleting;
    private string deleteConfirmText = "";
    private string? logoError;
    private bool showCropDialog;
    private readonly Utils.Debouncer saveDebounce = new();
    private DetailHeader? header;

    public void Dispose() => saveDebounce.Dispose();

    protected override async Task OnInitializedAsync()
    {
        organization = await UserService.GetOrganizationByIdAsync(OrganizationId, OrgState.ToCallerContext());
        if (organization is not null)
        {
            editName = organization.Name;
            members = await UserService.GetUsersByOrganizationAsync(OrganizationId, OrgState.ToCallerContext());
        }
    }

    private void HandleNameChanged(ChangeEventArgs e)
    {
        editName = e.Value?.ToString() ?? "";
        saveDebounce.Run(SaveName);
    }

    private async Task SaveName()
    {
        if (string.IsNullOrWhiteSpace(editName) || organization is null) return;

        await UserService.UpdateOrganizationAsync(OrganizationId, editName.Trim(), OrgState.ToCallerContext());
        organization.Name = editName.Trim();

        if (OrgState.SelectedOrganizationId == OrganizationId)
            OrgState.SwitchOrganization(OrganizationId, editName.Trim());

        OrgState.NotifyOrganizationsChanged();
        header?.ShowSaved();
    }

    private void ShowDeleteConfirmation()
    {
        deleteConfirmText = "";
        showDeleteDialog = true;
    }

    private async Task DeleteOrganization()
    {
        if (isDeleting) return;
        isDeleting = true;

        await UserService.DeleteOrganizationAsync(OrganizationId, OrgState.ToCallerContext());

        if (OrgState.SelectedOrganizationId == OrganizationId)
        {
            var allOrgs = await UserService.GetAllOrganizationsAsync(OrgState.ToCallerContext());
            var next = allOrgs.FirstOrDefault();
            if (next is not null)
            {
                OrgState.SwitchOrganization(next.Id, next.Name);
                await UserService.SetUserSettingAsync(OrgState.UserId!, UserSetting.LastSelectedOrganizationId, next.Id, OrgState.ToCallerContext());
            }
        }

        OrgState.NotifyOrganizationsChanged();
        NavigationManager.NavigateTo("/admin/organizations");
    }

    private string RoleDisplayName(UserRole role) => role switch
    {
        UserRole.SuperAdmin => L["Users.Superadmin"],
        UserRole.Admin => L["Users.Admin"],
        UserRole.User => L["Users.User"],
        _ => role.ToString()
    };

    private ElementReference fileInput;

    private async Task ClickFileInput() => await JSRuntime.InvokeVoidAsync("clickElement", fileInput);

    private async Task OnLogoSelected()
    {
        logoError = null;
        var dataUrl = await JSRuntime.InvokeAsync<string?>("readFileAsDataUrl", fileInput, AppConstraints.MaxImageFileSizeBytes, AppConstraints.AllowedImageTypes);
        if (dataUrl is null) return;
        if (dataUrl == AppConstraints.FileReadUnsupportedType)
        {
            logoError = L["OrgDetail.UnsupportedFormat"];
            return;
        }
        if (dataUrl == AppConstraints.FileReadTooLarge)
        {
            logoError = L["OrgDetail.ImageTooLarge"];
            return;
        }

        showCropDialog = true;
        StateHasChanged();
        await Task.Delay(50);
        await JSRuntime.InvokeVoidAsync("initImageCropper", "org-logo-cropper", dataUrl);
    }

    private async Task OnZoomSliderChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var value))
            await JSRuntime.InvokeVoidAsync("setImageCropperZoom", "org-logo-cropper", value);
    }

    private async Task CloseCropDialog()
    {
        showCropDialog = false;
        await JSRuntime.InvokeVoidAsync("destroyImageCropper", "org-logo-cropper");
    }

    private async Task ConfirmCrop()
    {
        var croppedDataUrl = await JSRuntime.InvokeAsync<string>("getImageCropResult", "org-logo-cropper");
        showCropDialog = false;
        await JSRuntime.InvokeVoidAsync("destroyImageCropper", "org-logo-cropper");

        if (string.IsNullOrEmpty(croppedDataUrl)) return;

        var base64Data = croppedDataUrl.Substring(croppedDataUrl.IndexOf(',') + 1);
        var imageBytes = Convert.FromBase64String(base64Data);
        var (_, smallDataUri) = ProfileImageService.Resize(imageBytes, "image/webp");

        await UserService.UpdateOrganizationLogoAsync(OrganizationId, smallDataUri, OrgState.ToCallerContext());
        organization!.LogoSmall = smallDataUri;
        OrgState.NotifyOrganizationsChanged();
    }

    private async Task RemoveLogo()
    {
        logoError = null;
        await UserService.UpdateOrganizationLogoAsync(OrganizationId, null, OrgState.ToCallerContext());
        organization!.LogoSmall = null;
        OrgState.NotifyOrganizationsChanged();
    }

    private static string RoleBadgeClass(UserRole role) => role switch
    {
        UserRole.SuperAdmin => "bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-300",
        UserRole.Admin => "bg-sky-100 dark:bg-sky-900 text-sky-700 dark:text-sky-300",
        UserRole.User => "bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300",
        _ => ""
    };
}
