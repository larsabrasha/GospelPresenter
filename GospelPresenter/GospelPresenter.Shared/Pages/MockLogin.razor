@page "/mock-login"

@using GospelPresenter.Shared.Components
@using GospelPresenter.Shared.Components.Symbols

<div class="animated-bg min-h-dvh w-full flex flex-col items-center justify-center -mt-14">
    <div class="blob-3"></div>
    <div class="relative z-10 flex flex-col items-center gap-6">
        <LogoSymbol Class="size-20 text-sky-500"/>
        <div class="text-2xl uppercase pb-4">
            <span class="text-sky-500 font-semibold">Gospel</span> <span class="text-sky-400">Presenter</span>
        </div>
        <p class="text-slate-500 dark:text-slate-400 text-sm pb-2">Mock mode — choose an organization</p>
        <div class="flex flex-col gap-3 w-64">
            <a href="/mock-signin/mock-user-sv"
               class="flex items-center justify-between gap-3 bg-white dark:bg-neutral-800 border border-slate-200 dark:border-neutral-700 rounded-xl px-5 py-4 hover:border-sky-400 dark:hover:border-sky-500 transition-colors">
                <div>
                    <div class="font-medium text-neutral-800 dark:text-neutral-100">Foo Bar Kyrka</div>
                    <div class="text-sm text-slate-500 dark:text-slate-400">Svenska</div>
                </div>
                <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </a>
            <a href="/mock-signin/mock-user-en"
               class="flex items-center justify-between gap-3 bg-white dark:bg-neutral-800 border border-slate-200 dark:border-neutral-700 rounded-xl px-5 py-4 hover:border-sky-400 dark:hover:border-sky-500 transition-colors">
                <div>
                    <div class="font-medium text-neutral-800 dark:text-neutral-100">Foo Bar Church</div>
                    <div class="text-sm text-slate-500 dark:text-slate-400">English</div>
                </div>
                <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </a>
        </div>
    </div>
</div>
