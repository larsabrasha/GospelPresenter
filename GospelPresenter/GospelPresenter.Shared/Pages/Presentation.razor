    private async Task AddImagesToExistingItem(List<OrganizationImage> images)
    {
        if (images.Count == 0 || Editor.SelectedImage is null) return;

        var imageItem = Editor.LoadedPresentation?.Items.FirstOrDefault(x => x.Id == Editor.SelectedImage.Id);
        if (imageItem is null) return;

        var maxSortOrder = imageItem.Parts.Count > 0
            ? imageItem.Parts.Max(p => p.SortOrder)
            : -1;

        var newParts = images.Select((img, i) => new PresentationItemPart
        {
            Id = Guid.NewGuid().ToString(),
            Content = img.Id,
            SortOrder = maxSortOrder + 1 + i,
            PresentationItemId = imageItem.Id
        }).ToList();

        imageItem.Parts.AddRange(newParts);

        // Rebuild the selected image with new URLs
        var urls = Editor.SelectedImage.Urls.ToList();
        var partIds = Editor.SelectedImage.PartIds.ToList();
        foreach (var img in images)
        {
            urls.Add(ImageUrlHelper.OrgImageUrl(img.Id, "full"));
            partIds.Add(newParts[images.IndexOf(img)].Id);
        }
        Editor.SelectedImage = new Image(Editor.SelectedImage.Id, urls, partIds);

        // Persist to database
        if (EffectiveId is not null)
        {
            var orgId = OrgState.ActiveOrganizationId;
            if (orgId is not null)
                await PresentationService.AddItemPartsAsync(orgId, EffectiveId, imageItem.Id, newParts, OrgState.ToCallerContext());
        }

        NotifyPresentationChanged();
    }



    /// <summary>
    /// Persists a rename the header collected. The header owns the text field and the cursor; where
    /// the new name has to be written is the page's business, because it is the page that loaded the
    /// presentation and knows the organisation.
    /// </summary>
    private async Task RenameSelectedItemAsync(string title)
    {
        var item = AppState.SelectedProjectItem;

        if (item is null || string.IsNullOrWhiteSpace(title) || title == item.Title)
            return;

        item.Title = title;

        // Update in-memory presentation model
        var presentationItem = Editor.LoadedPresentation?.Items.FirstOrDefault(x => x.Id == item.Id);
        if (presentationItem is not null)
            presentationItem.Title = title;

        // Persist to database
        if (EffectiveId is not null)
        {
            var orgId = OrgState.ActiveOrganizationId;
            if (orgId is not null)
                await PresentationService.RenameItemAsync(orgId, EffectiveId, item.Id, title, OrgState.ToCallerContext());
        }

        NotifyPresentationChanged();
        AppState.NotifyProjectChanged();
    }

