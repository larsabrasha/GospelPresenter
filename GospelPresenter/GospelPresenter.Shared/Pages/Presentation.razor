    private async Task AddBibleVerses(List<Verse> verses)
    {
        var bibleText = BibleTextService.Create(verses);
        var itemId = Guid.NewGuid().ToString();
        var projectItem = new ProjectItem
        {
            Id = itemId,
            Type = ProjectItemType.BibleText,
            Title = bibleText.Title
        };

        var presentationItem = new PresentationItem
        {
            Id = itemId,
            Type = PresentationItemType.BibleText,
            Title = bibleText.Title
        };

        foreach (var (part, index) in bibleText.Parts.Select((p, i) => (p, i)))
        {
            presentationItem.Parts.Add(new PresentationItemPart
            {
                Content = part,
                SortOrder = index
            });
        }

        InsertAfterSelected(loadedPresentation?.Items, presentationItem);
        var inserted = InsertAfterSelected(AppState.SelectedProject?.Items, projectItem);
        AppState.SelectedProjectItem = projectItem;

        if (EffectiveId is not null)
        {
            var orgId = OrgState.ActiveOrganizationId;
            if (orgId is not null)
            {
                await PresentationService.AddItemAsync(orgId, EffectiveId, presentationItem, OrgState.ToCallerContext());
                if (inserted) await ReorderAfterInsert(orgId);
            }
        }

        NotifyPresentationChanged();
        ToastService.Show(L["Toast.BibleTextAdded", bibleText.Title]);
    }

