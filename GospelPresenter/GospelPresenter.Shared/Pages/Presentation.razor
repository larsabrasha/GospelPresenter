    private async Task AddImages(List<OrganizationImage> images)
    {
        if (images.Count == 0) return;

        var itemId = Guid.NewGuid().ToString();
        var title = images.Count == 1
            ? images[0].FileName
            : $"{images.Count} {L["ImageTab.Images"]}";

        var parts = images.Select((img, i) => new PresentationItemPart
        {
            Id = Guid.NewGuid().ToString(),
            Content = img.Id,
            SortOrder = i,
            PresentationItemId = itemId
        }).ToList();

        var projectItem = new ProjectItem
        {
            Id = itemId,
            SourceId = images[0].Id,
            Type = ProjectItemType.Image,
            Title = title
        };

        var presentationItem = new PresentationItem
        {
            Id = itemId,
            SourceId = images[0].Id,
            Type = PresentationItemType.Image,
            Title = title,
            ImageData = images[0].FullData,
            Parts = parts
        };

        loadedPresentation?.Items.Add(presentationItem);
        AppState.SelectedProject?.Items.Add(projectItem);
        AppState.SelectedProjectItem = projectItem;

        if (PresentationId is not null)
        {
            var orgId = OrgState.ActiveOrganizationId;
            if (orgId is not null)
                await PresentationService.AddItemAsync(orgId, PresentationId, presentationItem, OrgState.ToCallerContext());
        }
    }

