@page "/presentations/{presentationId}"
@attribute [Authorize]

@using System.ComponentModel
@using GospelPresenter.Shared.Components
@using GospelPresenter.Shared.Components.Presentations
@using GospelPresenter.Shared.Components.Presentations.AddItem
@using GospelPresenter.Shared.Components.Presentations.AddItem.Image
@using GospelPresenter.Shared.Components.Symbols
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State

@inject AppState AppState
@inject SharedAppState SharedAppState
@inject ISongService SongService
@inject IBibleTextService BibleTextService
@inject IPresentationService PresentationService
@inject IOrganizationImageService OrganizationImageService
@inject IJSRuntime JsRuntime

@implements IDisposable
@inject IStatusBarService StatusBarService
@inject NavigationManager NavigationManager
@inject ActiveOrganizationState OrgState

@{
    var statusBarHeight = StatusBarService.GetStatusBarHeight();
    var statusBarStyle = $"padding-top: {statusBarHeight}px";
    var liveSlide = SharedAppState.GetLiveSlide(AppState.SessionId);
}
<div class="flex h-full relative dark:text-neutral-200 dark:bg-neutral-800" style="@statusBarStyle">
    @{
        var menuBackdropVisibilityClass = AppState.IsMenuVisible ? "visible opacity-100" : "invisible opacity-0";
        var menuVisibilityClass = AppState.IsMenuVisible ? "visible translate-x-0" : "invisible -translate-x-full";
    }
    <div
        class="bg-black/30 z-100 absolute top-0 bottom-0 left-0 right-0 transition-opacity lg:invisible @menuBackdropVisibilityClass"
        @onclick="() => AppState.IsMenuVisible = false">
    </div>
    <div
        class="w-[var(--navmenu-width)] duration-200 ease-in-out shrink-0 overflow-auto h-full bg-white dark:bg-neutral-800 absolute top-0 bottom-0 left-0 z-110 shadow-xl lg:relative lg:top-auto lg:bottom-auto lg:left-auto lg:z-0 lg:shadow-none lg:visible lg:translate-x-0 @menuVisibilityClass">
        <Sidebar OnAddRequested="@OpenAddModal"
                 OnRemoveRequested="@ConfirmRemoveItem"
                 OnItemsReordered="@HandleItemsReordered"
                 OnDeleteRequested="@ConfirmDeletePresentation"/>

    </div>

    <div class="bg-neutral-100 dark:bg-neutral-900 grow relative">
        <div class="flex flex-col h-full">
            <div class="flex flex-col grow overflow-hidden h-full relative">
                <div
                    class="flex justify-between absolute top-0 left-0 right-0 bg-linear-to-b from-neutral-100 dark:from-neutral-900 to-transparent z-10 pointer-events-auto lg:pointer-events-none h-16">
                    <div class="px-5 py-3 pointer-events-auto flex items-center gap-3">
                        @if (isEditingItemTitle)
                        {
                            <input @ref="itemTitleInput"
                                   type="text"
                                   class="text-xl font-semibold px-2 py-1 -mx-2 rounded-lg border border-sky-500 dark:bg-neutral-700 focus:outline-none focus:ring-2 focus:ring-sky-500"
                                   @bind="editItemTitle"
                                   @bind:event="oninput"
                                   @onblur="SaveItemTitleAsync"
                                   @onkeydown="OnItemTitleKeyDown"/>
                        }
                        else
                        {
                            <button class="text-xl font-semibold cursor-pointer hover:text-sky-500 text-left truncate"
                                    @onclick="StartEditingItemTitle"
                                    title="@L["Sidebar.ClickToRename"]">
                                @AppState.SelectedProjectItem?.Title
                            </button>
                        }
                        @if (SelectedImage is not null)
                        {
                            <button class="flex items-center gap-1 px-2 py-1 rounded-full text-xs cursor-pointer
                                           @(isEditingImageOrder
                                               ? "bg-sky-500 text-white hover:bg-sky-600"
                                               : "text-neutral-400 dark:text-neutral-500 hover:text-neutral-600 dark:hover:text-neutral-300")"
                                    @onclick="ToggleImageEditMode"
                                    title="@(isEditingImageOrder ? L["Presentation.DoneEditingImages"] : L["Presentation.EditImageOrder"])">
                                @if (isEditingImageOrder)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
                                    </svg>
                                    @L["Presentation.DoneEditingImages"]
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125"/>
                                    </svg>
                                    @L["Presentation.EditImageOrder"]
                                }
                            </button>
                        }
                    </div>

                    <div id="live-view-container" class="p-3 pointer-events-auto flex items-center gap-2">
                        @if (SharedAppState.IsPresentationActive(AppState.SessionId))
                        {
                            <div class="flex items-center gap-2 text-sm font-medium text-red-500 dark:text-red-400">
                                <span class="size-2 rounded-full bg-red-500 animate-pulse"></span>
                                Live
                            </div>
                            <a href="/live?session=@AppState.SessionId" target="_blank"
                               class="px-4 py-2.5 rounded-full flex items-center gap-2 shadow-lg cursor-pointer bg-red-500 text-white hover:bg-red-600"
                               title="@L["Presentation.StopPresentation"]">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                                    <path fill-rule="evenodd" d="M4.5 7.5a3 3 0 0 1 3-3h9a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3h-9a3 3 0 0 1-3-3v-9Z" clip-rule="evenodd"/>
                                </svg>
                                <span class="text-sm font-medium">@L["Presentation.StopPresentation"]</span>
                            </a>
                        }
                        else
                        {
                            <a href="/live?session=@AppState.SessionId" target="_blank"
                               class="px-4 py-2.5 rounded-full flex items-center gap-2 shadow-lg cursor-pointer bg-emerald-500 text-white hover:bg-emerald-600"
                               title="@L["Presentation.StartPresentation"]">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                                    <path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd"/>
                                </svg>
                                <span class="text-sm font-medium">@L["Presentation.StartPresentation"]</span>
                            </a>
                        }
                    </div>
                </div>

                @{
                    var slideScale = AppState.MainViewport is null
                        ? 0.0
                        : AppState.MainViewport.Width < 768
                            ? AppState.MainViewport.Width / (double)AppState.BaseSlideWidth * 0.9 ?? 0.15
                            : AppState.MainViewport.Width <= 1024
                                ? AppState.MainViewport.Width / (double)AppState.BaseSlideWidth / 3 * 0.98 ?? 0.15
                                : 0.2;

                    var miscSlideScale = AppState.MainViewport is null
                        ? 0.0
                        : AppState.MainViewport.Width < 1024
                            ? 0.1
                            : 0.14;
                }

                @{
                    var hasSlides = SelectedSong is not null || SelectedBibleText is not null || SelectedImage is not null;
                    var mainClass = hasSlides
                        ? "mx-auto sm:mx-0 grid grid-cols-1 sm:flex sm:flex-wrap gap-3 p-3 overflow-auto pt-16 pb-36"
                        : "flex items-center justify-center h-full overflow-auto";
                }
                <div class="@mainClass" id="main">
                    @if (SelectedSong is not null)
                    {
                        @for (var i = 0; i < SelectedSong.Parts.Count; i++)
                        {
                            var partIndex = i;
                            <button @onclick="() => SetSelectedLiveSlide(AppState.SelectedProjectItem!.Id, partIndex)">
                                <SongSlide
                                    Content="@SelectedSong.Parts[i].Content"
                                    Label="@SelectedSong.Parts[i].Label"
                                    LabelColor="@SelectedSong.Parts[i].LabelColor"
                                    Credits="@SongCredits"
                                    IsSelected="@(liveSlide.ProjectItemId == AppState.SelectedProjectItem!.Id && liveSlide.ItemPartIndex == i)"
                                    BaseWidth="@AppState.BaseSlideWidth"
                                    BaseHeight="@AppState.BaseSlideHeight"
                                    Scale="@slideScale"/>
                            </button>
                        }
                    }
                    else if (SelectedBibleText is not null)
                    {
                        @for (var i = 0; i < SelectedBibleText.Parts.Count; i++)
                        {
                            var partIndex = i;
                            <button @onclick="() => SetSelectedLiveSlide(SelectedBibleText.Id, partIndex)">
                                <BibleTextSlide
                                    Content="@SelectedBibleText.Parts[i]"
                                    Credits="@SelectedBibleText.Title"
                                    IsSelected="@(liveSlide.ProjectItemId == SelectedBibleText.Id && liveSlide.ItemPartIndex == i)"
                                    BaseWidth="@AppState.BaseSlideWidth"
                                    BaseHeight="@AppState.BaseSlideHeight"
                                    Scale="@slideScale"/>
                            </button>
                        }
                    }
                    else if (SelectedImage is not null)
                    {
                        <div id="image-slide-list" class="@(isEditingImageOrder ? "col-span-full grid grid-cols-1 sm:flex sm:flex-wrap gap-3" : "contents")">
                            @for (var i = 0; i < SelectedImage.Urls.Count; i++)
                            {
                                var partIndex = i;
                                <div @key="SelectedImage.PartIds.ElementAtOrDefault(i) ?? i.ToString()" data-id="@(SelectedImage.PartIds.ElementAtOrDefault(i) ?? i.ToString())" class="@(isEditingImageOrder ? "cursor-grab active:cursor-grabbing" : "")">
                                    @if (isEditingImageOrder)
                                    {
                                        <div class="relative drag-handle">
                                            <ImageSlide
                                                Url="@SelectedImage.Urls[i]"
                                                IsSelected="@(liveSlide.ProjectItemId == SelectedImage.Id && liveSlide.ItemPartIndex == i)"
                                                BaseWidth="@AppState.BaseSlideWidth"
                                                BaseHeight="@AppState.BaseSlideHeight"
                                                Scale="@slideScale"/>
                                            <button class="absolute top-1 right-1 bg-black/50 hover:bg-red-500 text-white rounded-full size-6 flex items-center justify-center cursor-pointer"
                                                    title="@L["Common.Delete"]"
                                                    @onclick="() => ConfirmRemoveImagePart(partIndex)"
                                                    @onclick:stopPropagation="true">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                                                </svg>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button @onclick="() => SetSelectedLiveSlide(SelectedImage.Id, partIndex)">
                                            <ImageSlide
                                                Url="@SelectedImage.Urls[i]"
                                                IsSelected="@(liveSlide.ProjectItemId == SelectedImage.Id && liveSlide.ItemPartIndex == i)"
                                                BaseWidth="@AppState.BaseSlideWidth"
                                                BaseHeight="@AppState.BaseSlideHeight"
                                                Scale="@slideScale"/>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        @if (isEditingImageOrder)
                        {
                            <button class="border-2 border-dashed border-neutral-300 dark:border-neutral-600 rounded-xl flex items-center justify-center cursor-pointer hover:border-sky-500 hover:text-sky-500 text-neutral-400 dark:text-neutral-500 transition-colors"
                                    style="width: @(AppState.BaseSlideWidth * slideScale)px; height: @(AppState.BaseSlideHeight * slideScale)px;"
                                    @onclick="OpenAddImagesToExisting"
                                    title="@L["Presentation.AddMoreImages"]">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                                </svg>
                            </button>
                        }
                    }
                    else if (AppState.SelectedProject is not null && AppState.SelectedProject.Items.Count == 0)
                    {
                        <div class="flex flex-col items-center text-center px-6 select-none">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 200 160" class="w-48 h-auto mb-6 text-neutral-300 dark:text-neutral-600">
                                <!-- Back slide -->
                                <rect x="50" y="10" width="120" height="80" rx="8" stroke="currentColor" stroke-width="2" fill="none" opacity="0.5"/>
                                <!-- Middle slide -->
                                <rect x="35" y="25" width="120" height="80" rx="8" stroke="currentColor" stroke-width="2" fill="none" opacity="0.7"/>
                                <!-- Front slide -->
                                <rect x="20" y="40" width="120" height="80" rx="8" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                                <!-- Lines on front slide -->
                                <line x1="40" y1="65" x2="120" y2="65" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.4"/>
                                <line x1="40" y1="78" x2="100" y2="78" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
                                <line x1="40" y1="91" x2="110" y2="91" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.2"/>
                                <!-- Plus circle -->
                                <circle cx="160" cy="130" r="20" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                                <line x1="160" y1="120" x2="160" y2="140" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                                <line x1="150" y1="130" x2="170" y2="130" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                            </svg>
                            <h2 class="text-lg font-semibold text-neutral-500 dark:text-neutral-400 mb-2">@L["Presentation.Empty"]</h2>
                            <p class="text-sm text-neutral-400 dark:text-neutral-500 max-w-xs leading-relaxed">
                                @((MarkupString)L["Presentation.EmptyHint"].Value)
                            </p>
                        </div>
                    }
                    else if (AppState.SelectedProject is not null && AppState.SelectedProject.Items.Count > 0)
                    {
                        var hint = idleHints[idleHintIndex];
                        <div class="flex flex-col items-center text-center select-none gap-3">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-8 text-neutral-300 dark:text-neutral-600">
                                @((MarkupString)hint.Icon)
                            </svg>
                            <div class="max-w-sm">
                                <p class="text-sm text-neutral-300 dark:text-neutral-600 italic">
                                    @hint.Text
                                </p>
                                @if (hint.Source is not null)
                                {
                                    <p class="text-xs text-neutral-300 dark:text-neutral-600 mt-1">
                                        – @hint.Source
                                    </p>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div
                    class="flex items-center absolute bottom-0 left-0 right-0 justify-between p-3 bg-linear-to-t from-neutral-100 dark:from-neutral-900 to-transparent z-10 pointer-events-none">
                    <div class="flex items-center lg:hidden pointer-events-auto">
                        <button class="cursor-pointer p-4 bg-white dark:bg-neutral-800 rounded-full shadow-2xl"
                                @onclick="() => AppState.IsMenuVisible = true">
                            <Bars3Symbol Class="size-8"/>
                        </button>
                    </div>

                    @if (SharedAppState.IsPresentationActive(AppState.SessionId))
                    {
                        var isBlackScreen = liveSlide.Status == LiveSlideStatus.ShowingBlackScreen;

                        <div class="pointer-events-auto ml-auto bg-white/90 dark:bg-neutral-800/90 backdrop-blur-sm rounded-2xl shadow-xl p-4 flex flex-col gap-3">
                            <div class="text-[10px] uppercase tracking-widest text-neutral-400 dark:text-neutral-500 font-semibold">Nu visas</div>
                            @{
                                var activeOverlay = SharedAppState.GetActiveOverlay(AppState.SessionId);
                            }
                            <LiveDisplay
                                LiveSlide="@liveSlide"
                                Overlay="@activeOverlay"
                                Scale="@miscSlideScale"
                                BaseWidth="@AppState.BaseSlideWidth"
                                BaseHeight="@AppState.BaseSlideHeight"
                                Class="rounded-lg"/>
                            <button @onclick="() => SharedAppState.ToggleBlackScreen(AppState.SessionId)"
                                    class="cursor-pointer flex items-center justify-between gap-3 px-3 py-2 rounded-lg bg-neutral-100 dark:bg-neutral-700/50 text-sm text-neutral-600 dark:text-neutral-300"
                                    title="@L["Presentation.ShowBlack"]">
                                <span>@L["Presentation.ShowBlack"]</span>
                                <div class="relative w-9 h-5 rounded-full transition-colors duration-200 shrink-0 @(isBlackScreen ? "bg-sky-500" : "bg-neutral-300 dark:bg-neutral-500")">
                                    <div class="absolute top-0.5 size-4 rounded-full bg-white shadow transition-all duration-200 @(isBlackScreen ? "left-4.5" : "left-0.5")"></div>
                                </div>
                            </button>

                            @if (overlaySlides.Count > 0)
                            {
                                <div class="text-[10px] uppercase tracking-widest text-neutral-400 dark:text-neutral-500 font-semibold mt-1">Overlays</div>
                                @foreach (var overlay in overlaySlides)
                                {
                                    var isActive = activeOverlayId == overlay.Id;
                                    <button @onclick="() => ToggleOverlay(overlay)"
                                            class="cursor-pointer flex items-center justify-between gap-3 px-3 py-2 rounded-lg text-sm text-neutral-600 dark:text-neutral-300 @(isActive ? "bg-sky-100 dark:bg-sky-900/30 ring-1 ring-sky-500" : "bg-neutral-100 dark:bg-neutral-700/50")"
                                            title="@overlay.Title">
                                        <span class="truncate">@overlay.Title</span>
                                        <div class="relative w-9 h-5 rounded-full transition-colors duration-200 shrink-0 @(isActive ? "bg-sky-500" : "bg-neutral-300 dark:bg-neutral-500")">
                                            <div class="absolute top-0.5 size-4 rounded-full bg-white shadow transition-all duration-200 @(isActive ? "left-4.5" : "left-0.5")"></div>
                                        </div>
                                    </button>
                                }
                            }

                            <button @onclick="() => showOverlayManager = true"
                                    class="cursor-pointer flex items-center gap-2 px-3 py-2 rounded-lg bg-neutral-100 dark:bg-neutral-700/50 text-sm text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-600"
                                    title="@L["Presentation.ManageOverlays"]">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                                </svg>
                                <span>@L["Presentation.ManageOverlays"]</span>
                            </button>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

@if (showSessionExpired)
{
    <div class="fixed inset-0 bg-black/40 z-200 flex items-center justify-center p-4">
        <div class="bg-white dark:bg-neutral-800 dark:text-neutral-100 rounded-2xl shadow-2xl p-6 w-full max-w-sm space-y-4">
            <div class="font-semibold text-lg">@L["Presentation.SessionExpired"]</div>
            <div>@L["Presentation.SessionExpiredDescription"]</div>
            <div class="flex justify-end">
                <button class="px-4 py-2.5 rounded-full bg-sky-500 text-white cursor-pointer hover:bg-sky-600"
                        @onclick="DismissSessionExpired">
                    @L["Common.OK"]
                </button>
            </div>
        </div>
    </div>
}

@if (showAddModal)
{
    <AddItemModal OnClose="@CloseAddModal"
                  OnSongAdded="@HandleSongAdded"
                  OnSongAddedKeepOpen="@HandleSongAddedKeepOpen"
                  OnBibleVersesAdded="@HandleBibleVersesAdded"
                  OnBibleVersesAddedKeepOpen="@HandleBibleVersesAddedKeepOpen"
                  OnImagesAdded="@HandleImagesAdded"
                  OnImagesAddedKeepOpen="@HandleImagesAddedKeepOpen"/>
}

@if (showAddImagesToExisting)
{
    <Modal Class="bg-white dark:bg-neutral-800 max-w-4xl" OnClose="@CloseAddImagesToExisting">
        <Title><span>@L["Presentation.AddMoreImages"]</span></Title>
        <Body>
            <ImageTab OnAdd="@HandleImagesAddedToExisting" OnAddKeepOpen="@HandleImagesAddedToExistingKeepOpen"/>
        </Body>
    </Modal>
}

@if (imagePartToRemoveIndex is not null)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-sm" OnClose="() => imagePartToRemoveIndex = null">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["Common.Delete"]</div>
            <div>@L["Presentation.ConfirmRemoveImage"]</div>
            <div class="flex justify-end gap-3">
                <button class="px-4 py-2.5 rounded-full cursor-pointer hover:bg-neutral-100 dark:hover:bg-neutral-700"
                        @onclick="() => imagePartToRemoveIndex = null">
                    @L["Common.Cancel"]
                </button>
                <button class="px-4 py-2.5 rounded-full bg-red-500 text-white cursor-pointer hover:bg-red-600"
                        @onclick="ConfirmAndRemoveImagePart">
                    @L["Common.Delete"]
                </button>
            </div>
        </div>
    </Dialog>
}

@if (itemToRemove is not null)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-sm" OnClose="CancelRemove">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["Common.Delete"]</div>
            <div>@((MarkupString)L["Presentation.ConfirmRemoveItem", itemToRemove.Title].Value)</div>
            <div class="flex justify-end gap-3">
                <button class="px-4 py-2.5 rounded-full cursor-pointer hover:bg-neutral-100 dark:hover:bg-neutral-700"
                        @onclick="CancelRemove">
                    @L["Common.Cancel"]
                </button>
                <button class="px-4 py-2.5 rounded-full bg-red-500 text-white cursor-pointer hover:bg-red-600"
                        @onclick="RemoveItemAsync">
                    @L["Common.Delete"]
                </button>
            </div>
        </div>
    </Dialog>
}

@if (showOverlayManager)
{
    <Modal Class="bg-white dark:bg-neutral-800 max-w-lg" OnClose="@CloseOverlayManager">
        <Title><span>@L["Presentation.ManageOverlays"]</span></Title>
        <Body>
            <OverlayManager OrganizationId="@loadedPresentation?.OrganizationId" OnOverlaysChanged="@ReloadOverlays"/>
        </Body>
    </Modal>
}

@if (showDeleteConfirmation)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-sm" OnClose="CancelDeletePresentation">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["Presentation.DeletePresentation"]</div>
            <div>@((MarkupString)L["Presentation.ConfirmDeletePresentation", AppState.SelectedProject?.Name ?? ""].Value)</div>
            <div class="flex justify-end gap-3">
                <button class="px-4 py-2.5 rounded-full cursor-pointer hover:bg-neutral-100 dark:hover:bg-neutral-700"
                        @onclick="CancelDeletePresentation">
                    @L["Common.Cancel"]
                </button>
                <button class="px-4 py-2.5 rounded-full bg-red-500 text-white cursor-pointer hover:bg-red-600"
                        @onclick="DeletePresentationAsync">
                    @L["Common.Remove"]
                </button>
            </div>
        </div>
    </Dialog>
}

