@page "/presentations/{presentationId}"
@using GospelPresenter.Shared.Live
@using GospelPresenter.Shared.Localization
@page "/templates/{templateId}"
@attribute [Authorize]

@using System.ComponentModel
@using GospelPresenter.Shared.Components
@using GospelPresenter.Shared.Components.Presentations
@using GospelPresenter.Shared.Components.Presentations.AddItem
@using GospelPresenter.Shared.Components.Presentations.AddItem.Image
@using GospelPresenter.Shared.Components.Symbols
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using Microsoft.Extensions.Logging

@inject ILogger<Presentation> Logger
@inject AppState AppState
@inject SharedAppState SharedAppState
@inject ISongService SongService
@inject ILiveSlideBuilder SlideBuilder
@inject IBibleTextService BibleTextService
@inject IPresentationService PresentationService
@inject IJSRuntime JsRuntime

@implements IDisposable
@inject IStatusBarService StatusBarService
@inject NavigationManager NavigationManager
@inject ToastService ToastService
@inject ActiveOrganizationState OrgState
@inject IThemeService ThemeService
@inject IRemoteDisplayService RemoteDisplayService
@inject IServiceProvider Services
@inject CircuitCulture Culture
@inject PresentationEditorState Editor
@inject KeyboardShortcutService Shortcuts

@{
    var statusBarHeight = StatusBarService.GetStatusBarHeight();
    var statusBarStyle = $"padding-top: {statusBarHeight}px";
    var liveSlide = SharedAppState.GetLiveSlide(EffectiveSessionId);
    var isLiveShowing = SharedAppState.IsPresentationActive(EffectiveSessionId) && liveSlide.Status != LiveSlideStatus.ShowingBlackScreen;
}

<RefreshOnSync Reload="ReloadAfterSyncAsync"/>

@if (IsStageReady && AppState.SelectedProject is not null)
{
    <StageView
        SessionId="@EffectiveSessionId"
        BaseWidth="@AppState.BaseSlideWidth"
        BaseHeight="@AppState.BaseSlideHeight"
        Items="@AppState.SelectedProject.Items"
        SelectedItem="@AppState.SelectedProjectItem"
        SelectedSong="@Editor.SelectedSong"
        SongParts="@Editor.EffectiveSongParts(AppState.SelectedProjectItem?.Id)"
        SelectedBibleText="@Editor.SelectedBibleText"
        SelectedImage="@Editor.SelectedImage"
        SelectedAudio="@Editor.SelectedAudio"
        SelectedSlides="@Editor.SelectedSlides"
        Theme="@Editor.Theme"
        OverlaySlides="@Editor.OverlaySlides"
        ActiveOverlayId="@activeOverlayId"
        OnSelectSlide="HandleStageSelectSlide"
        OnSelectItem="HandleStageSelectItem"
        OnToggleOverlay="ToggleOverlay"
        OnClearScreen="() => SharedAppState.ToggleBlackScreen(EffectiveSessionId)"
        OnExit="ExitStageMode"/>
}

<div class="flex flex-col h-full relative dark:text-neutral-200 dark:bg-neutral-800" style="@statusBarStyle">
    @if (IsTemplateMode)
    {
        <div class="bg-sky-500 text-white text-center py-1.5 text-sm font-medium shrink-0">
            @L["Templates.EditingBanner"]
        </div>
    }
    @if (IsRemoteMode)
    {
        <div class="bg-amber-500 text-white text-center py-1.5 text-sm font-medium shrink-0">
            @L["RemoteControl.Banner"]
        </div>
    }
    @if (!SharedAppState.IsPresentationActive(AppState.SessionId))
    {
        var nonLiveAudio = SharedAppState.GetSessionAudio(AppState.SessionId);
        @if (nonLiveAudio is not null)
        {
            <div id="persistent-audio-container" class="hidden">
                @foreach (var part in nonLiveAudio.Parts)
                {
                    <AudioPlayerEngine AudioElementId="@($"session-audio-{part.PartId}")" Url="@part.Url" ContainerId="persistent-audio-container" Muted="@IsRemoteMode"/>
                }
            </div>
        }
    }
    <div class="flex flex-1 min-h-0 relative">
    @{
        // When stage mode is active the StageView covers everything as a fixed overlay,
        // but the sidebar/backdrop sit at higher z-indexes than the stage view to support
        // the regular mobile menu. Force them hidden in stage mode so they can't leak
        // through when the viewport shrinks below the lg breakpoint.
        var menuOpen = AppState.IsMenuVisible && !IsStageReady;
        var menuBackdropVisibilityClass = menuOpen ? "visible opacity-100" : "invisible opacity-0";
        var menuVisibilityClass = menuOpen ? "visible translate-x-0" : "invisible -translate-x-full";
        var sidebarLgVisibilityClass = IsStageReady ? "" : "lg:visible lg:translate-x-0";
    }
    <div
        class="bg-black/30 z-100 absolute top-0 bottom-0 left-0 right-0 transition-opacity lg:invisible @menuBackdropVisibilityClass"
        @onclick="() => AppState.IsMenuVisible = false">
    </div>
    <div
        class="w-[var(--navmenu-width)] duration-200 ease-in-out shrink-0 overflow-auto h-full bg-white dark:bg-neutral-800 absolute top-0 bottom-0 left-0 z-110 shadow-xl lg:relative lg:top-auto lg:bottom-auto lg:left-auto lg:z-10 lg:shadow-xl @sidebarLgVisibilityClass @menuVisibilityClass">
        <Sidebar OnAddRequested="@OpenAddModal"
                 OnRemoveRequested="@ConfirmRemoveItem"
                 OnRemoveMultipleRequested="@ConfirmRemoveMultipleItems"
                 OnItemsReordered="@HandleItemsReordered"
                 OnDeleteRequested="@DeletePresentationAsync"
                 IsTemplateMode="@IsTemplateMode"
                 OnSaveAsTemplate="@ConfirmSaveAsTemplate"
                 OnScheduleChanged="@HandleScheduleChanged"
                 OnEventChanged="@HandleEventChanged"
                 LiveProjectItemId="@SidebarLiveProjectItemId"/>

    </div>

    <div class="bg-neutral-100 dark:bg-neutral-900 grow relative">
        <div class="flex flex-col lg:flex-row h-full">
            <div class="flex flex-col grow overflow-hidden h-full relative min-w-0">
                <PresentationHeader
                    @ref="header"
                    SessionId="@AppState.SessionId"
                    IsTemplateMode="@IsTemplateMode"
                    IsRemoteMode="@IsRemoteMode"
                    OnRenameItem="RenameSelectedItemAsync"
                    OnEditSong="ShowSongEditor"
                    OnStartPresentation="StartPresentation"/>

                @{
                    var desktopLiveScale = DesktopSidebarContentWidth / AppState.BaseSlideWidth;
                    var miscSlideScale = AppState.MainViewport is null
                        ? 0.0
                        : AppState.MainViewport.Width < 1024
                            ? 0.1
                            : 0.14;
                }

                @{
                    var remoteNotReady = IsRemoteMode && !IsRemoteReady;
                    var remoteNoSession = IsRemoteMode && _presenterSessionId is null;
                }
                @if (NeedsSessionChoice)
                {
                    <div class="flex items-center justify-center h-full px-6 pt-16">
                        <div class="w-full max-w-sm space-y-3">
                            <div class="text-sm text-neutral-500 dark:text-neutral-400">
                                @L["RemoteControl.ChooseSession"]
                            </div>
                            @for (var i = 0; i < _presenterCandidates.Count; i++)
                            {
                                var candidate = _presenterCandidates[i];
                                var label = SessionChoiceLabel(i, candidate);
                                <AppButton Variant="ButtonVariant.Primary" Filled="true" Class="w-full"
                                           OnClick="() => ControlSession(candidate)">
                                    @label
                                </AppButton>
                            }
                        </div>
                    </div>
                }
                else if (remoteNotReady)
                {
                    <div class="flex items-center justify-center h-full text-center px-6 pt-16">
                        <div class="space-y-2">
                            <div class="text-neutral-400 dark:text-neutral-500 text-sm">
                                @if (IsPresenterOffline)
                                {
                                    @L["RemoteControl.PresenterOffline"]
                                }
                                else if (remoteNoSession)
                                {
                                    @L["RemoteControl.NoActivePresentation"]
                                }
                                else
                                {
                                    @L["RemoteControl.NotEnabled"]
                                }
                            </div>
                            @* The only way left to end it. The machine that owns the session is not
                               listening, so nothing can ask it to stop — and left alone it stays on
                               the dashboard and on the congregation's screens until it ages out
                               hours later. See CanEndAbandonedSession. *@
                            @if (CanEndAbandonedSession)
                            {
                                <div class="space-y-2 pt-2">
                                    <div class="text-neutral-400 dark:text-neutral-500 text-xs">
                                        @L["RemoteControl.EndAbandonedHint"]
                                    </div>
                                    <AppButton Variant="ButtonVariant.Danger" Filled="true"
                                               Disabled="@changingPresentationState"
                                               OnClick="StopPresentation">
                                        @L["RemoteControl.EndAbandoned"]
                                    </AppButton>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (Editor.SelectedAudio is not null)
                {
                    <div id="audio-container" class="flex flex-col gap-3 w-full sm:max-w-lg sm:mx-auto px-3 pt-16 overflow-auto">
                        @foreach (var part in Editor.SelectedAudio.Parts)
                        {
                            var elementId = $"session-audio-{part.PartId}";
                            <AudioPlayer AudioElementId="@elementId" FileName="@part.FileName"/>
                        }
                    </div>
                }
                else
                {
                <SlideGrid
                    SessionId="@EffectiveSessionId"
                    PresentationId="@EffectiveId"
                    OnSelectSlide="HandleSelectSlide"
                    OnRemoveImagePart="ConfirmRemoveImagePart"
                    OnAddImages="OpenAddImagesToExisting"/>
                }

                <div class="absolute bottom-0 left-0 right-0 h-24 bg-linear-to-t from-neutral-100 dark:from-neutral-900 to-transparent lg:hidden z-20 pointer-events-none"></div>
                <div
                    class="flex items-end absolute bottom-0 left-0 right-0 justify-between p-3 z-30 pointer-events-none">
                    <div class="flex items-center lg:hidden pointer-events-auto">
                        <MenuToggleButton OnClick="() => AppState.IsMenuVisible = true"/>
                    </div>

                    @if (!IsTemplateMode && !IsRemoteMode && !SharedAppState.IsPresentationActive(AppState.SessionId))
                    {
                        <div class="lg:hidden pointer-events-auto">
                            <button @onclick="StartPresentation"
                                    class="px-4 py-2.5 rounded-full flex items-center gap-2 shadow-lg cursor-pointer bg-emerald-500 text-white hover:bg-emerald-600"
                                    title="@L["Presentation.StartPresentation"]">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                                    <path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd"/>
                                </svg>
                                <span class="text-sm font-medium">@L["Presentation.StartPresentation"]</span>
                            </button>
                        </div>
                    }

                    @if (!IsTemplateMode && IsRemoteReady && SharedAppState.IsPresentationActive(EffectiveSessionId))
                    {
                        var activeOverlay = SharedAppState.GetActiveOverlay(EffectiveSessionId);

                        <div class="pointer-events-auto ml-auto lg:hidden bg-white/90 dark:bg-neutral-800/90 backdrop-blur-sm rounded-2xl shadow-xl p-4 flex flex-col gap-3 max-h-[calc(100dvh-7rem)] overflow-hidden">
                            <LivePanel
                                LiveSlide="@liveSlide"
                                ActiveOverlay="@activeOverlay"
                                Scale="@miscSlideScale"
                                BaseWidth="@AppState.BaseSlideWidth"
                                BaseHeight="@AppState.BaseSlideHeight"
                                OverlaySlides="@Editor.OverlaySlides"
                                ActiveOverlayId="@activeOverlayId"
                                SessionId="@EffectiveSessionId"
                                IsRemoteController="@IsRemoteMode"
                                SavedDisplays="@Editor.SavedDisplays"
                                Collapsible
                                OnClearSlide="() => SharedAppState.ToggleBlackScreen(EffectiveSessionId)"
                                OnToggleOverlay="ToggleOverlay"
                                CanStop="@CanStopPresentation"
                                OnStopPresentation="StopPresentation"
                                OnEnterStageMode="EnterStageMode"/>
                        </div>
                    }
                </div>

            </div>

            @if (!IsTemplateMode && IsRemoteReady && SharedAppState.IsPresentationActive(EffectiveSessionId))
            {
                var activeOverlayDesktop = SharedAppState.GetActiveOverlay(EffectiveSessionId);

                <div class="hidden lg:flex flex-col shrink-0 w-72 h-full bg-white dark:bg-neutral-800 overflow-auto shadow-xl">
                    <div class="p-4 flex flex-col gap-3 h-full">
                        <LivePanel
                            LiveSlide="@liveSlide"
                            ActiveOverlay="@activeOverlayDesktop"
                            Scale="@desktopLiveScale"
                            BaseWidth="@AppState.BaseSlideWidth"
                            BaseHeight="@AppState.BaseSlideHeight"
                            OverlaySlides="@Editor.OverlaySlides"
                            ActiveOverlayId="@activeOverlayId"
                            SessionId="@EffectiveSessionId"
                            IsRemoteController="@IsRemoteMode"
                            SavedDisplays="@Editor.SavedDisplays"
                            ShowGrow
                            OnClearSlide="() => SharedAppState.ToggleBlackScreen(EffectiveSessionId)"
                            OnToggleOverlay="ToggleOverlay"
                            CanStop="@CanStopPresentation"
                            OnStopPresentation="StopPresentation"
                            OnEnterStageMode="EnterStageMode"/>
                    </div>
                </div>
            }
        </div>
    </div>
    </div>
</div>

@if (showSessionExpired)
{
    <div class="fixed inset-0 bg-black/40 z-200 flex items-center justify-center p-4">
        <div class="bg-white dark:bg-neutral-800 dark:text-neutral-100 rounded-2xl shadow-2xl p-6 w-full max-w-sm space-y-4">
            <div class="font-semibold text-lg">@L["Presentation.SessionExpired"]</div>
            <div>@L["Presentation.SessionExpiredDescription"]</div>
            <div class="flex justify-end">
                <AppButton Variant="ButtonVariant.Primary" OnClick="DismissSessionExpired">
                    @L["Common.OK"]
                </AppButton>
            </div>
        </div>
    </div>
}

@if (showSongEditor && AppState.SelectedProjectItem?.SourceId is not null)
{
    <Modal Class="bg-white dark:bg-neutral-900 max-w-4xl" OnClose="@CloseSongEditor">
        <Title>
            <span>@L["Presentation.EditSong"]</span>
            <AutoSaveIndicator @ref="songEditorSaveIndicator" Class="absolute right-12 top-5"/>
        </Title>
        <Body>
            <div class="overflow-y-auto flex-1 -mx-4 px-4">
                <SongEditor SongId="@AppState.SelectedProjectItem.SourceId" OnDeleted="@HandleSongDeletedFromEditor" OnSaved="OnSongEditorSaved"/>
            </div>
        </Body>
    </Modal>
}

@if (showAddModal)
{
    <AddItemModal OnClose="@CloseAddModal"
                  PresentationId="@EffectiveId"
                  Theme="@Editor.Theme"
                  OnSongAdded="@HandleSongAdded"
                  OnSongAddedKeepOpen="@HandleSongAddedKeepOpen"
                  OnBibleVersesAdded="@HandleBibleVersesAdded"
                  OnBibleVersesAddedKeepOpen="@HandleBibleVersesAddedKeepOpen"
                  OnImagesAdded="@HandleImagesAdded"
                  OnImagesAddedKeepOpen="@HandleImagesAddedKeepOpen"
                  OnAudiosAdded="@HandleAudiosAdded"
                  OnAudiosAddedKeepOpen="@HandleAudiosAddedKeepOpen"
                  OnSlidesAdded="@HandleSlidesAdded"/>
}

@if (showAddImagesToExisting)
{
    <Modal Class="bg-white dark:bg-neutral-800 max-w-4xl" OnClose="@CloseAddImagesToExisting">
        <Title><span>@L["Presentation.AddMoreImages"]</span></Title>
        <Body>
            <ImageTab OnAdd="@HandleImagesAddedToExisting" OnAddKeepOpen="@HandleImagesAddedToExistingKeepOpen"/>
        </Body>
    </Modal>
}

@if (imagePartToRemoveIndex is not null)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-sm" OnClose="() => imagePartToRemoveIndex = null">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["Common.Delete"]</div>
            <div>@L["Presentation.ConfirmRemoveImage"]</div>
            <div class="flex justify-end gap-3">
                <AppButton Variant="ButtonVariant.Cancel" OnClick="() => imagePartToRemoveIndex = null">
                    @L["Common.Cancel"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Danger" Filled OnClick="ConfirmAndRemoveImagePart">
                    @L["Common.Delete"]
                </AppButton>
            </div>
        </div>
    </Dialog>
}

@if (itemToRemove is not null)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-sm" OnClose="CancelRemove">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["Common.Delete"]</div>
            <div><LocalizedEmphasis Key="Presentation.ConfirmRemoveItem" Value="@itemToRemove.Title"/></div>
            <div class="flex justify-end gap-3">
                <AppButton Variant="ButtonVariant.Cancel" OnClick="CancelRemove">
                    @L["Common.Cancel"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Danger" Filled OnClick="RemoveItemAsync">
                    @L["Common.Delete"]
                </AppButton>
            </div>
        </div>
    </Dialog>
}

@if (itemsToRemove is not null)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-sm" OnClose="CancelRemoveMultiple">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@L["Common.Delete"]</div>
            <div>
                @if (itemsToRemove.Count == 1)
                {
                    @L["Presentation.ConfirmRemoveItemSingle"]
                }
                else
                {
                    @L["Presentation.ConfirmRemoveItems", itemsToRemove.Count]
                }
            </div>
            <div class="flex justify-end gap-3">
                <AppButton Variant="ButtonVariant.Cancel" Disabled="isRemovingMultiple" OnClick="CancelRemoveMultiple">
                    @L["Common.Cancel"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Danger" Filled Disabled="isRemovingMultiple" Loading="isRemovingMultiple" OnClick="RemoveMultipleItemsAsync">
                    @L["Common.Delete"]
                </AppButton>
            </div>
        </div>
    </Dialog>
}


@if (showSaveAsTemplateDialog)
{
    <NameDialog Title="@L["Sidebar.SaveAsTemplate"]"
                Name="@(AppState.SelectedProject?.Name ?? "")"
                SaveText="@L["Common.Save"]"
                SaveLoadingText="@L["Common.Saving"]"
                OnSave="SaveAsTemplateAsync"
                OnClose="() => showSaveAsTemplateDialog = false"/>
}

@code {
    // w-72 (288px) minus p-4 (32px) padding
    private const double DesktopSidebarContentWidth = 256.0;

    [Parameter] public string? PresentationId { get; set; }
    [Parameter] public string? TemplateId { get; set; }

    [SupplyParameterFromQuery(Name = "remote")]
    public bool Remote { get; set; }

    [SupplyParameterFromQuery(Name = "stage")]
    public bool Stage { get; set; }

    /// <summary>
    /// Which live session to control, when the same presentation is running in more than one place.
    /// Absent means "the only one", and the picker appears when that turns out to be untrue.
    /// </summary>
    [SupplyParameterFromQuery(Name = "session")]
    public string? Session { get; set; }

    private bool IsTemplateMode => TemplateId is not null;
    private bool IsRemoteMode => Remote && !IsTemplateMode;
    private bool IsStageMode => Stage && !IsTemplateMode;
    private string? EffectiveId => TemplateId ?? PresentationId;

    private string? _presenterSessionId;
    private IReadOnlyList<string> _presenterCandidates = [];
    private ILiveSessionPresence? liveSessionPresence;
    private ILiveSessionEnder? liveSessionEnder;
    private bool endingAbandonedSession;

    /// <summary>
    /// The machine running this presentation has dropped off the network. What it last showed is
    /// still on the congregation's screens — deliberately, since a moment of bad wifi should not
    /// black out a service — but nothing can be moved on until it comes back.
    /// </summary>
    private bool IsPresenterOffline =>
        IsRemoteMode
        && _presenterSessionId is not null
        && liveSessionPresence?.IsOwnerOnline(_presenterSessionId) == false;

    private void OnOwnerPresenceChanged(string sessionId)
    {
        if (sessionId == _presenterSessionId)
            _ = InvokeAsync(Culture.Restore(StateHasChanged));
    }

    /// <summary>
    /// How long the owning device gets to echo a change back before the controller says so. Long
    /// enough that a round trip over a congested church wifi is not called a failure, short enough
    /// that somebody standing with a phone finds out before the next verse.
    /// </summary>
    private static readonly TimeSpan CommandConfirmationTimeout = TimeSpan.FromSeconds(2);

    private CancellationTokenSource? confirmationCts;
    private bool unconfirmedReported;

    /// <summary>
    /// Watches for a change this controller made that the device never acknowledged.
    ///
    /// A remote controller writes into the live state itself, so its own screen moves whether or not
    /// the projector does — that is deliberate, and it is the write the server forwards down. But it
    /// means the operator gets no signal at all when the device drops the command: it has stopped
    /// presenting, it does not have the item in its own library, it is a version behind. All three
    /// only wrote a log line on a machine nobody is looking at.
    ///
    /// Losing the connection is already covered by IsPresenterOffline, which replaces the whole
    /// control surface. This covers the rest: the device is there, it answered, and it still is not
    /// showing what was asked for.
    /// </summary>
    private void ExpectConfirmation()
    {
        if (!IsRemoteMode || _presenterSessionId is not { } session) return;
        if (liveSessionPresence?.IsMirrored(session) != true) return;

        var expected = MirroredSessionStateReader.Read(SharedAppState, session);
        if (expected is null) return;

        // The latest change is the only one worth waiting on: an operator moving quickly through a
        // song would otherwise leave a queue of stale checks behind, each judging a slide that has
        // already been replaced.
        confirmationCts?.Cancel();
        confirmationCts?.Dispose();
        var cts = new CancellationTokenSource();
        confirmationCts = cts;
        _ = ConfirmCommandAsync(session, expected, cts.Token);
    }

    private async Task ConfirmCommandAsync(string session, MirroredSessionState expected, CancellationToken token)
    {
        try
        {
            await Task.Delay(CommandConfirmationTimeout, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        // Nothing reported yet is not a refusal, it is silence before the first word. A device that
        // has only just connected has said nothing, and the first thing to happen on a session is
        // often the owner's own — switching remote control on. Judging that as a dropped command
        // put a warning on screen before anybody had asked for anything, which is what running this
        // against the real desktop showed. Only a report that disagrees is evidence.
        if (liveSessionPresence?.LastReported(session) is not { } reported) return;

        if (MirroredSessionStateReader.ShowsTheSame(reported, expected))
        {
            // Back in step. The next one that is not gets to say so again.
            unconfirmedReported = false;
            return;
        }

        // One toast, not one per tap: somebody pressing on through a device that is not listening
        // should get told once, not buried.
        if (unconfirmedReported) return;
        unconfirmedReported = true;

        await InvokeAsync(() => ToastService.Show(L["RemoteControl.CommandNotConfirmed"], ToastKind.Warning));
    }

    /// <summary>
    /// Picks the session this controller is driving. A session named in the URL wins, so a link
    /// keeps pointing at the same machine; failing that, a single candidate is taken without asking
    /// and several leave the choice open for the picker.
    /// </summary>
    private void ResolvePresenterSession()
    {
        var orgId = OrgState.ActiveOrganizationId;
        _presenterCandidates = orgId is not null && PresentationId is not null
            ? SharedAppState.GetActiveSessionIdsForPresentation(orgId, PresentationId)
            : [];

        _presenterSessionId = Session is not null && _presenterCandidates.Contains(Session)
            ? Session
            : _presenterCandidates.Count == 1
                ? _presenterCandidates[0]
                : null;
    }

    /// <summary>Carries the chosen session through navigation, so a picked machine stays picked.</summary>
    private string RemoteSessionQuery => _presenterSessionId is null ? "" : $"&session={_presenterSessionId}";

    /// <summary>Several places are presenting this and the controller has not said which it means.</summary>
    private bool NeedsSessionChoice =>
        IsRemoteMode && _presenterSessionId is null && _presenterCandidates.Count > 1;

    private void ControlSession(string sessionId) =>
        NavigationManager.NavigateTo($"/presentations/{PresentationId}?remote=true&session={sessionId}");

    /// <summary>
    /// What to call a session in the picker. The choice only matters when the same presentation is
    /// live in two places at once, and that is exactly when a number tells the operator nothing: the
    /// question they are answering is which machine, so the machine's own name is the answer.
    ///
    /// A browser session on this server has no device name, and a device token issued before the
    /// name existed has none either; both fall back to the numbering, which is stable in the order
    /// the state returns them in.
    /// </summary>
    private string SessionChoiceLabel(int index, string sessionId) =>
        liveSessionPresence?.OwnerName(sessionId) is { Length: > 0 } name
            ? name
            : L["RemoteControl.SessionChoice", index + 1];

    private string EffectiveSessionId =>
        IsRemoteMode && _presenterSessionId is not null ? _presenterSessionId : AppState.SessionId;
    private bool IsRemoteReady => !IsRemoteMode
        || (!IsPresenterOffline
            && _presenterSessionId is not null
            && SharedAppState.IsRemoteControlEnabled(_presenterSessionId));

    /// <summary>
    /// Whether this page may end the presentation it is looking at. Its own, always; a session it
    /// is only controlling, only when that session runs in a browser on this server.
    ///
    /// A mirrored session is owned by a device, and deactivating it here changed nothing on the
    /// projector: the owner keeps mirroring, its next report activates the session again, and in
    /// between the dashboard and this page both said "stopped" about a service that was still
    /// running. The protocol carries no stop, deliberately — see adr/0004, where losing the
    /// connection freezes and only the owner ends the session.
    /// </summary>
    private bool CanStopPresentation =>
        !IsRemoteMode
        || liveSessionPresence?.IsMirrored(EffectiveSessionId) != true
        || CanEndAbandonedSession;

    /// <summary>
    /// Whether this page may end a mirrored session outright, because there is no owner left to ask.
    ///
    /// The rule above holds while the device is listening: it keeps mirroring, its next report
    /// activates the session again, and "stopped" would be a lie. An owner that has dropped off
    /// sends no next report, so there is nothing left to contradict — and without this nothing
    /// could end the session at all. It stayed on the dashboard and on the congregation's screens,
    /// frozen on its last slide, until the session aged out hours later.
    ///
    /// Deliberately still not a stop command down the wire: if the device comes back and is really
    /// still presenting, it reports itself and the session returns, which is the truth.
    /// </summary>
    private bool CanEndAbandonedSession =>
