    private void ToggleOverlay(OverlaySlide overlay)
    {
        if (activeOverlayId == overlay.Id)
        {
            activeOverlayId = null;
            SharedAppState.ClearOverlay(AppState.SessionId);
        }
        else
        {
            activeOverlayId = overlay.Id;
            string? imageUrl = null;
            if (overlay.ImageData is not null)
            {
                imageUrl = $"data:image/png;base64,{Convert.ToBase64String(overlay.ImageData)}";
            }
            SharedAppState.SetOverlay(AppState.SessionId, overlay.Content, imageUrl);
        }
    }

    private async Task ReloadOverlays()
    {
        if (loadedPresentation is null) return;
        overlaySlides = await PresentationService.GetOverlaysAsync(loadedPresentation.OrganizationId, OrgState.ToCallerContext());

        // If the active overlay was deleted, clear it
        if (activeOverlayId is not null && overlaySlides.All(o => o.Id != activeOverlayId))
        {
            activeOverlayId = null;
            SharedAppState.ClearOverlay(AppState.SessionId);
        }
    }

