    /// <summary>
    /// Held while starting or stopping, so the second of two quick presses does not run against a
    /// half-finished first. Both methods await the browser and, on a device, the mirror; the state
    /// they leave behind in between is neither started nor stopped, and a Start landing there
    /// blacked out a slide the first press had already put up.
    /// </summary>
    private bool changingPresentationState;

    private async Task StartPresentation()
    {
        var orgId = OrgState.ActiveOrganizationId;
        if (orgId is null || changingPresentationState) return;
        changingPresentationState = true;

        try
        {
            // Cleared, not just blacked out: the session may have run another presentation before
            // this one, and its last slide is still here. See SharedAppState.ClearLiveSlide.
            SharedAppState.ClearLiveSlide(AppState.SessionId);
            SharedAppState.ActivatePresentation(AppState.SessionId, orgId, EffectiveId, AppState.SelectedProject?.Name);

            if (liveSessionMirror is not null)
                await liveSessionMirror.StartAsync(AppState.SessionId);

            // A sleeping operator machine takes the circuit and the projector window with it. Held
            // only while live, so browsing and editing behave as before.
            try { await JsRuntime.InvokeVoidAsync("gospelPresenter.requestWakeLock"); } catch { }
        }
        finally
        {
            changingPresentationState = false;
        }
    }

    /// <summary>
    /// The grid reports which tile was pressed rather than writing the live slide itself: choosing
    /// what is shown is the page's job, and the grid is a view of the choice.
    /// </summary>
    private void HandleSelectSlide((string ItemId, int PartIndex) selection) =>
        SetSelectedLiveSlide(selection.ItemId, selection.PartIndex);

    private async Task HandleStageSelectSlide((string ItemId, int PartIndex) selection)
    {
        if (AppState.SelectedProjectItem?.Id != selection.ItemId)
        {
            var item = AppState.SelectedProject?.Items.FirstOrDefault(x => x.Id == selection.ItemId);
            if (item is null) return;
            AppState.SelectedProjectItem = item;
            // Wait for OnPropertyChanged → GetDataForSelectedItem to populate Selected* fields.
            await Task.Yield();
        }
        SetSelectedLiveSlide(selection.ItemId, selection.PartIndex);
    }

    private async Task HandleStageSelectItem(ProjectItem item)
    {
        AppState.SelectedProjectItem = item;
        await Task.Yield();
        if (item.Type == ProjectItemType.Audio)
        {
            // Audio has no slides — black out the screen so audio plays without a stale slide.
            var current = SharedAppState.GetLiveSlide(EffectiveSessionId);
            SharedAppState.SetLiveSlide(EffectiveSessionId, current with { Status = LiveSlideStatus.ShowingBlackScreen });
        }
        else
        {
            // Auto-pick the first slide so the leader doesn't need a second tap.
            SetSelectedLiveSlide(item.Id, 0);
        }
    }

