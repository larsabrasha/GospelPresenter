@page "/presentation"
@layout PresentationLayout

@inject AppState AppState

@using System.ComponentModel
@using GospelPresenter.Shared.Components
@using GospelPresenter.Shared.Layout
@using GospelPresenter.Shared.State
@implements IDisposable

@{
    var viewportWidth = AppState.PresentationViewport?.Width ?? 0;
    var viewportHeight = AppState.PresentationViewport?.Height ?? 0;

    var widthScale = (double)viewportWidth / AppState.BaseSlideWidth;
    var heightScale = (double)viewportHeight / AppState.BaseSlideHeight;

    var scale = Math.Min(widthScale, heightScale);
}

<div class="flex h-full bg-black text-white items-center justify-items-center relative">

    @{
        var slideClass = AppState.LiveSlide.Status == LiveSlideStatus.ShowingPresentation ? "opacity-100" : "opacity-0";
    }

    <div
        class="w-full transition-opacity duration-500 ease-in-out @slideClass">

        @if (AppState.LiveSlide.Text is not null)
        {
            <Slide
                Class=""
                BaseWidth="@AppState.BaseSlideWidth"
                BaseHeight="@AppState.BaseSlideHeight"
                Scale="@scale">
                @((MarkupString)AppState.LiveSlide.Text)
            </Slide>
        }
        else if (AppState.LiveSlide.ImageUrl is not null)
        {
            <Slide
                Class=""
                BaseWidth="@AppState.BaseSlideWidth"
                BaseHeight="@AppState.BaseSlideHeight"
                Scale="@scale">
                <div class="w-full text-center">
                    <img src="@AppState.LiveSlide.ImageUrl" class="w-full h-full object-contain drag-none" alt="">
                </div>
            </Slide>
        }
    </div>
</div>

@code {

    protected override void OnInitialized()
    {
        AppState.PropertyChanged += OnPropertyChanged;
    }

    public void Dispose()
    {
        AppState.PropertyChanged -= OnPropertyChanged;
    }

    private void OnPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName is
            nameof(AppState.LiveSlide) or
            nameof(AppState.PresentationViewport))
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

}
