    private async Task StopPresentation()
    {
        // The button is hidden in this case; the guard is here because the state it would leave
        // behind is a lie rather than a mess — see CanStopPresentation.
        if (!CanStopPresentation || changingPresentationState) return;
        changingPresentationState = true;

        try
        {
            await JsRuntime.InvokeVoidAsync("stopLivePresentation", EffectiveSessionId);
            ResetLiveSlide();

            // A mirrored session ends the way its own device would end it, outputs and all. Only
            // an abandoned one reaches this — see CanEndAbandonedSession — but it must not end any
            // less completely for having been ended from here: deactivating it directly would
            // leave the screens and public outputs bound to a session that no longer exists.
            if (liveSessionEnder is not null
                && liveSessionPresence?.IsMirrored(EffectiveSessionId) == true)
                liveSessionEnder.End(EffectiveSessionId);
            else
                SharedAppState.DeactivatePresentation(EffectiveSessionId);
            if (liveSessionMirror is not null)
                await liveSessionMirror.StopAsync();
            try { await JsRuntime.InvokeVoidAsync("gospelPresenter.releaseWakeLock"); } catch { }
            if (Editor.SelectedAudio is not null)
                SharedAppState.SetSessionAudio(AppState.SessionId, Editor.SelectedAudio);

            // Nothing here lets go of the outputs. LiveOutputsState follows the deactivation
            // above, so it does the same whether the operator pressed Stop, a phone did, or the
            // session simply aged out.
        }
        finally
        {
            changingPresentationState = false;
        }
    }

    private void ResetLiveSlide()
    {
        var current = SharedAppState.GetLiveSlide(EffectiveSessionId);
        SharedAppState.SetLiveSlide(EffectiveSessionId, current with
        {
            Status = LiveSlideStatus.ShowingBlackScreen
        });
    }

