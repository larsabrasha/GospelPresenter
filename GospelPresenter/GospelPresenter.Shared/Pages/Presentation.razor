    private async Task RemoveImagePart(int index)
    {
        if (Editor.SelectedImage is null || index < 0 || index >= Editor.SelectedImage.Urls.Count) return;

        var partId = Editor.SelectedImage.PartIds.ElementAtOrDefault(index);
        var urls = Editor.SelectedImage.Urls.ToList();
        var partIds = Editor.SelectedImage.PartIds.ToList();

        urls.RemoveAt(index);
        if (index < partIds.Count) partIds.RemoveAt(index);

        // Update in-memory model
        var imageItem = Editor.LoadedPresentation?.Items.FirstOrDefault(x => x.Id == Editor.SelectedImage.Id);
        if (imageItem is not null && partId is not null)
        {
            imageItem.Parts.RemoveAll(p => p.Id == partId);
            for (var i = 0; i < imageItem.Parts.Count; i++)
                imageItem.Parts[i].SortOrder = i;
        }

        if (urls.Count == 0)
        {
            // No images left — remove the entire item
            Editor.IsEditingImageOrder = false;
            var projectItem = AppState.SelectedProjectItem;
            if (projectItem is not null)
            {
                AppState.SelectedProject?.Items.Remove(projectItem);
                Editor.LoadedPresentation?.Items.RemoveAll(x => x.Id == projectItem.Id);
                AppState.SelectedProjectItem = null;
            }
            Editor.SelectedImage = null;

            if (EffectiveId is not null && projectItem is not null)
            {
                var orgId = OrgState.ActiveOrganizationId;
                if (orgId is not null)
                    await PresentationService.RemoveItemAsync(orgId, EffectiveId, projectItem.Id, OrgState.ToCallerContext());
            }
            NotifyPresentationChanged();
            return;
        }

        Editor.SelectedImage = new Image(Editor.SelectedImage.Id, urls, partIds);

        // Persist to database
        if (EffectiveId is not null && partId is not null)
        {
            var orgId = OrgState.ActiveOrganizationId;
            if (orgId is not null)
                await PresentationService.RemoveItemPartAsync(orgId, EffectiveId, Editor.SelectedImage.Id, partId, OrgState.ToCallerContext());
        }
        NotifyPresentationChanged();
    }

