    private ILiveSessionMirror? liveSessionMirror;

    protected override void OnInitialized()
    {
        scope = Shortcuts.PushScope("Shortcuts.Group.Presentation", () => InvokeAsync(StateHasChanged));
        scope.Add(new Shortcut("a"), "Shortcuts.AddItem", AddItemShortcut);
        scope.Add(new Shortcut("F2"), "Shortcuts.RenameItem", RenameItemShortcut);
        scope.Add(new Shortcut("Delete"), "Shortcuts.RemoveItem", RemoveItemShortcut);
        scope.Document(new Shortcut("ArrowDown"), "Shortcuts.MoveThroughItems");
        scope.Document(new Shortcut("ArrowRight"), "Shortcuts.MoveThroughSlides");
        scope.Document(new Shortcut("Enter"), "Shortcuts.ShowSlide");

        // Only the device hosts mirror their live session to the server; the web is already there.
        // A controller's commands are applied by ILiveSessionCommandApplier, not here: this page
        // must be free to come and go without the machine going deaf. It only follows along.
        liveSessionMirror = Services.GetService(typeof(ILiveSessionMirror)) as ILiveSessionMirror;

        // Only the web host knows whether a session's machine is still reachable.
        liveSessionPresence = Services.GetService(typeof(ILiveSessionPresence)) as ILiveSessionPresence;
        if (liveSessionPresence is not null)
            liveSessionPresence.OwnerPresenceChanged += OnOwnerPresenceChanged;

        // And only the web host can end one that its device has abandoned. See ILiveSessionEnder.
        liveSessionEnder = Services.GetService(typeof(ILiveSessionEnder)) as ILiveSessionEnder;

        // AppState is this circuit's own, so only this circuit raises it. Everything on
        // SharedAppState below is a singleton event that somebody else can raise — the device
        // owning the session echoing through the hub, another operator's circuit, an MCP call — and
        // the handler then renders this page on the raiser's thread. Hence Culture.Restore on the
        // dispatch in each of those handlers; see CircuitCulture.
        AppState.PropertyChanged += OnAppStateChanged;
        SharedAppState.SessionChanged += OnSessionChanged;
        SharedAppState.PresentationChanged += OnPresentationChanged;
        SharedAppState.PresentationThemeChanged += OnPresentationThemeChanged;
        SharedAppState.PresentationActivated += OnPresenterActivated;
        SharedAppState.PresentationDeactivated += OnPresenterDeactivated;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsRemoteMode)
        {
            ResolvePresenterSession();
            Logger.LogDebug(
                "Remote viewer resolving presenter session: viewerSessionId={ViewerSessionId} presentationId={PresentationId} requestedSessionId={RequestedSessionId} candidates={CandidateCount} resolvedPresenterSessionId={PresenterSessionId} isRemoteReady={IsRemoteReady}",
                AppState.SessionId, PresentationId, Session, _presenterCandidates.Count, _presenterSessionId, IsRemoteReady);
        }

        if (EffectiveId == loadedPresentationId) return;
        loadedPresentationId = EffectiveId;

        AppState.IsMenuVisible = true;
        await LoadPresentationAsync();
        await GetDataForSelectedItem();
    }

    private async Task LoadPresentationAsync()
    {
        if (EffectiveId is null) return;

        var orgId = OrgState.ActiveOrganizationId;
        if (orgId is null) return;

        // Read before the rebuild below replaces AppState.SelectedProject.
        var selectedItemIdBeforeLoad = AppState.SelectedProjectItem?.Id;

        Editor.LoadedPresentation = IsTemplateMode
            ? await PresentationService.GetTemplateByIdAsync(EffectiveId, orgId, OrgState.ToCallerContext())
            : await PresentationService.GetPresentationByIdAsync(EffectiveId, orgId, OrgState.ToCallerContext());
        if (Editor.LoadedPresentation is null)
        {
            AppState.SelectedProject = null;
            AppState.SelectedProjectItem = null;
            return;
        }

        // Resolved after the presentation is loaded, since a presentation without a theme of its own
        // follows the organisation's default.
        Editor.Theme = await ThemeService.GetForPresentationAsync(
            orgId, Editor.LoadedPresentation.ThemeId, OrgState.ToCallerContext());

        AppState.SelectedProject = new Project
        {
            Id = Editor.LoadedPresentation.Id,
            Name = Editor.LoadedPresentation.Name,
            ScheduledDayOfWeek = Editor.LoadedPresentation.ScheduledDayOfWeek,
            ScheduledTime = Editor.LoadedPresentation.ScheduledTime,
            EventDate = Editor.LoadedPresentation.EventDate,
            EventTime = Editor.LoadedPresentation.EventTime,
            EventLocation = Editor.LoadedPresentation.EventLocation,
            Description = Editor.LoadedPresentation.Description,
            ThemeId = Editor.LoadedPresentation.ThemeId,
            Items = Editor.LoadedPresentation.Items.Select(item => new ProjectItem
            {
                Id = item.Id,
                SourceId = item.SourceId,
                Type = item.Type.ToProjectItemType(),
                Title = item.Title
            }).ToList()
        };

        if (!IsTemplateMode)
        {
            Editor.OverlaySlides = await PresentationService.GetOverlaysAsync(Editor.LoadedPresentation.OrganizationId, OrgState.ToCallerContext());

            Editor.SavedDisplays = await RemoteDisplayService.GetDisplaysAsync(Editor.LoadedPresentation.OrganizationId, OrgState.ToCallerContext());
        }

        // The live slide still wins — following the presentation is the whole point while one is
        // running — but otherwise the operator stays where they were. With nothing live this used
        // to clear the selection, which was harmless while only an own edit or a change of
        // presentation reloaded. A sync reload happens whenever anybody in the organisation writes
        // anything, so clearing it would empty the pane out from under someone reading a song, and
        // close the song editor with it. Matched by id because the items are rebuilt above.
        var liveItemId = SharedAppState.GetLiveSlide(EffectiveSessionId).ProjectItemId;
        var items = AppState.SelectedProject.Items;
        AppState.SelectedProjectItem =
            (liveItemId is not null ? items.FirstOrDefault(x => x.Id == liveItemId) : null)
            ?? items.FirstOrDefault(x => x.Id == selectedItemIdBeforeLoad);
    }

    /// <summary>
    /// A pull wrote rows into the local database, so this presentation may no longer be what is on
    /// screen — an item somebody else removed is still listed until this runs.
    ///
    /// Silent, unlike <see cref="OnPresentationChanged"/>, which toasts: that one fires for this
    /// presentation only, while the doorbell announces any change in the organisation, so a toast
    /// per sync would be noise. Resolves to nothing on a host without the signal, so the web is
    /// unaffected beyond what IOrganizationChangeNotifier already gives it.
    /// </summary>
    private async Task ReloadAfterSyncAsync()
    {
        await LoadPresentationAsync();
        await GetDataForSelectedItem();
    }

