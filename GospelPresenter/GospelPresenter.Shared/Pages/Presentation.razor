    private async Task RemoveMultipleItemsAsync()
    {
        if (itemsToRemove is null || AppState.SelectedProject is null || isRemovingMultiple) return;

        isRemovingMultiple = true;
        var items = itemsToRemove;

        try
        {
            if (EffectiveId is not null)
            {
                var orgId = OrgState.ActiveOrganizationId;
                if (orgId is not null)
                    await PresentationService.RemoveItemsAsync(orgId, EffectiveId, items.Select(i => i.Id).ToList(), OrgState.ToCallerContext());
            }

            itemsToRemove = null;

            foreach (var item in items)
            {
                AppState.SelectedProject.Items.Remove(item);
                Editor.LoadedPresentation?.Items.RemoveAll(x => x.Id == item.Id);

                if (AppState.SelectedProjectItem?.Id == item.Id)
                    AppState.SelectedProjectItem = null;
            }

            AppState.NotifyProjectChanged();
            NotifyPresentationChanged();
            ToastService.Show(items.Count == 1 ? L["Toast.ItemRemoved"] : L["Toast.ItemsRemoved", items.Count]);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove {Count} items from presentation {PresentationId}", items.Count, EffectiveId);
            ToastService.Show(L["Common.ErrorOccurred"]);
        }
        finally
        {
            isRemovingMultiple = false;
        }
    }

