    public void Dispose()
    {
        scope?.Dispose();
        if (!SharedAppState.IsPresentationActive(AppState.SessionId))
            SharedAppState.SetSessionAudio(AppState.SessionId, null);
        if (IsRemoteMode)
            _ = JsRuntime.InvokeVoidAsync("gospelPresenter.unregisterAudioRelay").AsTask();
        if (liveSessionPresence is not null)
            liveSessionPresence.OwnerPresenceChanged -= OnOwnerPresenceChanged;

        // A check still waiting out its two seconds would toast into a circuit that is gone.
        confirmationCts?.Cancel();
        confirmationCts?.Dispose();

        AppState.PropertyChanged -= OnAppStateChanged;
        SharedAppState.SessionChanged -= OnSessionChanged;
        SharedAppState.PresentationChanged -= OnPresentationChanged;
        SharedAppState.PresentationThemeChanged -= OnPresentationThemeChanged;
        SharedAppState.PresentationActivated -= OnPresenterActivated;
        SharedAppState.PresentationDeactivated -= OnPresenterDeactivated;
        dotNetRef?.Dispose();
    }

    private void OnPresenterActivated(string sessionId) => RefreshPresenterSession();

