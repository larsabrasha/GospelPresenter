    private DotNetObjectReference<Presentation>? dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            var isActive = SharedAppState.IsPresentationActive(AppState.SessionId);
            await JsRuntime.InvokeVoidAsync("initLiveViewButton", "live-view-container", dotNetRef, isActive, AppState.SessionId);
        }

        if (isEditingItemTitle)
        {
            try { await itemTitleInput.FocusAsync(); } catch { }
        }

        if (isEditingImageOrder && !imageSortableInitialized)
        {
            await JsRuntime.InvokeVoidAsync("initSortableList", "image-slide-list", dotNetRef);
            imageSortableInitialized = true;
        }
    }

    [JSInvokable]
    public void OnPresentationStateChanged(bool active)
    {
        SharedAppState.SetPresentationActive(AppState.SessionId, active);
    }

    [JSInvokable]
    public async Task OnItemReordered(int oldIndex, int newIndex)
    {
        if (SelectedImage is null || SelectedImage.PartIds.Count == 0) return;
        if (oldIndex < 0 || oldIndex >= SelectedImage.Urls.Count || newIndex < 0 || newIndex >= SelectedImage.Urls.Count) return;

        var urls = SelectedImage.Urls.ToList();
        var partIds = SelectedImage.PartIds.ToList();

        var movedUrl = urls[oldIndex];
        urls.RemoveAt(oldIndex);
        urls.Insert(newIndex, movedUrl);

        var movedPartId = partIds[oldIndex];
        partIds.RemoveAt(oldIndex);
        partIds.Insert(newIndex, movedPartId);

        SelectedImage = new Image(SelectedImage.Id, urls, partIds);

        // Update the in-memory model
        var imageItem = loadedPresentation?.Items.FirstOrDefault(x => x.Id == SelectedImage.Id);
        if (imageItem is not null)
        {
            for (var i = 0; i < partIds.Count; i++)
            {
                var part = imageItem.Parts.FirstOrDefault(p => p.Id == partIds[i]);
                if (part is not null)
                    part.SortOrder = i;
            }
        }

        // Persist to database
        if (PresentationId is not null)
        {
            var orgId = OrgState.ActiveOrganizationId;
            if (orgId is not null)
                await PresentationService.ReorderItemPartsAsync(orgId, PresentationId, SelectedImage.Id, partIds, OrgState.ToCallerContext());
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleImageEditMode()
    {
        isEditingImageOrder = !isEditingImageOrder;

        if (!isEditingImageOrder)
        {
            imageSortableInitialized = false;
            await JsRuntime.InvokeVoidAsync("destroySortableList", "image-slide-list");
        }
    }

    private void ConfirmRemoveImagePart(int index)
    {
        imagePartToRemoveIndex = index;
    }

    private async Task ConfirmAndRemoveImagePart()
    {
        if (imagePartToRemoveIndex is null) return;
        var index = imagePartToRemoveIndex.Value;
        imagePartToRemoveIndex = null;
        await RemoveImagePart(index);
    }

    private async Task RemoveImagePart(int index)
    {
        if (SelectedImage is null || index < 0 || index >= SelectedImage.Urls.Count) return;

        var partId = SelectedImage.PartIds.ElementAtOrDefault(index);
        var urls = SelectedImage.Urls.ToList();
        var partIds = SelectedImage.PartIds.ToList();

        urls.RemoveAt(index);
        if (index < partIds.Count) partIds.RemoveAt(index);

        // Update in-memory model
        var imageItem = loadedPresentation?.Items.FirstOrDefault(x => x.Id == SelectedImage.Id);
        if (imageItem is not null && partId is not null)
        {
            imageItem.Parts.RemoveAll(p => p.Id == partId);
            for (var i = 0; i < imageItem.Parts.Count; i++)
                imageItem.Parts[i].SortOrder = i;
        }

        if (urls.Count == 0)
        {
            // No images left — remove the entire item
            isEditingImageOrder = false;
            imageSortableInitialized = false;
            var projectItem = AppState.SelectedProjectItem;
            if (projectItem is not null)
            {
                AppState.SelectedProject?.Items.Remove(projectItem);
                loadedPresentation?.Items.RemoveAll(x => x.Id == projectItem.Id);
                AppState.SelectedProjectItem = null;
            }
            SelectedImage = null;

            if (PresentationId is not null && projectItem is not null)
            {
                var orgId = OrgState.ActiveOrganizationId;
                if (orgId is not null)
                    await PresentationService.RemoveItemAsync(orgId, PresentationId, projectItem.Id, OrgState.ToCallerContext());
            }
            return;
        }

        SelectedImage = new Image(SelectedImage.Id, urls, partIds);

        // Persist to database
        if (PresentationId is not null && partId is not null)
        {
            var orgId = OrgState.ActiveOrganizationId;
            if (orgId is not null)
                await PresentationService.RemoveItemPartAsync(orgId, PresentationId, SelectedImage.Id, partId, OrgState.ToCallerContext());
        }
    }

    private void OpenAddImagesToExisting()
    {
        showAddImagesToExisting = true;
    }

    private void CloseAddImagesToExisting()
    {
        showAddImagesToExisting = false;
    }

    private async Task HandleImagesAddedToExisting(List<OrganizationImage> images)
    {
        showAddImagesToExisting = false;
        await AddImagesToExistingItem(images);
    }

    private async Task HandleImagesAddedToExistingKeepOpen(List<OrganizationImage> images)
    {
        await AddImagesToExistingItem(images);
    }

    private async Task AddImagesToExistingItem(List<OrganizationImage> images)
    {
        if (images.Count == 0 || SelectedImage is null) return;

        var imageItem = loadedPresentation?.Items.FirstOrDefault(x => x.Id == SelectedImage.Id);
        if (imageItem is null) return;

        var maxSortOrder = imageItem.Parts.Count > 0
            ? imageItem.Parts.Max(p => p.SortOrder)
            : -1;

        var newParts = images.Select((img, i) => new PresentationItemPart
        {
            Id = Guid.NewGuid().ToString(),
            Content = img.Id,
            SortOrder = maxSortOrder + 1 + i,
            PresentationItemId = imageItem.Id
        }).ToList();

        imageItem.Parts.AddRange(newParts);

        // Rebuild SelectedImage with new URLs
        var urls = SelectedImage.Urls.ToList();
        var partIds = SelectedImage.PartIds.ToList();
        foreach (var img in images)
        {
            if (img.FullData is not null)
            {
                urls.Add($"data:{img.ContentType};base64,{Convert.ToBase64String(img.FullData)}");
                partIds.Add(newParts[images.IndexOf(img)].Id);
            }
        }
        SelectedImage = new Image(SelectedImage.Id, urls, partIds);

        // Reinitialize sortable after render
        imageSortableInitialized = false;

        // Persist to database
        if (PresentationId is not null)
        {
            var orgId = OrgState.ActiveOrganizationId;
            if (orgId is not null)
                await PresentationService.AddItemPartsAsync(orgId, PresentationId, imageItem.Id, newParts, OrgState.ToCallerContext());
        }
    }

    private void StartEditingItemTitle()
    {
        editItemTitle = AppState.SelectedProjectItem?.Title ?? "";
        isEditingItemTitle = true;
    }

    private async Task OnItemTitleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SaveItemTitleAsync();
        else if (e.Key == "Escape")
            isEditingItemTitle = false;
    }

    private async Task SaveItemTitleAsync()
    {
        isEditingItemTitle = false;
        var trimmed = editItemTitle.Trim();
        var item = AppState.SelectedProjectItem;

        if (item is null || string.IsNullOrWhiteSpace(trimmed) || trimmed == item.Title)
            return;

        item.Title = trimmed;

        // Update in-memory presentation model
        var presentationItem = loadedPresentation?.Items.FirstOrDefault(x => x.Id == item.Id);
        if (presentationItem is not null)
            presentationItem.Title = trimmed;

        // Persist to database
        if (PresentationId is not null)
        {
            var orgId = OrgState.ActiveOrganizationId;
            if (orgId is not null)
                await PresentationService.RenameItemAsync(orgId, PresentationId, item.Id, trimmed, OrgState.ToCallerContext());
        }

        AppState.NotifyProjectChanged();
    }

    protected override void OnInitialized()
    {
        idleHintIndex = Random.Shared.Next(idleHints.Length);
        AppState.PropertyChanged += OnPropertyChanged;
        SharedAppState.PropertyChanged += OnPropertyChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (PresentationId == loadedPresentationId) return;
        loadedPresentationId = PresentationId;

        await LoadPresentationAsync();
        await GetDataForSelectedItem();
    }

    private async Task LoadPresentationAsync()
    {
        if (PresentationId is null) return;

        var orgId = OrgState.ActiveOrganizationId;
        if (orgId is null) return;
        loadedPresentation = await PresentationService.GetPresentationByIdAsync(PresentationId, orgId, OrgState.ToCallerContext());
        if (loadedPresentation is null)
        {
            AppState.SelectedProject = null;
            AppState.SelectedProjectItem = null;
            return;
        }

        AppState.SelectedProject = new Project
        {
            Id = loadedPresentation.Id,
            Name = loadedPresentation.Name,
            Items = loadedPresentation.Items.Select(item => new ProjectItem
            {
                Id = item.Id,
                SourceId = item.SourceId,
                Type = item.Type switch
                {
                    PresentationItemType.Song => ProjectItemType.Song,
                    PresentationItemType.BibleText => ProjectItemType.BibleText,
                    PresentationItemType.Image => ProjectItemType.Image,
                    _ => ProjectItemType.Song
                },
                Title = item.Title
            }).ToList()
        };

        overlaySlides = await PresentationService.GetOverlaysAsync(loadedPresentation.OrganizationId, OrgState.ToCallerContext());

        var liveItemId = SharedAppState.GetLiveSlide(AppState.SessionId).ProjectItemId;
        var activeItem = liveItemId is not null
            ? AppState.SelectedProject.Items.FirstOrDefault(x => x.Id == liveItemId)
            : null;
        AppState.SelectedProjectItem = activeItem;
    }

    public void Dispose()
    {
        AppState.PropertyChanged -= OnPropertyChanged;
        SharedAppState.PropertyChanged -= OnPropertyChanged;
        dotNetRef?.Dispose();
    }

    private async void OnPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(AppState.SelectedProjectItem))
        {
            await GetDataForSelectedItem();
            if (AppState.SelectedProjectItem is null)
                idleHintIndex = Random.Shared.Next(idleHints.Length);
            await InvokeAsync(StateHasChanged);
        }
        else if (e.PropertyName is
                 nameof(AppState.MainViewport) or
                 nameof(AppState.IsMenuVisible))
        {
            _ = InvokeAsync(StateHasChanged);
        }
        else if (sender is SharedAppState && e.PropertyName == AppState.SessionId)
        {
            if (SharedAppState.IsSessionExpired(AppState.SessionId))
            {
                showSessionExpired = true;
                SharedAppState.ClearSessionExpired(AppState.SessionId);
            }

            _ = InvokeAsync(StateHasChanged);
        }
    }

    private async Task GetDataForSelectedItem()
    {
        SelectedSong = null;
        SongCredits = null;
        SelectedBibleText = null;
        SelectedImage = null;
        isEditingImageOrder = false;
        isEditingItemTitle = false;
        imageSortableInitialized = false;

        switch (AppState.SelectedProjectItem?.Type)
        {
            case ProjectItemType.Song:
                var songSourceId = AppState.SelectedProjectItem.SourceId;
                if (songSourceId is not null)
                    SelectedSong = SongService.GetSongById(songSourceId, OrgState.ActiveOrganizationId ?? "", OrgState.ToCallerContext());
                if (SelectedSong is null)
                {
                    // Fallback: reconstruct from saved parts (legacy data)
                    var songItem = loadedPresentation?.Items.FirstOrDefault(x => x.Id == AppState.SelectedProjectItem.Id);
                    if (songItem is not null && songItem.Parts.Count > 0)
                    {
                        SelectedSong = new Song(
                            songItem.SourceId ?? songItem.Id,
                            songItem.Title,
                            null, null, null, null,
                            songItem.Parts.Select(p => new SongPart(null, p.Content)).ToList()
                        );
                    }
                }
                SongCredits = FormatSongCredits(SelectedSong);
                break;
            case ProjectItemType.BibleText:
                var dbItem = loadedPresentation?.Items.FirstOrDefault(x => x.Id == AppState.SelectedProjectItem.Id);
                if (dbItem is not null)
                {
                    SelectedBibleText = new BibleText(
                        dbItem.Id,
                        dbItem.Title,
                        dbItem.Parts.Select(p => p.Content).ToList()
                    );
                }
                break;
            case ProjectItemType.Image:
                var imageItem = loadedPresentation?.Items.FirstOrDefault(x => x.Id == AppState.SelectedProjectItem.Id);
                if (imageItem is not null)
                {
                    var urls = new List<string>();
                    var partIds = new List<string>();
                    if (imageItem.Parts.Count > 0)
                    {
                        var orgId = OrgState.ActiveOrganizationId;
                        if (orgId is not null)
                        {
                            foreach (var part in imageItem.Parts.OrderBy(p => p.SortOrder))
                            {
                                var orgImage = await OrganizationImageService.GetImageByIdAsync(part.Content, orgId, OrgState.ToCallerContext());
                                if (orgImage?.FullData is not null)
                                {
                                    urls.Add($"data:{orgImage.ContentType};base64,{Convert.ToBase64String(orgImage.FullData)}");
                                    partIds.Add(part.Id);
                                }
                            }
                        }
                    }
                    else if (imageItem.ImageData is not null)
                    {
                        // Backward compatibility: single image stored directly
                        urls.Add($"data:image/jpeg;base64,{Convert.ToBase64String(imageItem.ImageData)}");
                    }

                    if (urls.Count > 0)
                    {
                        SelectedImage = new Image(imageItem.Id, urls, partIds);
                    }
                }
                break;
        }
    }

    private void SetSelectedLiveSlide(string selectedItemId, int partIndex)
    {
        var projectItem = AppState.SelectedProject?.Items.FirstOrDefault(x => x.Id == selectedItemId);
        if (projectItem is null) return;

        string? text = null;
        string? credits = null;
        string? imageUrl = null;
        SongPart? songPart = null;

        switch (projectItem.Type)
        {
            case ProjectItemType.Song:
            {
                Song? song = null;
                if (projectItem.SourceId is not null)
                    song = SongService.GetSongById(projectItem.SourceId, OrgState.ActiveOrganizationId ?? "", OrgState.ToCallerContext());
                if (song is null)
                {
                    // Fallback: reconstruct from saved parts (legacy data)
                    var songItem = loadedPresentation?.Items.FirstOrDefault(x => x.Id == projectItem.Id);
                    if (songItem is not null && songItem.Parts.Count > 0)
                    {
                        song = new Song(songItem.SourceId ?? songItem.Id, songItem.Title, null, null, null, null,
                            songItem.Parts.Select(p => new SongPart(null, p.Content)).ToList());
                    }
                }
                if (song is not null && partIndex < song.Parts.Count)
                {
                    songPart = song.Parts[partIndex];
                    text = songPart.Content.Replace("\n", "<br>");
                    credits = FormatSongCredits(song);
                }

                break;
            }
            case ProjectItemType.Image:
            {
                if (SelectedImage is not null && partIndex < SelectedImage.Urls.Count)
                {
                    imageUrl = SelectedImage.Urls[partIndex];
                }

                break;
            }
            case ProjectItemType.BibleText:
            {
                var bibleItem = loadedPresentation?.Items.FirstOrDefault(x => x.Id == projectItem.Id);
                if (bibleItem is not null && partIndex < bibleItem.Parts.Count)
                {
                    text = bibleItem.Parts[partIndex].Content;
                    credits = bibleItem.Title;
                }

                break;
            }
            default:
                return;
        }

        SharedAppState.SetLiveSlide(AppState.SessionId, SharedAppState.GetLiveSlide(AppState.SessionId) with
        {
            Status = LiveSlideStatus.ShowingPresentation,
            ItemType = projectItem.Type,
            ProjectItemId = selectedItemId,
            ItemPartIndex = partIndex,
            Text = text,
            Credits = credits,
            ImageUrl = imageUrl,
            SongPart = songPart
        });
    }

