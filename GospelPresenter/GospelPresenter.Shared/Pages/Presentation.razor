    /// <summary>
    /// Nothing to confirm: presentations and templates both go to the trash, and the toast says
    /// where. A dialog belongs to what cannot be undone.
    /// </summary>
    private async Task DeletePresentationAsync()
    {
        if (EffectiveId is null) return;

        var orgId = OrgState.ActiveOrganizationId;
        if (orgId is null) return;

        var name = AppState.SelectedProject?.Name ?? "";

        try
        {
            if (IsTemplateMode)
                await PresentationService.DeleteTemplateAsync(orgId, EffectiveId, OrgState.ToCallerContext());
            else
                await PresentationService.DeletePresentationAsync(orgId, EffectiveId, OrgState.ToCallerContext());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete presentation {PresentationId}", EffectiveId);
            ToastService.Show(L["Common.ErrorOccurred"], ToastKind.Warning);
            return;
        }

        NotifyPresentationChanged();

        AppState.SelectedProject = null;
        AppState.SelectedProjectItem = null;

        ToastService.Show(L[IsTemplateMode ? "Toast.TemplateTrashed" : "Toast.PresentationTrashed", name]);

        NavigationManager.NavigateTo(IsTemplateMode ? "/admin/templates" : "/");
    }

    private async Task RemoveItemAsync()
    {
        if (itemToRemove is null || AppState.SelectedProject is null) return;

        var removedItem = itemToRemove;
        itemToRemove = null;

        AppState.SelectedProject.Items.Remove(removedItem);
        Editor.LoadedPresentation?.Items.RemoveAll(x => x.Id == removedItem.Id);

        if (AppState.SelectedProjectItem?.Id == removedItem.Id)
        {
            AppState.SelectedProjectItem = null;
        }

        AppState.NotifyProjectChanged();

        if (EffectiveId is not null)
        {
            var orgId = OrgState.ActiveOrganizationId;
            if (orgId is not null)
                await PresentationService.RemoveItemAsync(orgId, EffectiveId, removedItem.Id, OrgState.ToCallerContext());
        }

        NotifyPresentationChanged();
    }

