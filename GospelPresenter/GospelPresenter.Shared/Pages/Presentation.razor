    /// <summary>
    /// Re-picks the session being controlled when one starts or stops anywhere. Both directions
    /// matter: a second machine going live turns a settled choice into a question, and the machine
    /// being controlled going away has to release the controller rather than leave it driving a
    /// session that no longer exists.
    /// </summary>
    private void RefreshPresenterSession()
    {
        if (!IsRemoteMode || PresentationId is null) return;

        var previous = _presenterSessionId;
        var previousCount = _presenterCandidates.Count;
        ResolvePresenterSession();

        if (_presenterSessionId == previous && _presenterCandidates.Count == previousCount) return;

        _ = InvokeAsync(Culture.Restore(StateHasChanged));
    }

