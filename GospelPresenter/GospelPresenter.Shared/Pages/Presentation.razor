    private bool InsertAfterSelected<T>(IList<T>? list, T item) where T : class
    {
        if (list is null) return false;

        var selectedId = AppState.SelectedProjectItem?.Id;
        if (selectedId is not null)
        {
            var index = -1;
            for (var i = 0; i < list.Count; i++)
            {
                var id = list[i] switch
                {
                    ProjectItem pi => pi.Id,
                    PresentationItem pi => pi.Id,
                    _ => null
                };
                if (id == selectedId)
                {
                    index = i;
                    break;
                }
            }

            if (index >= 0 && index < list.Count - 1)
            {
                list.Insert(index + 1, item);
                return true;
            }
        }

        list.Add(item);
        return false;
    }

    private async Task ReorderAfterInsert(string orgId)
    {
        if (EffectiveId is null || AppState.SelectedProject is null) return;
        var itemIds = AppState.SelectedProject.Items.Select(x => x.Id).ToList();
        await PresentationService.ReorderItemsAsync(orgId, EffectiveId, itemIds, OrgState.ToCallerContext());
    }

    private void NotifyPresentationChanged()
    {
        if (EffectiveId is not null)
            SharedAppState.NotifyPresentationChanged(EffectiveId, AppState.SessionId);
