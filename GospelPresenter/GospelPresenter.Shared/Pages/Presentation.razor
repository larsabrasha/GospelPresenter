    /// <summary>
    /// Two sessions concern this page and it treats them differently. Its own is where it writes,
    /// and it needs every change to it — including the ones it did not make, because a phone or the
    /// desktop client owning the session can move the slide underneath it. The presenter session in
    /// remote mode is the machine being driven, where the page is a controller waiting to see its
    /// command land.
    ///
    /// No filter on Kind: every kind changes something visible here. The audio command is the one
    /// that must not be missed, since taking it consumes it.
    /// </summary>
    private void OnSessionChanged(SessionChange change)
    {
        if (change.SessionId == AppState.SessionId)
        {
            if (SharedAppState.IsSessionExpired(AppState.SessionId))
            {
                showSessionExpired = true;
                SharedAppState.ClearSessionExpired(AppState.SessionId);
            }

            var cmd = SharedAppState.TakeAudioCommand(AppState.SessionId);
            if (cmd is not null && !IsRemoteMode)
                _ = InvokeAsync(() => JsRuntime.InvokeVoidAsync(
                    "gospelPresenter.executeAudioCommand", cmd.Action, cmd.AudioElementId, cmd.Position).AsTask());

            SyncStageSelectionFromLiveSlide();
            _ = InvokeAsync(Culture.Restore(StateHasChanged));
        }
        else if (IsRemoteMode && change.SessionId == _presenterSessionId)
        {
            SyncStageSelectionFromLiveSlide();
            ExpectConfirmation();
            _ = InvokeAsync(Culture.Restore(StateHasChanged));
        }
    }

    /// <summary>
    /// Follows the live slide into the running order — stage mode only.
    ///
    /// Stage mode is a view of what is showing and nothing else, so it follows every change. No
    /// other surface does. What is selected is each client's own business: the whole point of
    /// picking up a phone, or of a second operator opening the same service, is to look somewhere
    /// other than where the projector is — lining up the next song while someone else advances
    /// this one. Only what is actually showing is shared, and the running order marks that with
    /// its own live dot rather than by moving anyone's selection.
    /// </summary>
    private void SyncStageSelectionFromLiveSlide()
    {
        if (!IsStageMode) return;

        var live = SharedAppState.GetLiveSlide(EffectiveSessionId);
        if (live.ProjectItemId is null) return;
        if (live.ProjectItemId == AppState.SelectedProjectItem?.Id) return;

        var item = AppState.SelectedProject?.Items.FirstOrDefault(x => x.Id == live.ProjectItemId);
        if (item is null) return;
        AppState.SelectedProjectItem = item;
    }

    private async Task GetDataForSelectedItem()
    {
        Editor.SelectedSong = null;
        Editor.SelectedBibleText = null;
        Editor.SelectedImage = null;
        Editor.SelectedAudio = null;
        Editor.SelectedSlides = null;
        Editor.IsEditingImageOrder = false;

        switch (AppState.SelectedProjectItem?.Type)
        {
            case ProjectItemType.Song:
                var songSourceId = AppState.SelectedProjectItem.SourceId;
                if (songSourceId is not null)
                    Editor.SelectedSong = SongService.GetSongById(songSourceId, OrgState.ActiveOrganizationId ?? "", OrgState.ToCallerContext());
                if (Editor.SelectedSong is null)
                {
                    // Fallback: reconstruct from saved parts (legacy data)
                    var songItem = Editor.LoadedPresentation?.Items.FirstOrDefault(x => x.Id == AppState.SelectedProjectItem.Id);
                    if (songItem is not null && songItem.Parts.Count > 0)
                    {
                        Editor.SelectedSong = new Song(
                            songItem.SourceId ?? songItem.Id,
                            songItem.Title,
                            null, null, null, null,
                            songItem.Parts.Select(p => new SongPart("", null, null, null, p.Content)).ToList(),
                            []
                        );
                    }
                }
                break;
            case ProjectItemType.BibleText:
                var dbItem = Editor.LoadedPresentation?.Items.FirstOrDefault(x => x.Id == AppState.SelectedProjectItem.Id);
                if (dbItem is not null)
                {
                    Editor.SelectedBibleText = new BibleText(
                        dbItem.Id,
                        dbItem.Title,
                        dbItem.Parts.Select(p => p.Content).ToList()
                    );
                }
                break;
            case ProjectItemType.Image:
                var imageItem = Editor.LoadedPresentation?.Items.FirstOrDefault(x => x.Id == AppState.SelectedProjectItem.Id);
                if (imageItem is not null)
                {
                    var urls = new List<string>();
                    var partIds = new List<string>();
                    if (imageItem.Parts.Count > 0)
                    {
                        foreach (var part in imageItem.Parts.OrderBy(p => p.SortOrder))
                        {
                            urls.Add(ImageUrlHelper.OrgImageUrl(part.Content, "full"));
                            partIds.Add(part.Id);
                        }
                    }
                    if (urls.Count > 0)
                    {
                        Editor.SelectedImage = new Image(imageItem.Id, urls, partIds);
                    }
                }
                break;
            case ProjectItemType.Audio:
                var audioItem = Editor.LoadedPresentation?.Items.FirstOrDefault(x => x.Id == AppState.SelectedProjectItem.Id);
                if (audioItem is not null && audioItem.Parts.Count > 0)
                {
                    var audioParts = audioItem.Parts.OrderBy(p => p.SortOrder)
                        .Select(p =>
                        {
                            var parts = p.Content.Split('|', 2);
                            var audioId = parts[0];
                            var fileName = parts.Length > 1 ? parts[1] : audioId;
                            return new AudioPart(p.Id, audioId, fileName, ImageUrlHelper.OrgAudioUrl(audioId));
                        })
                        .ToList();
                    var audio = new Audio(audioItem.Id, audioParts);
                    Editor.SelectedAudio = audio;
                    if (IsRemoteMode && _presenterSessionId is not null)
                        SharedAppState.SetSessionAudio(_presenterSessionId, audio);
                    SharedAppState.SetSessionAudio(AppState.SessionId, audio);
                }
                break;
            case ProjectItemType.Slides:
                var slidesItem = Editor.LoadedPresentation?.Items.FirstOrDefault(x => x.Id == AppState.SelectedProjectItem.Id);
                if (slidesItem is not null && slidesItem.SourceId is not null)
                {
                    var urls = slidesItem.Parts.OrderBy(p => p.SortOrder)
                        .Select(p => int.TryParse(p.Content, out var pageIdx) ? ImageUrlHelper.SlidesPageUrl(slidesItem.SourceId, pageIdx) : null)
                        .Where(u => u is not null)
                        .Select(u => u!)
                        .ToList();
                    Editor.SelectedSlides = new SlidesState(slidesItem.Id, slidesItem.SourceId, urls);
                }
                break;
        }
    }

    private void SetSelectedLiveSlide(string selectedItemId, int partIndex)
    {
        var projectItem = AppState.SelectedProject?.Items.FirstOrDefault(x => x.Id == selectedItemId);
        if (projectItem is null) return;

        var slide = SlideBuilder.Build(
            SharedAppState.GetLiveSlide(EffectiveSessionId),
            new LiveSlideRequest(
                EffectiveSessionId,
                OrgState.ActiveOrganizationId ?? "",
                selectedItemId,
                projectItem.Type,
                projectItem.SourceId,
                partIndex,
                Editor.LoadedPresentation,
                Editor.Theme,
                OrgState.ToCallerContext()));

        // Audio items have no slide of their own — leave what is showing alone.
        if (slide is null) return;

        if (EffectiveId is not null)
            SharedAppState.UpdateActivePresentationId(EffectiveSessionId, EffectiveId, AppState.SelectedProject?.Name);

        SharedAppState.SetLiveSlide(EffectiveSessionId, slide);
    }

