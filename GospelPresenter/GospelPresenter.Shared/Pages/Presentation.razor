@page "/presentations/{presentationId}"

@using System.ComponentModel
@using GospelPresenter.Shared.Components
@using GospelPresenter.Shared.Components.Presentations
@using GospelPresenter.Shared.Components.Presentations.AddItem
@using GospelPresenter.Shared.Components.Symbols
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State

@inject AppState AppState
@inject SharedAppState SharedAppState
@inject ISongService SongService
@inject IImageService ImageService
@inject IBibleTextService BibleTextService
@inject IPresentationService PresentationService
@inject IJSRuntime JsRuntime

@implements IDisposable
@inject IStatusBarService StatusBarService

@{
    var statusBarHeight = StatusBarService.GetStatusBarHeight();
    var statusBarStyle = $"padding-top: {statusBarHeight}px";
    var liveSlide = SharedAppState.GetLiveSlide(AppState.SessionId);
}
<div class="flex h-full relative dark:text-neutral-200 dark:bg-neutral-800" style="@statusBarStyle">
    @{
        var menuBackdropVisibilityClass = AppState.IsMenuVisible ? "visible opacity-100" : "invisible opacity-0";
        var menuVisibilityClass = AppState.IsMenuVisible ? "visible translate-x-0" : "invisible -translate-x-full";
    }
    <div
        class="bg-black/30 z-100 absolute top-0 bottom-0 left-0 right-0 transition-opacity lg:invisible @menuBackdropVisibilityClass"
        @onclick="() => AppState.IsMenuVisible = false">
    </div>
    <div
        class="w-[var(--navmenu-width)] duration-200 ease-in-out shrink-0 overflow-auto h-full bg-white dark:bg-neutral-800 absolute top-0 bottom-0 left-0 z-110 shadow-xl lg:relative lg:top-auto lg:bottom-auto lg:left-auto lg:z-0 lg:shadow-none lg:visible lg:translate-x-0 @menuVisibilityClass">
        <Sidebar OnAddRequested="@OpenAddModal"
                 OnRemoveRequested="@ConfirmRemoveItem"
                 OnItemsReordered="@HandleItemsReordered"/>
    </div>

    <div class="bg-neutral-100 dark:bg-neutral-900 grow relative">
        <div class="flex flex-col h-full">
            <div class="flex flex-col grow overflow-hidden h-full relative">
                <div
                    class="flex justify-between absolute top-0 left-0 right-0 bg-linear-to-b from-neutral-100 dark:from-neutral-900 to-transparent z-10 pointer-events-auto lg:pointer-events-none h-16">
                    <div class="px-5 py-3 pointer-events-auto">
                        <span class="text-xl font-semibold">@AppState.SelectedProjectItem?.Title</span>
                    </div>

                    <div id="live-view-container" class="p-3 pointer-events-auto flex items-center gap-2">
                        @if (SharedAppState.IsPresentationActive(AppState.SessionId))
                        {
                            <div class="flex items-center gap-2 text-sm font-medium text-red-500">
                                <span class="size-2 rounded-full bg-red-500 animate-pulse"></span>
                                Live
                            </div>
                            <a href="/live?session=@AppState.SessionId" target="_blank"
                               class="px-4 py-2.5 rounded-full flex items-center gap-2 shadow-lg cursor-pointer bg-red-500 text-white hover:bg-red-600"
                               title="Avsluta presentation">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                                    <path fill-rule="evenodd" d="M4.5 7.5a3 3 0 0 1 3-3h9a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3h-9a3 3 0 0 1-3-3v-9Z" clip-rule="evenodd"/>
                                </svg>
                                <span class="text-sm font-medium">Avsluta presentation</span>
                            </a>
                        }
                        else
                        {
                            <a href="/live?session=@AppState.SessionId" target="_blank"
                               class="px-4 py-2.5 rounded-full flex items-center gap-2 shadow-lg cursor-pointer bg-emerald-500 text-white hover:bg-emerald-600"
                               title="Starta presentation">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                                    <path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd"/>
                                </svg>
                                <span class="text-sm font-medium">Starta presentation</span>
                            </a>
                        }
                    </div>
                </div>

                @{
                    var slideScale = AppState.MainViewport is null
                        ? 0.0
                        : AppState.MainViewport.Width < 768
                            ? AppState.MainViewport.Width / (double)AppState.BaseSlideWidth * 0.9 ?? 0.15
                            : AppState.MainViewport.Width <= 1024
                                ? AppState.MainViewport.Width / (double)AppState.BaseSlideWidth / 3 * 0.98 ?? 0.15
                                : 0.2;

                    var miscSlideScale = AppState.MainViewport is null
                        ? 0.0
                        : AppState.MainViewport.Width < 1024
                            ? 0.1
                            : 0.14;
                }

                <div class="mx-auto sm:mx-0 grid grid-cols-1 sm:flex sm:flex-wrap gap-3 p-3 overflow-auto pt-16 pb-36"
                     id="main">
                    @if (SelectedSong is not null)
                    {
                        @for (var i = 0; i < SelectedSong.Parts.Count; i++)
                        {
                            var partIndex = i;
                            <button @onclick="() => SetSelectedLiveSlide(AppState.SelectedProjectItem!.Id, partIndex)">
                                <SongSlide
                                    Content="@SelectedSong.Parts[i].Content"
                                    Label="@SelectedSong.Parts[i].Label"
                                    LabelColor="@SelectedSong.Parts[i].LabelColor"
                                    Credits="@SongCredits"
                                    IsSelected="@(liveSlide.ProjectItemId == AppState.SelectedProjectItem!.Id && liveSlide.ItemPartIndex == i)"
                                    BaseWidth="@AppState.BaseSlideWidth"
                                    BaseHeight="@AppState.BaseSlideHeight"
                                    Scale="@slideScale"/>
                            </button>
                        }
                    }
                    else if (SelectedBibleText is not null)
                    {
                        @for (var i = 0; i < SelectedBibleText.Parts.Count; i++)
                        {
                            var partIndex = i;
                            <button @onclick="() => SetSelectedLiveSlide(SelectedBibleText.Id, partIndex)">
                                <BibleTextSlide
                                    Content="@SelectedBibleText.Parts[i]"
                                    Credits="@SelectedBibleText.Title"
                                    IsSelected="@(liveSlide.ProjectItemId == SelectedBibleText.Id && liveSlide.ItemPartIndex == i)"
                                    BaseWidth="@AppState.BaseSlideWidth"
                                    BaseHeight="@AppState.BaseSlideHeight"
                                    Scale="@slideScale"/>
                            </button>
                        }
                    }
                    else if (SelectedImage is not null)
                    {
                        <button @onclick="() => SetSelectedLiveSlide(SelectedImage.Id, 0)">
                            <ImageSlide
                                Url="@SelectedImage.Url"
                                IsSelected="@(liveSlide.ProjectItemId == SelectedImage.Id && liveSlide.ItemPartIndex == 0)"
                                BaseWidth="@AppState.BaseSlideWidth"
                                BaseHeight="@AppState.BaseSlideHeight"
                                Scale="@slideScale"/>
                        </button>
                    }
                </div>

                <div
                    class="flex items-center absolute bottom-0 left-0 right-0 justify-between p-3 bg-linear-to-t from-neutral-100 dark:from-neutral-900 to-transparent z-10 pointer-events-none">
                    <div class="flex items-center lg:hidden pointer-events-auto">
                        <button class="cursor-pointer p-4 bg-white dark:bg-neutral-800 rounded-full shadow-2xl"
                                @onclick="() => AppState.IsMenuVisible = true">
                            <Bars3Symbol Class="size-8"/>
                        </button>
                    </div>

                    @if (SharedAppState.IsPresentationActive(AppState.SessionId))
                    {
                        var isBlackScreen = liveSlide.Status == LiveSlideStatus.ShowingBlackScreen;

                        <div class="pointer-events-auto ml-auto bg-white/90 dark:bg-neutral-800/90 backdrop-blur-sm rounded-2xl shadow-xl p-4 flex flex-col gap-3">
                            <div class="text-[10px] uppercase tracking-widest text-neutral-400 dark:text-neutral-500 font-semibold">Nu visas</div>
                            <div class="relative">
                                <LiveSlideView
                                    LiveSlide="@liveSlide"
                                    Class="bg-black rounded-lg overflow-hidden text-white"
                                    BaseWidth="@AppState.BaseSlideWidth"
                                    BaseHeight="@AppState.BaseSlideHeight"
                                    Scale="@miscSlideScale"/>
                                <div class="absolute inset-0 bg-black rounded-lg transition-opacity duration-500 ease-in-out @(isBlackScreen ? "opacity-100" : "opacity-0 pointer-events-none")"></div>
                            </div>
                            <button @onclick="() => SharedAppState.ToggleBlackScreen(AppState.SessionId)"
                                    class="cursor-pointer flex items-center justify-between gap-3 px-3 py-2 rounded-lg bg-neutral-100 dark:bg-neutral-700/50 text-sm text-neutral-600 dark:text-neutral-300"
                                    title="Visa svart bild">
                                <span>Visa svart bild</span>
                                <div class="relative w-9 h-5 rounded-full transition-colors duration-200 shrink-0 @(isBlackScreen ? "bg-sky-500" : "bg-neutral-300 dark:bg-neutral-500")">
                                    <div class="absolute top-0.5 size-4 rounded-full bg-white shadow transition-all duration-200 @(isBlackScreen ? "left-4.5" : "left-0.5")"></div>
                                </div>
                            </button>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

@if (showSessionExpired)
{
    <div class="fixed inset-0 bg-black/40 z-200 flex items-center justify-center p-4">
        <div class="bg-white dark:bg-neutral-800 dark:text-neutral-100 rounded-2xl shadow-2xl p-6 w-full max-w-sm space-y-4">
            <div class="font-semibold text-lg">Visningen avslutades</div>
            <div>Presentationen stängdes automatiskt på grund av inaktivitet.</div>
            <div class="flex justify-end">
                <button class="px-4 py-2 rounded-full bg-sky-500 text-white cursor-pointer hover:bg-sky-600"
                        @onclick="DismissSessionExpired">
                    OK
                </button>
            </div>
        </div>
    </div>
}

@if (showAddModal)
{
    <AddItemModal OnClose="@CloseAddModal"
                  OnAddBibleText="@HandleBibleVersesAdded" OnAddBibleTextKeepOpen="@HandleBibleVersesAddedKeepOpen"
                  OnAddSong="@HandleSongAdded" OnAddSongKeepOpen="@HandleSongAddedKeepOpen"/>
}

@if (itemToRemove is not null)
{
    <div class="fixed inset-0 bg-black/40 z-200 flex items-center justify-center p-4" @onclick="CancelRemove">
        <div class="bg-white dark:bg-neutral-800 dark:text-neutral-100 rounded-2xl shadow-2xl p-6 w-full max-w-sm space-y-4"
             @onclick:stopPropagation="true">
            <div class="font-semibold text-lg">Ta bort</div>
            <div>Vill du ta bort <strong>@itemToRemove.Title</strong>?</div>
            <div class="flex justify-end gap-3">
                <button class="px-4 py-2 rounded-full cursor-pointer hover:bg-neutral-100 dark:hover:bg-neutral-700"
                        @onclick="CancelRemove">
                    Avbryt
                </button>
                <button class="px-4 py-2 rounded-full bg-red-500 text-white cursor-pointer hover:bg-red-600"
                        @onclick="RemoveItemAsync">
                    Ta bort
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? PresentationId { get; set; }

    private string? loadedPresentationId;
    private Models.Presentation? loadedPresentation;
    private ProjectItem? itemToRemove;
    private Song? SelectedSong { get; set; }
    private string? SongCredits { get; set; }
    private BibleText? SelectedBibleText { get; set; }
    private Image? SelectedImage { get; set; }
    private bool showAddModal;
    private bool showSessionExpired;

    private DotNetObjectReference<Presentation>? dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            var isActive = SharedAppState.IsPresentationActive(AppState.SessionId);
            await JsRuntime.InvokeVoidAsync("initLiveViewButton", "live-view-container", dotNetRef, isActive, AppState.SessionId);
        }
    }

    [JSInvokable]
    public void OnPresentationStateChanged(bool active)
    {
        SharedAppState.SetPresentationActive(AppState.SessionId, active);
    }

    protected override void OnInitialized()
    {
        AppState.PropertyChanged += OnPropertyChanged;
        SharedAppState.PropertyChanged += OnPropertyChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (PresentationId == loadedPresentationId) return;
        loadedPresentationId = PresentationId;

        await LoadPresentationAsync();
        GetDataForSelectedItem();
    }

    private async Task LoadPresentationAsync()
    {
        if (PresentationId is null) return;

        loadedPresentation = await PresentationService.GetPresentationByIdAsync(PresentationId);
        if (loadedPresentation is null)
        {
            AppState.SelectedProject = null;
            AppState.SelectedProjectItem = null;
            return;
        }

        AppState.SelectedProject = new Project
        {
            Id = loadedPresentation.Id,
            Name = loadedPresentation.Name,
            Items = loadedPresentation.Items.Select(item => new ProjectItem
            {
                Id = item.Id,
                SourceId = item.SourceId,
                Type = item.Type switch
                {
                    PresentationItemType.Song => ProjectItemType.Song,
                    PresentationItemType.BibleText => ProjectItemType.BibleText,
                    PresentationItemType.Image => ProjectItemType.Image,
                    _ => ProjectItemType.Song
                },
                Title = item.Title
            }).ToList()
        };

        var liveItemId = SharedAppState.GetLiveSlide(AppState.SessionId).ProjectItemId;
        var activeItem = liveItemId is not null
            ? AppState.SelectedProject.Items.FirstOrDefault(x => x.Id == liveItemId)
            : null;
        AppState.SelectedProjectItem = activeItem;
    }

    public void Dispose()
    {
        AppState.PropertyChanged -= OnPropertyChanged;
        SharedAppState.PropertyChanged -= OnPropertyChanged;
        dotNetRef?.Dispose();
    }

    private void OnPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(AppState.SelectedProjectItem))
        {
            GetDataForSelectedItem();
            _ = InvokeAsync(StateHasChanged);
        }
        else if (e.PropertyName is
                 nameof(AppState.MainViewport) or
                 nameof(AppState.IsMenuVisible))
        {
            _ = InvokeAsync(StateHasChanged);
        }
        else if (sender is SharedAppState && e.PropertyName == AppState.SessionId)
        {
            if (SharedAppState.IsSessionExpired(AppState.SessionId))
            {
                showSessionExpired = true;
                SharedAppState.ClearSessionExpired(AppState.SessionId);
            }

            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void GetDataForSelectedItem()
    {
        SelectedSong = null;
        SongCredits = null;
        SelectedBibleText = null;
        SelectedImage = null;

        switch (AppState.SelectedProjectItem?.Type)
        {
            case ProjectItemType.Song:
                var songSourceId = AppState.SelectedProjectItem.SourceId;
                if (songSourceId is not null)
                    SelectedSong = SongService.GetSongById(songSourceId);
                if (SelectedSong is null)
                {
                    // Fallback: reconstruct from saved parts (legacy data)
                    var songItem = loadedPresentation?.Items.FirstOrDefault(x => x.Id == AppState.SelectedProjectItem.Id);
                    if (songItem is not null && songItem.Parts.Count > 0)
                    {
                        SelectedSong = new Song(
                            songItem.SourceId ?? songItem.Id,
                            songItem.Title,
                            null, null, null, null,
                            songItem.Parts.Select(p => new SongPart(null, p.Content)).ToList()
                        );
                    }
                }
                SongCredits = FormatSongCredits(SelectedSong);
                break;
            case ProjectItemType.BibleText:
                var dbItem = loadedPresentation?.Items.FirstOrDefault(x => x.Id == AppState.SelectedProjectItem.Id);
                if (dbItem is not null)
                {
                    SelectedBibleText = new BibleText(
                        dbItem.Id,
                        dbItem.Title,
                        dbItem.Parts.Select(p => p.Content).ToList()
                    );
                }
                break;
            case ProjectItemType.Image:
                SelectedImage = ImageService.GetImageById(AppState.SelectedProjectItem.Id);
                break;
        }
    }

    private void SetSelectedLiveSlide(string selectedItemId, int partIndex)
    {
        var projectItem = AppState.SelectedProject?.Items.FirstOrDefault(x => x.Id == selectedItemId);
        if (projectItem is null) return;

        string? text = null;
        string? credits = null;
        string? imageUrl = null;
        SongPart? songPart = null;

        switch (projectItem.Type)
        {
            case ProjectItemType.Song:
            {
                Song? song = null;
                if (projectItem.SourceId is not null)
                    song = SongService.GetSongById(projectItem.SourceId);
                if (song is null)
                {
                    // Fallback: reconstruct from saved parts (legacy data)
                    var songItem = loadedPresentation?.Items.FirstOrDefault(x => x.Id == projectItem.Id);
                    if (songItem is not null && songItem.Parts.Count > 0)
                    {
                        song = new Song(songItem.SourceId ?? songItem.Id, songItem.Title, null, null, null, null,
                            songItem.Parts.Select(p => new SongPart(null, p.Content)).ToList());
                    }
                }
                if (song is not null && partIndex < song.Parts.Count)
                {
                    songPart = song.Parts[partIndex];
                    text = songPart.Content.Replace("\n", "<br>");
                    credits = FormatSongCredits(song);
                }

                break;
            }
            case ProjectItemType.Image:
            {
                var image = ImageService.GetImageById(projectItem.Id);
                if (image is not null)
                {
                    imageUrl = image.Url;
                }

                break;
            }
            case ProjectItemType.BibleText:
            {
                var bibleItem = loadedPresentation?.Items.FirstOrDefault(x => x.Id == projectItem.Id);
                if (bibleItem is not null && partIndex < bibleItem.Parts.Count)
                {
                    text = bibleItem.Parts[partIndex].Content;
                    credits = bibleItem.Title;
                }

                break;
            }
            default:
                return;
        }

        SharedAppState.SetLiveSlide(AppState.SessionId, SharedAppState.GetLiveSlide(AppState.SessionId) with
        {
            Status = LiveSlideStatus.ShowingPresentation,
            ItemType = projectItem.Type,
            ProjectItemId = selectedItemId,
            ItemPartIndex = partIndex,
            Text = text,
            Credits = credits,
            ImageUrl = imageUrl,
            SongPart = songPart
        });
    }

    private void ConfirmRemoveItem(ProjectItem item)
    {
        itemToRemove = item;
    }

    private void DismissSessionExpired()
    {
        showSessionExpired = false;
    }

    private void CancelRemove()
    {
        itemToRemove = null;
    }

    private async Task RemoveItemAsync()
    {
        if (itemToRemove is null || AppState.SelectedProject is null) return;

        var removedItem = itemToRemove;
        itemToRemove = null;

        AppState.SelectedProject.Items.Remove(removedItem);
        loadedPresentation?.Items.RemoveAll(x => x.Id == removedItem.Id);

        if (AppState.SelectedProjectItem?.Id == removedItem.Id)
        {
            AppState.SelectedProjectItem = null;
        }

        AppState.NotifyProjectChanged();

        if (PresentationId is not null)
        {
            await PresentationService.RemoveItemAsync(PresentationId, removedItem.Id);
        }
    }

    private async Task HandleItemsReordered(List<string> itemIds)
    {
        if (loadedPresentation is not null)
        {
            loadedPresentation.Items = loadedPresentation.Items
                .OrderBy(x => itemIds.IndexOf(x.Id))
                .ToList();
        }

        if (PresentationId is not null)
        {
            await PresentationService.ReorderItemsAsync(PresentationId, itemIds);
        }
    }

    private void OpenAddModal()
    {
        showAddModal = true;
    }

    private void CloseAddModal()
    {
        showAddModal = false;
    }

    private static string? FormatSongCredits(Song? song)
    {
        if (song is null) return null;
        var parts = new[]
            {
                song.Author,
                string.IsNullOrEmpty(song.Publisher) ? null : $"© {song.Publisher}",
                song.Year?.ToString()
            }
            .Where(s => !string.IsNullOrEmpty(s))
            .ToList();
        return parts.Count > 0 ? string.Join(" · ", parts) : null;
    }

    private async Task HandleBibleVersesAdded(List<Verse> verses)
    {
        showAddModal = false;
        await AddBibleVerses(verses);
    }

    private async Task HandleBibleVersesAddedKeepOpen(List<Verse> verses)
    {
        await AddBibleVerses(verses);
    }

    private async Task AddBibleVerses(List<Verse> verses)
    {
        var bibleText = BibleTextService.Create(verses);
        var itemId = Guid.NewGuid().ToString();
        var projectItem = new ProjectItem
        {
            Id = itemId,
            Type = ProjectItemType.BibleText,
            Title = bibleText.Title
        };

        var presentationItem = new PresentationItem
        {
            Id = itemId,
            Type = PresentationItemType.BibleText,
            Title = bibleText.Title
        };

        foreach (var (part, index) in bibleText.Parts.Select((p, i) => (p, i)))
        {
            presentationItem.Parts.Add(new PresentationItemPart
            {
                Content = part,
                SortOrder = index
            });
        }

        loadedPresentation?.Items.Add(presentationItem);
        AppState.SelectedProject?.Items.Add(projectItem);
        AppState.SelectedProjectItem = projectItem;

        if (PresentationId is not null)
        {
            await PresentationService.AddItemAsync(PresentationId, presentationItem);
        }
    }

    private async Task HandleSongAdded(Song song)
    {
        showAddModal = false;
        await AddSong(song);
    }

    private async Task HandleSongAddedKeepOpen(Song song)
    {
        await AddSong(song);
    }

    private async Task AddSong(Song song)
    {
        var itemId = Guid.NewGuid().ToString();
        var projectItem = new ProjectItem
        {
            Id = itemId,
            SourceId = song.Id,
            Type = ProjectItemType.Song,
            Title = song.Name
        };

        var presentationItem = new PresentationItem
        {
            Id = itemId,
            SourceId = song.Id,
            Type = PresentationItemType.Song,
            Title = song.Name
        };

        loadedPresentation?.Items.Add(presentationItem);
        AppState.SelectedProject?.Items.Add(projectItem);
        AppState.SelectedProjectItem = projectItem;

        if (PresentationId is not null)
        {
            await PresentationService.AddItemAsync(PresentationId, presentationItem);
        }
    }

}
