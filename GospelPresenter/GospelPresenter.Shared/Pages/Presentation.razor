    <Dialog Class="bg-white dark:bg-neutral-800 max-w-sm" OnClose="CancelDeletePresentation">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg">@(IsTemplateMode ? L["Sidebar.DeleteTemplate"] : L["Presentation.DeletePresentation"])</div>
            <div>
                @if (IsTemplateMode)
                {
                    @L["Templates.DeleteConfirm"]
                }
                else
                {
                    @((MarkupString)L["Presentation.ConfirmDeletePresentation", AppState.SelectedProject?.Name ?? ""].Value)
                }
            </div>
            <div class="flex justify-end gap-3">
                <AppButton Variant="ButtonVariant.Cancel" OnClick="CancelDeletePresentation">
