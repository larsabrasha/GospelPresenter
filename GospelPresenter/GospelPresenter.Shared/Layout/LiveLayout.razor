@using GospelPresenter.Shared.Components
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State

@inherits LayoutComponentBase

@inject IStatusBarService StatusBarService
@inject AppState AppState

<ViewportMonitor OnViewportChanged="viewport => AppState.PresentationViewport = viewport"/>

@{
    var statusBarHeight = StatusBarService.GetStatusBarHeight();
    var statusBarStyle = $"padding-top: {statusBarHeight}px";
}
<div class="flex h-full relative dark:text-neutral-200 bg-black mx-auto" style="@statusBarStyle">
    @Body
</div>

@* No error bar here, deliberately. This layout only serves /live and /display — a projector or a
   TV with a congregation in front of it. An error message belongs on the operator's own screen,
   where MainLayout has one; here the last rendered slide is left standing instead. app.css hides
   the framework's reconnection dialog on the same two routes. *@

