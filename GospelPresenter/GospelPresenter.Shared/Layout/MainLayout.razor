@using GospelPresenter.Shared.Components
@using GospelPresenter.Shared.Components.Symbols
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.Components.Authorization

@inherits LayoutComponentBase

@inject AppState AppState
@inject SharedAppState SharedAppState
@inject ActiveOrganizationState OrgState
@inject IUserService UserService
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

<ViewportMonitor OnViewportChanged="viewport => AppState.MainViewport = viewport"/>

<AuthorizeView>
    <Authorized>
        <nav class="flex items-center justify-between px-4 h-12 shrink-0 border-b-[0.5px] border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-800">
            <div class="flex items-center gap-3">
                <a href="/" class="flex items-center gap-2 text-sky-500 hover:text-sky-600">
                    <LogoSymbol Class="size-6"/>
                    <span class="text-sm font-semibold uppercase tracking-wide">
                        <span class="text-sky-500">Gospel</span> <span class="text-sky-400">Presenter</span>
                    </span>
                </a>
                <span class="inline-flex items-center rounded-full bg-red-500 px-2.5 py-0.5 text-xs font-semibold text-white">
                    Alpha
                </span>
            </div>
            <div class="flex items-center gap-6">
                <SyncStatusIndicator/>
                <AdminMenu/>
                <OrganizationSwitcher/>
                <LoginDisplay/>
            </div>
        </nav>
        <div class="flex-1 min-h-0 overflow-auto">
            @if (string.IsNullOrEmpty(AppState.SessionId) || !OrgState.IsInitialized)
            {
                <div></div>
            }
            else
            {
                @Body
            }
        </div>
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@implements IDisposable

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }



    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var state = await AuthState;
        var userId = state.User.FindFirst("user_id")?.Value;
        if (userId is null) return;

        var roleString = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        var role = Enum.TryParse<UserRole>(roleString, out var parsed) ? parsed : UserRole.User;
        var orgId = state.User.FindFirst("organization_id")?.Value;

        OrgState.Initialize(userId, role, orgId);

        if (OrgState.IsSuperAdmin && OrgState.SelectedOrganizationId is null)
        {
            var callerContext = new CallerContext(userId, role, orgId);
            Organization? org = null;

            var savedOrgId = await UserService.GetUserSettingAsync(userId, UserSetting.LastSelectedOrganizationId, callerContext);
            if (savedOrgId is not null)
            {
                org = await UserService.GetOrganizationByIdAsync(savedOrgId, callerContext);
            }

            if (org is null)
            {
                var allOrgs = await UserService.GetAllOrganizationsAsync(callerContext);
                org = allOrgs.FirstOrDefault();
            }

            if (org is not null)
            {
                OrgState.SwitchOrganization(org.Id, org.Name);
            }
            else
            {
                OrgState.MarkInitialized();
                var currentPath = new Uri(NavigationManager.Uri).AbsolutePath;
                if (!currentPath.StartsWith("/admin/organizations", StringComparison.OrdinalIgnoreCase))
                {
                    NavigationManager.NavigateTo("/admin/organizations");
                }
                return;
            }
        }

        OrgState.MarkInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            AppState.SessionId = await JsRuntime.InvokeAsync<string>("getOrCreateSessionId");
            StateHasChanged();
        }
    }

    public void Dispose()
    {
    }
}

<ToastContainer/>

<div id="blazor-error-ui" data-nosnippet
     class="
hidden
bg-yellow-50
fixed
left-0
bottom-0
w-full
z-1000
p-3">
    @L["MainLayout.UnexpectedError"]
    <a href="." class="bg-green-500 text-white mx-3 px-3 py-2 rounded-xl">@L["MainLayout.Reload"]</a>
</div>
