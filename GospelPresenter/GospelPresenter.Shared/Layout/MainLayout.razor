@using GospelPresenter.Shared.Components
@using GospelPresenter.Shared.State

@inherits LayoutComponentBase

@inject AppState AppState
@inject IJSRuntime JsRuntime

<ViewportMonitor OnViewportChanged="viewport => AppState.MainViewport = viewport"/>

@if (string.IsNullOrEmpty(AppState.SessionId))
{
    <div></div>
}
else
{
    @Body
}

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            AppState.SessionId = await JsRuntime.InvokeAsync<string>("getOrCreateSessionId");
            StateHasChanged();
        }
    }
}

<div id="blazor-error-ui" data-nosnippet
     class="
hidden
bg-yellow-50
fixed
left-0
bottom-0
w-full
z-1000
p-3">
    Ett oväntat fel har inträffat.
    <a href="." class="bg-green-500 text-white mx-3 px-3 py-2 rounded-xl">Ladda om</a>
</div>
