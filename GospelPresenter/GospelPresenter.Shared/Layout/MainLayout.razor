@using GospelPresenter.Shared.Components
@using GospelPresenter.Shared.Components.Symbols
@using GospelPresenter.Shared.State

@inherits LayoutComponentBase

@inject AppState AppState
@inject IJSRuntime JsRuntime

<ViewportMonitor OnViewportChanged="viewport => AppState.MainViewport = viewport"/>

<AuthorizeView>
    <Authorized>
        <nav class="flex items-center justify-between px-4 h-12 shrink-0 border-b border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-800">
            <a href="/" class="flex items-center gap-2 text-sky-500 hover:text-sky-600">
                <LogoSymbol Class="size-6"/>
                <span class="text-sm font-semibold uppercase tracking-wide">
                    <span class="text-sky-500">Gospel</span> <span class="text-sky-400">Presenter</span>
                </span>
            </a>
            <LoginDisplay/>
        </nav>
        <div class="flex-1 min-h-0">
            @if (string.IsNullOrEmpty(AppState.SessionId))
            {
                <div></div>
            }
            else
            {
                @Body
            }
        </div>
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            AppState.SessionId = await JsRuntime.InvokeAsync<string>("getOrCreateSessionId");
            StateHasChanged();
        }
    }
}

<div id="blazor-error-ui" data-nosnippet
     class="
hidden
bg-yellow-50
fixed
left-0
bottom-0
w-full
z-1000
p-3">
    Ett oväntat fel har inträffat.
    <a href="." class="bg-green-500 text-white mx-3 px-3 py-2 rounded-xl">Ladda om</a>
</div>
