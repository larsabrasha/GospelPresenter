@using GospelPresenter.Shared.Components.Symbols
@using Microsoft.AspNetCore.Components.Authorization

@using GospelPresenter.Shared.Services

@inherits LayoutComponentBase
@implements IDisposable
@layout MainLayout

@inject NavigationManager NavigationManager
@inject IAppCapabilities Capabilities

@{
    var backdropClass = menuVisible ? "visible opacity-100" : "invisible opacity-0";
    var sidebarClass = menuVisible ? "visible translate-x-0" : "invisible -translate-x-full";
}

<div class="flex h-full relative">
    <div
        class="bg-black/30 z-100 absolute inset-0 transition-opacity lg:invisible @backdropClass"
        @onclick="() => menuVisible = false">
    </div>
    <aside class="w-[var(--navmenu-width)] shrink-0 bg-white dark:bg-neutral-800 overflow-y-auto
                  duration-200 ease-in-out absolute inset-y-0 left-0 z-110 shadow-xl
                  lg:relative lg:inset-auto lg:z-0 lg:shadow-none lg:visible lg:translate-x-0 @sidebarClass">
        <nav class="flex flex-col py-3">
                <a href="/admin/songs"
                   @onclick="OnSidebarNavClick"
                   class="@NavClass("/admin/songs") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                    <MusicalNoteSymbol Class="w-4 h-4 shrink-0"/>
                    @L["Nav.Songs"]
                </a>
                <a href="/admin/bibles"
                   @onclick="OnSidebarNavClick"
                   class="@NavClass("/admin/bibles") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                    <BookOpenSymbol Class="w-4 h-4 shrink-0"/>
                    @L["Nav.Bibles"]
                </a>
                <a href="/admin/images"
                   @onclick="OnSidebarNavClick"
                   class="@NavClass("/admin/images") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                    <PhotoSymbol Class="w-4 h-4 shrink-0"/>
                    @L["Nav.Images"]
                </a>
                <a href="/admin/audios"
                   @onclick="OnSidebarNavClick"
                   class="@NavClass("/admin/audios") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                    <SpeakerWaveSymbol Class="w-4 h-4 shrink-0"/>
                    @L["Nav.Audios"]
                </a>

                <div class="my-3 mx-4 h-px bg-neutral-200 dark:bg-neutral-700"></div>

                <a href="/admin/overlays"
                   @onclick="OnSidebarNavClick"
                   class="@NavClass("/admin/overlays") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                    <SquaresOverlapSymbol Class="w-4 h-4 shrink-0"/>
                    @L["Nav.Overlays"]
                </a>
                <a href="/admin/templates"
                   @onclick="OnSidebarNavClick"
                   class="@NavClass("/admin/templates") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                    <ViewGridSymbol Class="w-4 h-4 shrink-0"/>
                    @L["Nav.Templates"]
                </a>
                <a href="/admin/labels"
                   @onclick="OnSidebarNavClick"
                   class="@NavClass("/admin/labels") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                    <TagSymbol Class="w-4 h-4 shrink-0"/>
                    @L["Nav.Labels"]
                </a>

                <div class="my-3 mx-4 h-px bg-neutral-200 dark:bg-neutral-700"></div>

                @* Remote displays pair with the web server; the device app has nothing to pair with. *@
                @if (Capabilities.RemoteDisplays)
                {
                    <a href="/admin/displays"
                       @onclick="OnSidebarNavClick"
                       class="@NavClass("/admin/displays") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                        <ComputerDesktopSymbol Class="w-4 h-4 shrink-0"/>
                        @L["Nav.Displays"]
                    </a>
                }
                <a href="/admin/themes"
                   @onclick="OnSidebarNavClick"
                   class="@NavClass("/admin/themes") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                    <Bars4Symbol Class="w-4 h-4 shrink-0"/>
                    @L["Nav.Themes"]
                </a>
                <a href="/admin/ccli-report"
                   @onclick="OnSidebarNavClick"
                   class="@NavClass("/admin/ccli-report") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                    <DocumentDuplicateSymbol Class="w-4 h-4 shrink-0"/>
                    @L["Nav.CcliReport"]
                </a>

                @* Users, invites, organisations and API keys live outside the sync protocol:
                   administer them on the web, where the source of truth is. *@
                @if (Capabilities.UserAdministration)
                {
                    <div class="my-3 mx-4 h-px bg-neutral-200 dark:bg-neutral-700"></div>

                    <a href="/admin/users"
                       @onclick="OnSidebarNavClick"
                       class="@NavClass("/admin/users") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                        <UsersSymbol Class="w-4 h-4 shrink-0"/>
                        @L["Nav.Users"]
                    </a>
                    @* Installed apps and their versions — the same gate as the user list, since a
                       device belongs to a user and the audience is the same. *@
                    <a href="/admin/devices"
                       @onclick="OnSidebarNavClick"
                       class="@NavClass("/admin/devices") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                             stroke="currentColor" class="w-4 h-4 shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25"/>
                        </svg>
                        @L["Nav.Devices"]
                    </a>
                    <AuthorizeView Policy="@ManageOrganizations" Context="superAdminContext">
                        <a href="/admin/organizations"
                           @onclick="OnSidebarNavClick"
                           class="@NavClass("/admin/organizations") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                            <Squares2x2Symbol Class="w-4 h-4 shrink-0"/>
                            @L["Nav.Organizations"]
                        </a>
                        <a href="/admin/api-keys"
                           @onclick="OnSidebarNavClick"
                           class="@NavClass("/admin/api-keys") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                            <KeySymbol Class="w-4 h-4 shrink-0"/>
                            @L["Nav.ApiKeys"]
                        </a>
                    </AuthorizeView>
                }
        </nav>
    </aside>
    <main class="flex-1 overflow-hidden flex flex-col relative">
        @Body
        <div class="flex items-center absolute bottom-0 left-0 right-0 justify-between p-3 z-10 pointer-events-none lg:hidden">
            <div class="pointer-events-auto">
                <MenuToggleButton OnClick="() => menuVisible = true"/>
            </div>
        </div>
    </main>
</div>

@code {
    private string currentPath = "";
    private bool menuVisible = true;
    private bool navigatingFromSidebar;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateCurrentPath();
    }

    private void OnSidebarNavClick()
    {
        navigatingFromSidebar = true;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var previousPath = currentPath;
        UpdateCurrentPath();

        if (navigatingFromSidebar)
        {
            menuVisible = false;
            navigatingFromSidebar = false;
        }
        else if (!previousPath.StartsWith("/admin", StringComparison.OrdinalIgnoreCase))
        {
            menuVisible = true;
        }

        InvokeAsync(StateHasChanged);
    }

    private void UpdateCurrentPath()
    {
        currentPath = new Uri(NavigationManager.Uri).AbsolutePath;
    }

    private string NavClass(string path)
    {
        var isActive = currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
        return isActive
            ? "bg-sky-500 text-white"
            : "text-neutral-600 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-700";
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
