@using GospelPresenter.Shared.Components.Symbols
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.Components.Authorization

@inherits LayoutComponentBase
@implements IDisposable
@layout MainLayout

@inject NavigationManager NavigationManager
@inject ActiveOrganizationState OrgState

@{
    var backdropClass = menuVisible ? "visible opacity-100" : "invisible opacity-0";
    var sidebarClass = menuVisible ? "visible translate-x-0" : "invisible -translate-x-full";
}

<div class="flex h-full relative">
    <div
        class="bg-black/30 z-100 absolute inset-0 transition-opacity lg:invisible @backdropClass"
        @onclick="() => menuVisible = false">
    </div>
    <aside class="w-[var(--navmenu-width)] shrink-0 bg-white dark:bg-neutral-800 overflow-y-auto
                  duration-200 ease-in-out absolute inset-y-0 left-0 z-110 shadow-xl
                  lg:relative lg:inset-auto lg:z-0 lg:shadow-none lg:visible lg:translate-x-0 @sidebarClass">
        <nav class="flex flex-col py-3">
            @if (IsContentSection)
            {
                <div class="px-4 py-2 text-xs font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                    @L["Nav.Media"]
                </div>
                <a href="/admin/songs"
                   @onclick="() => menuVisible = false"
                   class="@NavClass("/admin/songs") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 shrink-0">
                        <path d="M17.721 1.599a.75.75 0 0 1 .279.584v11.29a2.25 2.25 0 0 1-1.774 2.198l-2.041.442a2.216 2.216 0 1 1-.938-4.333l2.478-.536V5.749L9 7.889v8.584a2.25 2.25 0 0 1-1.774 2.198l-2.042.442a2.216 2.216 0 1 1-.938-4.333l2.504-.542V3.523a.75.75 0 0 1 .558-.724l7.5-2a.75.75 0 0 1 .913.8Z"/>
                    </svg>
                    @L["Nav.Songs"]
                </a>
                <a href="/admin/overlays"
                   @onclick="() => menuVisible = false"
                   class="@NavClass("/admin/overlays") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 shrink-0">
                        <path fill-rule="evenodd" d="M2 4.25A2.25 2.25 0 0 1 4.25 2h6.5A2.25 2.25 0 0 1 13 4.25v1.5h2.75A2.25 2.25 0 0 1 18 8v7.75A2.25 2.25 0 0 1 15.75 18H9.25A2.25 2.25 0 0 1 7 15.75v-1.5H4.25A2.25 2.25 0 0 1 2 12V4.25Zm5 9.25v2.25c0 .414.336.75.75.75h6.5a.75.75 0 0 0 .75-.75V8a.75.75 0 0 0-.75-.75H13v4.75A2.25 2.25 0 0 1 10.75 14.25h-3.75Z" clip-rule="evenodd"/>
                    </svg>
                    @L["Nav.Overlays"]
                </a>
            }
            else
            {
                <div class="px-4 py-2 text-xs font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                    @L["Nav.Administration"]
                </div>
                <a href="/admin/users"
                   @onclick="() => menuVisible = false"
                   class="@NavClass("/admin/users") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 shrink-0">
                        <path d="M7 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM14.5 9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM1.615 16.428a1.224 1.224 0 0 1-.569-1.175 6.002 6.002 0 0 1 11.908 0c.058.467-.172.92-.57 1.174A9.953 9.953 0 0 1 7 18a9.953 9.953 0 0 1-5.385-1.572ZM14.5 16h-.106c.07-.297.088-.611.048-.933a7.47 7.47 0 0 0-1.588-3.755 4.502 4.502 0 0 1 5.874 2.636.818.818 0 0 1-.36.98A7.465 7.465 0 0 1 14.5 16Z"/>
                    </svg>
                    @L["Nav.Users"]
                </a>

                <AuthorizeView Roles="SuperAdmin" Context="superAdminContext">
                    <a href="/superadmin/organizations"
                       @onclick="() => menuVisible = false"
                       class="@NavClass("/superadmin/organizations") flex items-center gap-3 mx-2 px-3 py-2.5 rounded-lg text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 shrink-0">
                            <path fill-rule="evenodd" d="M4.25 2A2.25 2.25 0 0 0 2 4.25v2.5A2.25 2.25 0 0 0 4.25 9h2.5A2.25 2.25 0 0 0 9 6.75v-2.5A2.25 2.25 0 0 0 6.75 2h-2.5Zm0 9A2.25 2.25 0 0 0 2 13.25v2.5A2.25 2.25 0 0 0 4.25 18h2.5A2.25 2.25 0 0 0 9 15.75v-2.5A2.25 2.25 0 0 0 6.75 11h-2.5Zm9-9A2.25 2.25 0 0 0 11 4.25v2.5A2.25 2.25 0 0 0 13.25 9h2.5A2.25 2.25 0 0 0 18 6.75v-2.5A2.25 2.25 0 0 0 15.75 2h-2.5Zm0 9A2.25 2.25 0 0 0 11 13.25v2.5A2.25 2.25 0 0 0 13.25 18h2.5A2.25 2.25 0 0 0 18 15.75v-2.5A2.25 2.25 0 0 0 15.75 11h-2.5Z" clip-rule="evenodd"/>
                        </svg>
                        @L["Nav.Organizations"]
                    </a>
                </AuthorizeView>
            }
        </nav>
    </aside>
    <main class="flex-1 overflow-y-auto relative">
        @Body
        <div class="flex items-center absolute bottom-0 left-0 right-0 justify-between p-3 z-10 pointer-events-none lg:hidden">
            <div class="pointer-events-auto">
                <button class="cursor-pointer p-4 bg-white dark:bg-neutral-800 rounded-full shadow-2xl"
                        @onclick="() => menuVisible = true">
                    <Bars3Symbol Class="size-8"/>
                </button>
            </div>
        </div>
    </main>
</div>

@code {
    private string currentPath = "";
    private bool menuVisible;

    private bool IsContentSection =>
        currentPath.StartsWith("/admin/songs", StringComparison.OrdinalIgnoreCase) ||
        currentPath.StartsWith("/admin/overlays", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateCurrentPath();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateCurrentPath();
        menuVisible = false;
        InvokeAsync(StateHasChanged);
    }

    private void UpdateCurrentPath()
    {
        currentPath = new Uri(NavigationManager.Uri).AbsolutePath;
    }

    private string NavClass(string path)
    {
        var isActive = currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
        return isActive
            ? "bg-sky-500 text-white"
            : "text-neutral-600 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-700";
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
