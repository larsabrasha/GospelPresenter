<div class="flex text-center text-sm font-bold">
    @for (var i = 0; i < TabTitles.Count; i++)
    {
        var index = i;
        var tabClass = index == SelectedTabIndex
            ? "border-green-500"
            : "border-neutral-200 dark:border-neutral-600";
        var tabTitle = TabTitles[index];
        <button class="flex-1 py-2 cursor-pointer border-b-2 @tabClass" @onclick="() => OnSelectTabAtIndex.InvokeAsync(index)">@tabTitle</button>
    }
</div>

@code {
    [Parameter] public int SelectedTabIndex { get; set; }
    [Parameter] public required IList<string> TabTitles { get; set; }
    [Parameter] public EventCallback<int> OnSelectTabAtIndex { get; set; }
}

