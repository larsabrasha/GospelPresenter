@if (Href is not null)
{
    <a href="@Href" target="@Target" title="@Title" download="@Download"
       class="@CombinedClass">
        @ChildContent
    </a>
}
else if (AsLabel)
{
    <label title="@Title" class="@LabelClass">
        @ChildContent
    </label>
}
else
{
    <button type="@(Type ?? "button")" disabled="@(Disabled || Loading)" title="@Title"
            class="@CombinedClass" @onclick="OnClick" data-copy-text="@CopyText">
        @if (Loading)
        {
            <svg class="animate-spin size-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
            </svg>
        }
        @ChildContent
    </button>
}

@code {
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Target { get; set; }
    [Parameter] public string? Download { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Type { get; set; }
    [Parameter] public bool AsLabel { get; set; }
    [Parameter] public bool Filled { get; set; }
    [Parameter] public string? CopyText { get; set; }

    private string BaseClasses => Variant switch
    {
        ButtonVariant.Primary =>
            "whitespace-nowrap text-sm px-4 py-2.5 rounded-full bg-sky-500 text-white cursor-pointer hover:bg-sky-600 disabled:opacity-50 disabled:cursor-default",
        ButtonVariant.Secondary =>
            "whitespace-nowrap text-sm px-4 py-2.5 rounded-full text-sky-600 dark:text-sky-400 bg-sky-50 dark:bg-sky-900/30 cursor-pointer hover:bg-sky-100 dark:hover:bg-sky-900/50 disabled:opacity-50 disabled:cursor-default",
        ButtonVariant.Neutral =>
            "whitespace-nowrap text-sm px-4 py-2.5 rounded-full text-neutral-600 dark:text-neutral-400 bg-neutral-200 dark:bg-neutral-700 cursor-pointer hover:bg-neutral-300 dark:hover:bg-neutral-600 disabled:opacity-50 disabled:cursor-default",
        ButtonVariant.Cancel =>
            "whitespace-nowrap text-sm px-4 py-2.5 rounded-full text-neutral-500 dark:text-neutral-400 cursor-pointer hover:bg-neutral-200 dark:hover:bg-neutral-600",
        ButtonVariant.Danger when Filled =>
            "whitespace-nowrap text-sm px-4 py-2.5 rounded-full bg-red-500 text-white cursor-pointer hover:bg-red-600 disabled:opacity-50 disabled:cursor-default",
        ButtonVariant.Danger =>
            "whitespace-nowrap px-4 py-2.5 rounded-full text-sm text-red-600 dark:text-red-400 cursor-pointer bg-red-50 dark:bg-red-950/40 hover:bg-red-100 dark:hover:bg-red-950/60",
        // disabled:hover:bg-transparent because :hover still matches a disabled button in CSS, so
        // without it a dead control still lights up under the pointer.
        ButtonVariant.Icon =>
            "size-8 flex items-center justify-center rounded-full cursor-pointer hover:bg-neutral-200 dark:hover:bg-neutral-600 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 disabled:opacity-40 disabled:cursor-default disabled:hover:bg-transparent",
        ButtonVariant.DangerIcon =>
            "size-8 flex items-center justify-center rounded-full cursor-pointer text-red-500 dark:text-red-400 hover:bg-red-100 dark:hover:bg-red-950/60 disabled:opacity-50 disabled:cursor-default",
        _ => ""
    };

    private string CombinedClass => string.IsNullOrEmpty(Class) ? BaseClasses : $"{BaseClasses} {Class}";

    private string LabelClass => Disabled
        ? $"{CombinedClass} opacity-50 !cursor-default pointer-events-none"
        : CombinedClass;
}
