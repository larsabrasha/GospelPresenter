@using System.Globalization
@using GospelPresenter.Shared.State

<div>
    <button type="button"
            @onclick="Toggle"
            class="w-full flex items-center justify-between p-5 text-left cursor-pointer">
        <h2 class="text-base font-semibold">@Title</h2>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
             class="size-5 transition-transform @(isExpanded ? "rotate-180" : "")">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
        </svg>
    </button>
    @if (isExpanded)
    {
        <div class="px-5 pb-5 grid grid-cols-1 gap-5">
            <div>
                <FloatingSelect Id="slide-font-family"
                                Label="@L["SlideSettings.FontFamily"].Value"
                                Value="@Style.FontFamily"
                                OnChange="OnFontFamilyChanged">
                    @foreach (var option in SlideFontFamilies.Options)
                    {
                        <option value="@option.Value">@L[option.LocalizationKey]</option>
                    }
                </FloatingSelect>
            </div>

            <div>
                <FloatingSelect Id="slide-font-weight"
                                Label="@L["SlideSettings.FontWeight"].Value"
                                Value="@Style.FontWeight"
                                OnChange="OnFontWeightChanged">
                    @foreach (var option in SlideFontWeights.Options)
                    {
                        <option value="@option.Value">@L[option.LocalizationKey] (@option.Value)</option>
                    }
                </FloatingSelect>
            </div>

            <div>
                <div class="flex items-center justify-between mb-1">
                    <label class="block text-sm font-medium">@L["SlideSettings.FontSize"]</label>
                    <span class="text-sm font-mono">@(Style.FontSize) px</span>
                </div>
                <input type="range"
                       min="@FontSizeMin"
                       max="@FontSizeMax"
                       step="1"
                       value="@Style.FontSize"
                       @oninput="OnFontSizeInput"
                       class="w-full accent-sky-500"/>
            </div>

            <div>
                <div class="flex items-center justify-between mb-1">
                    <label class="block text-sm font-medium">@L["SlideSettings.LineHeight"]</label>
                    <span class="text-sm font-mono">@Style.LineHeight.ToString("0.0", CultureInfo.InvariantCulture)</span>
                </div>
                <input type="range"
                       min="@LineHeightMin.ToString(CultureInfo.InvariantCulture)"
                       max="@LineHeightMax.ToString(CultureInfo.InvariantCulture)"
                       step="@LineHeightStep.ToString(CultureInfo.InvariantCulture)"
                       value="@Style.LineHeight.ToString(CultureInfo.InvariantCulture)"
                       @oninput="OnLineHeightInput"
                       class="w-full accent-sky-500"/>
            </div>
        </div>
    }
</div>

@code {
    private const double LineHeightMin = 1.0;
    private const double LineHeightMax = 2.0;
    private const double LineHeightStep = 0.1;

    [Parameter] public required string Title { get; set; }
    [Parameter] public required SlideTextStyle Style { get; set; }
    [Parameter] public EventCallback<SlideTextStyle> StyleChanged { get; set; }
    [Parameter] public required int FontSizeMin { get; set; }
    [Parameter] public required int FontSizeMax { get; set; }

    private bool isExpanded;

    private void Toggle() => isExpanded = !isExpanded;

    private Task OnFontFamilyChanged(ChangeEventArgs e) =>
        StyleChanged.InvokeAsync(Style with { FontFamily = e.Value?.ToString() ?? SlideFontFamilies.Inter });

    private Task OnFontWeightChanged(ChangeEventArgs e) =>
        StyleChanged.InvokeAsync(Style with { FontWeight = int.TryParse(e.Value?.ToString(), out var w) ? w : 400 });

    private Task OnFontSizeInput(ChangeEventArgs e) =>
        StyleChanged.InvokeAsync(Style with { FontSize = int.TryParse(e.Value?.ToString(), out var v) ? v : Style.FontSize });

    private Task OnLineHeightInput(ChangeEventArgs e) =>
        StyleChanged.InvokeAsync(Style with { LineHeight = double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? v : Style.LineHeight });
}
