@implements IDisposable

<dialog @ref="dialogRef"
        class="animated top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-3xl shadow-lg w-full relative backdrop:bg-black/30 p-0 overflow-hidden text-neutral-900 dark:text-neutral-100 @Class"
        @onmousedown="HandleOnCloseAsync">
    <div class="rounded-3xl" @onmousedown:stopPropagation="true">
        <button class="absolute top-3 right-3 z-10 size-8 flex items-center justify-center rounded-full bg-neutral-100 dark:bg-neutral-700 hover:bg-neutral-200 dark:hover:bg-neutral-600 cursor-pointer text-neutral-500"
                @onclick="HandleOnCloseAsync">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
            </svg>
        </button>
        <div class="p-4 text-center">
            <h5>@Title</h5>
        </div>

        <div class="px-4 h-[40svh] flex flex-col">
            @Body
        </div>

        <div class="px-4 py-3">
            @Footer
        </div>
    </div>
</dialog>

@code {
    [Parameter] public RenderFragment? Title { get; set; }
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    [Inject] private IJSRuntime JsRuntime { get; set; } = default!;

    private ElementReference dialogRef;
    private DotNetObjectReference<Modal>? selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
            await JsRuntime.InvokeVoidAsync("showModal", dialogRef, selfRef);
        }
    }

    [JSInvokable]
    public async Task OnCancelFromJs()
    {
        await HandleOnCloseAsync();
        StateHasChanged();
    }

    private async Task HandleOnCloseAsync()
    {
        await JsRuntime.InvokeVoidAsync("closeModal", dialogRef);
        await OnClose.InvokeAsync();
    }

    public void Dispose()
    {
        selfRef?.Dispose();
    }
}
