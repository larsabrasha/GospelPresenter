<button @onclick="OnClick"
        class="flex items-center justify-between px-4 py-3 gap-4 cursor-pointer hover:bg-neutral-50 dark:hover:bg-neutral-600 @Class">
    <div class="flex gap-3 w-full">
        @if (LeftIcon is not null)
        {
            <div class="shrink-0">@LeftIcon</div>
        }
        <div class="flex flex-col w-full">
            <div class="text-left">@TitleContent</div>
            @if (Progress is not null)
            {
                <div class="flex-start flex h-0.5 w-full overflow-hidden rounded-full bg-gray-50 font-sans text-xs font-medium">
                    <div class="flex items-center justify-center h-full overflow-hidden text-white break-all bg-green-600 rounded-full"
                         style="width: @($"{Progress}")%">
                    </div>
                </div>
            }
            else
            {
                <div class="h-0.5"></div>
            }
        </div>
    </div>
    @if (RightIcon is not null)
    {
        <div class="shrink-0 text-right">@RightIcon</div>
    }
</button>

@code {
    [Parameter] public RenderFragment? LeftIcon { get; set; }
    [Parameter] public RenderFragment? TitleContent { get; set; }
    [Parameter] public RenderFragment? RightIcon { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public int? Progress { get; set; }
}
