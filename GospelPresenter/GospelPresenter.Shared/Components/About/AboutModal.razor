@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@inject AppState AppState
@inject IBuildInfoService BuildInfoService

<Modal OnClose="OnClose" Class="max-w-lg bg-white dark:bg-neutral-800">
    <Title>
        Om GospelPresenter
    </Title>
    <Body>
    <div class="text-sm">Version: @version</div>
    @if (branch is not null)
    {
        <div class="text-sm">Branch: @branch</div>
    }
    <div class="text-neutral-500 dark:text-neutral-400 text-xs pt-6">
        <button @onclick="ShowAcknowledgements" class="cursor-pointer hover:underline">
            Tillkännagivanden
        </button>
    </div>
    </Body>
</Modal>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string? version;
    private string? branch;

    protected override async Task OnInitializedAsync()
    {
        var buildInfo = await BuildInfoService.GetBuildInfoAsync();

        if (buildInfo is null)
        {
            version = string.Empty;
            return;
        }
        
        var shortCommit = buildInfo.Commit.Length >= 7 ? buildInfo.Commit[..7] : string.Empty;
        
        version = $"{buildInfo.Version} ({buildInfo.BuildNumber}) - {shortCommit}";
        branch = buildInfo.Branch is not null &&
                 (buildInfo.Branch.StartsWith("feature") ||
                  buildInfo.Branch.StartsWith("development"))
            ? buildInfo.Branch
            : null;
    }

    private void ShowAcknowledgements()
    {
        AppState.IsAboutModalVisible = false;
        AppState.IsAcknowledgementsModalVisible = true;
    }
}
