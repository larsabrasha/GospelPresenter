@using GospelPresenter.Shared.Components.Presentations
@using GospelPresenter.Shared.Components.Symbols
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State

@inject IPresentationService PresentationService
@inject IOnboardingService OnboardingService
@inject NavigationManager NavigationManager
@inject ActiveOrganizationState OrgState
@inject SharedAppState SharedAppState
@inject AppState AppState

<div class="flex flex-col p-3 pt-8 w-full sm:w-180 mx-auto space-y-5">

    <div class="relative flex items-center justify-between px-5">
        <div class="text-xl font-bold dark:text-neutral-100">@L["Dashboard.Presentations"]</div>
        @if (hasAny)
        {
            <AppButton Variant="ButtonVariant.Primary" OnClick="@OpenNewPresentationPicker" Class="flex items-center">
                <PlusSymbol Class="size-4 mr-2"/>@L["Dashboard.Create"]
            </AppButton>
        }
    </div>

    @foreach (var (sessionId, session) in liveSessions)
    {
        var livePresentationId = session.PresentationId;
        var livePresentationName = session.PresentationName;
        <div class="bg-emerald-50 dark:bg-emerald-900/20 rounded-xl border border-emerald-200 dark:border-emerald-800 overflow-hidden">
            <div class="px-4 py-3 flex items-center justify-between gap-3">
                <div class="flex items-center gap-2 min-w-0">
                    <span class="inline-block size-2 rounded-full bg-emerald-500 shrink-0 animate-pulse"></span>
                    <div class="min-w-0">
                        <div class="text-xs font-semibold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">@L["Dashboard.LiveNow"]</div>
                        <div class="text-sm font-medium text-neutral-700 dark:text-neutral-200 truncate">@(livePresentationName ?? L["Dashboard.LiveNowUnknown"])</div>
                    </div>
                </div>
                @if (livePresentationId is not null)
                {
                    <a href="/presentations/@livePresentationId?remote=true"
                       class="shrink-0 px-3 py-1.5 rounded-lg bg-emerald-500 text-white text-xs font-medium hover:bg-emerald-600 no-underline">
                        @L["Dashboard.TakeControl"]
                    </a>
                }
            </div>
        </div>
    }

    @if (dashboard is null)
    {
        <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t-[0.5px] border-white dark:border-neutral-700 overflow-hidden">
            <div class="px-4 py-3 text-neutral-400">@L["Common.Loading"]</div>
        </div>
    }
    else if (!hasAny)
    {
        <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t-[0.5px] border-white dark:border-neutral-700 overflow-hidden">
            <div class="flex flex-col items-center justify-center text-center px-6 py-12 select-none">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 200 160" class="w-48 h-auto mb-6 text-neutral-300 dark:text-neutral-600">
                    <rect x="55" y="12" width="100" height="130" rx="8" stroke="currentColor" stroke-width="2" fill="none" opacity="0.4"/>
                    <rect x="35" y="22" width="100" height="130" rx="8" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                    <line x1="55" y1="50" x2="115" y2="50" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.5"/>
                    <line x1="55" y1="70" x2="110" y2="70" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
                    <line x1="55" y1="83" x2="100" y2="83" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.25"/>
                    <line x1="55" y1="96" x2="105" y2="96" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.2"/>
                    <circle cx="155" cy="130" r="18" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                    <line x1="155" y1="121" x2="155" y2="139" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                    <line x1="146" y1="130" x2="164" y2="130" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
                <h2 class="text-lg font-semibold text-neutral-500 dark:text-neutral-400 mb-2">@L["Dashboard.NoPresentations"]</h2>
                <p class="text-sm text-neutral-400 dark:text-neutral-500 max-w-xs leading-relaxed mb-4">
                    @L["Dashboard.Description"]
                </p>
                <AppButton Variant="ButtonVariant.Primary" OnClick="@OpenNewPresentationPicker" Class="flex items-center gap-1.5">
                    <PlusSymbol Class="size-4"/>
                    @L["Dashboard.Create"]
                </AppButton>
            </div>
        </div>
    }
    else
    {
        <PresentationSection Title="@L["Dashboard.Today"]" Presentations="dashboard.Today" ShowDate="false"/>
        <PresentationSection Title="@L["Dashboard.Upcoming"]" Presentations="dashboard.Upcoming"/>
        <PresentationSection Title="@L["Dashboard.Previous"]" Presentations="dashboard.Previous"/>

        <div class="px-5">
            <a href="/presentations"
               class="inline-flex items-center gap-1 text-sm text-sky-600 dark:text-sky-400 hover:text-sky-700 dark:hover:text-sky-300 no-underline">
                @L["Dashboard.AllPresentations"]
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
                </svg>
            </a>
        </div>
    }

</div>

@if (showPicker)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-md" OnClose="ClosePicker">
        <div class="p-6 space-y-4 relative">
            <button class="absolute top-4 right-4 size-8 flex items-center justify-center rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-700 cursor-pointer text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300"
                    @onclick="ClosePicker">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                </svg>
            </button>
            <div class="font-semibold text-lg pr-8">@L["Dashboard.CreateTitle"]</div>
            <button class="flex items-center gap-3 w-full px-4 py-3 rounded-xl border border-neutral-200 dark:border-neutral-600 hover:border-sky-500 dark:hover:border-sky-500 hover:bg-neutral-50 dark:hover:bg-neutral-700 text-left text-inherit cursor-pointer transition-colors"
                    @onclick="PickBlank">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 shrink-0 text-neutral-400 dark:text-neutral-500">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
                </svg>
                <span class="text-sm font-medium">@L["Dashboard.BlankPresentation"]</span>
            </button>
            @if (recentTemplates is not null && recentTemplates.Count > 0)
            {
                <div class="text-xs font-medium text-neutral-400 dark:text-neutral-500 uppercase tracking-wide pt-2">@L["Dashboard.PickerTemplates"]</div>
                <div class="flex flex-col gap-2">
                    @foreach (var template in recentTemplates)
                    {
                        <button class="flex items-center gap-3 w-full px-4 py-3 rounded-xl border border-neutral-200 dark:border-neutral-600 hover:border-sky-500 dark:hover:border-sky-500 hover:bg-neutral-50 dark:hover:bg-neutral-700 text-left text-inherit cursor-pointer transition-colors"
                                @onclick="() => PickTemplate(template)">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 shrink-0 text-neutral-400 dark:text-neutral-500">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
                            </svg>
                            <div class="flex-1 min-w-0">
                                <div class="text-sm font-medium truncate">@template.Name</div>
                                @if (template.ScheduledDayOfWeek is not null || template.ScheduledTime is not null || !string.IsNullOrWhiteSpace(template.Location))
                                {
                                    <div class="text-xs text-neutral-400 dark:text-neutral-500">@GetTemplatePickerDetails(template)</div>
                                }
                            </div>
                        </button>
                    }
                </div>
            }
        </div>
    </Dialog>
}

@if (showCreateDialog)
{
    <PresentationDetailsDialog Title="@L["Dashboard.CreateTitle"]"
                               Name="@newPresentationName"
                               Date="@prefillDate"
                               Time="@prefillTime"
                               Location="@prefillLocation"
                               SaveText="@L["Common.Create"]"
                               SaveLoadingText="@L["Common.Creating"]"
                               OnSave="CreateAsync"
                               OnClose="CancelCreate"/>
}

@if (showWelcomeModal)
{
    <WelcomeModal OnClose="DismissWelcomeAsync"/>
}

@using System.ComponentModel
@implements IDisposable

@code {

    private DashboardPresentations? dashboard;
    private IList<PresentationSummary>? recentTemplates;
    private bool showPicker;
    private bool showCreateDialog;
    private bool showWelcomeModal;
    private PresentationSummary? selectedTemplate;
    private string newPresentationName = "";
    private DateOnly? prefillDate;
    private TimeOnly? prefillTime;
    private string? prefillLocation;

    private bool hasAny => dashboard is { } d && (d.Today.Count + d.Upcoming.Count + d.Previous.Count) > 0;

    private IReadOnlyList<(string SessionId, ActiveSession Session)> liveSessions
    {
        get
        {
            var orgId = OrgState.ActiveOrganizationId;
            if (orgId is null) return [];
            return SharedAppState.GetRemoteEnabledSessionsForOrganization(orgId)
                .Where(s => s.SessionId != AppState.SessionId)
                .OrderBy(s => s.Session.PresentationName ?? string.Empty, StringComparer.OrdinalIgnoreCase)
                .ThenBy(s => s.SessionId, StringComparer.Ordinal)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        SharedAppState.PropertyChanged += OnSharedStateChanged;
        SharedAppState.PresentationActivated += OnPresentationActivatedOrDeactivated;
        SharedAppState.PresentationDeactivated += OnPresentationActivatedOrDeactivated;

        var orgId = OrgState.ActiveOrganizationId;
        if (orgId is null) return;

        var caller = OrgState.ToCallerContext();
        var today = DateOnly.FromDateTime(DateTime.Today);
        var dashboardTask = PresentationService.GetDashboardPresentationsAsync(orgId, today, caller);
        var templatesTask = PresentationService.GetRecentTemplateSummariesAsync(orgId, caller);
        await Task.WhenAll(dashboardTask, templatesTask);
        dashboard = await dashboardTask;
        recentTemplates = await templatesTask;

        if (OrgState.UserId is { } userId)
        {
            showWelcomeModal = await OnboardingService.ShouldShowWelcomeAsync(userId, caller);
        }
    }

    private async Task DismissWelcomeAsync()
    {
        showWelcomeModal = false;
        if (OrgState.UserId is { } userId)
        {
            await OnboardingService.MarkWelcomeShownAsync(userId, OrgState.ToCallerContext());
        }
    }

    private void OpenNewPresentationPicker()
    {
        if (recentTemplates is null || recentTemplates.Count == 0)
        {
            OpenCreateDialog(null);
        }
        else
        {
            showPicker = true;
        }
    }

    private void ClosePicker()
    {
        showPicker = false;
    }

    private void PickBlank()
    {
        showPicker = false;
        OpenCreateDialog(null);
    }

    private void PickTemplate(PresentationSummary template)
    {
        showPicker = false;
        OpenCreateDialog(template);
    }

    private void OpenCreateDialog(PresentationSummary? template)
    {
        selectedTemplate = template;
        newPresentationName = template?.Name ?? L["Dashboard.DefaultName"];
        prefillDate = GetNextDateForDay(template?.ScheduledDayOfWeek, template?.ScheduledTime);
        prefillTime = template?.ScheduledTime;
        prefillLocation = template?.Location;
        showCreateDialog = true;
    }

    private string GetTemplatePickerDetails(PresentationSummary template)
    {
        var schedule = "";
        if (template.ScheduledDayOfWeek is { } day)
            schedule = L[$"Weekday.{day}"];
        if (template.ScheduledTime is { } time)
            schedule += (schedule.Length > 0 ? " " : "") + time.ToString("HH:mm");
        if (!string.IsNullOrWhiteSpace(template.Location))
            schedule += (schedule.Length > 0 ? " \u00b7 " : "") + template.Location;
        return schedule;
    }

    private static DateOnly? GetNextDateForDay(int? scheduledDayOfWeek, TimeOnly? scheduledTime)
    {
        if (scheduledDayOfWeek is not { } targetDay) return null;

        var now = DateTime.Now;
        var today = DateOnly.FromDateTime(now);
        var currentDay = (int)today.DayOfWeek;
        var daysUntil = (targetDay - currentDay + 7) % 7;

        if (daysUntil == 0 && scheduledTime is { } time && TimeOnly.FromDateTime(now) >= time)
            daysUntil = 7;

        return today.AddDays(daysUntil);
    }

    private void CancelCreate()
    {
        showCreateDialog = false;
        selectedTemplate = null;
    }

    private async Task CreateAsync((string Name, DateOnly? Date, TimeOnly? Time, string? Location) details)
    {
        var orgId = OrgState.ActiveOrganizationId ?? "default";
        var userId = OrgState.UserId ?? "default";
        var caller = OrgState.ToCallerContext();

        Presentation presentation;
        if (selectedTemplate is not null)
        {
            presentation = await PresentationService.CreatePresentationFromTemplateAsync(
                selectedTemplate.Id, details.Name, orgId, userId, caller, details.Date, details.Time, details.Location);
        }
        else
        {
            presentation = await PresentationService.CreatePresentationAsync(
                details.Name, orgId, userId, caller, details.Date, details.Time, details.Location);
        }

        NavigationManager.NavigateTo($"/presentations/{presentation.Id}");
    }

    private void OnSharedStateChanged(object? sender, PropertyChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnPresentationActivatedOrDeactivated(string sessionId)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedAppState.PropertyChanged -= OnSharedStateChanged;
        SharedAppState.PresentationActivated -= OnPresentationActivatedOrDeactivated;
        SharedAppState.PresentationDeactivated -= OnPresentationActivatedOrDeactivated;
    }
}
