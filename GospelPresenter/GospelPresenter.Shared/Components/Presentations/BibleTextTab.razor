@using GospelPresenter.Shared.Services

@inject IBibleService BibleService
@inject IJSRuntime JsRuntime

@if (BibleService.Bibles.Count == 0)
{
    <div class="text-center text-neutral-400 text-sm py-8">
        Ingen bibel laddad
    </div>
}
else
{
    <div class="flex flex-col h-full" @onkeydown="OnKeyDown" tabindex="-1" @ref="container">
        @if (browseBook is null)
        {
            <div class="shrink-0">
                <div class="flex gap-2">
                    <div class="flex-1 relative">
                        <input type="text"
                               @ref="searchInput"
                               class="w-full h-[46px] px-4 rounded-xl border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-700 text-neutral-900 dark:text-neutral-100 focus:outline-none focus:ring-2 focus:ring-sky-500 @(string.IsNullOrEmpty(query) ? "" : "pr-9")"
                               placeholder="Sök bibeltext..."
                               value="@query"
                               @oninput="OnSearchInput"/>
                        @if (!string.IsNullOrEmpty(query))
                        {
                            <button class="absolute right-2.5 top-1/2 -translate-y-1/2 size-6 flex items-center justify-center rounded-full hover:bg-neutral-200 dark:hover:bg-neutral-600 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 cursor-pointer"
                                    @onclick="ClearSearch">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                                </svg>
                            </button>
                        }
                    </div>

                    <div class="relative">
                        <select class="appearance-none h-[46px] pl-3 pr-8 rounded-xl border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-700 text-neutral-900 dark:text-neutral-100 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm"
                                @onchange="OnBibleChanged">
                            @foreach (var bible in BibleService.Bibles)
                            {
                                <option value="@bible.Id" selected="@(bible.Id == selectedBibleId)">@bible.Name</option>
                            }
                        </select>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 absolute right-2.5 top-1/2 -translate-y-1/2 text-neutral-400 pointer-events-none">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                        </svg>
                    </div>
                </div>
                <div class="text-xs text-neutral-400 mt-1 px-3">
                    T.ex. <span class="text-neutral-500 dark:text-neutral-400">Joh 3:16</span>,
                    <span class="text-neutral-500 dark:text-neutral-400">Ps 23</span> eller
                    <span class="text-neutral-500 dark:text-neutral-400">Rom 8:28-30</span>
                </div>
            </div>

            @if (results.Count > 0)
            {
                <div class="mt-3 flex-1 min-h-0 flex flex-col">
                    <BibleSearchResults Results="results" TotalCount="totalCount" OnSelectionChanged="OnSearchSelectionChanged"/>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(query))
            {
                <div class="text-center text-neutral-400 text-sm py-2 mt-3">
                    Inga verser hittades
                </div>
            }
            else
            {
                <div class="mt-3 flex-1 min-h-0 flex flex-col">
                    <BibleBookPicker BibleId="@selectedBibleId" OnPicked="StartBrowse"/>
                </div>
            }
        }
        else
        {
            <BibleBrowsePicker BibleId="@selectedBibleId" InitialBook="@browseBook" OnBackClicked="OnBrowseBack" OnSelectionChanged="OnBrowseSelectionChanged"/>
        }

        @if (ShowAddButton)
        {
            <div class="shrink-0 flex items-center justify-end gap-3 pt-4">
                <div class="flex items-center gap-1 text-xs text-neutral-400">
                    <kbd class="px-1.5 py-0.5 rounded-md bg-neutral-100 dark:bg-neutral-700 border border-neutral-200 dark:border-neutral-600 font-medium">@(isMac ? "⌘" : "Ctrl")</kbd>
                    <span>+</span>
                    <kbd class="px-1.5 py-0.5 rounded-md bg-neutral-100 dark:bg-neutral-700 border border-neutral-200 dark:border-neutral-600 font-medium">↵</kbd>
                </div>
                <button class="px-4 py-2 rounded-xl text-sm bg-sky-500 text-white hover:bg-sky-600 cursor-pointer"
                        @onclick="HandleAdd">
                    L&auml;gg till @AddLabel
                </button>
            </div>
        }
    </div>
}

@code {
    [Parameter] public EventCallback<List<Verse>> OnAdd { get; set; }

    private const int MaxResults = 500;

    private ElementReference container;
    private ElementReference searchInput;
    private string selectedBibleId = "";
    private bool isMac;

    // Search state
    private string query = "";
    private List<Verse> results = [];
    private int totalCount;
    private string searchSelectionLabel = "";
    private List<Verse> searchSelectedVerses = [];

    // Browse state
    private string? browseBook;
    private bool browseHasSelection;
    private string browseSelectionLabel = "";
    private List<Verse> browseSelectedVerses = [];

    private bool ShowAddButton => browseHasSelection || results.Count > 0;

    private string AddLabel => browseHasSelection
        ? browseSelectionLabel
        : searchSelectionLabel;

    protected override void OnInitialized()
    {
        selectedBibleId = BibleService.Bibles.FirstOrDefault()?.Id ?? "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isMac = await JsRuntime.InvokeAsync<bool>("eval", "navigator.platform.toUpperCase().indexOf('MAC') >= 0");
            StateHasChanged();
        }

        try
        {
            if (browseBook is null)
                await searchInput.FocusAsync();
            else
                await container.FocusAsync();
        }
        catch { }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.MetaKey || e.CtrlKey) && ShowAddButton)
            await HandleAdd();
    }

    private void OnBibleChanged(ChangeEventArgs e)
    {
        selectedBibleId = e.Value?.ToString() ?? "";
        PerformSearch();
        browseBook = null;
        browseHasSelection = false;
        browseSelectionLabel = "";
        browseSelectedVerses = [];
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        PerformSearch();
    }

    private void ClearSearch()
    {
        query = "";
        results = [];
        totalCount = 0;
        searchSelectionLabel = "";
        searchSelectedVerses = [];
    }

    private void PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            results = [];
            totalCount = 0;
            searchSelectionLabel = "";
            searchSelectedVerses = [];
            return;
        }

        var allResults = BibleService.Search(selectedBibleId, query).ToList();
        totalCount = allResults.Count;
        results = allResults.Count > MaxResults ? allResults.Take(MaxResults).ToList() : allResults;
    }

    private void OnSearchSelectionChanged(BibleSearchResults.SelectionState state)
    {
        searchSelectionLabel = state.Label;
        searchSelectedVerses = state.Verses;
    }

    private void StartBrowse(string bookId)
    {
        browseBook = bookId;
        browseHasSelection = false;
        browseSelectionLabel = "";
        browseSelectedVerses = [];
    }

    private void OnBrowseBack()
    {
        browseBook = null;
        browseHasSelection = false;
        browseSelectionLabel = "";
        browseSelectedVerses = [];
    }

    private void OnBrowseSelectionChanged(BibleBrowsePicker.SelectionState state)
    {
        browseHasSelection = state.IsComplete;
        browseSelectionLabel = state.Label;
        browseSelectedVerses = state.Verses;
    }

    private async Task HandleAdd()
    {
        if (browseHasSelection && browseSelectedVerses.Count > 0)
        {
            await OnAdd.InvokeAsync(browseSelectedVerses);
        }
        else if (searchSelectedVerses.Count > 0)
        {
            await OnAdd.InvokeAsync(searchSelectedVerses);
        }
        else if (results.Count > 0)
        {
            await OnAdd.InvokeAsync(results);
        }
    }
}
