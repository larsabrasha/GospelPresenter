<Dialog Class="bg-white dark:bg-neutral-800 max-w-2xl" OnClose="OnClose">
    <div class="p-6 space-y-3">
        <div class="font-semibold text-lg dark:text-neutral-100">@Title</div>

        <FloatingInput @ref="nameInput" Id="presentation-name" Label="@L["Common.Name"]"
                       Value="@name" OnInput="HandleNameInput"
                       OnKeyDown="OnKeyDown" MaxLength="AppConstraints.NameMaxLength"
                       HideLabel/>

        <div class="flex gap-2 flex-wrap">
            <SimpleInput Id="presentation-date" Type="date"
                         Value="@selectedDate" OnInput="HandleDateChange"/>

            <SimpleInput Id="presentation-time" Type="time"
                         Value="@selectedTime" OnInput="HandleTimeChange"/>

            <SimpleInput Id="presentation-location" Placeholder="@L["Event.Location"]"
                         Value="@selectedLocation" OnInput="HandleLocationChange"
                         MaxLength="AppConstraints.LocationMaxLength">
                <Icon><MapPinSymbol Class="size-4"/></Icon>
            </SimpleInput>
        </div>

        <FloatingTextarea Id="presentation-description" Label="@L["Event.Description"]"
                          Value="@selectedDescription" OnInput="HandleDescriptionChange"
                          MaxLength="AppConstraints.DescriptionMaxLength" Rows="4"/>

        @if (Themes is not null)
        {
            <div>
                <label for="presentation-theme" class="block text-sm font-medium mb-1.5 text-neutral-500 dark:text-neutral-400">
                    @L["Event.Theme"]
                </label>
                @* w-fit so the wrapper hugs the select, keeping its chevron on the control rather than at
                   the far edge of the dialog. *@
                <SimpleSelect Id="presentation-theme" Class="w-fit" Value="@(selectedThemeId ?? "")" OnChange="HandleThemeChange">
                    <option value="">@L["Event.Theme.FollowsOrganizationDefault"]</option>
                    @foreach (var theme in Themes)
                    {
                        <option value="@theme.Id">@ThemeName(theme)</option>
                    }
                </SimpleSelect>
            </div>
        }

        <div class="flex justify-end gap-3">
            <AppButton Variant="ButtonVariant.Cancel" OnClick="OnClose">
                @L["Common.Cancel"]
            </AppButton>
            <AppButton Variant="ButtonVariant.Primary" Disabled="@(isSaving || string.IsNullOrWhiteSpace(name))" OnClick="Save">
                @(isSaving && SaveLoadingText is not null ? SaveLoadingText : SaveText)
            </AppButton>
        </div>
    </div>
</Dialog>

@code {

    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public DateOnly? Date { get; set; }
    [Parameter] public TimeOnly? Time { get; set; }
    [Parameter] public string? Location { get; set; }
    [Parameter] public string? Description { get; set; }
    /// <summary>
    /// The themes the presentation may use. Null hides the picker, which is what the create flow does:
    /// a new presentation follows the organisation's default until someone chooses otherwise.
    /// </summary>
    [Parameter] public List<GospelPresenter.Shared.Models.Theme>? Themes { get; set; }

    /// <summary>The presentation's own theme, or null when it follows the organisation's default.</summary>
    [Parameter] public string? ThemeId { get; set; }

    [Parameter, EditorRequired] public EventCallback<(string Name, DateOnly? Date, TimeOnly? Time, string? Location, string? Description, string? ThemeId)> OnSave { get; set; }
    [Parameter, EditorRequired] public EventCallback OnClose { get; set; }
    [Parameter] public string? SaveText { get; set; }
    [Parameter] public string? SaveLoadingText { get; set; }

    private string name = "";
    private string selectedDate = "";
    private string selectedTime = "";
    private string selectedLocation = "";
    private string selectedDescription = "";
    private string? selectedThemeId;
    private bool isSaving;
    private FloatingInput? nameInput;

    protected override void OnInitialized()
    {
        name = Name;
        selectedDate = Date?.ToString("yyyy-MM-dd") ?? "";
        selectedTime = Time?.ToString("HH:mm") ?? "";
        selectedLocation = Location ?? "";
        selectedDescription = Description ?? "";
        selectedThemeId = ThemeId;
        SaveText ??= L["Common.Save"];
    }

    private void HandleNameInput(ChangeEventArgs e) => name = e.Value?.ToString() ?? "";
    private void HandleDateChange(ChangeEventArgs e) => selectedDate = e.Value?.ToString() ?? "";
    private void HandleTimeChange(ChangeEventArgs e) => selectedTime = e.Value?.ToString() ?? "";
    private void HandleLocationChange(ChangeEventArgs e) => selectedLocation = e.Value?.ToString() ?? "";
    private void HandleDescriptionChange(ChangeEventArgs e) => selectedDescription = e.Value?.ToString() ?? "";

    private void HandleThemeChange(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        selectedThemeId = string.IsNullOrEmpty(value) ? null : value;
    }

    // Built-in themes are named in the resource files by convention; an organisation's own theme carries
    // the name its author typed.
    private string ThemeName(GospelPresenter.Shared.Models.Theme theme) =>
        theme.IsBuiltIn ? L[$"Theme.Name.{theme.Id}"].Value : theme.Name;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && nameInput is not null)
        {
            try { await nameInput.FocusAsync(); } catch { }
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(name))
            await Save();
        else if (e.Key == "Escape")
            await OnClose.InvokeAsync();
    }

    private async Task Save()
    {
        var trimmed = name.Trim();
        if (isSaving || string.IsNullOrWhiteSpace(trimmed)) return;

        isSaving = true;
        try
        {
            DateOnly? date = DateOnly.TryParse(selectedDate, out var d) ? d : null;
            TimeOnly? time = TimeOnly.TryParse(selectedTime, out var t) ? t : null;
            string? location = string.IsNullOrWhiteSpace(selectedLocation) ? null : selectedLocation.Trim();
            string? description = string.IsNullOrWhiteSpace(selectedDescription) ? null : selectedDescription.Trim();

            await OnSave.InvokeAsync((trimmed, date, time, location, description, selectedThemeId));
        }
        finally
        {
            isSaving = false;
        }
    }

}
