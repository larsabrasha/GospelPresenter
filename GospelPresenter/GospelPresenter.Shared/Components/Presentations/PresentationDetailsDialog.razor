<Dialog Class="bg-white dark:bg-neutral-800 max-w-2xl" OnClose="OnClose">
    <div class="p-6 space-y-4">
        <div class="font-semibold text-lg dark:text-neutral-100">@Title</div>

        <FloatingInput @ref="nameInput" Id="presentation-name" Label="@L["Common.Name"]"
                       Value="@name" OnInput="HandleNameInput"
                       OnKeyDown="OnKeyDown"/>

        <div class="flex gap-3">
            <FloatingInput Id="presentation-date" Type="date" Label="@L["Event.Date"]" Class="flex-1"
                           Value="@selectedDate" OnInput="HandleDateChange"/>

            <FloatingInput Id="presentation-time" Type="time" Label="@L["Event.Time"]" Class="flex-1"
                           Value="@selectedTime" OnInput="HandleTimeChange"/>
        </div>

        <FloatingInput Id="presentation-location" Label="@L["Event.Location"]"
                       Value="@selectedLocation" OnInput="HandleLocationChange"/>

        <div class="flex justify-end gap-3">
            <AppButton Variant="ButtonVariant.Cancel" OnClick="OnClose">
                @L["Common.Cancel"]
            </AppButton>
            <AppButton Variant="ButtonVariant.Primary" Disabled="@(isSaving || string.IsNullOrWhiteSpace(name))" OnClick="Save">
                @(isSaving && SaveLoadingText is not null ? SaveLoadingText : SaveText)
            </AppButton>
        </div>
    </div>
</Dialog>

@code {

    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public DateOnly? Date { get; set; }
    [Parameter] public TimeOnly? Time { get; set; }
    [Parameter] public string? Location { get; set; }
    [Parameter, EditorRequired] public EventCallback<(string Name, DateOnly? Date, TimeOnly? Time, string? Location)> OnSave { get; set; }
    [Parameter, EditorRequired] public EventCallback OnClose { get; set; }
    [Parameter] public string? SaveText { get; set; }
    [Parameter] public string? SaveLoadingText { get; set; }

    private string name = "";
    private string selectedDate = "";
    private string selectedTime = "";
    private string selectedLocation = "";
    private bool isSaving;
    private FloatingInput? nameInput;

    protected override void OnInitialized()
    {
        name = Name;
        selectedDate = Date?.ToString("yyyy-MM-dd") ?? "";
        selectedTime = Time?.ToString("HH:mm") ?? "";
        selectedLocation = Location ?? "";
        SaveText ??= L["Common.Save"];
    }

    private void HandleNameInput(ChangeEventArgs e) => name = e.Value?.ToString() ?? "";
    private void HandleDateChange(ChangeEventArgs e) => selectedDate = e.Value?.ToString() ?? "";
    private void HandleTimeChange(ChangeEventArgs e) => selectedTime = e.Value?.ToString() ?? "";
    private void HandleLocationChange(ChangeEventArgs e) => selectedLocation = e.Value?.ToString() ?? "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && nameInput is not null)
        {
            try { await nameInput.FocusAsync(); } catch { }
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(name))
            await Save();
        else if (e.Key == "Escape")
            await OnClose.InvokeAsync();
    }

    private async Task Save()
    {
        var trimmed = name.Trim();
        if (isSaving || string.IsNullOrWhiteSpace(trimmed)) return;

        isSaving = true;
        try
        {
            DateOnly? date = DateOnly.TryParse(selectedDate, out var d) ? d : null;
            TimeOnly? time = TimeOnly.TryParse(selectedTime, out var t) ? t : null;
            string? location = string.IsNullOrWhiteSpace(selectedLocation) ? null : selectedLocation.Trim();

            await OnSave.InvokeAsync((trimmed, date, time, location));
        }
        finally
        {
            isSaving = false;
        }
    }

}
