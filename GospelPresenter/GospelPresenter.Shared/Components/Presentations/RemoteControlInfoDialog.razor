@using GospelPresenter.Shared.Services
@inject NavigationManager NavigationManager
@inject IServerUrlProvider ServerUrlProvider
@inject ToastService ToastService

<Dialog Class="bg-white dark:bg-neutral-800 max-w-sm" OnClose="OnClose" ShowCloseButton="true">
    <div class="max-h-[90svh] overflow-y-auto p-6 space-y-5">
        <div class="font-semibold text-lg pr-10">@L["LivePanel.RemoteControlInfoTitle"]</div>

        <div class="space-y-2">
            <div class="flex justify-center">
                <QrCode Value="@remoteUrl"/>
            </div>
            <div class="text-sm text-neutral-500 dark:text-neutral-400 text-center">@L["LivePanel.RemoteControlScanQrHint"]</div>
        </div>

        <div class="!mt-8 flex items-center gap-3">
            <div class="h-px flex-1 bg-neutral-200 dark:bg-neutral-700"></div>
            <span class="text-xs uppercase tracking-widest text-neutral-400 dark:text-neutral-500">@L["LivePanel.PairOr"]</span>
            <div class="h-px flex-1 bg-neutral-200 dark:bg-neutral-700"></div>
        </div>

        <div>
            <button @onclick="() => isCopyLinkCollapsed = !isCopyLinkCollapsed"
                    aria-expanded="@(!isCopyLinkCollapsed)"
                    class="cursor-pointer flex items-center gap-2 w-full text-left py-2 -my-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                     stroke="currentColor"
                     class="size-3 text-neutral-400 dark:text-neutral-500 transition-transform duration-300 @(isCopyLinkCollapsed ? "-rotate-90" : "")">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                </svg>
                <span class="text-[10px] uppercase tracking-widest text-neutral-400 dark:text-neutral-500 font-semibold">@L["LivePanel.RemoteControlOrCopyUrl"]</span>
            </button>
            <div class="grid transition-[grid-template-rows] duration-300 ease-in-out @(isCopyLinkCollapsed ? "grid-rows-[0fr]" : "grid-rows-[1fr]")">
                <div class="overflow-hidden min-h-0">
                    <div class="pt-3 flex items-stretch gap-2">
                        <input type="text" readonly value="@remoteUrl"
                               class="flex-1 min-w-0 px-3 py-2 rounded-lg bg-neutral-100 dark:bg-neutral-700 text-sm font-mono text-neutral-800 dark:text-neutral-100 border border-neutral-200 dark:border-neutral-600 select-all focus:outline-none focus:ring-2 focus:ring-sky-500"/>
                        <AppButton Variant="ButtonVariant.Neutral" CopyText="@remoteUrl" OnClick="OnCopyUrl"
                                   Title="@L["UserDetail.Copy"]"
                                   Class="!px-3 !py-2 !rounded-lg flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                                <path d="M7 3.5A1.5 1.5 0 0 1 8.5 2h3.879a1.5 1.5 0 0 1 1.06.44l3.122 3.12A1.5 1.5 0 0 1 17 6.622V12.5a1.5 1.5 0 0 1-1.5 1.5h-1v-3.379a3 3 0 0 0-.879-2.121L10.5 5.379A3 3 0 0 0 8.379 4.5H7v-1Z"/>
                                <path d="M4.5 6A1.5 1.5 0 0 0 3 7.5v9A1.5 1.5 0 0 0 4.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L9.44 6.439A1.5 1.5 0 0 0 8.378 6H4.5Z"/>
                            </svg>
                        </AppButton>
                    </div>
                </div>
            </div>
        </div>

        <div>
            <button @onclick="() => isOpenAppCollapsed = !isOpenAppCollapsed"
                    aria-expanded="@(!isOpenAppCollapsed)"
                    class="cursor-pointer flex items-center gap-2 w-full text-left py-2 -my-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                     stroke="currentColor"
                     class="size-3 text-neutral-400 dark:text-neutral-500 transition-transform duration-300 @(isOpenAppCollapsed ? "-rotate-90" : "")">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                </svg>
                <span class="text-[10px] uppercase tracking-widest text-neutral-400 dark:text-neutral-500 font-semibold">@L["LivePanel.RemoteControlOpenAppTitle"]</span>
            </button>
            <div class="grid transition-[grid-template-rows] duration-300 ease-in-out @(isOpenAppCollapsed ? "grid-rows-[0fr]" : "grid-rows-[1fr]")">
                <div class="overflow-hidden min-h-0">
                    <div class="pt-3 space-y-2">
                        <div class="text-sm text-neutral-500 dark:text-neutral-400">@L["LivePanel.RemoteControlOpenAppHint"]</div>
                        <div class="rounded-lg border border-neutral-200 dark:border-neutral-700 overflow-hidden bg-white dark:bg-neutral-900 shadow-sm pointer-events-none select-none">
                            <div class="flex items-center gap-1 px-2 py-1.5 bg-neutral-100 dark:bg-neutral-800 border-b border-neutral-200 dark:border-neutral-700">
                                <span class="size-1.5 rounded-full bg-red-400"></span>
                                <span class="size-1.5 rounded-full bg-yellow-400"></span>
                                <span class="size-1.5 rounded-full bg-green-400"></span>
                            </div>
                            <div class="p-2">
                                <div class="bg-emerald-50 dark:bg-emerald-900/20 rounded border border-emerald-200 dark:border-emerald-800">
                                    <div class="px-2 py-1.5 flex items-center justify-between gap-2">
                                        <div class="flex items-center gap-1.5 min-w-0">
                                            <span class="inline-block size-1.5 rounded-full bg-emerald-500 shrink-0 animate-pulse"></span>
                                            <div class="min-w-0">
                                                <div class="text-[8px] font-semibold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">@L["Dashboard.LiveNow"]</div>
                                                <div class="text-[10px] font-medium text-neutral-700 dark:text-neutral-200 truncate">@(PresentationName ?? L["Dashboard.LiveNowUnknown"])</div>
                                            </div>
                                        </div>
                                        <div class="shrink-0 px-1.5 py-0.5 rounded bg-emerald-500 text-white text-[9px] font-medium">
                                            @L["Dashboard.TakeControl"]
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Dialog>

@code {
    [Parameter] public required string PresentationId { get; set; }
    [Parameter] public string? PresentationName { get; set; }

    /// <summary>
    /// The session the scanning phone should drive. Named in the link because the same
    /// presentation may be live in more than one place, and a code taped to a lectern has to keep
    /// meaning this machine rather than whichever session the controller resolves to that morning.
    /// </summary>
    [Parameter] public string? SessionId { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private string remoteUrl = "";
    private bool isCopyLinkCollapsed = true;
    private bool isOpenAppCollapsed = true;

    protected override void OnInitialized()
    {
        // Against the server, not against this host: on a device app the two differ, and the phone
        // scanning this can only reach the former. See IServerUrlProvider.
        var session = string.IsNullOrEmpty(SessionId) ? "" : $"&session={Uri.EscapeDataString(SessionId)}";
        remoteUrl = ServerUrls.Absolute(
            ServerUrlProvider, NavigationManager, $"presentations/{PresentationId}?remote=true{session}");
    }

    private void OnCopyUrl()
    {
        ToastService.Show(L["Toast.LinkCopied"]);
    }
}
