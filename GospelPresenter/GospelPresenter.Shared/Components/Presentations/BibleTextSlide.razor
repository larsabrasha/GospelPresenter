@using GospelPresenter.Shared.State

<Slide
    IsSelected="@IsSelected"
    IsLive="@IsLive"
    Class="@Class"
    Background="@EffectiveStyle.Background"
    BaseWidth="@BaseWidth"
    BaseHeight="@BaseHeight"
    Scale="@Scale">
    @* Bible slides that were stored before themes existed carry their own left-aligned wrapper div,
       so the theme's alignment only takes effect on parts added after that. *@
    <div style="@EffectiveStyle.MainText.ToCss()">@((MarkupString)Content)</div>
    @if (!string.IsNullOrEmpty(Credits))
    {
        <div class="absolute bottom-8 left-20 right-20" style="@EffectiveStyle.Credits.ToCss()">
            @Credits
        </div>
    }
</Slide>

@code {
    [Parameter] public required string Content { get; set; }
    [Parameter] public string? Credits { get; set; }
    [Parameter] public bool? IsSelected { get; set; }
    [Parameter] public bool IsLive { get; set; }
    [Parameter] public string? Class { get; set; }

    /// <summary>The Bible-text block of the presentation's theme.</summary>
    [Parameter] public SlideStyle? Style { get; set; }

    [Parameter] public required int BaseWidth { get; set; }
    [Parameter] public required int BaseHeight { get; set; }
    [Parameter] public required double Scale { get; set; }

    private SlideStyle EffectiveStyle => Style ?? SlideTheme.Fallback.BibleText;
}
