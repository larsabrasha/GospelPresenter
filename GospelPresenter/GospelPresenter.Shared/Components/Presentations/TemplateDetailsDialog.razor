<Dialog Class="bg-white dark:bg-neutral-800 max-w-2xl" OnClose="OnClose">
    <div class="p-6 space-y-3">
        <div class="font-semibold text-lg dark:text-neutral-100">@Title</div>

        <FloatingInput @ref="nameInput" Id="template-name" Label="@L["Common.Name"]"
                       Value="@name" ValueChanged="HandleNameInput"
                       OnKeyDown="OnKeyDown" MaxLength="AppConstraints.NameMaxLength"
                       HideLabel/>

        <div class="flex gap-2 flex-wrap">
            <SimpleSelect Id="template-day" Placeholder="@L["Schedule.Day"]"
                          Value="@selectedDay" OnChange="HandleDayChange">
                <option value="">@L["Schedule.NoDay"]</option>
                @foreach (var day in OrderedDays())
                {
                    <option value="@day">@L[$"Weekday.{day}"]</option>
                }
            </SimpleSelect>

            <SimpleInput Id="template-time" Type="time" Placeholder="@L["Schedule.Time"]"
                         Value="@selectedTime" ValueChanged="HandleTimeChange"/>

            <SimpleInput Id="template-location" Placeholder="@L["Event.Location"]"
                         Value="@selectedLocation" ValueChanged="HandleLocationChange"
                         MaxLength="AppConstraints.LocationMaxLength"/>
        </div>

        <div class="flex justify-end gap-3">
            <AppButton Variant="ButtonVariant.Cancel" OnClick="OnClose">
                @L["Common.Cancel"]
            </AppButton>
            <AppButton Variant="ButtonVariant.Primary" Disabled="@(isSaving || string.IsNullOrWhiteSpace(name))" OnClick="Save">
                @(isSaving && SaveLoadingText is not null ? SaveLoadingText : SaveText)
            </AppButton>
        </div>
    </div>
</Dialog>

@code {

    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int? DayOfWeek { get; set; }
    [Parameter] public TimeOnly? Time { get; set; }
    [Parameter] public string? Location { get; set; }
    [Parameter, EditorRequired] public EventCallback<(string Name, int? DayOfWeek, TimeOnly? Time, string? Location)> OnSave { get; set; }
    [Parameter, EditorRequired] public EventCallback OnClose { get; set; }
    [Parameter] public string? SaveText { get; set; }
    [Parameter] public string? SaveLoadingText { get; set; }

    private string name = "";
    private string selectedDay = "";
    private string selectedTime = "";
    private string selectedLocation = "";
    private bool isSaving;
    private FloatingInput? nameInput;

    protected override void OnInitialized()
    {
        name = Name;
        selectedDay = DayOfWeek?.ToString() ?? "";
        selectedTime = Time?.ToString("HH:mm") ?? "";
        selectedLocation = Location ?? "";
        SaveText ??= L["Common.Save"];
    }

    private void HandleNameInput(string value) => name = value;
    private void HandleDayChange(ChangeEventArgs e) => selectedDay = e.Value?.ToString() ?? "";
    private void HandleTimeChange(string value) => selectedTime = value;
    private void HandleLocationChange(string value) => selectedLocation = value;

    private static IEnumerable<int> OrderedDays()
    {
        var first = (int)System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek;
        for (var i = 0; i < 7; i++)
            yield return (first + i) % 7;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && nameInput is not null)
        {
            try { await nameInput.FocusAsync(); } catch { }
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(name))
            await Save();
        else if (e.Key == "Escape")
            await OnClose.InvokeAsync();
    }

    private async Task Save()
    {
        var trimmed = name.Trim();
        if (isSaving || string.IsNullOrWhiteSpace(trimmed)) return;

        isSaving = true;
        try
        {
            int? day = int.TryParse(selectedDay, out var d) ? d : null;
            TimeOnly? time = TimeOnly.TryParse(selectedTime, out var t) ? t : null;
            string? location = string.IsNullOrWhiteSpace(selectedLocation) ? null : selectedLocation.Trim();

            await OnSave.InvokeAsync((trimmed, day, time, location));
        }
        finally
        {
            isSaving = false;
        }
    }

}
