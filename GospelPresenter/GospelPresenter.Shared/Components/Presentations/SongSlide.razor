@using GospelPresenter.Shared.State

<Slide
    IsSelected="@IsSelected"
    IsLive="@IsLive"
    Class="@Class"
    Background="@EffectiveStyle.Background"
    BaseWidth="@BaseWidth"
    BaseHeight="@BaseHeight"
    Scale="@Scale">
    @* Song lyrics are rendered as text, not markup, so the framework HTML-encodes them and
       user-authored content cannot inject script. Line breaks come from white-space: pre-wrap
       instead of <br>. ContentHtml is the one markup path, and its only producer is
       SearchHighlighter, which encodes every segment itself. *@
    @* The text block keeps its shrink-to-fit width, as it had before themes: alignment applies
       within the block, exactly as the old text-left/text-center classes did. *@
    <div class="whitespace-pre-wrap" style="@EffectiveStyle.MainText.ToCss()">
        @if (ContentHtml is not null)
        {
            @((MarkupString)ContentHtml)
        }
        else
        {
            @Content
        }
    </div>
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="absolute top-6 right-10 text-[48px] font-semibold rounded-full px-8 py-1"
             style="background-color: @LabelColor; color: white;">
            @Label
        </div>
    }
    @if (!string.IsNullOrEmpty(Credits))
    {
        <div class="absolute bottom-8 left-20 right-20" style="@EffectiveStyle.Credits.ToCss()">
            @Credits
        </div>
    }
</Slide>

@code {
    [Parameter] public string? Content { get; set; }
    [Parameter] public string? ContentHtml { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? LabelColor { get; set; }
    [Parameter] public string? Credits { get; set; }
    [Parameter] public bool? IsSelected { get; set; }
    [Parameter] public bool IsLive { get; set; }
    [Parameter] public string? Class { get; set; }

    /// <summary>The song block of the presentation's theme.</summary>
    [Parameter] public SlideStyle? Style { get; set; }

    [Parameter] public required int BaseWidth { get; set; }
    [Parameter] public required int BaseHeight { get; set; }
    [Parameter] public required double Scale { get; set; }

    private SlideStyle EffectiveStyle => Style ?? SlideTheme.Fallback.Song;
}
