@using GospelPresenter.Shared.State

<Slide
    IsSelected="@IsSelected"
    IsLive="@IsLive"
    Class="@Class"
    BaseWidth="@BaseWidth"
    BaseHeight="@BaseHeight"
    Scale="@Scale">
    <div style="@EffectiveContentStyle.ToCss()">@((MarkupString)ResolvedHtml)</div>
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="absolute top-6 right-10 text-[48px] font-semibold rounded-full px-8 py-1"
             style="background-color: @LabelColor; color: white;">
            @Label
        </div>
    }
    @if (!string.IsNullOrEmpty(Credits))
    {
        <div class="absolute bottom-8 left-20 text-white/40 text-left"
             style="@EffectiveCreditsStyle.ToCss()">
            @Credits
        </div>
    }
</Slide>

@code {
    [Parameter] public string? Content { get; set; }
    [Parameter] public string? ContentHtml { get; set; }

    private string ResolvedHtml => ContentHtml ?? Content?.Replace("\n", "<br>") ?? "";
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? LabelColor { get; set; }
    [Parameter] public string? Credits { get; set; }
    [Parameter] public bool? IsSelected { get; set; }
    [Parameter] public bool IsLive { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public SlideTextStyle? ContentStyle { get; set; }
    [Parameter] public SlideTextStyle? CreditsStyle { get; set; }
    [Parameter] public required int BaseWidth { get; set; }
    [Parameter] public required int BaseHeight { get; set; }
    [Parameter] public required double Scale { get; set; }

    private SlideTextStyle EffectiveContentStyle => ContentStyle ?? SlideTextStyle.SongDefault;
    private SlideTextStyle EffectiveCreditsStyle => CreditsStyle ?? SlideTextStyle.CreditsDefault;
}
