    private DotNetObjectReference<SlideGrid>? dotNetRef;

    /// <summary>
    /// How many image tiles the sortable was built for, or null when there is no sortable. The count
    /// rather than a flag, because adding images while reordering changes the list the sortable is
    /// bound to and it has to be rebuilt for the new tiles to be draggable. A reorder alone does not
    /// change the count, so dragging does not tear down the thing being dragged.
    /// </summary>
    private int? sortableParts;

    private int idleHintIndex = Random.Shared.Next(idleHints.Length);

    /// <summary>
    /// The grid listens for itself rather than being repainted by the page.
    ///
    /// Every property it reads is a record or a list, which Blazor cannot prove unchanged, so
    /// receiving them as parameters would rebuild this whole grid on every render of the page —
    /// including the ones caused by a modal opening or a title being typed. Listening here instead
    /// means a slide change repaints the grid and nothing else, and a change the grid does not read
    /// repaints nothing at all. Measured in PresentationRenderTests.
    ///
    /// Culture.Restore on the live-state dispatch for the usual reason: the writer is not always
    /// the viewer, and CultureInfo travels with the thread. See CircuitCulture.
    /// </summary>
    protected override void OnInitialized()
    {
        AppState.PropertyChanged += OnAppStateChanged;
        Editor.PropertyChanged += OnEditorChanged;
        SharedAppState.SessionChanged += OnSessionChanged;
    }

    private void OnAppStateChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName is not (nameof(AppState.SelectedProjectItem)
                                   or nameof(AppState.SelectedProject)
                                   or nameof(AppState.MainViewport)))
            return;

        // A running order with items but nothing selected shows a quote, and it should not be the
        // same one every time the operator comes back to it.
        if (e.PropertyName is nameof(AppState.SelectedProjectItem) && AppState.SelectedProjectItem is null)
            idleHintIndex = Random.Shared.Next(idleHints.Length);

        // A different item means a different set of tiles: start over at the top rather than
        // leaving the arrows halfway down a grid the operator has not seen yet.
        if (e.PropertyName is nameof(AppState.SelectedProjectItem) or nameof(AppState.SelectedProject))
            navIndex = -1;

        _ = InvokeAsync(StateHasChanged);
    }

    private void OnEditorChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(PresentationEditorState.SelectedSong)
            or nameof(PresentationEditorState.SelectedBibleText)
            or nameof(PresentationEditorState.SelectedImage)
            or nameof(PresentationEditorState.SelectedAudio)
            or nameof(PresentationEditorState.SelectedSlides)
            or nameof(PresentationEditorState.LoadedPresentation)
            or nameof(PresentationEditorState.Theme)
            or nameof(PresentationEditorState.IsEditingImageOrder))
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void OnSessionChanged(SessionChange change)
    {
        // Which tile is marked as showing, and whether it is marked live at all.
        if (change.SessionId != SessionId) return;

        _ = InvokeAsync(Culture.Restore(StateHasChanged));
    }

    private Task SelectSlide(string itemId, int partIndex) =>
        OnSelectSlide.InvokeAsync((itemId, partIndex));

    /// <summary>
    /// The tile the arrows are on. Kept separate from which slide is live: moving here only moves
    /// focus, and Enter — the button's own default — is what puts the slide on the screens. Arrows
    /// that went live as they moved would broadcast every slide the operator scrolled past.
    /// </summary>
    private int navIndex = -1;

    private int FocusTargetIndex => navIndex < 0 ? 0 : navIndex;

    /// <summary>
    /// How many tiles the arrows can reach. Zero while the image order is being edited: those tiles
    /// are drag handles with a delete button, not slides to pick.
    /// </summary>
    private int NavCount
    {
        get
        {
            if (Editor.SelectedSong is not null)
                return Editor.EffectiveSongParts(AppState.SelectedProjectItem?.Id).Count;
            if (Editor.SelectedBibleText is not null)
                return Editor.SelectedBibleText.Parts.Count;
            if (Editor.SelectedImage is not null)
                return Editor.IsEditingImageOrder ? 0 : Editor.SelectedImage.Urls.Count;
            if (Editor.SelectedSlides is not null)
                return Editor.SelectedSlides.Urls.Count;
            return 0;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // Grid, not vertical: the tiles wrap by CSS, so how many fit on a row is a fact only the
        // browser holds. All four arrows step one tile, which behaves the same in every window size.
        if (!ListNavigation.TryMove(e, navIndex, NavCount, ListOrientation.Grid, out var next))
            return;

        navIndex = next;
        await JsRuntime.InvokeVoidAsync("gospelPresenter.focusNavItem", "main", navIndex);
    }

    /// <summary>
    /// Follows IsEditingImageOrder rather than being told about it, so the header only has to flip
    /// the flag. The list of tiles is rendered here, so the sortable that binds to it belongs here.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var wanted = Editor.IsEditingImageOrder ? Editor.SelectedImage?.Urls.Count : null;
        if (wanted == sortableParts) return;

        if (sortableParts is not null)
            await JsRuntime.InvokeVoidAsync("destroySortableList", "image-slide-list");

        sortableParts = wanted;

        if (wanted is not null)
        {
            dotNetRef ??= DotNetObjectReference.Create(this);
            await JsRuntime.InvokeVoidAsync("initSortableList", "image-slide-list", dotNetRef);
        }
    }

    [JSInvokable]
    public async Task OnItemReordered(int oldIndex, int newIndex)
    {
        if (Editor.SelectedImage is null || Editor.SelectedImage.PartIds.Count == 0) return;
        if (oldIndex < 0 || oldIndex >= Editor.SelectedImage.Urls.Count || newIndex < 0 || newIndex >= Editor.SelectedImage.Urls.Count) return;

        var urls = Editor.SelectedImage.Urls.ToList();
        var partIds = Editor.SelectedImage.PartIds.ToList();

        var movedUrl = urls[oldIndex];
        urls.RemoveAt(oldIndex);
        urls.Insert(newIndex, movedUrl);

        var movedPartId = partIds[oldIndex];
        partIds.RemoveAt(oldIndex);
        partIds.Insert(newIndex, movedPartId);

        Editor.SelectedImage = new Image(Editor.SelectedImage.Id, urls, partIds);

        // Update the in-memory model
        var imageItem = Editor.LoadedPresentation?.Items.FirstOrDefault(x => x.Id == Editor.SelectedImage.Id);
        if (imageItem is not null)
        {
            for (var i = 0; i < partIds.Count; i++)
            {
                var part = imageItem.Parts.FirstOrDefault(p => p.Id == partIds[i]);
                if (part is not null)
                    part.SortOrder = i;
            }
        }

        // Persist to database
        if (PresentationId is not null)
        {
            var orgId = OrgState.ActiveOrganizationId;
            if (orgId is not null)
                await PresentationService.ReorderItemPartsAsync(orgId, PresentationId, Editor.SelectedImage.Id, partIds, OrgState.ToCallerContext());
        }

        if (PresentationId is not null)
            SharedAppState.NotifyPresentationChanged(PresentationId, AppState.SessionId);

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        AppState.PropertyChanged -= OnAppStateChanged;
        Editor.PropertyChanged -= OnEditorChanged;
        SharedAppState.SessionChanged -= OnSessionChanged;

        if (sortableParts is not null)
        {
            try { await JsRuntime.InvokeVoidAsync("destroySortableList", "image-slide-list"); } catch { }
        }

        dotNetRef?.Dispose();
    }
}
