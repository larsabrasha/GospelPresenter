@using GospelPresenter.Shared.Models

@if (Presentations.Count > 0)
{
    <div class="space-y-2">
        <div class="text-xs font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400 px-5">@Title</div>
        <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t-[0.5px] border-white dark:border-neutral-700 overflow-hidden">
            @foreach (var presentation in Presentations)
            {
                <PresentationRow Presentation="presentation" ShowDate="ShowDate"/>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public IList<PresentationSummary> Presentations { get; set; } = [];
    [Parameter] public bool ShowDate { get; set; } = true;
}
