<Dialog Class="bg-white dark:bg-neutral-800 max-w-2xl" OnClose="OnClose">
    <div class="p-6 space-y-4">
        <div class="font-semibold text-lg">@Title</div>
        <FloatingInput @ref="floatingInput" Id="dialog-name" Label="@L["Common.Name"]"
                       Value="@name" OnInput="HandleNameInput" OnKeyDown="OnKeyDown"
                       MaxLength="AppConstraints.NameMaxLength"/>
        <div class="flex justify-end gap-3">
            <AppButton Variant="ButtonVariant.Cancel" OnClick="OnClose">
                @L["Common.Cancel"]
            </AppButton>
            <AppButton Variant="ButtonVariant.Primary" Disabled="@(isSaving || string.IsNullOrWhiteSpace(name))" OnClick="Save">
                @(isSaving && SaveLoadingText is not null ? SaveLoadingText : SaveText)
            </AppButton>
        </div>
    </div>
</Dialog>

@code {

    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public EventCallback<string> OnSave { get; set; }
    [Parameter, EditorRequired] public EventCallback OnClose { get; set; }
    [Parameter] public string? SaveText { get; set; }
    [Parameter] public string? SaveLoadingText { get; set; }

    private string name = "";
    private bool isSaving;
    private FloatingInput? floatingInput;

    protected override void OnInitialized()
    {
        name = Name;
        SaveText ??= L["Common.Save"];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && floatingInput is not null)
        {
            try { await floatingInput.FocusAsync(); } catch { }
        }
    }

    private void HandleNameInput(ChangeEventArgs e) => name = e.Value?.ToString() ?? "";

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(name))
        {
            await Save();
        }
        else if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task Save()
    {
        var trimmed = name.Trim();
        if (isSaving || string.IsNullOrWhiteSpace(trimmed)) return;

        isSaving = true;
        await OnSave.InvokeAsync(trimmed);
    }

}
