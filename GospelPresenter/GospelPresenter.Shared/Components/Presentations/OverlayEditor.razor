@implements IDisposable

@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Utils
@using Microsoft.AspNetCore.Components.Forms

<div class="@Class">
    <div class="space-y-4">
        <FloatingInput Id="overlay-title" Label="@L["OverlayEditor.Title"]"
                       Value="@Overlay.Title" OnInput="HandleTitleChanged"
                       MaxLength="DataLimits.OverlayTitleMaxLength"/>
        <FloatingTextarea Id="overlay-content" Label="@L["OverlayEditor.TextContent"]"
                          Value="@Overlay.Content" OnInput="HandleContentChanged" Rows="4"
                          MaxLength="DataLimits.OverlayContentMaxLength"/>
        <div>
            <label class="block text-sm font-medium mb-1">@L["OverlayEditor.ImageOptional"]</label>
            @if (Overlay.ImageData is not null || Overlay.HasImage)
            {
                var imgSrc = Overlay.ImageData is not null
                    ? $"data:{Overlay.ImageContentType};base64,{Convert.ToBase64String(Overlay.ImageData)}"
                    : ImageUrlHelper.OverlayImageUrl(Overlay.Id);
                <div class="flex items-center gap-3">
                    <img src="@imgSrc" alt="@L["OverlayEditor.Preview"]" class="w-48 h-[108px] object-cover rounded-lg border border-neutral-200 dark:border-neutral-600"/>
                    <div class="flex flex-col items-start gap-1">
                        <AppButton Variant="ButtonVariant.Secondary" AsLabel>
                            @L["Common.ChangeImage"]
                            <InputFile OnChange="HandleImageUpload" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden"/>
                        </AppButton>
                        <AppButton Variant="ButtonVariant.Danger" OnClick="RemoveImage"
                                   Class="text-left">@L["Common.RemoveImage"]</AppButton>
                    </div>
                </div>
            }
            else
            {
                <AppButton Variant="ButtonVariant.Secondary" AsLabel>
                    @L["Common.ChooseImage"]
                    <InputFile OnChange="HandleImageUpload" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden"/>
                </AppButton>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public required OverlaySlide Overlay { get; set; }
    [Parameter] public EventCallback<OverlaySlide> OnChanged { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public string? Class { get; set; }
    private readonly Debouncer debounce = new();

    public void Dispose() => debounce.Dispose();

    private void HandleTitleChanged(ChangeEventArgs e)
    {
        Overlay.Title = e.Value?.ToString() ?? "";
        debounce.Run(SaveFields);
    }

    private void HandleContentChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        Overlay.Content = string.IsNullOrWhiteSpace(value) ? null : value;
        debounce.Run(SaveFields);
    }

    private async Task SaveFields()
    {
        if (string.IsNullOrWhiteSpace(Overlay.Title)) return;
        Overlay.Title = Overlay.Title.Trim();
        if (Overlay.Content is not null) Overlay.Content = Overlay.Content.Trim();
        await OnChanged.InvokeAsync(Overlay);
        await OnSaved.InvokeAsync();
    }

    private async Task RemoveImage()
    {
        if (string.IsNullOrWhiteSpace(Overlay.Title)) return;
        Overlay.Title = Overlay.Title.Trim();
        Overlay.ImageData = null;
        Overlay.HasImage = false;
        await OnChanged.InvokeAsync(Overlay);
        await OnSaved.InvokeAsync();
    }

    private static readonly HashSet<string> AllowedImageTypes = ["image/jpeg", "image/png", "image/webp", "image/gif"];

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(Overlay.Title)) return;
        var file = e.File;
        if (!AllowedImageTypes.Contains(file.ContentType)) return;
        if (file.Size > DataLimits.MaxImageFileSizeBytes) return;

        Overlay.Title = Overlay.Title.Trim();
        using var stream = file.OpenReadStream(DataLimits.MaxImageFileSizeBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        Overlay.ImageData = ms.ToArray();
        Overlay.ImageContentType = file.ContentType;
        await OnChanged.InvokeAsync(Overlay);
        await OnSaved.InvokeAsync();
    }
}
