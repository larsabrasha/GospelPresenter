@implements IDisposable

@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.State
@using GospelPresenter.Shared.Utils

@inject IJSRuntime JsRuntime
@inject ActiveOrganizationState OrgState
@inject IServiceProvider Services
@using GospelPresenter.Shared.Services

<div class="@Class">
    <div class="space-y-4">
        <FloatingInput Id="overlay-title" Label="@L["OverlayEditor.Title"]"
                       Value="@Overlay.Title" ValueChanged="HandleTitleChanged"
                       MaxLength="AppConstraints.OverlayTitleMaxLength"/>
        <FloatingTextarea Id="overlay-content" Label="@L["OverlayEditor.TextContent"]"
                          Value="@Overlay.Content" ValueChanged="HandleContentChanged" Rows="4"
                          MaxLength="AppConstraints.OverlayContentMaxLength"/>
        <div>
            <label class="block text-sm font-medium mb-1">@L["OverlayEditor.ImageOptional"]</label>
            @if (Overlay.HasImage)
            {
                <div class="flex items-center gap-3">
                    <img src="@ImageUrlHelper.OverlayImageUrl(Overlay.Id)" alt="@L["OverlayEditor.Preview"]" class="w-48 h-[108px] object-cover rounded-lg border border-neutral-200 dark:border-neutral-600"/>
                    <div class="flex flex-col items-start gap-1">
                        <AppButton Variant="ButtonVariant.Secondary" AsLabel="@(mediaUploader is null)" OnClick="PickAndUpload">
                            @L["Common.ChangeImage"]
                            @if (mediaUploader is null)
                            {
                                <input @ref="fileInput" type="file" @onchange="HandleImageUpload" accept="@AppConstraints.ImageAccept" class="hidden"/>
                            }
                        </AppButton>
                        <AppButton Variant="ButtonVariant.Danger" OnClick="RemoveImage"
                                   Class="text-left">@L["Common.RemoveImage"]</AppButton>
                    </div>
                </div>
            }
            else
            {
                <AppButton Variant="ButtonVariant.Secondary" AsLabel="@(mediaUploader is null)" OnClick="PickAndUpload">
                    @L["Common.ChooseImage"]
                    @if (mediaUploader is null)
                    {
                        <input @ref="fileInput" type="file" @onchange="HandleImageUpload" accept="@AppConstraints.ImageAccept" class="hidden"/>
                    }
                </AppButton>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public required OverlaySlide Overlay { get; set; }
    [Parameter] public EventCallback<OverlaySlide> OnChanged { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public string? Class { get; set; }
    private readonly Debouncer debounce = new();
    private ElementReference fileInput;
    private DotNetObjectReference<OverlayEditor>? dotNetRef;
    private IMediaUploader? mediaUploader;

    public void Dispose()
    {
        debounce.Dispose();
        dotNetRef?.Dispose();
    }

    private void HandleTitleChanged(string value)
    {
        Overlay.Title = value;
        debounce.Run(SaveFields);
    }

    private void HandleContentChanged(string value)
    {
        Overlay.Content = string.IsNullOrWhiteSpace(value) ? null : value;
        debounce.Run(SaveFields);
    }

    // The trim below deliberately does not bump a Revision on the fields. This runs from the
    // debounce while someone is still typing, so writing the trimmed value back into the field
    // would delete the space they just pressed — the exact bug DomOwnedInputBase exists to stop.
    // The field keeps what was typed, the stored value is trimmed, and the two agree again on
    // the next keystroke.
    private async Task SaveFields()
    {
        if (string.IsNullOrWhiteSpace(Overlay.Title)) return;
        Overlay.Title = Overlay.Title.Trim();
        if (Overlay.Content is not null) Overlay.Content = Overlay.Content.Trim();
        await OnChanged.InvokeAsync(Overlay);
        await OnSaved.InvokeAsync();
    }

    private async Task RemoveImage()
    {
        if (string.IsNullOrWhiteSpace(Overlay.Title)) return;
        Overlay.Title = Overlay.Title.Trim();
        Overlay.ImageData = null;
        Overlay.HasImage = false;
        await OnChanged.InvokeAsync(Overlay);
        await OnSaved.InvokeAsync();
    }

    // Only the device app registers an uploader; the web keeps the file input.
    protected override void OnInitialized() =>
        mediaUploader = Services.GetService(typeof(IMediaUploader)) as IMediaUploader;

    /// <summary>The device path: the picker and the ingest both live behind the seam.</summary>
    private async Task PickAndUpload()
    {
        if (mediaUploader is null) return;
        if (string.IsNullOrWhiteSpace(Overlay.Title)) return;
        if (string.IsNullOrEmpty(Overlay.Id)) return;
        if (OrgState.ActiveOrganizationId is null) return;

        Overlay.Title = Overlay.Title.Trim();
        await mediaUploader.PickAndUploadAsync(
            new MediaUploadTarget(MediaUploadKind.OverlayImage, OrgState.ActiveOrganizationId, Overlay.Id),
            new MediaUploadCallbacks(OnUploadStarted, json => _ = OnFileUploaded(json), OnFileUploadFailed, OnAllUploadsComplete));
    }

    private async Task HandleImageUpload()
    {
        if (string.IsNullOrWhiteSpace(Overlay.Title)) return;
        if (string.IsNullOrEmpty(Overlay.Id)) return;
        if (OrgState.ActiveOrganizationId is null) return;

        Overlay.Title = Overlay.Title.Trim();
        dotNetRef ??= DotNetObjectReference.Create(this);
        await JsRuntime.InvokeVoidAsync("uploadFiles", fileInput, $"/api/upload/overlay-image/{Overlay.Id}", OrgState.ActiveOrganizationId, dotNetRef, AppConstraints.MaxImageFileSizeBytes, AppConstraints.AllowedImageTypes);
    }

    [JSInvokable]
    public void OnUploadStarted(int totalCount) { }

    [JSInvokable]
    public async Task OnFileUploaded(string json)
    {
        Overlay.HasImage = true;
        StateHasChanged();
        await OnSaved.InvokeAsync();
    }

    [JSInvokable]
    public void OnFileUploadFailed(string fileName) { }

    [JSInvokable]
    public void OnAllUploadsComplete() { }
}
