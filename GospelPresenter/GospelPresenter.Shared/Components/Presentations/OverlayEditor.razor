@using GospelPresenter.Shared.Models

<div class="flex flex-col h-full">
    <div class="shrink-0">
        <button class="flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-700 hover:text-neutral-700 dark:hover:text-neutral-200 cursor-pointer px-4 py-2.5 mb-2 -ml-1 rounded-full"
                @onclick="OnBack">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
            </svg>
            Tillbaka
        </button>
    </div>

    <div class="flex-1 min-h-0 overflow-y-auto space-y-4">
        <div>
            <label class="block text-sm font-medium mb-1">Titel</label>
            <input type="text" @bind="title" placeholder="Namn"
                   class="px-3 py-2 rounded-lg border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 text-sm w-full"/>
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Textinnehåll</label>
            <textarea @bind="content" placeholder="Text som visas i overlayen (valfritt)" rows="4"
                      class="px-3 py-2 rounded-lg border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 text-sm w-full resize-none"/>
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Bild (valfritt)</label>
            @if (imageData is not null || (Overlay.ImageData is not null && !clearImage))
            {
                <div class="flex items-center gap-2">
                    <label class="text-sm text-sky-500 hover:text-sky-600 cursor-pointer">
                        Byt bild
                        <InputFile OnChange="HandleImageUpload" accept="image/*" class="hidden"/>
                    </label>
                    <button class="text-sm text-red-500 hover:text-red-600 cursor-pointer"
                            @onclick="RemoveImage">Ta bort bild</button>
                </div>
            }
            else
            {
                <label class="text-sm text-sky-500 hover:text-sky-600 cursor-pointer">
                    Välj bild
                    <InputFile OnChange="HandleImageUpload" accept="image/*" class="hidden"/>
                </label>
            }
        </div>
    </div>

    <div class="shrink-0 flex items-center justify-between pt-4">
        @if (isExisting)
        {
            <button class="px-4 py-2.5 rounded-full text-sm cursor-pointer @(showDeleteConfirm ? "bg-red-500 text-white hover:bg-red-600" : "text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20")"
                    @onclick="HandleDelete">
                @(showDeleteConfirm ? "Bekräfta borttagning" : "Ta bort")
            </button>
        }
        else
        {
            <div></div>
        }
        <div class="flex gap-2">
            <button class="px-4 py-2.5 rounded-full text-sm text-neutral-500 hover:bg-neutral-100 dark:hover:bg-neutral-700 cursor-pointer"
                    @onclick="OnBack">
                Avbryt
            </button>
            <button class="px-4 py-2.5 rounded-full text-sm bg-sky-500 text-white hover:bg-sky-600 cursor-pointer disabled:opacity-50"
                    disabled="@string.IsNullOrWhiteSpace(title)"
                    @onclick="HandleSave">
                Spara
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public required OverlaySlide Overlay { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback<OverlaySlide> OnSaved { get; set; }
    [Parameter] public EventCallback<OverlaySlide> OnDeleted { get; set; }

    private string title = "";
    private string content = "";
    private byte[]? imageData;
    private bool clearImage;
    private bool showDeleteConfirm;
    private bool isExisting;

    protected override void OnInitialized()
    {
        isExisting = !string.IsNullOrWhiteSpace(Overlay.OrganizationId);
        title = Overlay.Title;
        content = Overlay.Content ?? "";
    }

    private async Task HandleSave()
    {
        if (string.IsNullOrWhiteSpace(title)) return;

        Overlay.Title = title.Trim();
        Overlay.Content = string.IsNullOrWhiteSpace(content) ? null : content.Trim();

        if (imageData is not null)
            Overlay.ImageData = imageData;
        else if (clearImage)
            Overlay.ImageData = null;

        await OnSaved.InvokeAsync(Overlay);
    }

    private async Task HandleDelete()
    {
        if (!showDeleteConfirm)
        {
            showDeleteConfirm = true;
            return;
        }

        await OnDeleted.InvokeAsync(Overlay);
    }

    private void RemoveImage()
    {
        imageData = null;
        clearImage = true;
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > 5 * 1024 * 1024) return;

        using var stream = file.OpenReadStream(5 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        imageData = ms.ToArray();
        clearImage = false;
    }
}
