@implements IDisposable

@using GospelPresenter.Shared.Components.Presentations.AddItem
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using GospelPresenter.Shared.Utils

@inject ISongService SongService
@inject AppState AppState
@inject IJSRuntime JsRuntime
@inject ActiveOrganizationState OrgState

@if (OrgSongs.Count == 0)
{
    <div class="flex flex-col items-center justify-center text-center text-neutral-400 text-sm h-full gap-3 select-none">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-12 mb-1 text-neutral-300 dark:text-neutral-600">
            <path stroke-linecap="round" stroke-linejoin="round" d="m9 9 10.5-3m0 6.553v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 1 1-.99-3.467l2.31-.66a2.25 2.25 0 0 0 1.632-2.163Zm0 0V2.25L9 5.25v10.303m0 0v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 0 1-.99-3.467l2.31-.66A2.25 2.25 0 0 0 9 15.553Z"/>
        </svg>
        <p class="text-neutral-400 dark:text-neutral-500">@L["SongTab.NoSongs"]</p>
        @if (OrgState.HasPermission(Permission.ManageSongs))
        {
            <AppButton Variant="ButtonVariant.Secondary" Href="/admin/songs" Class="flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75"/>
                </svg>
                @L["SongTab.ManageSongs"]
            </AppButton>
        }
        <AppButton Variant="ButtonVariant.Secondary" OnClick="EnterCreateMode" Class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
            </svg>
            @L["SongTab.CreateNewSong"]
        </AppButton>
    </div>
}
else
{
    <div class="flex flex-col h-full" @onkeydown="OnKeyDown" tabindex="-1">
        <div class="shrink-0">
            <div class="relative">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-neutral-400 pointer-events-none">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
                </svg>
                <input type="text"
                       class="w-full py-2.5 pl-10 pr-4 rounded-full border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-700 text-neutral-900 dark:text-neutral-100 focus:outline-none focus:ring-2 focus:ring-sky-500 @(string.IsNullOrEmpty(query) ? "" : "!pr-9")"
                       placeholder="@L["Common.Search"]"
                       value="@query"
                       @oninput="OnSearchInput"/>
                @if (!string.IsNullOrEmpty(query))
                {
                    <AppButton Variant="ButtonVariant.Icon" OnClick="ClearSearch" Class="absolute right-2.5 top-1/2 -translate-y-1/2 size-6">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                        </svg>
                    </AppButton>
                }
            </div>
        </div>

        <div class="mt-3 flex-1 min-h-0 flex flex-col md:flex-row">
            @if (results.Count > 0)
            {
                <div class="w-full md:w-[50%] min-w-0 min-h-0 flex flex-col pr-0 md:pr-3">
                    <div class="flex-1 min-h-0 overflow-y-auto" data-song-list>
                        <Virtualize Items="results" Context="song" ItemSize="56" OverscanCount="5">
                            @{
                                var isSelected = selectedSong?.Id == song.Id;
                            }
                            <button class="w-full text-left px-3 h-[52px] mb-1 flex flex-col justify-center rounded-lg cursor-pointer text-sm @(isSelected ? "bg-sky-500/15 dark:bg-sky-500/20 ring-1 ring-inset ring-sky-500/30" : "bg-neutral-50 dark:bg-neutral-700/50 hover:bg-neutral-200 dark:hover:bg-neutral-600")"
                                    @onclick="() => SelectSong(song)">
                                <div class="truncate w-full">@((MarkupString)Highlight(song.Name))</div>
                                <div class="text-xs text-neutral-400 truncate w-full">@(string.IsNullOrEmpty(song.Author) ? (MarkupString)"\u00a0" : (MarkupString)Highlight(song.Author))</div>
                            </button>
                        </Virtualize>
                    </div>
                    <div class="shrink-0 pt-3">
                        <AppButton Variant="ButtonVariant.Secondary" OnClick="EnterCreateMode" Class="flex items-center gap-1.5">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 shrink-0">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                            </svg>
                            @L["SongTab.CreateNewSong"]
                        </AppButton>
                    </div>
                </div>

                <div class="hidden md:block md:w-[50%] min-w-0 overflow-y-scroll overflow-x-hidden md:pl-3" data-song-preview>
                    @if (selectedSong is not null && previewWidth > 0)
                    {
                        var previewScale = previewWidth / AppState.BaseSlideWidth;
                        <div class="mb-4 px-1 flex items-start gap-2">
                            <div class="flex-1 min-w-0">
                                <div class="font-semibold text-sm">@((MarkupString)Highlight(selectedSong.Name))</div>
                                @if (!string.IsNullOrEmpty(selectedSong.Author))
                                {
                                    <div class="text-xs text-neutral-400">@((MarkupString)Highlight(selectedSong.Author))</div>
                                }
                            </div>
                            <AppButton Variant="ButtonVariant.Icon" OnClick="() => EditSong(selectedSong)" Class="shrink-0 size-7 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200">
                                <PencilSymbol Class="size-4"/>
                            </AppButton>
                        </div>
                        <div class="flex flex-col gap-2">
                            @foreach (var part in selectedSong.Parts)
                            {
                                <SongSlide
                                    ContentHtml="@(Highlight(part.Content).Replace("\n", "<br>"))"
                                    Label="@part.Label"
                                    LabelColor="@part.LabelColor"
                                    Class="border-t border-neutral-800/90 bg-black rounded-2xl overflow-hidden text-white"
                                    BaseWidth="@AppState.BaseSlideWidth"
                                    BaseHeight="@AppState.BaseSlideHeight"
                                    Scale="@previewScale"/>
                            }
                        </div>
                    }
                    else if (selectedSong is null)
                    {
                        <div class="flex flex-col items-center justify-center h-full text-neutral-400 text-sm select-none">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-12 mb-3 text-neutral-300 dark:text-neutral-600">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m9 9 10.5-3m0 6.553v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 1 1-.99-3.467l2.31-.66a2.25 2.25 0 0 0 1.632-2.163Zm0 0V2.25L9 5.25v10.303m0 0v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 0 1-.99-3.467l2.31-.66A2.25 2.25 0 0 0 9 15.553Z"/>
                            </svg>
                            <p class="text-neutral-400 dark:text-neutral-500">@L["SongTab.NoSongSelected"]</p>
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(query))
            {
                <div class="flex flex-col items-center justify-center w-full text-neutral-400 text-sm gap-3">
                    <div>@L["SongTab.NoSongsFound"]</div>
                    <AppButton Variant="ButtonVariant.Secondary" OnClick="EnterCreateMode" Class="flex items-center gap-1.5 self-start">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                        </svg>
                        @L["SongTab.CreateNewSong"]
                    </AppButton>
                </div>
            }
        </div>

        @if (mobilePreviewSong is not null)
        {
            <div class="md:hidden fixed inset-0 z-50 flex flex-col bg-white dark:bg-neutral-800">
                <div class="shrink-0 flex items-center gap-3 px-4 py-3 border-b border-neutral-200 dark:border-neutral-700">
                    <AppButton Variant="ButtonVariant.Icon" OnClick="CloseMobilePreview">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                        </svg>
                    </AppButton>
                    <div class="flex-1 min-w-0">
                        <div class="font-semibold text-sm truncate">@mobilePreviewSong.Name</div>
                        @if (!string.IsNullOrEmpty(mobilePreviewSong.Author))
                        {
                            <div class="text-xs text-neutral-400 truncate">@mobilePreviewSong.Author</div>
                        }
                    </div>
                    <AppButton Variant="ButtonVariant.Icon" OnClick="() => EditSong(mobilePreviewSong)" Class="shrink-0 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200">
                        <PencilSymbol Class="size-4"/>
                    </AppButton>
                </div>
                <div class="flex-1 overflow-y-auto p-4" data-mobile-song-preview>
                    @if (mobilePreviewWidth > 0)
                    {
                        var mobileScale = mobilePreviewWidth / AppState.BaseSlideWidth;
                        <div class="flex flex-col gap-2">
                            @foreach (var part in mobilePreviewSong.Parts)
                            {
                                <SongSlide
                                    ContentHtml="@(part.Content.Replace("\n", "<br>"))"
                                    Label="@part.Label"
                                    LabelColor="@part.LabelColor"
                                    Class="border-t border-neutral-800/90 bg-black rounded-2xl overflow-hidden text-white"
                                    BaseWidth="@AppState.BaseSlideWidth"
                                    BaseHeight="@AppState.BaseSlideHeight"
                                    Scale="@mobileScale"/>
                            }
                        </div>
                    }
                </div>
                <div class="shrink-0 flex items-center justify-between gap-4 px-4 py-3 border-t border-neutral-200 dark:border-neutral-700">
                    <div class="shrink-0 whitespace-nowrap">
                        <AddMoreCheckbox State="AddMoreState"/>
                    </div>
                    <AppButton Variant="ButtonVariant.Primary" Disabled="isAdding" OnClick="MobileAdd" Class="min-w-0 inline-flex items-center gap-1">
                        <span class="shrink-0">@L["Common.Add"]</span> <span class="font-bold truncate">@mobilePreviewSong.Name</span>
                    </AppButton>
                </div>
            </div>
        }

        @if (selectedSong is not null)
        {
            <div class="shrink-0 hidden md:flex items-center justify-end gap-10 pt-4">
                <AddMoreCheckbox State="AddMoreState"/>
                <AppButton Variant="ButtonVariant.Primary" Disabled="isAdding" OnClick="HandleAdd" Class="max-w-full inline-flex items-center gap-1">
                    <span class="shrink-0">@L["Common.Add"]</span> <span class="font-bold truncate">@selectedSong.Name</span>
                </AppButton>
            </div>
        }
    </div>
}

@if (showNameDialog)
{
    <NameDialog Title="@L["Songs.NewSong"]"
                Name="@newSongName"
                SaveText="@L["Common.Create"]"
                SaveLoadingText="@L["Common.Creating"]"
                OnSave="HandleCreateSong"
                OnClose="() => showNameDialog = false"/>
}

@code {
    [Parameter] public EventCallback<Song> OnAdd { get; set; }
    [Parameter] public EventCallback<Song> OnAddKeepOpen { get; set; }
    [Parameter] public AddMoreToggle AddMoreState { get; set; } = new();
    [Parameter] public EventCallback<string> OnEditSong { get; set; }

    private string query = "";
    private string[] searchTerms = [];
    private List<Song> results = [];
    private Song? selectedSong;
    private double previewWidth;
    private double mobilePreviewWidth;
    private Song? mobilePreviewSong;
    private readonly Debouncer searchDebounce = new(150);
    private bool isAdding;
    private string? organizationId;
    private int? pendingScrollIndex;
    private bool showNameDialog;
    private string newSongName = "";

    private IReadOnlyList<Song> OrgSongs => organizationId is not null
        ? SongService.GetSongsByOrganization(organizationId, OrgState.ToCallerContext())
        : [];

    protected override Task OnInitializedAsync()
    {
        organizationId = OrgState.ActiveOrganizationId;
        results = OrgSongs.ToList();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Measure available content width: clientWidth minus padding and scrollbar
            previewWidth = await JsRuntime.InvokeAsync<double>("eval",
                "((el) => { if(!el) return 0; var s=getComputedStyle(el); return el.clientWidth - parseFloat(s.paddingLeft) - parseFloat(s.paddingRight) - 2; })(document.querySelector('[data-song-preview]'))");
            StateHasChanged();
        }

        if (pendingScrollIndex is { } index)
        {
            pendingScrollIndex = null;
            await ScrollSelectedIntoView(index);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.ShiftKey && selectedSong is not null && !isAdding)
        {
            isAdding = true;
            try
            {
                await OnAddKeepOpen.InvokeAsync(selectedSong);
            }
            finally
            {
                isAdding = false;
            }
        }
        else if (e.Key == "Enter" && (e.MetaKey || e.CtrlKey) && selectedSong is not null)
        {
            await HandleAdd();
        }
        else if (e.Key == "ArrowDown" && results.Count > 0)
        {
            var idx = selectedSong is not null ? results.IndexOf(selectedSong) : -1;
            if (idx < results.Count - 1)
            {
                selectedSong = results[idx + 1];
                await ScrollSelectedIntoView(idx + 1);
            }
        }
        else if (e.Key == "ArrowUp" && results.Count > 0)
        {
            var idx = selectedSong is not null ? results.IndexOf(selectedSong) : results.Count;
            if (idx > 0)
            {
                selectedSong = results[idx - 1];
                await ScrollSelectedIntoView(idx - 1);
            }
        }
    }

    private async Task ScrollSelectedIntoView(int index)
    {
        // Scroll song list to keep selected item visible
        await JsRuntime.InvokeVoidAsync("eval",
            $"((el,i)=>{{if(!el)return;var top=i*56;if(top<el.scrollTop)el.scrollTop=top;else if(top+56>el.scrollTop+el.clientHeight)el.scrollTop=top+56-el.clientHeight}})(document.querySelector('[data-song-list]'),{index})");
        // Scroll preview to top when changing selection
        await JsRuntime.InvokeVoidAsync("eval",
            "document.querySelector('[data-song-preview]')?.scrollTo(0,0)");
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        searchTerms = string.IsNullOrWhiteSpace(query)
            ? []
            : query.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        searchDebounce.Run(async () =>
        {
            results = SongService.SearchByOrganization(query, organizationId!, OrgState.ToCallerContext()).ToList();
            selectedSong = results.Count > 0 ? results[0] : null;
            await ScrollListsToTop();
        });
    }

    private async Task ClearSearch()
    {
        query = "";
        searchTerms = [];
        results = OrgSongs.ToList();
        selectedSong = results.Count > 0 ? results[0] : null;
        await ScrollListsToTop();
    }

    private async Task ScrollListsToTop()
    {
        await JsRuntime.InvokeVoidAsync("eval",
            "document.querySelector('[data-song-list]')?.scrollTo(0,0);document.querySelector('[data-song-preview]')?.scrollTo(0,0)");
    }

    private async Task SelectSong(Song song)
    {
        selectedSong = song;
        // On mobile, open full-screen preview
        var isMobile = await JsRuntime.InvokeAsync<bool>("eval", "window.innerWidth < 768");
        if (isMobile)
        {
            mobilePreviewSong = song;
            StateHasChanged();
            await Task.Yield();
            mobilePreviewWidth = await JsRuntime.InvokeAsync<double>("eval",
                "((el) => { if(!el) return 0; var s=getComputedStyle(el); return el.clientWidth - parseFloat(s.paddingLeft) - parseFloat(s.paddingRight) - 2; })(document.querySelector('[data-mobile-song-preview]'))");
        }
    }

    private void CloseMobilePreview()
    {
        mobilePreviewSong = null;
    }

    private async Task MobileAdd()
    {
        if (mobilePreviewSong is null || isAdding) return;
        isAdding = true;
        try
        {
            selectedSong = mobilePreviewSong;
            mobilePreviewSong = null;
            await OnAdd.InvokeAsync(selectedSong);
        }
        finally
        {
            isAdding = false;
        }
    }

    private async Task HandleAdd()
    {
        if (selectedSong is null || isAdding) return;
        isAdding = true;
        try
        {
            await OnAdd.InvokeAsync(selectedSong);
        }
        finally
        {
            isAdding = false;
        }
    }

    private bool wasInMobilePreview;

    private async Task EditSong(Song song)
    {
        wasInMobilePreview = mobilePreviewSong is not null;
        mobilePreviewSong = null;
        await OnEditSong.InvokeAsync(song.Id);
    }

    private void EnterCreateMode()
    {
        newSongName = query;
        showNameDialog = true;
    }

    public void NotifyEditComplete(string? editedSongId)
    {
        // Refresh song data (name/content may have changed) but preserve search and selection
        var previousId = editedSongId ?? selectedSong?.Id;
        results = string.IsNullOrWhiteSpace(query)
            ? OrgSongs.ToList()
            : SongService.SearchByOrganization(query, organizationId!, OrgState.ToCallerContext()).ToList();
        selectedSong = previousId is not null
            ? results.FirstOrDefault(s => s.Id == previousId)
            : selectedSong;
        if (wasInMobilePreview && selectedSong is not null)
        {
            mobilePreviewSong = selectedSong;
        }
        wasInMobilePreview = false;
        StateHasChanged();
    }

    private async Task HandleCreateSong(string name)
    {
        if (organizationId is null) return;
        var song = await SongService.CreateSongAsync(name, null, null, null, null, [], organizationId, OrgState.ToCallerContext());
        showNameDialog = false;
        await OnEditSong.InvokeAsync(song.Id);
    }

    private void RefreshSongList()
    {
        query = "";
        searchTerms = [];
        results = OrgSongs.ToList();
        selectedSong = null;
    }

    public void Dispose() => searchDebounce.Dispose();

    private string Highlight(string text) => SearchHighlighter.Highlight(text, searchTerms);

}
