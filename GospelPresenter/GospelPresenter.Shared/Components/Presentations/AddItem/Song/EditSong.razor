<div class="flex flex-col h-full">
    <div class="shrink-0 px-4 py-3 md:px-0 md:py-0">
        <DetailHeader @ref="header" OnBack="OnBack"/>
    </div>

    <div class="flex-1 min-h-0 overflow-y-auto">
        <div class="px-4 pb-6 md:px-0 md:pb-0">
            <SongEditor SongId="@SongId" OnDeleted="OnDeleted" OnSaved="() => header?.ShowSaved()"/>
        </div>
    </div>
    
    <div class="shrink-0 px-4 py-3 md:px-0 md-py-0"></div>
</div>

@code {
    [Parameter, EditorRequired] public string SongId { get; set; } = "";
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }

    private DetailHeader? header;
}
