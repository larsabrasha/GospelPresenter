<div class="flex flex-col h-full">
    <div class="shrink-0 relative flex items-center mb-2">
        <AppButton Variant="ButtonVariant.Cancel" OnClick="OnBack" Class="flex items-center gap-2 -ml-1">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
            </svg>
            @L["Common.Back"]
        </AppButton>
        <AutoSaveIndicator @ref="saveIndicator" Class="absolute right-0"/>
    </div>

    <div class="flex-1 min-h-0 overflow-y-auto">
        <SongEditor SongId="@SongId" OnDeleted="OnDeleted" OnSaved="() => saveIndicator?.Show()"/>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string SongId { get; set; } = "";
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }

    private AutoSaveIndicator? saveIndicator;
}
