@using GospelPresenter.Shared.State

<div class="flex flex-col h-full">
    <div class="shrink-0">
        <button class="flex items-center gap-2 text-sm text-neutral-500 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-700 hover:text-neutral-700 dark:hover:text-neutral-200 cursor-pointer px-4 py-2.5 mb-2 -ml-1 rounded-full"
                @onclick="HandleBack">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
            </svg>
            @L["Common.Back"]
        </button>
    </div>

    <div class="flex-1 min-h-0 overflow-y-auto space-y-4">
        <SongFieldsEditor @bind-Name="name" @bind-Author="author"
                          @bind-Publisher="publisher" @bind-Year="year" @bind-Ccli="ccli"/>

        <SongPartsEditor Parts="parts"
                         OnMoveUp="MovePartUp"
                         OnMoveDown="MovePartDown"
                         OnLabelChanged="HandleLabelChanged"
                         OnContentChanged="HandleContentChanged"
                         OnDelete="RemovePart"
                         OnAdd="AddPart"/>
    </div>

    <div class="shrink-0 flex items-center justify-end gap-3 pt-4">
        <button class="px-4 py-2.5 rounded-full text-sm text-neutral-500 hover:bg-neutral-100 dark:hover:bg-neutral-700 cursor-pointer"
                @onclick="HandleBack">
            @L["Common.Cancel"]
        </button>
        <button class="px-4 py-2.5 rounded-full text-sm bg-sky-500 text-white hover:bg-sky-600 cursor-pointer disabled:opacity-50"
                disabled="@(!CanSave)"
                @onclick="HandleSave">
            @if (isSaving)
            {
                <span>@L["Common.Saving"]</span>
            }
            else
            {
                <span>@L["CreateSong.SaveSong"]</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback<Song> OnCreated { get; set; }
    [Parameter] public string? InitialName { get; set; }

    private string name = "";
    private string? author;
    private string? publisher;
    private int? year;
    private string? ccli;
    private List<SongPart> parts = [];
    private bool isSaving;

    private bool CanSave => !isSaving && !string.IsNullOrWhiteSpace(name);

    protected override void OnInitialized()
    {
        if (parts.Count == 0)
            parts.Add(new SongPart(L["CreateSong.DefaultVerse", 1], ""));
        if (!string.IsNullOrWhiteSpace(InitialName))
            name = InitialName;
    }

    private void AddPart()
    {
        var nextNumber = parts.Count + 1;
        parts.Add(new SongPart(L["CreateSong.DefaultVerse", nextNumber], ""));
    }

    private void RemovePart(int index)
    {
        if (index >= 0 && index < parts.Count)
            parts.RemoveAt(index);
    }

    private void HandleLabelChanged(SongPartsEditor.PartLabelChange change)
    {
        if (change.Index >= 0 && change.Index < parts.Count)
        {
            var trimmed = string.IsNullOrWhiteSpace(change.Label) ? null : change.Label.Trim();
            parts[change.Index] = parts[change.Index] with { Label = trimmed };
        }
    }

    private void HandleContentChanged(SongPartsEditor.PartContentChange change)
    {
        if (change.Index >= 0 && change.Index < parts.Count)
            parts[change.Index] = parts[change.Index] with { Content = change.Content };
    }

    private void MovePartUp(int index)
    {
        if (index > 0)
            (parts[index], parts[index - 1]) = (parts[index - 1], parts[index]);
    }

    private void MovePartDown(int index)
    {
        if (index < parts.Count - 1)
            (parts[index], parts[index + 1]) = (parts[index + 1], parts[index]);
    }

    private async Task HandleSave()
    {
        if (!CanSave) return;
        isSaving = true;

        var songParts = parts
            .Where(p => !string.IsNullOrWhiteSpace(p.Content))
            .Select(p => new SongPart(p.Label, p.Content.Trim()))
            .ToList();

        await OnCreated.InvokeAsync(new Song(
            "",
            name.Trim(),
            author?.Trim(),
            publisher?.Trim(),
            year,
            ccli?.Trim(),
            songParts
        ));

        isSaving = false;
    }

    private async Task HandleBack()
    {
        await OnBack.InvokeAsync();
    }
}
