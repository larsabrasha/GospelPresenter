@using GospelPresenter.Shared.State
@implements IDisposable

@inject IJSRuntime JsRuntime
@inject ActiveOrganizationState OrgState

<div class="flex flex-col items-center justify-center h-full gap-6 px-4 py-8">
    @if (isUploading)
    {
        <div class="flex flex-col items-center gap-3 text-neutral-500 dark:text-neutral-400">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-12 text-neutral-300 dark:text-neutral-600 animate-pulse">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605"/>
            </svg>
            <span class="text-sm font-medium">@L["SlidesTab.Uploading"]</span>
        </div>
    }
    else
    {
        <AppButton Variant="ButtonVariant.Primary" Filled AsLabel Class="inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"/>
            </svg>
            @L["SlidesTab.Upload"]
            <input @ref="fileInput" type="file" accept="@AppConstraints.SlidesAccept" @onchange="HandleFileSelected" class="hidden"/>
        </AppButton>

        @if (uploadError is not null)
        {
            <p class="text-sm text-red-500 dark:text-red-400 text-center max-w-xs">@uploadError</p>
        }

        <div class="text-xs text-neutral-400 dark:text-neutral-500 text-center max-w-xs leading-relaxed space-y-3">
            @((MarkupString)L["SlidesTab.HelpText"].Value)
        </div>
    }
</div>

@code {
    [Parameter] public string PresentationId { get; set; } = "";
    [Parameter] public EventCallback<SlidesAddResult> OnAdded { get; set; }

    private ElementReference fileInput;
    private DotNetObjectReference<SlidesTab>? dotNetRef;
    private bool isUploading;
    private string? uploadError;

    private async Task HandleFileSelected()
    {
        if (isUploading || string.IsNullOrEmpty(PresentationId)) return;

        var orgId = OrgState.ActiveOrganizationId;
        if (orgId is null) return;

        uploadError = null;
        isUploading = true;
        StateHasChanged();

        dotNetRef ??= DotNetObjectReference.Create(this);
        var url = $"/api/upload/presentation-slides/{PresentationId}";
        await JsRuntime.InvokeVoidAsync("uploadSlides", fileInput, url, orgId, dotNetRef);
    }

    [JSInvokable]
    public async Task OnSlidesUploaded(string json)
    {
        isUploading = false;

        var result = System.Text.Json.JsonSerializer.Deserialize<SlidesAddResult>(json, SlidesAddResult.JsonOptions);
        if (result is not null)
            await OnAdded.InvokeAsync(result);

        StateHasChanged();
    }

    [JSInvokable]
    public void OnSlidesUploadFailed(string error)
    {
        isUploading = false;
        uploadError = error.Contains("too many pages", StringComparison.OrdinalIgnoreCase)
            ? L["SlidesTab.TooManyPages"]
            : L["SlidesTab.UploadError"];
        StateHasChanged();
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }
}
