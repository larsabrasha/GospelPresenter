@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Authorization

@inject IOrganizationVideoService OrganizationVideoService
@inject IUserService UserService

@if (isLoading)
{
    <div class="flex items-center justify-center py-12 text-neutral-400 text-sm">
        Laddar videor...
    </div>
}
else if (organizationId is null)
{
    <div class="flex items-center justify-center py-12 text-neutral-400 text-sm">
        Kunde inte ladda videor
    </div>
}
else
{
    <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3">
            <div class="relative flex-1 max-w-md">
                <input type="text"
                       class="w-full py-2.5 pl-4 pr-24 rounded-full border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-700 text-neutral-900 dark:text-neutral-100 focus:outline-none focus:ring-2 focus:ring-sky-500"
                       placeholder="Klistra in YouTube-länk..."
                       @bind="urlInput"
                       @bind:event="oninput"
                       @onkeydown="OnKeyDown"/>
                <button class="absolute right-2 top-1/2 -translate-y-1/2 px-3 py-1.5 rounded-full text-sm bg-sky-500 text-white hover:bg-sky-600 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                        disabled="@(string.IsNullOrWhiteSpace(urlInput) || isSaving)"
                        @onclick="AddFromUrl">
                    @(isSaving ? "Sparar..." : "Lägg till")
                </button>
            </div>
            @if (urlError is not null)
            {
                <span class="text-red-500 text-sm">@urlError</span>
            }
        </div>

        @if (videos.Count > 0)
        {
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
                @foreach (var video in videos)
                {
                    <div class="group relative">
                        <button class="w-full rounded-lg overflow-hidden bg-neutral-100 dark:bg-neutral-700 cursor-pointer hover:ring-2 hover:ring-sky-500 transition-shadow"
                                @onclick="() => HandleVideoClicked(video)">
                            <div class="relative aspect-video">
                                <img src="https://img.youtube.com/vi/@video.YoutubeVideoId/mqdefault.jpg"
                                     alt="@video.Title"
                                     class="w-full h-full object-cover"/>
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <div class="size-10 rounded-full bg-black/60 flex items-center justify-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="size-5 ml-0.5">
                                            <path d="M8 5v14l11-7z"/>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            <div class="px-2 py-1.5 text-xs text-left truncate text-neutral-600 dark:text-neutral-300">@video.Title</div>
                        </button>
                        <button class="absolute top-1 right-1 size-7 flex items-center justify-center rounded-full bg-black/60 text-white opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer hover:bg-red-600"
                                @onclick="() => ConfirmDelete(video)"
                                @onclick:stopPropagation="true">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                            </svg>
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center text-neutral-400 text-sm py-8 select-none">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-12 mb-3 text-neutral-300 dark:text-neutral-600">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM15.91 11.672a.375.375 0 0 1 0 .656l-5.603 3.113a.375.375 0 0 1-.557-.328V8.887c0-.286.307-.466.557-.327l5.603 3.112Z"/>
                </svg>
                <p class="text-neutral-400 dark:text-neutral-500">Inga videor tillagda</p>
            </div>
        }
    </div>

    @if (videoToDelete is not null)
    {
        <div class="fixed inset-0 bg-black/40 z-200 flex items-center justify-center p-4" @onclick="CancelDelete">
            <div class="bg-white dark:bg-neutral-800 dark:text-neutral-100 rounded-2xl shadow-2xl p-6 w-full max-w-sm space-y-4"
                 @onclick:stopPropagation="true">
                <div class="font-semibold text-lg">Radera video</div>
                <div>Vill du radera <strong>@videoToDelete.Title</strong>?</div>
                <div class="flex justify-end gap-3">
                    <button class="px-4 py-2.5 rounded-full cursor-pointer hover:bg-neutral-100 dark:hover:bg-neutral-700"
                            @onclick="CancelDelete">
                        Avbryt
                    </button>
                    <button class="px-4 py-2.5 rounded-full bg-red-500 text-white cursor-pointer hover:bg-red-600"
                            @onclick="DeleteVideo">
                        Radera
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public EventCallback<OrganizationVideo> OnAdd { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string? organizationId;
    private List<OrganizationVideo> videos = [];
    private bool isLoading = true;
    private bool isSaving;
    private string urlInput = "";
    private string? urlError;
    private OrganizationVideo? videoToDelete;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            var userId = state.User.FindFirst("user_id")?.Value;
            if (userId != null)
            {
                var user = await UserService.GetByIdAsync(userId);
                organizationId = user?.OrganizationId;
            }
        }

        if (organizationId is not null)
        {
            videos = await OrganizationVideoService.GetVideosAsync(organizationId);
        }

        isLoading = false;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(urlInput))
        {
            await AddFromUrl();
        }
    }

    private async Task AddFromUrl()
    {
        urlError = null;
        var videoId = ExtractYoutubeVideoId(urlInput.Trim());

        if (videoId is null)
        {
            urlError = "Ogiltig YouTube-länk";
            return;
        }

        if (videos.Any(v => v.YoutubeVideoId == videoId))
        {
            urlError = "Videon finns redan";
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            var title = $"YouTube ({videoId})";
            var video = await OrganizationVideoService.AddVideoAsync(organizationId!, videoId, title);
            videos.Insert(0, video);
            urlInput = "";
        }
        catch
        {
            urlError = "Kunde inte spara videon";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleVideoClicked(OrganizationVideo video)
    {
        await OnAdd.InvokeAsync(video);
    }

    private void ConfirmDelete(OrganizationVideo video)
    {
        videoToDelete = video;
    }

    private void CancelDelete()
    {
        videoToDelete = null;
    }

    private async Task DeleteVideo()
    {
        if (videoToDelete is null) return;

        await OrganizationVideoService.DeleteVideoAsync(videoToDelete.Id);
        videos.Remove(videoToDelete);
        videoToDelete = null;
    }

    private static string? ExtractYoutubeVideoId(string url)
    {
        // Match youtube.com/watch?v=ID, youtu.be/ID, youtube.com/embed/ID, youtube.com/shorts/ID
        var match = Regex.Match(url, @"(?:youtube\.com/(?:watch\?.*v=|embed/|shorts/)|youtu\.be/)([a-zA-Z0-9_-]{11})");
        return match.Success ? match.Groups[1].Value : null;
    }
}
