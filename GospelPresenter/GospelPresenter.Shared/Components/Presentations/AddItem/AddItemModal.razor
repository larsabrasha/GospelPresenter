@using GospelPresenter.Shared.Components.Symbols
@using GospelPresenter.Shared.Components.Presentations.AddItem.Bible
@using GospelPresenter.Shared.Components.Presentations.AddItem.Song
@using GospelPresenter.Shared.Components.Presentations.AddItem.Image
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State

<Modal Class="bg-white dark:bg-neutral-800 max-w-4xl" OnClose="@OnClose">
    <Title>
        <span>Lägg till</span>
    </Title>
    <Body>
        <div class="flex gap-1 bg-neutral-100 dark:bg-neutral-700 rounded-full p-1 shrink-0">
            <button class="flex-1 flex items-center justify-center gap-2 px-3 py-2.5 rounded-full text-sm cursor-pointer transition-colors @TabClass(Tab.Song)"
                    @onclick="() => activeTab = Tab.Song">
                <MusicalNoteSymbol Class="size-4"/>
                Sång
            </button>
            <button class="flex-1 flex items-center justify-center gap-2 px-3 py-2.5 rounded-full text-sm cursor-pointer transition-colors @TabClass(Tab.BibleText)"
                    @onclick="() => activeTab = Tab.BibleText">
                <BookOpenSymbol Class="size-4"/>
                Bibeltext
            </button>
            <button class="flex-1 flex items-center justify-center gap-2 px-3 py-2.5 rounded-full text-sm cursor-pointer transition-colors @TabClass(Tab.Image)"
                    @onclick="() => activeTab = Tab.Image">
                <PhotoSymbol Class="size-4"/>
                Bild
            </button>
        </div>

        <div class="flex-1 min-h-0 mt-3">
            @switch (activeTab)
            {
                case Tab.Song:
                    <SongTab OnAdd="@OnAddSong" OnAddKeepOpen="@OnAddSongKeepOpen"/>
                    break;

                case Tab.BibleText:
                    <BibleTextTab OnAdd="@OnAddBibleText" OnAddKeepOpen="@OnAddBibleTextKeepOpen"/>
                    break;

                case Tab.Image:
                    <ImageTab/>
                    break;
            }
        </div>
    </Body>
</Modal>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<List<Verse>> OnAddBibleText { get; set; }
    [Parameter] public EventCallback<List<Verse>> OnAddBibleTextKeepOpen { get; set; }
    [Parameter] public EventCallback<State.Song> OnAddSong { get; set; }
    [Parameter] public EventCallback<State.Song> OnAddSongKeepOpen { get; set; }

    private enum Tab { Song, BibleText, Image }

    private Tab activeTab = Tab.Song;

    private string TabClass(Tab tab)
    {
        return activeTab == tab
            ? "bg-white dark:bg-neutral-600 shadow-sm font-semibold"
            : "hover:bg-neutral-200 dark:hover:bg-neutral-600";
    }
}
