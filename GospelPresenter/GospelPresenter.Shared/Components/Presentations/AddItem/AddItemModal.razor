@using GospelPresenter.Shared.Components.Symbols
@using GospelPresenter.Shared.Components.Presentations.AddItem.Bible
@using GospelPresenter.Shared.Components.Presentations.AddItem.Song
@using GospelPresenter.Shared.Components.Presentations.AddItem.Image
@using GospelPresenter.Shared.Components.Presentations.AddItem.Audio
@using GospelPresenter.Shared.Components.Presentations.AddItem.Slides
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State

@inject KeyboardShortcutService Shortcuts

@implements IDisposable

<Modal Class="bg-white dark:bg-neutral-800 max-w-4xl" OnClose="@OnClose">
    <Title>
        <span>@L["Common.Add"]</span>
    </Title>
    <Body>
        @if (editingSongId is not null)
        {
            <div class="fixed inset-0 z-50 flex flex-col bg-white dark:bg-neutral-800 md:static md:inset-auto md:z-auto md:h-full">
                <EditSong SongId="@editingSongId" OnBack="ExitSongEdit" OnDeleted="HandleSongDeleted"/>
            </div>
        }

        <div class="@(editingSongId is not null ? "hidden" : "mb-4 md:flex md:justify-center")">
            <PillTabs>
                <button class="@TabClass("song")" title="@TabTooltip("song", L["Sidebar.Song"])" @onclick="@(() => activeTab = "song")">
                    <MusicalNoteSymbol Class="hidden md:block size-4"/>
                    @L["Sidebar.Song"]
                </button>
                <button class="@TabClass("bible")" title="@TabTooltip("bible", L["Sidebar.BibleText"])" @onclick="@(() => activeTab = "bible")">
                    <BookOpenSymbol Class="hidden md:block size-4"/>
                    @L["Sidebar.BibleText"]
                </button>
                <button class="@TabClass("image")" title="@TabTooltip("image", L["Sidebar.Images"])" @onclick="@(() => activeTab = "image")">
                    <PhotoSymbol Class="hidden md:block size-4"/>
                    @L["Sidebar.Images"]
                </button>
                <button class="@TabClass("audio")" title="@TabTooltip("audio", L["Sidebar.Audio"])" @onclick="@(() => activeTab = "audio")">
                    <SpeakerWaveSymbol Class="hidden md:block size-4"/>
                    @L["Sidebar.Audio"]
                </button>
                <button class="@TabClass("slides")" title="@TabTooltip("slides", L["Sidebar.Slides"])" @onclick="@(() => activeTab = "slides")">
                    <RectangleStackSymbol Class="hidden md:block size-4"/>
                    @L["Sidebar.Slides"]
                </button>
            </PillTabs>
        </div>

        <div class="@(editingSongId is null && activeTab == "song" ? "flex-1 min-h-0 flex flex-col" : "hidden")">
            <SongTab @ref="songTab" OnAdd="@HandleSongAdd" OnAddKeepOpen="@HandleSongAddKeepOpen" AddMoreState="@addMoreState" OnEditSong="EnterSongEdit" Theme="@Theme"/>
        </div>
        <div class="@(editingSongId is null && activeTab == "bible" ? "flex-1 min-h-0 flex flex-col" : "hidden")">
            <BibleTextTab OnAdd="@HandleBibleAdd" OnAddKeepOpen="@HandleBibleAddKeepOpen" AddMoreState="@addMoreState"/>
        </div>
        <div class="@(editingSongId is null && activeTab == "image" ? "flex-1 min-h-0 flex flex-col" : "hidden")">
            <ImageTab OnAdd="@HandleImageAdd" OnAddKeepOpen="@HandleImageAddKeepOpen" AddMoreState="@addMoreState"/>
        </div>
        <div class="@(editingSongId is null && activeTab == "audio" ? "flex-1 min-h-0 flex flex-col" : "hidden")">
            <AudioTab OnAdd="@HandleAudioAdd" OnAddKeepOpen="@HandleAudioAddKeepOpen" AddMoreState="@addMoreState"/>
        </div>
        <div class="@(editingSongId is null && activeTab == "slides" ? "flex-1 min-h-0 flex flex-col" : "hidden")">
            <SlidesTab PresentationId="@PresentationId" OnAdded="@HandleSlidesAdded"/>
        </div>
    </Body>
</Modal>

@code {
    [Parameter] public string InitialTab { get; set; } = "song";
    [Parameter] public string PresentationId { get; set; } = "";

    /// <summary>The presentation's theme, so song previews look like the slides that will be added.</summary>
    [Parameter] public GospelPresenter.Shared.State.SlideTheme Theme { get; set; } = GospelPresenter.Shared.State.SlideTheme.Fallback;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<GospelPresenter.Shared.State.SongAddRequest> OnSongAdded { get; set; }
    [Parameter] public EventCallback<GospelPresenter.Shared.State.SongAddRequest> OnSongAddedKeepOpen { get; set; }
    [Parameter] public EventCallback<List<Verse>> OnBibleVersesAdded { get; set; }
    [Parameter] public EventCallback<List<Verse>> OnBibleVersesAddedKeepOpen { get; set; }
    [Parameter] public EventCallback<List<OrganizationImage>> OnImagesAdded { get; set; }
    [Parameter] public EventCallback<List<OrganizationImage>> OnImagesAddedKeepOpen { get; set; }
    [Parameter] public EventCallback<List<OrganizationAudio>> OnAudiosAdded { get; set; }
    [Parameter] public EventCallback<List<OrganizationAudio>> OnAudiosAddedKeepOpen { get; set; }
    [Parameter] public EventCallback<SlidesAddResult> OnSlidesAdded { get; set; }

    private ShortcutScope? scope;

    private static readonly string[] TabOrder = ["song", "bible", "image", "audio", "slides"];

    private string activeTab = "song";
    private AddMoreToggle addMoreState = new();
    private string? editingSongId;
    private SongTab? songTab;

    private string TabClass(string tab) =>
        "flex-1 shrink-0 flex items-center justify-center gap-2 px-4 py-2 rounded-full text-sm cursor-pointer transition-all whitespace-nowrap " +
        (activeTab == tab
            ? "bg-white dark:bg-neutral-600 dark:text-white shadow font-medium"
            : "hover:bg-neutral-200 dark:hover:bg-neutral-600 text-neutral-500 dark:text-neutral-400");

    protected override void OnInitialized()
    {
        activeTab = InitialTab;

        // Blocking: while this is open, the page behind it must not hear "a" and open a second copy
        // of itself, or Delete and remove the item being added to.
        scope = Shortcuts.PushScope("Shortcuts.Group.AddItem", () => InvokeAsync(StateHasChanged), blocking: true);

        // Ctrl/Cmd rather than the bare digits: the search box in each tab takes focus on open, and
        // a bare "1" belongs to whoever is typing a hymn number.
        for (var i = 0; i < TabOrder.Length; i++)
        {
            var tab = TabOrder[i];
            scope.Add(TabShortcut(i), $"Shortcuts.Tab.{tab}", () => activeTab = tab);
        }

        // Handled by each tab's own container, which can see what is selected in it. Listed here so
        // that the two ways to add are documented in the one place a reader will look.
        scope.Document(new Shortcut("Enter", Ctrl: true), "Shortcuts.AddAndClose");
        scope.Document(new Shortcut("Enter", Shift: true), "Shortcuts.AddAndStay");
        scope.Document(new Shortcut("ArrowDown"), "Shortcuts.MoveThroughResults");
    }

    private static Shortcut TabShortcut(int index) => new((index + 1).ToString(), Ctrl: true);

    private string TabTooltip(string tab, string label) =>
        $"{label} ({TabShortcut(Array.IndexOf(TabOrder, tab)).ToDisplay(Shortcuts.IsMac)})";

    public void Dispose() => scope?.Dispose();

    private async Task HandleSongAdd(GospelPresenter.Shared.State.SongAddRequest request)
    {
        if (addMoreState.Value)
            await OnSongAddedKeepOpen.InvokeAsync(request);
        else
            await OnSongAdded.InvokeAsync(request);
    }

    private async Task HandleSongAddKeepOpen(GospelPresenter.Shared.State.SongAddRequest request)
    {
        await OnSongAddedKeepOpen.InvokeAsync(request);
    }

    private async Task HandleBibleAdd(List<Verse> verses)
    {
        if (addMoreState.Value)
            await OnBibleVersesAddedKeepOpen.InvokeAsync(verses);
        else
            await OnBibleVersesAdded.InvokeAsync(verses);
    }

    private async Task HandleBibleAddKeepOpen(List<Verse> verses)
    {
        await OnBibleVersesAddedKeepOpen.InvokeAsync(verses);
    }

    private async Task HandleImageAdd(List<OrganizationImage> images)
    {
        if (addMoreState.Value)
            await OnImagesAddedKeepOpen.InvokeAsync(images);
        else
            await OnImagesAdded.InvokeAsync(images);
    }

    private async Task HandleImageAddKeepOpen(List<OrganizationImage> images)
    {
        await OnImagesAddedKeepOpen.InvokeAsync(images);
    }

    private async Task HandleAudioAdd(List<OrganizationAudio> audios)
    {
        if (addMoreState.Value)
            await OnAudiosAddedKeepOpen.InvokeAsync(audios);
        else
            await OnAudiosAdded.InvokeAsync(audios);
    }

    private async Task HandleAudioAddKeepOpen(List<OrganizationAudio> audios)
    {
        await OnAudiosAddedKeepOpen.InvokeAsync(audios);
    }

    private void EnterSongEdit(string songId)
    {
        editingSongId = songId;
    }

    private void ExitSongEdit()
    {
        var editedId = editingSongId;
        editingSongId = null;
        songTab?.NotifyEditComplete(editedId);
    }

    private void HandleSongDeleted()
    {
        editingSongId = null;
        songTab?.NotifyEditComplete(null);
    }

    private async Task HandleSlidesAdded(SlidesAddResult result)
    {
        await OnSlidesAdded.InvokeAsync(result);
    }
}
