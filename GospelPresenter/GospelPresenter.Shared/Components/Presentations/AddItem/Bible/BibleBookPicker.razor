@using GospelPresenter.Shared.Localization
@using GospelPresenter.Shared.Services

@inject IBibleService BibleService
@inject CircuitCulture Culture

<div class="flex-1 min-h-0 overflow-y-auto">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm mt-4">
        @foreach (var (label, bookIds) in groupedBooks)
        {
            <div class="flex flex-col gap-1">
                <div class="text-xs font-semibold text-neutral-400 uppercase tracking-wide px-3 mb-1 sticky top-0 bg-white dark:bg-neutral-800 py-2 z-10">@label</div>
                @foreach (var bookId in bookIds)
                {
                    <button class="px-3 py-2 rounded-lg bg-neutral-50 dark:bg-neutral-700/50 hover:bg-neutral-200 dark:hover:bg-neutral-600 cursor-pointer text-left"
                            @onclick="() => OnPicked.InvokeAsync(bookId)">
                        @BibleBookNames.GetLocalizedName(bookId, Culture.UiCulture.TwoLetterISOLanguageName)
                    </button>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string BibleId { get; set; } = "";
    [Parameter, EditorRequired] public string OrganizationId { get; set; } = "";
    [Parameter] public EventCallback<string> OnPicked { get; set; }

    private string loadedBibleId = "";
    private List<(string Label, List<string> BookIds)> groupedBooks = [];

    protected override void OnParametersSet()
    {
        if (BibleId != loadedBibleId)
        {
            loadedBibleId = BibleId;
            var books = BibleService.GetBooks(OrganizationId, BibleId);
            var ot = books.Where(BibleBookNames.IsOldTestament).ToList();
            var nt = books.Where(b => !BibleBookNames.IsOldTestament(b)).ToList();
            groupedBooks = [];
            if (ot.Count > 0) groupedBooks.Add((L["Bible.OldTestament"], ot));
            if (nt.Count > 0) groupedBooks.Add((L["Bible.NewTestament"], nt));
        }
    }
}
