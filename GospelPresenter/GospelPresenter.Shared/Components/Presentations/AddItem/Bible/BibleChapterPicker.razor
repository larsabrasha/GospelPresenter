@using GospelPresenter.Shared.Services

@inject IBibleService BibleService
@inject IJSRuntime JsRuntime

<div id="bible-chapter-list" class="flex-1 min-h-0 overflow-y-auto" @onkeydown="OnKeyDown">
    <div class="flex flex-wrap gap-1.5 text-sm">
        @for (var i = 0; i < chapters.Count; i++)
        {
            var chapter = chapters[i];
            var itemIndex = i;
            <button class="size-10 flex items-center justify-center rounded-lg bg-neutral-50 dark:bg-neutral-700/50 hover:bg-neutral-200 dark:hover:bg-neutral-600 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500"
                    data-nav-index="@itemIndex"
                    tabindex="@(itemIndex == FocusTargetIndex ? 0 : -1)"
                    @onclick="() => OnPicked.InvokeAsync(chapter)">
                @chapter
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string BibleId { get; set; } = "";
    [Parameter, EditorRequired] public string OrganizationId { get; set; } = "";
    [Parameter, EditorRequired] public string BookId { get; set; } = "";
    [Parameter] public EventCallback<int> OnPicked { get; set; }

    private string loadedBookId = "";
    private List<int> chapters = [];

    private int focusedIndex = -1;
    private int FocusTargetIndex => focusedIndex < 0 ? 0 : focusedIndex;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // Grid: the numbers wrap across as many columns as the modal is wide.
        if (!ListNavigation.TryMove(e, focusedIndex, chapters.Count, ListOrientation.Grid, out var next))
            return;

        focusedIndex = next;
        await JsRuntime.InvokeVoidAsync("gospelPresenter.focusNavItem", "bible-chapter-list", focusedIndex);
    }

    protected override void OnParametersSet()
    {
        if (BookId != loadedBookId)
        {
            loadedBookId = BookId;
            chapters = BibleService.GetChapters(OrganizationId, BibleId, BookId).ToList();
            focusedIndex = -1;
        }
    }
}
