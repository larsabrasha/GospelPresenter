@using GospelPresenter.Shared.Components.Presentations.AddItem
@using GospelPresenter.Shared.Components.Symbols
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using GospelPresenter.Shared.Utils

@inject IBibleService BibleService
@inject ActiveOrganizationState OrgState
@implements IDisposable

@if (orgBibles.Count == 0)
{
    <div class="flex flex-col items-center justify-center text-neutral-400 text-sm py-8 select-none">
        <BookOpenSymbol Class="size-12 mb-3 text-neutral-300 dark:text-neutral-600"/>
        <p class="text-neutral-400 dark:text-neutral-500">@L["Bible.NoBible"]</p>
    </div>
}
else
{
    <KeyFilter Class="flex flex-col h-full" Keys="ShortcutKeys" OnKey="OnShortcutKey">
        @if (browseBook is null)
        {
            <div class="shrink-0">
                <div class="flex gap-2">
                    <div class="flex-1">
                        <SimpleInput Id="bible-search" Variant="InputVariant.Outlined" Class="w-full"
                                     Placeholder="@L["BibleTab.SearchPlaceholder"]"
                                     MaxLength="AppConstraints.SearchMaxLength"
                                     Value="@query" Revision="queryRevision" ValueChanged="OnQueryChanged"
                                     ThrottleMs="AppConstraints.SearchThrottleMs"
                                     Clearable OnClear="ClearSearch">
                            <Icon>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
                                </svg>
                            </Icon>
                        </SimpleInput>
                    </div>

                    <div class="relative">
                        <select class="appearance-none py-2.5 pl-4 pr-8 rounded-full border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-700 text-neutral-900 dark:text-neutral-100 focus:outline-none focus:ring-2 focus:ring-sky-500"
                                @onchange="OnBibleChanged">
                            @foreach (var bible in orgBibles)
                            {
                                <option value="@bible.Id" selected="@(bible.Id == selectedBibleId)">@bible.Name</option>
                            }
                        </select>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 absolute right-2.5 top-1/2 -translate-y-1/2 text-neutral-400 pointer-events-none">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                        </svg>
                    </div>
                </div>


            </div>

            @if (results.Count > 0)
            {
                <div class="mt-3 flex-1 min-h-0 flex flex-col">
                    <BibleSearchResults Results="results" TotalCount="totalCount"/>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(query))
            {
                <div class="text-center text-neutral-400 text-sm py-2 mt-3">
                    <div>@L["Bible.NoVersesFound"]</div>
                    <div class="text-xs mt-6">
                        <div>@L["Bible.SearchHint"]</div>
                        <div class="mt-1 text-neutral-500 dark:text-neutral-400">@L["Bible.SearchExamples"]</div>
                    </div>
                </div>
            }
            else
            {
                <div class="mt-3 flex-1 min-h-0 flex flex-col">
                    <BibleBookPicker BibleId="@selectedBibleId" OrganizationId="@organizationId" OnPicked="StartBrowse"/>
                </div>
            }
        }
        else
        {
            <BibleBrowsePicker BibleId="@selectedBibleId" OrganizationId="@organizationId" InitialBook="@browseBook" OnBackClicked="OnBrowseBack" OnSelectionChanged="OnBrowseSelectionChanged"/>
        }

        @if (ShowAddButton)
        {
            <div class="shrink-0 flex items-center justify-end gap-10 pt-4">
                <AddMoreCheckbox State="AddMoreState"/>
                <AppButton Variant="ButtonVariant.Primary" Disabled="isAdding" OnClick="HandleAdd" Class="max-w-full inline-flex items-center gap-1">
                    <span class="shrink-0">@L["Common.Add"]</span> <span class="font-bold truncate">@AddLabel</span>
                </AppButton>
            </div>
        }
    </KeyFilter>
}

@code {
    [Parameter] public EventCallback<List<Verse>> OnAdd { get; set; }
    [Parameter] public EventCallback<List<Verse>> OnAddKeepOpen { get; set; }
    [Parameter] public AddMoreToggle AddMoreState { get; set; } = new();

    private const int MaxResults = 500;

    // Shift+Enter adds and keeps the dialog open, Cmd/Ctrl+Enter adds and closes. Nothing
    // else in this tab reacts to a keystroke, so nothing else is worth a roundtrip.
    private static readonly string[] ShortcutKeys = ["Enter"];

    private string organizationId = "";
    private string selectedBibleId = "";
    private IReadOnlyList<Bible> orgBibles = [];
    // Search state
    private string query = "";
    private int queryRevision;
    private readonly LatestOnly search = new();
    private List<Verse> results = [];
    private int totalCount;

    // Browse state
    private string? browseBook;
    private string browseSelectionLabel = "";
    private List<Verse> browseSelectedVerses = [];

    private bool isAdding;
    private bool ShowAddButton => browseSelectedVerses.Count > 0 || results.Count > 0;

    private string AddLabel => browseSelectedVerses.Count > 0
        ? browseSelectionLabel
        : FormatSearchLabel();

    protected override void OnInitialized()
    {
        organizationId = OrgState.ActiveOrganizationId ?? "";
        orgBibles = BibleService.GetBibles(organizationId);
        selectedBibleId = orgBibles.FirstOrDefault()?.Id ?? "";
    }

    private async Task OnShortcutKey(FilteredKey key)
    {
        if (key.Shift && ShowAddButton && !isAdding)
        {
            isAdding = true;
            try
            {
                await OnAddKeepOpen.InvokeAsync(VersesToAdd);
            }
            finally
            {
                isAdding = false;
            }
        }
        else if ((key.Meta || key.Ctrl) && ShowAddButton)
            await HandleAdd();
    }

    private async Task OnBibleChanged(ChangeEventArgs e)
    {
        selectedBibleId = e.Value?.ToString() ?? "";
        browseBook = null;
        browseSelectionLabel = "";
        browseSelectedVerses = [];
        await SearchAsync(query);
    }

    private Task OnQueryChanged(string value)
    {
        query = value;
        return SearchAsync(value);
    }

    private void ClearSearch()
    {
        query = "";
        // The field's value is owned by the DOM by now, so it only takes a new one when the
        // revision says the app set it on purpose. See DomOwnedInputBase.
        queryRevision++;
        search.Cancel();
        results = [];
        totalCount = 0;
    }

    private Task SearchAsync(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            search.Cancel();
            results = [];
            totalCount = 0;
            return Task.CompletedTask;
        }

        // The search is a linear scan of every verse in the bible — over 31 000 of them — so it
        // runs off the renderer's thread; inline it blocks the circuit and queues every UI event
        // behind it. BibleService reads a snapshot-swapped cache, so this is safe from a
        // thread-pool thread.
        return search.RunAsync(
            () =>
            {
                var all = BibleService.Search(organizationId, selectedBibleId, value).ToList();
                return (Hits: all.Count > MaxResults ? all.Take(MaxResults).ToList() : all,
                        Total: all.Count);
            },
            found =>
            {
                results = found.Hits;
                totalCount = found.Total;
            });
    }

    private string FormatSearchLabel()
    {
        if (results.Count == 0) return "";
        var first = results[0];
        var last = results[^1];
        var bookName = BibleBookNames.GetSwedishName(first.BookId);
        if (first.Chapter == last.Chapter && first.VerseNumber == last.VerseNumber)
            return $"{bookName} {first.Chapter}:{first.VerseNumber}";
        if (first.Chapter == last.Chapter)
            return $"{bookName} {first.Chapter}:{first.VerseNumber}-{last.VerseNumber}";
        return $"{bookName} {first.Chapter}:{first.VerseNumber} - {last.Chapter}:{last.VerseNumber}";
    }

    private void StartBrowse(string bookId)
    {
        browseBook = bookId;
        browseSelectionLabel = "";
        browseSelectedVerses = [];
    }

    private void OnBrowseBack()
    {
        browseBook = null;
        browseSelectionLabel = "";
        browseSelectedVerses = [];
    }

    private void OnBrowseSelectionChanged(BibleBrowsePicker.SelectionState state)
    {
        browseSelectionLabel = state.Label;
        browseSelectedVerses = state.Verses;
    }

    private List<Verse> VersesToAdd =>
        browseSelectedVerses.Count > 0 ? browseSelectedVerses : results;

    private async Task HandleAdd()
    {
        if (!ShowAddButton || isAdding) return;
        isAdding = true;
        try
        {
            await OnAdd.InvokeAsync(VersesToAdd);
        }
        finally
        {
            isAdding = false;
        }
    }

    public void Dispose() => search.Dispose();
}
