@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.State

@implements IDisposable

@inject RemoteDisplayState RemoteDisplayState
@inject SharedAppState SharedAppState
@inject IJSRuntime JsRuntime

@{
    var isBlackScreen = LiveSlide.Status == LiveSlideStatus.ShowingBlackScreen;
}

<div class="text-[10px] uppercase tracking-widest text-neutral-400 dark:text-neutral-500 font-semibold">Nu visas</div>

<div class="flex justify-center">
    <LiveDisplay
        LiveSlide="@LiveSlide"
        Overlay="@ActiveOverlay"
        Scale="@Scale"
        BaseWidth="@BaseWidth"
        BaseHeight="@BaseHeight"
        Class="rounded-lg"/>
</div>

<button @onclick="OnClearSlide"
        class="cursor-pointer flex items-center justify-center gap-2 px-3 py-2 rounded-lg bg-neutral-100 dark:bg-neutral-700/50 text-sm text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-600 @(isBlackScreen ? "invisible pointer-events-none" : "")"
        title="@L["Presentation.ClearSlide"]">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
    </svg>
    <span>@L["Presentation.ClearSlide"]</span>
</button>

@if (OverlaySlides.Count > 0)
{
    <div class="text-[10px] uppercase tracking-widest text-neutral-400 dark:text-neutral-500 font-semibold mt-4">Overlays</div>
    @foreach (var overlay in OverlaySlides)
    {
        var isActive = ActiveOverlayId == overlay.Id;
        <button @onclick="() => OnToggleOverlay.InvokeAsync(overlay)"
                class="cursor-pointer flex items-center justify-between gap-3 px-3 py-2 rounded-lg text-sm text-neutral-600 dark:text-neutral-300 @(isActive ? "bg-sky-100 dark:bg-sky-900/30 ring-1 ring-sky-500" : "bg-neutral-100 dark:bg-neutral-700/50")"
                title="@overlay.Title">
            <span class="truncate">@overlay.Title</span>
            <ToggleSwitch Value="@isActive"/>
        </button>
    }
}

@if (SessionId is not null)
{
    <div class="text-[10px] uppercase tracking-widest text-neutral-400 dark:text-neutral-500 font-semibold mt-4 mb-2">
        @L["LivePanel.Outputs"]
    </div>

    @if (hasPresentationApi)
    {
        var isActive = presentationDisplays.Count > 0;
        <button @onclick="TogglePresentationDisplay"
                class="cursor-pointer flex items-center justify-between gap-2 px-3 py-2 rounded-lg text-sm @(isActive ? "text-neutral-600 dark:text-neutral-300 bg-sky-100 dark:bg-sky-900/30 ring-1 ring-sky-500" : "text-neutral-600 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-700/50")">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0">
                    <path d="M3 5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5Z"/>
                    <path d="M8 13h4v2H8v-2Z"/>
                    <path d="M6 16a1 1 0 0 0 0 2h8a1 1 0 1 0 0-2H6Z"/>
                </svg>
                <span>@L["LivePanel.ExternalDisplay"]</span>
            </div>
            <div class="pointer-events-none">
                <ToggleSwitch Value="@isActive"/>
            </div>
        </button>
    }

    @foreach (var display in SavedDisplays)
    {
        var isEnabled = RemoteDisplayState.IsDisplayConnectedToSession(display.DisplayIdentifier, SessionId!);
        var isOnline = RemoteDisplayState.IsDisplayOnline(display.DisplayIdentifier);
        var iconColor = isEnabled ? "text-green-500" : isOnline ? "text-neutral-500 dark:text-neutral-400" : "text-neutral-300 dark:text-neutral-500";
        var disabled = !isOnline && !isEnabled;

        <button @onclick="() => ToggleDisplay(display)"
                disabled="@disabled"
                class="flex items-center justify-between gap-2 px-3 py-2 rounded-lg text-sm @(disabled ? "cursor-default opacity-60" : "cursor-pointer") @(isEnabled ? "text-neutral-600 dark:text-neutral-300 bg-sky-100 dark:bg-sky-900/30 ring-1 ring-sky-500" : "text-neutral-600 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-700/50")">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0 @iconColor">
                    <path d="M3 5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5Z"/>
                    <path d="M8 13h4v2H8v-2Z"/>
                    <path d="M6 16a1 1 0 0 0 0 2h8a1 1 0 1 0 0-2H6Z"/>
                    @if (!isOnline)
                    {
                        <line x1="3" y1="2" x2="17" y2="18" stroke="white" stroke-width="3.5" stroke-linecap="round"/>
                        <line x1="3" y1="2" x2="17" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    }
                </svg>
                <span>@display.Name</span>
            </div>
            @if (isOnline || isEnabled)
            {
                <div class="pointer-events-none">
                    <ToggleSwitch Value="@isEnabled"/>
                </div>
            }
        </button>
    }

    @foreach (var liveWindow in liveWindows)
    {
        var windowId = liveWindow.WindowId;
        <button @onclick="() => CloseLiveWindow(windowId)"
                class="cursor-pointer flex items-center justify-between gap-2 px-3 py-2 rounded-lg text-sm text-neutral-600 dark:text-neutral-300 bg-sky-100 dark:bg-sky-900/30 ring-1 ring-sky-500">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8.25V18a2.25 2.25 0 0 0 2.25 2.25h13.5A2.25 2.25 0 0 0 21 18V8.25m-18 0V6a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 6v2.25m-18 0h18"/>
                </svg>
                <span>@L["LivePanel.LocalLiveView"] (@liveWindow.Index)</span>
            </div>
            <div class="pointer-events-none">
                <ToggleSwitch Value="true"/>
            </div>
        </button>
    }

    @foreach (var adHoc in adHocDisplays)
    {
        <div class="flex items-center justify-between gap-2 px-3 py-2 rounded-lg bg-sky-100 dark:bg-sky-900/30 ring-1 ring-sky-500">
            <div class="flex items-center gap-2 text-sm text-neutral-600 dark:text-neutral-300">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0 text-green-500">
                    <path d="M3 5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5Z"/>
                    <path d="M8 13h4v2H8v-2Z"/>
                    <path d="M6 16a1 1 0 0 0 0 2h8a1 1 0 1 0 0-2H6Z"/>
                </svg>
                <span>@adHoc.Name</span>
            </div>
            <button @onclick="() => RemoteDisplayState.DisconnectDisplay(adHoc.DisplayId)"
                    class="cursor-pointer text-neutral-400 dark:text-neutral-500 hover:text-red-500 dark:hover:text-red-400"
                    title="@L["Display.Disconnect"]">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
                    <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/>
                </svg>
            </button>
        </div>
    }

    <Dropdown MenuClass="right-0 left-0">
        <Trigger>
            <button class="cursor-pointer w-full flex items-center gap-2 px-3 py-2 rounded-lg bg-neutral-100 dark:bg-neutral-700/50 text-sm text-neutral-500 dark:text-neutral-400 hover:bg-neutral-200 dark:hover:bg-neutral-600">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                <span>@L["LivePanel.AddOutput"]</span>
            </button>
        </Trigger>
        <Menu>
            <button type="button"
                    onclick="gospelPresenter.openLiveWindowFromClick(this)"
                    data-session-id="@SessionId"
                    data-title-prefix="@L["LivePanel.LocalLiveView"]"
                    data-next-index="@nextWindowIndex"
                    class="cursor-pointer w-full flex items-center gap-3 px-4 py-3 text-sm text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-600">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8.25V18a2.25 2.25 0 0 0 2.25 2.25h13.5A2.25 2.25 0 0 0 21 18V8.25m-18 0V6a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 6v2.25m-18 0h18"/>
                </svg>
                <span>@L["LivePanel.LocalLiveView"]</span>
            </button>
            <button @onclick="ShowPairingDialog"
                    class="cursor-pointer w-full flex items-center gap-3 px-4 py-3 text-sm text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-600">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"/>
                </svg>
                <span>@L["LivePanel.AddTempDisplay"]</span>
            </button>
        </Menu>
    </Dropdown>
}

@if (SessionId is not null)
{
    var isRemoteEnabled = SharedAppState.IsRemoteControlEnabled(SessionId);
    @if (!IsRemoteController)
    {
        <button @onclick="ToggleRemoteControl"
                class="cursor-pointer flex items-center justify-between gap-2 px-3 py-2 rounded-lg text-sm @(isRemoteEnabled ? "text-neutral-600 dark:text-neutral-300 bg-sky-100 dark:bg-sky-900/30 ring-1 ring-sky-500" : "text-neutral-600 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-700/50")">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0H3"/>
                </svg>
                <span>@L["LivePanel.RemoteControl"]</span>
            </div>
            <div class="pointer-events-none">
                <ToggleSwitch Value="@isRemoteEnabled"/>
            </div>
        </button>
    }
}

@{
    var remoteAudioItem = SessionId is not null && !IsRemoteController
        ? SharedAppState.GetRemoteAudio(SessionId)
        : null;
}
@if (remoteAudioItem is not null)
{
    <div class="text-[10px] uppercase tracking-widest text-neutral-400 dark:text-neutral-500 font-semibold mt-4 mb-2">
        @L["LivePanel.RemoteAudio"]
    </div>
    <div id="live-panel-audio-container">
        @for (var i = 0; i < remoteAudioItem.Parts.Count; i++)
        {
            var part = remoteAudioItem.Parts[i];
            <AudioPlayer AudioElementId="@($"live-panel-audio-{i}")" FileName="@part.FileName" Url="@part.Url" ContainerId="live-panel-audio-container"/>
        }
    </div>
}

@if (ShowGrow)
{
    <div class="grow"></div>
}

<button @onclick="OnStopPresentation"
        class="mt-4 px-4 py-2.5 rounded-full flex items-center justify-center gap-2 shadow-lg cursor-pointer bg-red-500 text-white hover:bg-red-600"
        title="@L["Presentation.StopPresentation"]">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
        <path fill-rule="evenodd" d="M4.5 7.5a3 3 0 0 1 3-3h9a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3h-9a3 3 0 0 1-3-3v-9Z" clip-rule="evenodd"/>
    </svg>
    <span class="text-sm font-medium">@L["Presentation.StopPresentation"]</span>
</button>

@if (showPairingDialog)
{
    <PairingCodeDialog SessionId="@(SessionId!)" OnClose="ClosePairingDialog" OnPaired="ClosePairingDialog"/>
}

@code {
    [Parameter] public required LiveSlide LiveSlide { get; set; }
    [Parameter] public ActiveOverlay? ActiveOverlay { get; set; }
    [Parameter] public required double Scale { get; set; }
    [Parameter] public required int BaseWidth { get; set; }
    [Parameter] public required int BaseHeight { get; set; }
    [Parameter] public required List<OverlaySlide> OverlaySlides { get; set; }
    [Parameter] public string? ActiveOverlayId { get; set; }
    [Parameter] public EventCallback OnClearSlide { get; set; }
    [Parameter] public EventCallback<OverlaySlide> OnToggleOverlay { get; set; }
    [Parameter] public EventCallback OnStopPresentation { get; set; }
    [Parameter] public bool ShowGrow { get; set; }
    [Parameter] public string? SessionId { get; set; }
    [Parameter] public bool IsRemoteController { get; set; }
    [Parameter] public List<RemoteDisplay> SavedDisplays { get; set; } = [];

    private HashSet<string> savedDisplayIds => SavedDisplays.Select(d => d.DisplayIdentifier).ToHashSet();

    private List<ConnectedDisplay> adHocDisplays => SessionId is not null
        ? RemoteDisplayState.GetConnectedDisplays(SessionId)
            .Where(d => !savedDisplayIds.Contains(d.DisplayId)).ToList()
        : [];

    private record LiveWindowEntry(string WindowId, int Index);
    private List<LiveWindowEntry> liveWindows = [];
    private int nextWindowIndex = 1;
    private DotNetObjectReference<LivePanel>? windowCloseRef;
    private string? previousSessionId;

    private List<int> presentationDisplays = [];
    private bool hasPresentationApi;
    private DotNetObjectReference<LivePanel>? dotNetRef;

    private bool showPairingDialog;

    protected override void OnInitialized()
    {
        RemoteDisplayState.DisplayCameOnline += OnDisplayStatusChanged;
        RemoteDisplayState.DisplayWentOffline += OnDisplayStatusChanged;
        RemoteDisplayState.DisplayPaired += OnDisplayStatusChanged;
        RemoteDisplayState.DisplayUnpaired += OnDisplayStatusChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (SessionId is not null && previousSessionId is null)
        {
            await RestoreOutputConfig();
        }
        previousSessionId = SessionId;
    }

    private void OnDisplayStatusChanged(string displayId)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        RemoteDisplayState.DisplayCameOnline -= OnDisplayStatusChanged;
        RemoteDisplayState.DisplayWentOffline -= OnDisplayStatusChanged;
        RemoteDisplayState.DisplayPaired -= OnDisplayStatusChanged;
        RemoteDisplayState.DisplayUnpaired -= OnDisplayStatusChanged;
        dotNetRef?.Dispose();
        windowCloseRef?.Dispose();
    }

    private async Task ToggleDisplay(RemoteDisplay display)
    {
        if (SessionId is null) return;

        if (RemoteDisplayState.IsDisplayConnectedToSession(display.DisplayIdentifier, SessionId!))
        {
            RemoteDisplayState.DisableDisplay(display.DisplayIdentifier, SessionId!);
        }
        else
        {
            RemoteDisplayState.EnableDisplay(display.DisplayIdentifier, SessionId!, display.Name);
        }
        await SaveOutputConfig();
    }

    private async Task OpenLiveWindow()
    {
        if (SessionId is null) return;
        var windowId = Guid.NewGuid().ToString("N")[..8];
        var index = nextWindowIndex++;
        var title = $"{L["LivePanel.LocalLiveView"]} ({index})";
        var success = await JsRuntime.InvokeAsync<bool>("gospelPresenter.openLiveWindow", SessionId, windowId, title);
        if (success)
        {
            liveWindows.Add(new LiveWindowEntry(windowId, index));
            await SaveOutputConfig();
        }
    }

    private async Task CloseLiveWindow(string windowId)
    {
        await JsRuntime.InvokeVoidAsync("gospelPresenter.closeLiveWindow", windowId);
        liveWindows.RemoveAll(w => w.WindowId == windowId);
        await SaveOutputConfig();
    }

    [JSInvokable]
    public void OnLiveWindowOpened(string windowId)
    {
        // The synchronous JS click handler opened the window and now tells us
        // to register it. The index passed to the new window's title matches
        // the current value of nextWindowIndex (rendered as a data attribute).
        var index = nextWindowIndex++;
        liveWindows.Add(new LiveWindowEntry(windowId, index));
        _ = InvokeAsync(async () =>
        {
            await SaveOutputConfig();
            StateHasChanged();
        });
    }

    [JSInvokable]
    public void OnLiveWindowClosed(string windowId)
    {
        liveWindows.RemoveAll(w => w.WindowId == windowId);
        _ = InvokeAsync(async () =>
        {
            await SaveOutputConfig();
            StateHasChanged();
        });
    }

    private async Task SaveOutputConfig()
    {
        if (SessionId is null) return;
        var enabledDisplayIds = SavedDisplays
            .Where(d => RemoteDisplayState.IsDisplayConnectedToSession(d.DisplayIdentifier, SessionId!))
            .Select(d => d.DisplayIdentifier)
            .ToArray();
        var config = new
        {
            enabledDisplayIds,
            windowCount = liveWindows.Count,
            presentationDisplay = presentationDisplays.Count > 0
        };
        await JsRuntime.InvokeVoidAsync("gospelPresenter.saveOutputConfig", config);
    }

    private async Task RestoreOutputConfig()
    {
        try
        {
            var config = await JsRuntime.InvokeAsync<OutputConfig?>("gospelPresenter.loadOutputConfig");
            if (config is null) return;

            if (config.EnabledDisplayIds is not null)
            {
                foreach (var displayId in config.EnabledDisplayIds)
                {
                    var display = SavedDisplays.FirstOrDefault(d => d.DisplayIdentifier == displayId);
                    // Only restore if the display is not currently bound to any session —
                    // we never want to steal a display from another active presentation on restore.
                    if (display is not null && RemoteDisplayState.IsDisplayOnline(displayId)
                        && !RemoteDisplayState.IsDisplayConnected(displayId))
                    {
                        RemoteDisplayState.EnableDisplay(displayId, SessionId!, display.Name);
                    }
                }
            }

            for (var i = 0; i < (config.WindowCount ?? 0); i++)
            {
                await OpenLiveWindow();
            }

            if (config.PresentationDisplay == true && hasPresentationApi && presentationDisplays.Count == 0)
            {
                await StartPresentationDisplay();
            }
        }
        catch
        {
            // Ignore corrupt or missing config
        }
    }

    private record OutputConfig(string[]? EnabledDisplayIds, int? WindowCount, bool? PresentationDisplay);

    private async Task TogglePresentationDisplay()
    {
        if (presentationDisplays.Count > 0)
        {
            foreach (var id in presentationDisplays.ToList())
            {
                await JsRuntime.InvokeVoidAsync("gospelPresenter.stopPresentation", id);
            }
            presentationDisplays.Clear();
        }
        else
        {
            await StartPresentationDisplay();
        }
        await SaveOutputConfig();
    }

    private async Task StartPresentationDisplay()
    {
        if (SessionId is null) return;
        dotNetRef ??= DotNetObjectReference.Create(this);
        try
        {
            var id = await JsRuntime.InvokeAsync<int>("gospelPresenter.startPresentation", SessionId, dotNetRef);
            presentationDisplays.Add(id);
        }
        catch
        {
            // User cancelled the picker or API not available
        }
    }

    [JSInvokable]
    public void OnPresentationClosed(int id)
    {
        presentationDisplays.Remove(id);
        _ = InvokeAsync(async () =>
        {
            await SaveOutputConfig();
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            hasPresentationApi = await JsRuntime.InvokeAsync<bool>("gospelPresenter.isPresentationApiAvailable");
            windowCloseRef = DotNetObjectReference.Create(this);
            await JsRuntime.InvokeVoidAsync("gospelPresenter.onLiveWindowClosed", windowCloseRef);
            await JsRuntime.InvokeVoidAsync("gospelPresenter.setLivePanelRef", windowCloseRef);
            StateHasChanged();
        }

    }

    private void ShowPairingDialog() => showPairingDialog = true;

    private void ClosePairingDialog() => showPairingDialog = false;

    private void ToggleRemoteControl()
    {
        if (SessionId is null) return;
        if (SharedAppState.IsRemoteControlEnabled(SessionId))
            SharedAppState.DisableRemoteControl(SessionId);
        else
            SharedAppState.EnableRemoteControl(SessionId);
    }
}
