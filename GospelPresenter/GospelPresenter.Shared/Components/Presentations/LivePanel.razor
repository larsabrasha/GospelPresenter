@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.State
@using GospelPresenter.Shared.Localization

@implements IDisposable

@inject RemoteDisplayState RemoteDisplayState
@inject SharedAppState SharedAppState
@inject PublicOutputState PublicOutputState
@inject LiveOutputsState Outputs
@inject GospelPresenter.Shared.Services.IAppCapabilities Capabilities
@inject ToastService ToastService
@inject CircuitCulture Culture

@{
    var isBlackScreen = LiveSlide.Status == LiveSlideStatus.ShowingBlackScreen;
}

@if (Collapsible)
{
    <button @onclick="ToggleCollapsed"
            aria-expanded="@(!isCollapsed)"
            aria-label="@L["LivePanel.ToggleCollapsed"]"
            class="cursor-pointer flex items-center justify-between gap-3 text-left -mx-4 -mt-4 px-4 pt-4 pb-2 @(isCollapsed ? "-mb-5" : "-mb-2")">
        <span class="text-[10px] uppercase tracking-widest text-neutral-400 dark:text-neutral-500 font-semibold">@L["LivePanel.NowShowing"]</span>
        <div class="flex items-center gap-3">
            @if (isCollapsed)
            {
                <LiveDisplay
                    LiveSlide="@LiveSlide"
                    Overlay="@ActiveOverlay"
                    Scale="0.035"
                    BaseWidth="@BaseWidth"
                    BaseHeight="@BaseHeight"
                    Class="rounded"/>
            }
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                 stroke="currentColor"
                 class="size-4 text-neutral-400 dark:text-neutral-500 transition-transform duration-300 @(isCollapsed ? "rotate-180" : "")">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
            </svg>
        </div>
    </button>
}
else
{
    <div class="text-[10px] uppercase tracking-widest text-neutral-400 dark:text-neutral-500 font-semibold">@L["LivePanel.NowShowing"]
    </div>
}

<div
    class="grid transition-[grid-template-rows] duration-300 ease-in-out @(Collapsible && isCollapsed ? "grid-rows-[0fr]" : "grid-rows-[1fr] grow min-h-0")">
    <div class="overflow-hidden flex flex-col min-h-0">
    <div class="flex flex-col gap-3 min-h-0 px-1 -mx-1 grow overflow-y-auto">

        <div class="flex flex-col gap-2">
            <div class="flex justify-center">
                <LiveDisplay
                    LiveSlide="@LiveSlide"
                    Overlay="@ActiveOverlay"
                    Scale="@Scale"
                    BaseWidth="@BaseWidth"
                    BaseHeight="@BaseHeight"
                    Class="rounded-lg"/>
            </div>

            <div class="mx-1 @(isBlackScreen ? "invisible pointer-events-none" : "")">
                <AppButton Variant="ButtonVariant.Secondary" OnClick="OnClearSlide"
                           Class="w-full flex items-center justify-center gap-1.5" Title="@L["Presentation.ClearSlide"]">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                         stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                    </svg>
                    <span>@L["Presentation.ClearSlide"]</span>
                </AppButton>
            </div>
        </div>

        @* Outputs belong to the machine that is presenting. A controller cannot own another
           host's windows, and for a mirrored session the owner's next report puts its own set of
           outputs back — so a toggle here looked as if it worked and then silently undid itself.
           See adr/0004: an output is the owner's own business. *@
        @if (SessionId is not null && !IsRemoteController)
        {
            <div class="mt-3">
                <div class="flex items-center gap-2">
                    <button @onclick="() => isOutputsCollapsed = !isOutputsCollapsed"
                            aria-expanded="@(!isOutputsCollapsed)"
                            class="cursor-pointer flex items-center gap-2 flex-1 text-left py-2 -my-2">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                             stroke="currentColor"
                             class="size-3 text-neutral-400 dark:text-neutral-500 transition-transform duration-300 @(isOutputsCollapsed ? "-rotate-90" : "")">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                        </svg>
                        <span
                            class="text-[10px] uppercase tracking-widest text-neutral-400 dark:text-neutral-500 font-semibold">@L["LivePanel.Outputs"]</span>
                    </button>
                    <HintButton @bind-Active="showOutputsInfo" Title="@L["LivePanel.OutputsHint"]"/>
                </div>
                <HintPanel Show="showOutputsInfo" Text="@L["LivePanel.OutputsHint"]"/>
                <div
                    class="grid transition-[grid-template-rows] duration-300 ease-in-out @(isOutputsCollapsed ? "grid-rows-[0fr]" : "grid-rows-[1fr]")">
                    <div class="overflow-hidden min-h-0">
                        <div class="flex flex-col gap-3 p-1 pt-3">
                            @* Also when the host says it cannot do this any more but the output is
                               on anyway: unplug the projector mid-service and the window is still
                               there, on the operator's own screen now, and the row is the only way
                               to close it. *@
                            @if (Outputs.HasPresentationApi || Outputs.HasNativeExternalDisplay || Outputs.IsExternalDisplayOn)
                            {
                                var isActive = Outputs.IsExternalDisplayOn;
                                <button @onclick="ToggleExternalDisplay"
                                        class="cursor-pointer flex items-center justify-between gap-2 px-3 py-2 rounded-lg text-sm @(isActive ? "text-neutral-600 dark:text-neutral-300 bg-sky-100 dark:bg-sky-900/30 ring-1 ring-sky-500" : "text-neutral-600 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-700/50")">
                                    <div class="flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                                             class="size-4 shrink-0">
                                            <path
                                                d="M3 5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5Z"/>
                                            <path d="M8 13h4v2H8v-2Z"/>
                                            <path d="M6 16a1 1 0 0 0 0 2h8a1 1 0 1 0 0-2H6Z"/>
                                        </svg>
                                        <span>@L["LivePanel.ExternalDisplay"]</span>
                                    </div>
                                    <div class="pointer-events-none">
                                        <ToggleSwitch Value="@isActive"/>
                                    </div>
                                </button>
                            }

                            @foreach (var display in Screens)
                            {
                                var isEnabled = RemoteDisplayState.IsDisplayConnectedToSession(display.DisplayIdentifier, SessionId!);
                                var isOnline = RemoteDisplayState.IsDisplayOnline(display.DisplayIdentifier);
                                var iconColor = isEnabled ? "text-green-500" : isOnline ? "text-neutral-500 dark:text-neutral-400" : "text-neutral-300 dark:text-neutral-500";
                                var disabled = !isOnline && !isEnabled;

                                <button @onclick="() => ToggleDisplay(display)"
                                        disabled="@disabled"
                                        class="flex items-center justify-between gap-2 px-3 py-2 rounded-lg text-sm @(disabled ? "cursor-default opacity-60" : "cursor-pointer") @(isEnabled ? "text-neutral-600 dark:text-neutral-300 bg-sky-100 dark:bg-sky-900/30 ring-1 ring-sky-500" : "text-neutral-600 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-700/50")">
                                    <div class="flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                                             class="size-4 shrink-0 @iconColor">
                                            <path
                                                d="M3 5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5Z"/>
                                            <path d="M8 13h4v2H8v-2Z"/>
                                            <path d="M6 16a1 1 0 0 0 0 2h8a1 1 0 1 0 0-2H6Z"/>
                                            @if (!isOnline)
                                            {
                                                <line x1="3" y1="2" x2="17" y2="18" stroke="white" stroke-width="3.5"
                                                      stroke-linecap="round"/>
                                                <line x1="3" y1="2" x2="17" y2="18" stroke="currentColor"
                                                      stroke-width="1.5" stroke-linecap="round"/>
                                            }
                                        </svg>
                                        <span>@display.Name</span>
                                    </div>
                                    @if (isOnline || isEnabled)
                                    {
                                        <div class="pointer-events-none">
                                            <ToggleSwitch Value="@isEnabled"/>
                                        </div>
                                    }
                                </button>
                            }

                            @foreach (var output in PublicOutputs)
                            {
                                var isEnabled = RemoteDisplayState.IsDisplayConnectedToSession(output.DisplayIdentifier, SessionId!);
                                var viewers = PublicOutputState.GetViewerCount(output.DisplayIdentifier);
                                var otherPresentation = isEnabled ? null : BroadcastingPresentationName(output.DisplayIdentifier);

                                <button @onclick="() => ToggleOutput(output)"
                                        class="cursor-pointer flex items-center justify-between gap-2 px-3 py-2 rounded-lg text-sm @(isEnabled ? "text-neutral-600 dark:text-neutral-300 bg-sky-100 dark:bg-sky-900/30 ring-1 ring-sky-500" : "text-neutral-600 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-700/50")">
                                    <div class="flex items-center gap-2 min-w-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                                             class="size-4 shrink-0 @(isEnabled ? "text-green-500" : "text-neutral-400 dark:text-neutral-500")">
                                            <path d="M3 3h5v5H3V3Zm1.5 1.5v2h2v-2h-2ZM12 3h5v5h-5V3Zm1.5 1.5v2h2v-2h-2ZM3 12h5v5H3v-5Zm1.5 1.5v2h2v-2h-2ZM12 12h1.5v1.5H12V12Zm3.5 0H17v1.5h-1.5V12ZM12 15.5h1.5V17H12v-1.5Zm3.5 0H17V17h-1.5v-1.5ZM9.5 3H11v1.5H9.5V3Zm0 3H11v1.5H9.5V6Zm0 3H11v1.5H9.5V9ZM3 9.5h1.5V11H3V9.5Zm3.5 0H8V11H6.5V9.5Zm6.5 0h1.5V11H13V9.5Zm3 0H17V11h-1V9.5Z"/>
                                        </svg>
                                        <div class="min-w-0 text-left">
                                            <div class="truncate">@output.Name</div>
                                            @if (otherPresentation is not null)
                                            {
                                                <div class="text-[11px] text-neutral-400 dark:text-neutral-500 truncate">
                                                    @L["LivePanel.PublicOutputBusy", otherPresentation]
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2 shrink-0">
                                        @if (isEnabled)
                                        {
                                            <span class="text-[11px] @(viewers > 0 ? "text-green-600 dark:text-green-400" : "text-neutral-400 dark:text-neutral-500")">
                                                @ViewerCountText(viewers)
                                            </span>
                                        }
                                        <div class="pointer-events-none">
                                            <ToggleSwitch Value="@isEnabled"/>
                                        </div>
                                    </div>
                                </button>
                            }

                            @foreach (var liveWindow in Outputs.Windows)
                            {
                                var windowId = liveWindow.WindowId;
                                <div
                                    class="flex items-center justify-between gap-2 px-3 py-2 rounded-lg bg-sky-100 dark:bg-sky-900/30 ring-1 ring-sky-500">
                                    <div class="flex items-center gap-2 text-sm text-neutral-600 dark:text-neutral-300">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                                             class="size-4 shrink-0">
                                            <path
                                                d="M3 5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5Z"/>
                                            <path d="M8 13h4v2H8v-2Z"/>
                                            <path d="M6 16a1 1 0 0 0 0 2h8a1 1 0 1 0 0-2H6Z"/>
                                        </svg>
                                        <span>@L["LivePanel.LocalLiveView"] (@liveWindow.Index)</span>
                                    </div>
                                    <button @onclick="() => CloseLiveWindow(windowId)"
                                            class="cursor-pointer text-neutral-400 dark:text-neutral-500 hover:text-red-500 dark:hover:text-red-400"
                                            title="@L["LivePanel.CloseWindow"]">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                                             class="size-4">
                                            <path
                                                d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/>
                                        </svg>
                                    </button>
                                </div>
                            }

                            @foreach (var (adHoc, adHocIndex) in adHocDisplays.Select((d, i) => (d, i + 1)))
                            {
                                <div
                                    class="flex items-center justify-between gap-2 px-3 py-2 rounded-lg bg-sky-100 dark:bg-sky-900/30 ring-1 ring-sky-500">
                                    <div class="flex items-center gap-2 text-sm text-neutral-600 dark:text-neutral-300">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                                             class="size-4 shrink-0">
                                            <path
                                                d="M3 5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5Z"/>
                                            <path d="M8 13h4v2H8v-2Z"/>
                                            <path d="M6 16a1 1 0 0 0 0 2h8a1 1 0 1 0 0-2H6Z"/>
                                        </svg>
                                        <span>@L["LivePanel.AddTempDisplay"] (@adHocIndex)</span>
                                    </div>
                                    <button @onclick="() => RemoteDisplayState.DisconnectDisplay(adHoc.DisplayId)"
                                            class="cursor-pointer text-neutral-400 dark:text-neutral-500 hover:text-red-500 dark:hover:text-red-400"
                                            title="@L["Display.Disconnect"]">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                                             class="size-4">
                                            <path
                                                d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/>
                                        </svg>
                                    </button>
                                </div>
                            }

                            <Dropdown Portal Class="self-start">
                                <Trigger>
                                    <AppButton Variant="ButtonVariant.Secondary" Class="flex items-center gap-1.5">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                             stroke-width="2" stroke="currentColor" class="size-4">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M12 4.5v15m7.5-7.5h-15"/>
                                        </svg>
                                        @L["LivePanel.AddOutput"]
                                    </AppButton>
                                </Trigger>
                                <Menu>
                                    @* Native host (MAUI): the launcher opens a real second window, no
                                       popup gesture needed. Web: the synchronous JS path, which must run
                                       inside the click event or Safari blocks the popup. *@
                                    @if (Outputs.HasNativeLauncher)
                                    {
                                        <button type="button" @onclick="OpenLiveWindow"
                                                class="cursor-pointer w-full flex items-center gap-3 px-4 py-3 text-sm text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-600">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                                 stroke-width="1.5" stroke="currentColor" class="size-4 shrink-0">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                      d="M3 8.25V18a2.25 2.25 0 0 0 2.25 2.25h13.5A2.25 2.25 0 0 0 21 18V8.25m-18 0V6a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 6v2.25m-18 0h18"/>
                                            </svg>
                                            <span>@L["LivePanel.LocalLiveView"]</span>
                                        </button>
                                    }
                                    else
                                    {
                                    <button type="button"
                                            onclick="gospelPresenter.openLiveWindowFromClick(this)"
                                            data-session-id="@SessionId"
                                            data-title-prefix="@L["LivePanel.LocalLiveView"]"
                                            data-next-index="@Outputs.NextWindowIndex"
                                            class="cursor-pointer w-full flex items-center gap-3 px-4 py-3 text-sm text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-600">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                             stroke-width="1.5" stroke="currentColor" class="size-4 shrink-0">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M3 8.25V18a2.25 2.25 0 0 0 2.25 2.25h13.5A2.25 2.25 0 0 0 21 18V8.25m-18 0V6a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 6v2.25m-18 0h18"/>
                                        </svg>
                                        <span>@L["LivePanel.LocalLiveView"]</span>
                                    </button>
                                    }
                                    @if (Capabilities.PairedDisplays)
                                    {
                                        <button @onclick="ShowPairingDialog"
                                                class="cursor-pointer w-full flex items-center gap-3 px-4 py-3 text-sm text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-600">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                                 stroke-width="1.5" stroke="currentColor" class="size-4 shrink-0">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                      d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"/>
                                            </svg>
                                            <span>@L["LivePanel.ConnectTempDisplay"]</span>
                                        </button>
                                    }
                                </Menu>
                            </Dropdown>

                        </div>
                    </div>
                </div>
            </div>
        }

        @if (OverlaySlides.Count > 0)
        {
            <div class="mt-3">
                <div class="flex items-center gap-2">
                    <button @onclick="() => isOverlaysCollapsed = !isOverlaysCollapsed"
                            aria-expanded="@(!isOverlaysCollapsed)"
                            class="cursor-pointer flex items-center gap-2 flex-1 text-left py-2 -my-2">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                             stroke="currentColor"
                             class="size-3 text-neutral-400 dark:text-neutral-500 transition-transform duration-300 @(isOverlaysCollapsed ? "-rotate-90" : "")">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                        </svg>
                        <span
                            class="text-[10px] uppercase tracking-widest text-neutral-400 dark:text-neutral-500 font-semibold">@L["Overlays.Title"]</span>
                    </button>
                    <HintButton @bind-Active="showOverlaysInfo" Title="@L["LivePanel.OverlaysHint"]"/>
                </div>
                <HintPanel Show="showOverlaysInfo" Text="@L["LivePanel.OverlaysHint"]"/>
                <div
                    class="grid transition-[grid-template-rows] duration-300 ease-in-out @(isOverlaysCollapsed ? "grid-rows-[0fr]" : "grid-rows-[1fr]")">
                    <div class="overflow-hidden min-h-0">
                        <div class="flex flex-col gap-3 pt-3 p-1">
                            @foreach (var overlay in OverlaySlides)
                            {
                                var isActive = ActiveOverlayId == overlay.Id;
                                <button @onclick="() => OnToggleOverlay.InvokeAsync(overlay)"
                                        class="cursor-pointer flex items-center justify-between gap-3 px-3 py-2 rounded-lg text-sm text-neutral-600 dark:text-neutral-300 @(isActive ? "bg-sky-100 dark:bg-sky-900/30 ring-1 ring-sky-500" : "bg-neutral-100 dark:bg-neutral-700/50")"
                                        title="@overlay.Title">
                                    <span class="truncate">@overlay.Title</span>
                                    <ToggleSwitch Value="@isActive"/>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (SessionId is not null && !IsRemoteController && Capabilities.RemoteControl)
        {
            var isRemoteEnabled = SharedAppState.IsRemoteControlEnabled(SessionId);
            <div class="mt-3">
                <div class="flex items-center gap-2">
                    <button @onclick="() => isRemoteCollapsed = !isRemoteCollapsed"
                            aria-expanded="@(!isRemoteCollapsed)"
                            class="cursor-pointer flex items-center gap-2 flex-1 text-left py-2 -my-2">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                             stroke="currentColor"
                             class="size-3 text-neutral-400 dark:text-neutral-500 transition-transform duration-300 @(isRemoteCollapsed ? "-rotate-90" : "")">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                        </svg>
                        <span
                            class="text-[10px] uppercase tracking-widest text-neutral-400 dark:text-neutral-500 font-semibold">@L["LivePanel.RemoteControlSection"]</span>
                    </button>
                    <HintButton @bind-Active="showRemoteInfo" Title="@L["LivePanel.RemoteControlHint"]"/>
                </div>
                <HintPanel Show="showRemoteInfo" Text="@L["LivePanel.RemoteControlHint"]"/>
                <div
                    class="grid transition-[grid-template-rows] duration-300 ease-in-out @(isRemoteCollapsed ? "grid-rows-[0fr]" : "grid-rows-[1fr]")">
                    <div class="overflow-hidden min-h-0">
                        <div class="flex flex-col gap-3 p-1 pt-3">
                            <div class="flex items-center gap-2">
                                <button @onclick="ToggleRemoteControl"
                                        class="cursor-pointer flex-1 flex items-center justify-between gap-2 px-3 py-2 rounded-lg text-sm @(isRemoteEnabled ? "text-neutral-600 dark:text-neutral-300 bg-sky-100 dark:bg-sky-900/30 ring-1 ring-sky-500" : "text-neutral-600 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-700/50")">
                                    <div class="flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                             stroke-width="1.5" stroke="currentColor" class="size-4 shrink-0">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0H3"/>
                                        </svg>
                                        <span>@L["LivePanel.RemoteControl"]</span>
                                    </div>
                                    <div class="pointer-events-none">
                                        <ToggleSwitch Value="@isRemoteEnabled"/>
                                    </div>
                                </button>
                                <button @onclick="ShowRemoteControlInfoDialog"
                                        disabled="@(!isRemoteEnabled)"
                                        class="size-8 flex items-center justify-center rounded-lg shrink-0 transition-colors @(isRemoteEnabled ? "cursor-pointer text-sky-600 dark:text-sky-400 bg-sky-100 dark:bg-sky-900/30 hover:bg-sky-200 dark:hover:bg-sky-900/50" : "cursor-default text-neutral-400 dark:text-neutral-500 bg-neutral-100 dark:bg-neutral-700/50 opacity-50")"
                                        title="@L["LivePanel.RemoteControlShowInfo"]"
                                        aria-label="@L["LivePanel.RemoteControlShowInfo"]">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 6.75h.75v.75h-.75v-.75ZM6.75 16.5h.75v.75h-.75v-.75ZM16.5 6.75h.75v.75h-.75v-.75ZM13.5 13.5h.75v.75h-.75v-.75ZM13.5 19.5h.75v.75h-.75v-.75ZM19.5 13.5h.75v.75h-.75v-.75ZM19.5 19.5h.75v.75h-.75v-.75ZM16.5 16.5h.75v.75h-.75v-.75Z"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (SessionId is not null && !IsRemoteController)
        {
            var sessionAudioItem = SharedAppState.GetSessionAudio(SessionId);
            @if (sessionAudioItem is not null)
            {
                <div id="live-panel-audio-container">
                    @foreach (var part in sessionAudioItem.Parts)
                    {
                        <AudioPlayerEngine AudioElementId="@($"session-audio-{part.PartId}")" Url="@part.Url"
                                           ContainerId="live-panel-audio-container"/>
                    }
                </div>
            }
        }

        <AppButton Variant="ButtonVariant.Secondary" OnClick="OnEnterStageMode"
                   Class="mt-3 w-full flex items-center justify-center gap-2"
                   Title="@L["StageMode.Enter"]">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="size-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"/>
            </svg>
            <span class="font-medium">@L["StageMode.Enter"]</span>
        </AppButton>

    </div>

    @if (CanStop)
    {
        <button @onclick="OnStopPresentation"
                class="mt-4 px-4 py-2.5 rounded-full flex items-center justify-center gap-2 shadow-lg cursor-pointer bg-red-500 text-white hover:bg-red-600"
                title="@L["Presentation.StopPresentation"]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                <path fill-rule="evenodd"
                      d="M4.5 7.5a3 3 0 0 1 3-3h9a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3h-9a3 3 0 0 1-3-3v-9Z"
                      clip-rule="evenodd"/>
            </svg>
            <span class="text-sm font-medium">@L["Presentation.StopPresentation"]</span>
        </button>
    }
    else
    {
        @* Said rather than shown as a dead button: pressing it used to look as if it had worked —
           the panel went away — while the projector carried on and the owner's next report put the
           session straight back. See adr/0004: only the owner ends the session. *@
        <div class="mt-4 text-xs text-neutral-500 dark:text-neutral-400 text-center">
            @L["RemoteControl.StopOnOwnerOnly"]
        </div>
    }

    </div>
</div>

@if (showPairingDialog)
{
    <PairingCodeDialog SessionId="@(SessionId!)" OnClose="ClosePairingDialog"/>
}

@if (showRemoteControlInfoDialog && remoteControlPresentationId is not null)
{
    <RemoteControlInfoDialog PresentationId="@remoteControlPresentationId" PresentationName="@remoteControlPresentationName" SessionId="@SessionId" OnClose="CloseRemoteControlInfoDialog"/>
}

@if (outputToTakeOver is not null)
{
    <Dialog Class="bg-white dark:bg-neutral-800 max-w-md" OnClose="CancelTakeOver">
        <div class="p-6 space-y-4">
            <div class="font-semibold text-lg dark:text-neutral-100">@L["LivePanel.TakeOverTitle"]</div>
            <p class="text-sm text-neutral-600 dark:text-neutral-300">
                @if (outputToTakeOverFrom is not null)
                {
                    @L["LivePanel.TakeOverMessage", outputToTakeOverFrom, outputToTakeOver.Name]
                }
                else
                {
                    @L["LivePanel.TakeOverMessageUnknown", outputToTakeOver.Name]
                }
            </p>
            <div class="flex justify-end gap-3">
                <AppButton Variant="ButtonVariant.Cancel" OnClick="CancelTakeOver">
                    @L["Common.Cancel"]
                </AppButton>
                <AppButton Variant="ButtonVariant.Primary" OnClick="ConfirmTakeOver">
                    @L["LivePanel.TakeOverConfirm"]
                </AppButton>
            </div>
        </div>
    </Dialog>
}

@code {
    [Parameter] public required LiveSlide LiveSlide { get; set; }
    [Parameter] public ActiveOverlay? ActiveOverlay { get; set; }
    [Parameter] public required double Scale { get; set; }
    [Parameter] public required int BaseWidth { get; set; }
    [Parameter] public required int BaseHeight { get; set; }
    [Parameter] public required List<OverlaySlide> OverlaySlides { get; set; }
    [Parameter] public string? ActiveOverlayId { get; set; }
    [Parameter] public EventCallback OnClearSlide { get; set; }
    [Parameter] public EventCallback<OverlaySlide> OnToggleOverlay { get; set; }
    [Parameter] public EventCallback OnStopPresentation { get; set; }
    [Parameter] public EventCallback OnEnterStageMode { get; set; }
    [Parameter] public bool ShowGrow { get; set; }
    [Parameter] public bool Collapsible { get; set; }
    [Parameter] public string? SessionId { get; set; }
    [Parameter] public bool IsRemoteController { get; set; }

    /// <summary>
    /// Whether stopping is this page's to do. False for a controller driving a device: the device
    /// owns the projector and the protocol carries no way to ask it to stop.
    /// </summary>
    [Parameter] public bool CanStop { get; set; } = true;
    [Parameter] public List<RemoteDisplay> SavedDisplays { get; set; } = [];

    private bool isCollapsed;
    private bool isOverlaysCollapsed = true;
    private bool showOverlaysInfo;
    private bool showOutputsInfo;
    private bool showRemoteInfo;
    private bool isOutputsCollapsed;
    private bool isRemoteCollapsed = true;
    private void ToggleCollapsed() => isCollapsed = !isCollapsed;

    private HashSet<string> savedDisplayIds => SavedDisplays.Select(d => d.DisplayIdentifier).ToHashSet();

    // On a host without the capability the list is simply empty, which hides every control.
    private List<RemoteDisplay> Screens => Capabilities.PairedDisplays
        ? SavedDisplays.Where(d => d.Kind == OutputKind.Screen).ToList()
        : [];

    private List<RemoteDisplay> PublicOutputs => Capabilities.PublicOutput
        ? SavedDisplays.Where(d => d.Kind == OutputKind.PublicQr).ToList()
        : [];

    private RemoteDisplay? outputToTakeOver;
    private string? outputToTakeOverFrom;

    private List<ConnectedDisplay> adHocDisplays => SessionId is not null && Capabilities.PairedDisplays
        ? RemoteDisplayState.GetConnectedDisplays(SessionId)
            .Where(d => !savedDisplayIds.Contains(d.DisplayId)).ToList()
        : [];

    private bool showPairingDialog;

    protected override void OnInitialized()
    {
        // The windows and the projector output are owned by LiveOutputsState, not by this panel:
        // the presentation page renders two panels and only CSS picks which one the operator sees,
        // so a copy per panel meant two of everything. See LiveOutputsState.
        Outputs.Changed += OnOutputsChanged;

        RemoteDisplayState.DisplayCameOnline += OnDisplayStatusChanged;
        RemoteDisplayState.DisplayWentOffline += OnDisplayStatusChanged;
        RemoteDisplayState.DisplayPaired += OnDisplayStatusChanged;
        RemoteDisplayState.DisplayUnpaired += OnDisplayStatusChanged;
        PublicOutputState.ViewerCountChanged += OnDisplayStatusChanged;
    }

    private void OnOutputsChanged() => _ = InvokeAsync(Culture.Restore(StateHasChanged));

    protected override async Task OnParametersSetAsync()
    {
        if (SessionId is null || IsRemoteController) return;

        // Both panels call this on every parameters-set; the first one to arrive does the restoring
        // and every call after that only refreshes the output list it keeps. The titles are passed
        // because the state writes them into windows it opens, and localization belongs on this side.
        await Outputs.AttachAsync(
            SessionId, SavedDisplays, L["LivePanel.LocalLiveView"], L["LivePanel.ExternalDisplay"]);
    }

    private void OnDisplayStatusChanged(string displayId)
    {
        // Raised from wherever the display or the viewer count changed — another circuit, the live
        // hub, or the throttle timer in PublicOutputState, whose context is an anonymous visitor's
        // request. None of them know this operator's language; see CircuitCulture.
        _ = InvokeAsync(Culture.Restore(StateHasChanged));
    }

    public void Dispose()
    {
        Outputs.Changed -= OnOutputsChanged;
        RemoteDisplayState.DisplayCameOnline -= OnDisplayStatusChanged;
        RemoteDisplayState.DisplayWentOffline -= OnDisplayStatusChanged;
        RemoteDisplayState.DisplayPaired -= OnDisplayStatusChanged;
        RemoteDisplayState.DisplayUnpaired -= OnDisplayStatusChanged;
        PublicOutputState.ViewerCountChanged -= OnDisplayStatusChanged;
    }

    private async Task ToggleDisplay(RemoteDisplay display)
    {
        if (SessionId is null) return;

        if (RemoteDisplayState.IsDisplayConnectedToSession(display.DisplayIdentifier, SessionId!))
        {
            RemoteDisplayState.DisableDisplay(display.DisplayIdentifier, SessionId!);
        }
        else
        {
            RemoteDisplayState.EnableDisplay(display.DisplayIdentifier, SessionId!, display.Name);
        }

        await SaveOutputConfig();
    }

    private string ViewerCountText(int viewers) => viewers == 1
        ? L["LivePanel.PublicOutputViewersOne", viewers]
        : L["LivePanel.PublicOutputViewers", viewers];

    /// <summary>The name of the presentation currently broadcasting to an output, if any.</summary>
    private string? BroadcastingPresentationName(string identifier)
    {
        var sessionId = RemoteDisplayState.GetSessionForDisplay(identifier);
        if (sessionId is null) return null;

        return SharedAppState.GetActiveSession(sessionId)?.PresentationName;
    }

    /// <summary>
    /// Turning a public output on and off. Only one presentation may broadcast to an output at a
    /// time, and taking one over is confirmed rather than silent: nobody stands next to a
    /// congregation's phones to notice that the wrong presentation started sending to them.
    /// </summary>
    private async Task ToggleOutput(RemoteDisplay output)
    {
        if (SessionId is null) return;

        if (RemoteDisplayState.IsDisplayConnectedToSession(output.DisplayIdentifier, SessionId))
        {
            RemoteDisplayState.DisableDisplay(output.DisplayIdentifier, SessionId);
            await SaveOutputConfig();
            return;
        }

        if (RemoteDisplayState.IsDisplayConnected(output.DisplayIdentifier))
        {
            outputToTakeOver = output;
            outputToTakeOverFrom = BroadcastingPresentationName(output.DisplayIdentifier);
            return;
        }

        await EnableOutput(output);
    }

    private async Task EnableOutput(RemoteDisplay output)
    {
        if (SessionId is null) return;

        RemoteDisplayState.EnableDisplay(output.DisplayIdentifier, SessionId, output.Name);
        await SaveOutputConfig();
    }

    private async Task ConfirmTakeOver()
    {
        var output = outputToTakeOver;
        outputToTakeOver = null;
        outputToTakeOverFrom = null;

        if (output is not null)
            await EnableOutput(output);
    }

    private void CancelTakeOver()
    {
        outputToTakeOver = null;
        outputToTakeOverFrom = null;
    }

    private async Task OpenLiveWindow()
    {
        // The window can fail either way: a blocked popup on the web, an unsupported second
        // window on the device. Both leave the button looking like it did nothing.
        if (!await Outputs.OpenWindowAsync(L["LivePanel.LocalLiveView"]))
            ToastService.Show(L["LivePanel.LiveWindowFailed"]);
    }

    private Task CloseLiveWindow(string windowId) => Outputs.CloseWindowAsync(windowId);

    private Task SaveOutputConfig() => Outputs.SaveAsync();

    private async Task ToggleExternalDisplay()
    {
        if (!await Outputs.ToggleExternalDisplayAsync(L["LivePanel.ExternalDisplay"]))
            ToastService.Show(L["LivePanel.LiveWindowFailed"]);
    }

    private void ShowPairingDialog() => showPairingDialog = true;

    private void ClosePairingDialog() => showPairingDialog = false;

    private bool showRemoteControlInfoDialog;
    private bool hasAutoShownRemoteControlInfoDialog;
    private string? remoteControlPresentationId;
    private string? remoteControlPresentationName;

    private void ToggleRemoteControl()
    {
        if (SessionId is null) return;
        if (SharedAppState.IsRemoteControlEnabled(SessionId))
        {
            SharedAppState.DisableRemoteControl(SessionId);
        }
        else
        {
            SharedAppState.EnableRemoteControl(SessionId);
            if (!hasAutoShownRemoteControlInfoDialog)
            {
                hasAutoShownRemoteControlInfoDialog = true;
                ShowRemoteControlInfoDialog();
            }
        }
    }

    private void ShowRemoteControlInfoDialog()
    {
        if (SessionId is null) return;
        var session = SharedAppState.GetActiveSession(SessionId);
        if (session?.PresentationId is null) return;
        remoteControlPresentationId = session.PresentationId;
        remoteControlPresentationName = session.PresentationName;
        showRemoteControlInfoDialog = true;
    }

    private void CloseRemoteControlInfoDialog() => showRemoteControlInfoDialog = false;

}
