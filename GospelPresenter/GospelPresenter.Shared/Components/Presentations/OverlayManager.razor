@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services

@inject IPresentationService PresentationService

@if (editingOverlay is not null)
{
    <OverlayEditor Overlay="@editingOverlay"
                   OnBack="ExitEditor"
                   OnSaved="HandleSaved"
                   OnDeleted="HandleDeleted"/>
}
else
{
    <div class="flex flex-col gap-2 overflow-auto grow">
        @if (overlays.Count == 0)
        {
            <div class="flex flex-col items-center justify-center text-center px-6 select-none grow">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 200 160" class="w-48 h-auto mb-6 text-neutral-300 dark:text-neutral-600">
                    <!-- Slide background -->
                    <rect x="30" y="20" width="140" height="90" rx="8" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                    <!-- Text lines on slide -->
                    <line x1="50" y1="50" x2="150" y2="50" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
                    <line x1="50" y1="65" x2="130" y2="65" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.2"/>
                    <!-- Overlay layer -->
                    <rect x="55" y="45" width="100" height="60" rx="6" stroke="currentColor" stroke-width="2" stroke-dasharray="4 3" fill="none" opacity="0.7"/>
                    <!-- Overlay text lines -->
                    <line x1="75" y1="70" x2="135" y2="70" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
                    <line x1="85" y1="82" x2="125" y2="82" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.4"/>
                </svg>
                <h2 class="text-lg font-semibold text-neutral-500 dark:text-neutral-400 mb-2">Inga overlays</h2>
                <p class="text-sm text-neutral-400 dark:text-neutral-500 max-w-xs leading-relaxed mb-4">
                    Overlays visas ovanpå den aktiva bilden under en presentation, t.ex. ett Swish-nummer vid kollekt.
                </p>
                <div>
                    <button class="px-4 py-2.5 rounded-full text-sm text-sky-600 dark:text-sky-400 cursor-pointer hover:bg-sky-50 dark:hover:bg-sky-900/30 flex items-center gap-1.5"
                            @onclick="AddNew">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                        </svg>
                        Lägg till overlay
                    </button>
                </div>
            </div>
        }
        else
        {
            @foreach (var overlay in overlays)
            {
                <button class="flex items-center gap-3 p-3 rounded-xl text-left cursor-pointer bg-neutral-100 dark:bg-neutral-700/50 hover:bg-neutral-200 dark:hover:bg-neutral-600"
                        @onclick="() => EditOverlay(overlay)">
                    <div class="grow min-w-0">
                        <div class="font-medium text-sm truncate">@overlay.Title</div>
                        @if (!string.IsNullOrWhiteSpace(overlay.Content))
                        {
                            <div class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5 truncate">@overlay.Content</div>
                        }
                        @if (overlay.ImageData is not null)
                        {
                            <div class="text-xs text-neutral-400 mt-0.5">Bild bifogad</div>
                        }
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 shrink-0 text-neutral-400">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
                    </svg>
                </button>
            }

            <button class="px-4 py-2.5 rounded-full text-sm text-sky-600 dark:text-sky-400 cursor-pointer hover:bg-sky-50 dark:hover:bg-sky-900/30 flex items-center gap-1.5 self-start"
                    @onclick="AddNew">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                Lägg till overlay
            </button>
        }
    </div>
}

@code {
    [Parameter] public required string OrganizationId { get; set; }
    [Parameter] public EventCallback OnOverlaysChanged { get; set; }

    private List<OverlaySlide> overlays = [];
    private OverlaySlide? editingOverlay;

    protected override async Task OnInitializedAsync()
    {
        overlays = await PresentationService.GetOverlaysAsync(OrganizationId);
    }

    private void AddNew()
    {
        editingOverlay = new OverlaySlide();
    }

    private void EditOverlay(OverlaySlide overlay)
    {
        editingOverlay = overlay;
    }

    private void ExitEditor()
    {
        editingOverlay = null;
    }

    private async Task HandleSaved(OverlaySlide overlay)
    {
        if (string.IsNullOrWhiteSpace(overlay.OrganizationId))
        {
            await PresentationService.AddOverlayAsync(OrganizationId, overlay);
        }
        else
        {
            await PresentationService.UpdateOverlayAsync(overlay);
        }

        overlays = await PresentationService.GetOverlaysAsync(OrganizationId);
        editingOverlay = null;
        await OnOverlaysChanged.InvokeAsync();
    }

    private async Task HandleDeleted(OverlaySlide overlay)
    {
        await PresentationService.RemoveOverlayAsync(OrganizationId, overlay.Id);
        overlays = await PresentationService.GetOverlaysAsync(OrganizationId);
        editingOverlay = null;
        await OnOverlaysChanged.InvokeAsync();
    }
}
