@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State

@inject IPresentationService PresentationService
@inject ActiveOrganizationState OrgState

@if (editingOverlay is not null)
{
    <OverlayEditorPanel Overlay="@editingOverlay"
                        OnBack="ExitEditor"
                        OnChanged="HandleChanged"
                        OnDeleted="HandleDelete"/>
}
else
{
    <div class="flex flex-col gap-2 overflow-auto grow">
        @if (overlays.Count == 0)
        {
            <div class="flex flex-col items-center justify-center text-center px-6 select-none grow">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 200 160" class="w-48 h-auto mb-6 text-neutral-300 dark:text-neutral-600">
                    <!-- Slide background -->
                    <rect x="30" y="20" width="140" height="90" rx="8" stroke="currentColor" stroke-width="2" class="fill-neutral-100 dark:fill-neutral-800"/>
                    <!-- Text lines on slide -->
                    <line x1="50" y1="50" x2="150" y2="50" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
                    <line x1="50" y1="65" x2="130" y2="65" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.2"/>
                    <!-- Overlay layer -->
                    <rect x="55" y="45" width="100" height="60" rx="6" stroke="currentColor" stroke-width="2" stroke-dasharray="4 3" fill="none" opacity="0.7"/>
                    <!-- Overlay text lines -->
                    <line x1="75" y1="70" x2="135" y2="70" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
                    <line x1="85" y1="82" x2="125" y2="82" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.4"/>
                </svg>
                <h2 class="text-lg font-semibold text-neutral-500 dark:text-neutral-400 mb-2">@L["OverlayManager.Empty"]</h2>
                <p class="text-sm text-neutral-400 dark:text-neutral-500 max-w-xs leading-relaxed mb-4">
                    @L["OverlayManager.Description"]
                </p>
                <div>
                    <AppButton Variant="ButtonVariant.Secondary"
                               Class="flex items-center gap-1.5"
                               OnClick="AddNew">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                        </svg>
                        @L["Overlays.Create"]
                    </AppButton>
                </div>
            </div>
        }
        else
        {
            @foreach (var overlay in overlays)
            {
                <button class="flex items-center gap-3 p-3 rounded-xl text-left cursor-pointer bg-neutral-100 dark:bg-neutral-700/50 hover:bg-neutral-200 dark:hover:bg-neutral-600"
                        @onclick="() => EditOverlay(overlay)">
                    @if (overlay.HasImage)
                    {
                        <img src="@ImageUrlHelper.OverlayImageUrl(overlay.Id)"
                             alt="" class="w-16 h-9 object-cover rounded border border-neutral-200 dark:border-neutral-600 shrink-0"/>
                    }
                    else
                    {
                        <div class="w-16 h-9 rounded border border-neutral-200 dark:border-neutral-600 bg-neutral-200 dark:bg-neutral-700 shrink-0 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 text-neutral-400">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z"/>
                            </svg>
                        </div>
                    }
                    <div class="grow min-w-0">
                        <div class="font-medium text-sm truncate">@overlay.Title</div>
                        @if (!string.IsNullOrWhiteSpace(overlay.Content))
                        {
                            <div class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5 truncate">@overlay.Content</div>
                        }
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 shrink-0 text-neutral-400">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
                    </svg>
                </button>
            }

            <AppButton Variant="ButtonVariant.Secondary"
                       Class="flex items-center gap-1.5 self-start"
                       OnClick="AddNew">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                </svg>
                @L["Overlays.Create"]
            </AppButton>
        }
    </div>
}

@if (showNameDialog)
{
    <NameDialog Title="@L["Overlays.Create"]"
                Name="@newOverlayTitle"
                SaveText="@L["Common.Create"]"
                SaveLoadingText="@L["Common.Creating"]"
                OnSave="HandleCreateOverlay"
                OnClose="() => showNameDialog = false"/>
}

@code {
    [Parameter] public required string OrganizationId { get; set; }
    [Parameter] public EventCallback OnOverlaysChanged { get; set; }

    private List<OverlaySlide> overlays = [];
    private OverlaySlide? editingOverlay;
    private bool showNameDialog;
    private string newOverlayTitle = "";

    protected override async Task OnInitializedAsync()
    {
        overlays = await PresentationService.GetOverlaysAsync(OrganizationId, OrgState.ToCallerContext());
    }

    private void AddNew()
    {
        newOverlayTitle = "";
        showNameDialog = true;
    }

    private async Task HandleCreateOverlay(string title)
    {
        var overlay = new OverlaySlide { Title = title.Trim() };
        await PresentationService.AddOverlayAsync(OrganizationId, overlay, OrgState.ToCallerContext());
        await RefreshOverlays();
        showNameDialog = false;
        editingOverlay = overlays.FirstOrDefault(o => o.Id == overlay.Id) ?? overlay;
    }

    private void EditOverlay(OverlaySlide overlay)
    {
        editingOverlay = overlay;
    }

    private void ExitEditor()
    {
        editingOverlay = null;
    }

    private async Task HandleChanged(OverlaySlide overlay)
    {
        await PresentationService.UpdateOverlayAsync(OrganizationId, overlay, OrgState.ToCallerContext());
        await RefreshOverlays();
    }

    private async Task HandleDelete()
    {
        if (editingOverlay is null) return;
        await PresentationService.RemoveOverlayAsync(OrganizationId, editingOverlay.Id, OrgState.ToCallerContext());
        editingOverlay = null;
        await RefreshOverlays();
    }

    private async Task RefreshOverlays()
    {
        overlays = await PresentationService.GetOverlaysAsync(OrganizationId, OrgState.ToCallerContext());
        await OnOverlaysChanged.InvokeAsync();
    }
}
