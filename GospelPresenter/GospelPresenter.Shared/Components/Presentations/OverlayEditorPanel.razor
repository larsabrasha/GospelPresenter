@using GospelPresenter.Shared.Models

<div class="flex flex-col h-full overflow-y-auto">
    <DetailHeader @ref="header" OnBack="OnBack" Class="mb-2"/>
    <OverlayEditor Overlay="@Overlay"
                   OnChanged="OnChanged"
                   OnSaved="() => header?.ShowSaved()"/>
    <div class="flex items-center justify-end pt-4">
        <AppButton Variant="ButtonVariant.Danger" OnClick="ConfirmDelete">
            @L["Common.Delete"]
        </AppButton>
    </div>
</div>

@if (showDeleteConfirm)
{
    <ConfirmDeleteDialog MessageKey="Overlays.ConfirmDelete" MessageValue="@Overlay.Title"
                         IsDeleting="isDeleting"
                         OnConfirm="ExecuteDelete"
                         OnClose="CancelDelete"/>
}

@code {
    [Parameter, EditorRequired] public required OverlaySlide Overlay { get; set; }
    [Parameter, EditorRequired] public EventCallback OnBack { get; set; }
    [Parameter, EditorRequired] public EventCallback<OverlaySlide> OnChanged { get; set; }
    [Parameter, EditorRequired] public EventCallback OnDeleted { get; set; }

    private DetailHeader? header;
    private bool showDeleteConfirm;
    private bool isDeleting;

    private void ConfirmDelete()
    {
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
    }

    private async Task ExecuteDelete()
    {
        if (isDeleting) return;
        isDeleting = true;
        try
        {
            await OnDeleted.InvokeAsync();
            showDeleteConfirm = false;
        }
        finally
        {
            isDeleting = false;
        }
    }
}
