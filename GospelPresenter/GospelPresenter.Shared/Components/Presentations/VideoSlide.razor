<Slide
    IsSelected="@IsSelected"
    Class="@Class"
    BaseWidth="@BaseWidth"
    BaseHeight="@BaseHeight"
    Scale="@Scale">
    @if (Embed)
    {
        <iframe src="https://www.youtube.com/embed/@VideoId?autoplay=1&rel=0"
                class="absolute inset-0 w-full h-full rounded-lg"
                allow="autoplay; encrypted-media"
                allowfullscreen
                frameborder="0">
        </iframe>
    }
    else
    {
        <div class="relative w-full h-full flex items-center justify-center">
            <img src="https://img.youtube.com/vi/@VideoId/mqdefault.jpg"
                 alt=""
                 class="absolute inset-0 w-full h-full object-cover rounded-lg drag-none"/>
            <div class="relative size-20 rounded-full bg-black/60 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="size-10 ml-1">
                    <path d="M8 5v14l11-7z"/>
                </svg>
            </div>
        </div>
    }
</Slide>

@code {
    [Parameter] public required string VideoId { get; set; }
    [Parameter] public bool Embed { get; set; }
    [Parameter] public bool? IsSelected { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public required int BaseWidth { get; set; }
    [Parameter] public required int BaseHeight { get; set; }
    [Parameter] public required double Scale { get; set; }
}
