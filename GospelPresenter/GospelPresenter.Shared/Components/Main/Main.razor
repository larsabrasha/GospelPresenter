@using System.ComponentModel
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State

@inject AppState AppState
@inject SharedAppState SharedAppState
@inject ISongService SongService
@inject IImageService ImageService

@implements IDisposable

<div class="flex flex-col grow overflow-hidden h-full relative">
    <div
        class="flex justify-between absolute top-0 left-0 right-0 bg-linear-to-b from-neutral-100 dark:from-neutral-900 to-transparent z-10 pointer-events-auto lg:pointer-events-none h-16">
        <div class="px-5 py-3 pointer-events-auto">
            <span class="text-xl font-semibold">@AppState.SelectedProjectItem?.Title</span>
        </div>

        <div class="p-3 pointer-events-auto">
            <a href="/live" target="_blank"
               class="bg-sky-500 text-white px-4 py-3 rounded-3xl space-x-2 flex items-center hover:bg-sky-600">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                     stroke="currentColor" class="size-5">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M6 20.25h12m-7.5-3v3m3-3v3m-10.125-3h17.25c.621 0 1.125-.504 1.125-1.125V4.875c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125Z"/>
                </svg>
                <div class="shrink-0 text-sm">Presentera</div>
            </a>
        </div>
    </div>

    @{
        var slideScale = AppState.MainViewport is null
            ? 0.0
            : AppState.MainViewport.Width < 768
                ? AppState.MainViewport.Width / (double)AppState.BaseSlideWidth * 0.9 ?? 0.15
                : AppState.MainViewport.Width <= 1024
                    ? AppState.MainViewport.Width / (double)AppState.BaseSlideWidth / 3 * 0.98 ?? 0.15
                    : 0.2;

        var miscSlideScale = AppState.MainViewport is null
            ? 0.0
            : AppState.MainViewport.Width < 1024
                ? 0.075
                : 0.1;
    }

    <div class="mx-auto sm:mx-0 grid grid-cols-1 sm:flex sm:flex-wrap gap-3 p-3 overflow-auto pt-16 pb-36" id="main">
        @if (SelectedSong is not null)
        {
            @for (var i = 0; i < SelectedSong.Parts.Count; i++)
            {
                var part = SelectedSong.Parts[i].Replace("\n", "<br>");
                var partIndex = i;

                var partClass =
                    SharedAppState.LiveSlide.Status == LiveSlideStatus.ShowingPresentation &&
                    SharedAppState.LiveSlide.ProjectItemId == SelectedSong.Id &&
                    SharedAppState.LiveSlide.ItemPartIndex == i
                        ? $"{DefaultClass} {SelectedClass}"
                        : $"{DefaultClass} {NotSelectedClass}";

                <button @onclick="() => SetSelectedLiveSlide(SelectedSong.Id, partIndex)" class="p-3-">
                    <Slide
                        Class="@partClass"
                        BaseWidth="@AppState.BaseSlideWidth"
                        BaseHeight="@AppState.BaseSlideHeight"
                        Scale="@slideScale">
                        @((MarkupString)part)
                    </Slide>
                </button>
            }
        }
        else if (SelectedImage is not null)
        {
            var partClass =
                SharedAppState.LiveSlide.Status == LiveSlideStatus.ShowingPresentation &&
                SharedAppState.LiveSlide.ProjectItemId == SelectedImage.Id &&
                SharedAppState.LiveSlide.ItemPartIndex == 0
                    ? $"{DefaultClass} {SelectedClass}"
                    : $"{DefaultClass} {NotSelectedClass}";

            <button @onclick="() => SetSelectedLiveSlide(SelectedImage.Id, 0)">
                <Slide
                    Class="@partClass"
                    BaseWidth="@AppState.BaseSlideWidth"
                    BaseHeight="@AppState.BaseSlideHeight"
                    Scale="@slideScale">
                    <img src="@SelectedImage.Url" alt="" class="w-fill rounded-lg drag-none">
                </Slide>
            </button>
        }
    </div>

    <div
        class="flex absolute bottom-0 left-0 right-0 h-28 lg:h-36 justify-between lg:justify-end p-3 bg-linear-to-t from-neutral-100 dark:from-neutral-900 to-transparent z-10 pointer-events-auto lg:pointer-events-none">
        <div class="flex items-center lg:hidden pointer-events-auto">
            <button class="cursor-pointer p-4 bg-white dark:bg-neutral-800 rounded-full shadow-2xl"
                    @onclick="() => AppState.IsMenuVisible = true">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                     stroke="currentColor" class="size-8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
                </svg>
            </button>
        </div>

        <div class="flex items-center">
            @{
                var emptySlideClass = SharedAppState.LiveSlide.Status == LiveSlideStatus.ShowingBlackScreen
                    ? $"{DefaultClass} {SelectedClass}"
                    : $"{DefaultClass} {NotSelectedClass}";
            }
            <button @onclick="SharedAppState.SelectBlackScreen" class="pointer-events-auto">
                <Slide Class="@emptySlideClass" BaseWidth="@AppState.BaseSlideWidth"
                    BaseHeight="@AppState.BaseSlideHeight" Scale="@miscSlideScale">
                    <div class="flex justify-center space-x-20 text-neutral-600">
                        @{
                            var blankScreenClass = SharedAppState.LiveSlide.Status == LiveSlideStatus.ShowingBlackScreen ?
                            "text-sky-500 bg-sky-950" : "bg-neutral-800 group-hover:bg-sky-950 group-hover:text-sky-500";
                        }
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-130 p-25 rounded-full  @blankScreenClass">
                            <path fill-rule="evenodd" d="M6.75 5.25a.75.75 0 0 1 .75-.75H9a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75H7.5a.75.75 0 0 1-.75-.75V5.25Zm7.5 0A.75.75 0 0 1 15 4.5h1.5a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75H15a.75.75 0 0 1-.75-.75V5.25Z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                </Slide>
            </button>
        </div>
    </div>

</div>


@code {
    private Song? SelectedSong { get; set; }
    private Image? SelectedImage { get; set; }

    private const string DefaultClass = "border-t border-neutral-800/90 bg-black rounded-2xl overflow-hidden outline-4 m-1 text-white hover:cursor-pointer hover:outline-sky-500 hover:drop-shadow-lg hover:drop-shadow-sky-500/40";
    private const string SelectedClass = "outline-sky-500";
    private const string NotSelectedClass = "outline-transparent";

    protected override void OnInitialized()
    {
        GetDataForSelectedItem();

        AppState.PropertyChanged += OnPropertyChanged;
        SharedAppState.PropertyChanged += OnPropertyChanged;
    }

    public void Dispose()
    {
        AppState.PropertyChanged -= OnPropertyChanged;
        SharedAppState.PropertyChanged += OnPropertyChanged;
    }

    private void OnPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(AppState.SelectedProjectItem))
        {
            GetDataForSelectedItem();
            _ = InvokeAsync(StateHasChanged);
        }
        else if (e.PropertyName is
                 nameof(AppState.MainViewport) or
                 nameof(SharedAppState.LiveSlide))
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void GetDataForSelectedItem()
    {
        SelectedSong = null;
        SelectedImage = null;

        switch (AppState.SelectedProjectItem?.Type)
        {
            case ProjectItemType.Song:
                SelectedSong = SongService.GetSongById(AppState.SelectedProjectItem.Id);
                break;
            case ProjectItemType.BibleText:
                break;
            case ProjectItemType.Image:
                SelectedImage = ImageService.GetImageById(AppState.SelectedProjectItem.Id);
                break;
        }
    }

    private void SetSelectedLiveSlide(string selectedItemId, int partIndex)
    {
        var projectItem = AppState.SelectedProject?.Items.FirstOrDefault(x => x.Id == selectedItemId);
        if (projectItem is null) return;

        string? text = null;
        string? credits = null;
        string? imageUrl = null;

        switch (projectItem.Type)
        {
            case ProjectItemType.Song:
            {
                var song = SongService.GetSongById(projectItem.Id);
                if (song is not null && partIndex < song.Parts.Count)
                {
                    text = song.Parts[partIndex].Replace("\n", "<br>");

                    var creditParts = new List<string?>
                        {
                            song.Author,
                            string.IsNullOrEmpty(song.Publisher)
                                ? null
                                : $"© {song.Publisher}",
                            $"{song.Year}"
                        }
                        .OfType<string>()
                        .ToList();
                    credits = string.Join(" · ", creditParts);
                }

                break;
            }
            case ProjectItemType.Image:
            {
                var image = ImageService.GetImageById(projectItem.Id);
                if (image is not null)
                {
                    imageUrl = image.Url;
                }

                break;
            }
            case ProjectItemType.BibleText:
                break;
            default:
                return;
        }

        SharedAppState.LiveSlide = SharedAppState.LiveSlide with
        {
            Status = LiveSlideStatus.ShowingPresentation,
            ProjectItemId = selectedItemId,
            ItemPartIndex = partIndex,
            Text = text,
            Credits = credits,
            ImageUrl = imageUrl
        };
    }

}
