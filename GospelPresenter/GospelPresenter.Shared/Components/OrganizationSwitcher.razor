@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State

@inject ActiveOrganizationState OrgState
@inject IUserService UserService
@inject NavigationManager NavigationManager

@implements IDisposable

@if (!OrgState.IsSuperAdmin)
{
    return;
}

@if (showDropdown)
{
    <div class="fixed inset-0 z-40" @onclick="CloseDropdown"></div>
}
<div class="relative">
    <button @onclick="ToggleDropdown" @onclick:stopPropagation="true"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium cursor-pointer
                   bg-neutral-100 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300
                   hover:bg-neutral-200 dark:hover:bg-neutral-600">
        @{ var activeOrg = organizations?.FirstOrDefault(o => o.Id == OrgState.SelectedOrganizationId); }
        @if (activeOrg?.LogoSmall is not null)
        {
            <img src="@activeOrg.LogoSmall" alt="" class="size-4 rounded-full object-cover shrink-0"/>
        }
        else
        {
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5">
                <path fill-rule="evenodd" d="M4.25 2A2.25 2.25 0 0 0 2 4.25v2.5A2.25 2.25 0 0 0 4.25 9h2.5A2.25 2.25 0 0 0 9 6.75v-2.5A2.25 2.25 0 0 0 6.75 2h-2.5Zm0 9A2.25 2.25 0 0 0 2 13.25v2.5A2.25 2.25 0 0 0 4.25 18h2.5A2.25 2.25 0 0 0 9 15.75v-2.5A2.25 2.25 0 0 0 6.75 11h-2.5Zm9-9A2.25 2.25 0 0 0 11 4.25v2.5A2.25 2.25 0 0 0 13.25 9h2.5A2.25 2.25 0 0 0 18 6.75v-2.5A2.25 2.25 0 0 0 15.75 2h-2.5Zm0 9A2.25 2.25 0 0 0 11 13.25v2.5A2.25 2.25 0 0 0 13.25 18h2.5A2.25 2.25 0 0 0 18 15.75v-2.5A2.25 2.25 0 0 0 15.75 11h-2.5Z" clip-rule="evenodd"/>
            </svg>
        }
        @(OrgState.SelectedOrganizationName ?? "Ingen organisation vald")
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="size-3">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
        </svg>
    </button>

    @if (showDropdown)
    {
        <div class="absolute right-0 top-full mt-2 w-64 bg-white dark:bg-neutral-700 rounded-lg shadow-lg py-1 z-50">
            <div class="max-h-64 overflow-y-auto">
                @if (organizations is null || organizations.Count == 0)
                {
                    <div class="px-4 py-3 text-sm text-neutral-400 dark:text-neutral-500">Inga organisationer</div>
                }
                else
                {
                    @foreach (var org in organizations)
                    {
                        var isActive = OrgState.SelectedOrganizationId == org.Id;
                        <button @onclick="() => SelectOrganization(org)"
                                class="flex items-center gap-3 w-full text-left px-4 py-2.5 text-sm cursor-pointer
                                       @(isActive ? "bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300" : "text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-600")">
                            <OrganizationAvatar LogoUrl="@org.LogoSmall" Name="@org.Name"/>
                            <div class="flex-1 min-w-0">
                                <div class="font-medium truncate">@org.Name</div>
                                <div class="text-xs text-neutral-400">@org.Users.Count @(org.Users.Count == 1 ? "användare" : "användare")</div>
                            </div>
                            @if (isActive)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0">
                                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
                                </svg>
                            }
                        </button>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private List<Organization>? organizations;
    private bool showDropdown;

    protected override async Task OnInitializedAsync()
    {
        OrgState.OnChange += OnOrgStateChanged;
        OrgState.OnOrganizationsChanged += OnOrganizationsChanged;

        if (!OrgState.IsSuperAdmin)
        {
            organizations = [];
            return;
        }

        organizations = await UserService.GetAllOrganizationsAsync(OrgState.ToCallerContext());
    }

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
    }

    private void CloseDropdown() => showDropdown = false;

    private async Task SelectOrganization(Organization org)
    {
        OrgState.SwitchOrganization(org.Id, org.Name);
        await UserService.SetUserSettingAsync(OrgState.UserId!, UserSetting.LastSelectedOrganizationId, org.Id, OrgState.ToCallerContext());
        showDropdown = false;
        NavigationManager.NavigateTo("/", forceLoad: true);
    }

    private async void OnOrganizationsChanged()
    {
        try
        {
            organizations = await UserService.GetAllOrganizationsAsync(OrgState.ToCallerContext());
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // Fire-and-forget event handler; swallow to prevent crash
        }
    }

    private void OnOrgStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        OrgState.OnChange -= OnOrgStateChanged;
        OrgState.OnOrganizationsChanged -= OnOrganizationsChanged;
    }
}
