@using GospelPresenter.Shared.State

<div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t-[0.5px] border-white dark:border-neutral-700 p-5 space-y-4">
    <FloatingInput Id="song-name" Label="@L["Common.Name"]" Value="@Name" ValueChanged="HandleNameChanged"
                   MaxLength="AppConstraints.NameMaxLength"/>
    <div class="flex gap-4">
        <FloatingInput Id="song-author" Label="@L["SongFields.Artist"]" Class="flex-1" Value="@Author" ValueChanged="HandleAuthorChanged"
                       MaxLength="AppConstraints.SongAuthorMaxLength"/>
        <FloatingInput Id="song-publisher" Label="@L["SongFields.Publisher"]" Class="flex-1" Value="@Publisher" ValueChanged="HandlePublisherChanged"
                       MaxLength="AppConstraints.SongPublisherMaxLength"/>
    </div>
    <div class="flex gap-4">
        <FloatingInput Id="song-year" Label="@L["SongFields.Year"]" Type="number" Class="flex-1" Value="@Year?.ToString()" ValueChanged="HandleYearChanged"
                       Min="AppConstraints.SongYearMin" Max="AppConstraints.SongYearMax"/>
        <FloatingInput Id="song-ccli" Label="CCLI" Class="flex-1" Value="@Ccli" ValueChanged="HandleCcliChanged"
                       MaxLength="AppConstraints.SongCcliMaxLength"/>
    </div>
    @if (ChildContent is not null)
    {
        @ChildContent
    }
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public EventCallback<string> NameChanged { get; set; }
    [Parameter] public string? Author { get; set; }
    [Parameter] public EventCallback<string?> AuthorChanged { get; set; }
    [Parameter] public string? Publisher { get; set; }
    [Parameter] public EventCallback<string?> PublisherChanged { get; set; }
    [Parameter] public int? Year { get; set; }
    [Parameter] public EventCallback<int?> YearChanged { get; set; }
    [Parameter] public string? Ccli { get; set; }
    [Parameter] public EventCallback<string?> CcliChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task HandleNameChanged(string value)
        => NameChanged.InvokeAsync(value);

    private Task HandleAuthorChanged(string value)
    {
        return AuthorChanged.InvokeAsync(string.IsNullOrWhiteSpace(value) ? null : value);
    }

    private Task HandlePublisherChanged(string value)
    {
        return PublisherChanged.InvokeAsync(string.IsNullOrWhiteSpace(value) ? null : value);
    }

    private Task HandleYearChanged(string value)
    {
        return YearChanged.InvokeAsync(int.TryParse(value, out var y) ? y : null);
    }

    private Task HandleCcliChanged(string value)
    {
        return CcliChanged.InvokeAsync(string.IsNullOrWhiteSpace(value) ? null : value);
    }
}
