<AuthorizeView Policy="@ManageSongs">
    @{
        var linkClass = "flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm text-neutral-500 dark:text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 bg-neutral-100 dark:bg-neutral-700 hover:bg-neutral-200 dark:hover:bg-neutral-600";
    }
    <div class="flex items-center gap-2">
        <a href="/"
           title="@L["Nav.Dashboard"]"
           class="@linkClass">
            @L["Nav.Dashboard"]
        </a>
        <a href="/admin"
           title="@L["Nav.Administration"]"
           class="@linkClass">
            @L["Nav.Administration"]
        </a>
    </div>
</AuthorizeView>
