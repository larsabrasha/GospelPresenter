@using GospelPresenter.Shared.Services
@inject NavigationManager Navigation
@inject IServiceProvider Services

@code {
    protected override void OnInitialized()
    {
        // On the device app there is no server /signin to force-load; the login page runs the
        // system-browser flow instead. IDeviceSignIn is only registered by the MAUI host.
        if (Services.GetService(typeof(IDeviceSignIn)) is not null)
            Navigation.NavigateTo("/login");
        else
            Navigation.NavigateTo($"/signin?returnUrl={Uri.EscapeDataString(Navigation.Uri)}", forceLoad: true);
    }
}
