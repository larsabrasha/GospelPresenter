<div class="relative @Class">
    <select id="@Id"
            value="@Value"
            @onchange="OnChange"
            class="appearance-none h-9 pl-4 pr-8 rounded-full bg-neutral-100 dark:bg-neutral-700 text-sm text-neutral-900 dark:text-neutral-100 focus:outline-none focus:ring-2 focus:ring-sky-500">
        @ChildContent
    </select>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5 absolute right-3 top-1/2 -translate-y-1/2 text-neutral-400 pointer-events-none">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
    </svg>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public object? Value { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnChange { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
}
