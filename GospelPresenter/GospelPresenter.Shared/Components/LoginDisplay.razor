@using CommunityToolkit.Mvvm.Messaging
@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.Services
@using GospelPresenter.Shared.State
@using Microsoft.AspNetCore.Authorization

@implements IRecipient<CurrentUserChangedMessage>
@implements IDisposable

@inject IUserService UserService
@inject ActiveOrganizationState OrgState

<AuthorizeView>
    <Authorized>
        @if (showDropdown)
        {
            <div class="fixed inset-0 z-40" @onclick="CloseDropdown"></div>
        }
        <div class="relative flex items-center gap-2">
            <button @onclick="ToggleDropdown" @onclick:stopPropagation="true"
                    class="cursor-pointer">
                <ProfileAvatar ImageUrl="@(user?.ProfileImageSmall ?? user?.ProfileImage)" Name="@user?.Name"/>
            </button>
            @if (showDropdown)
            {
                <div class="absolute right-0 top-full mt-2 w-60 bg-white dark:bg-neutral-700 rounded-lg shadow-lg py-1 z-50">
                    <div class="px-4 py-3 border-b border-neutral-200 dark:border-neutral-600">
                        <div class="text-sm font-medium text-neutral-900 dark:text-neutral-100">@user?.Name</div>
                        <div class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">@user?.Email</div>
                    </div>
                    <div class="py-1 border-b border-neutral-200 dark:border-neutral-600">
                        <a href="/profile" @onclick="CloseDropdown"
                           class="flex items-center gap-3 px-4 py-2.5 text-sm text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-600">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                                <path d="M10 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM3.465 14.493a1.23 1.23 0 0 0 .41 1.412A9.957 9.957 0 0 0 10 18c2.31 0 4.438-.784 6.131-2.1.43-.333.604-.903.408-1.41a7.002 7.002 0 0 0-13.074.003Z"/>
                            </svg>
                            Min profil
                        </a>
                    </div>
                    <AuthorizeView Roles="Admin,SuperAdmin" Context="adminContext">
                        <div class="py-1 border-b border-neutral-200 dark:border-neutral-600">
                            <a href="/admin/songs" @onclick="CloseDropdown"
                               class="flex items-center gap-3 px-4 py-2.5 text-sm text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-600">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                                    <path d="M17.721 1.599a.75.75 0 0 1 .279.584v11.29a2.25 2.25 0 0 1-1.774 2.198l-2.041.442a2.216 2.216 0 1 1-.938-4.333l2.478-.536V5.749L9 7.889v8.584a2.25 2.25 0 0 1-1.774 2.198l-2.042.442a2.216 2.216 0 1 1-.938-4.333l2.504-.542V3.523a.75.75 0 0 1 .558-.724l7.5-2a.75.75 0 0 1 .913.8Z"/>
                                </svg>
                                Innehåll
                            </a>
                            <a href="/admin/users" @onclick="CloseDropdown"
                               class="flex items-center gap-3 px-4 py-2.5 text-sm text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-600">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                                    <path fill-rule="evenodd" d="M7.84 1.804A1 1 0 0 1 8.82 1h2.36a1 1 0 0 1 .98.804l.331 1.652a6.993 6.993 0 0 1 1.929 1.115l1.598-.54a1 1 0 0 1 1.186.447l1.18 2.044a1 1 0 0 1-.205 1.251l-1.267 1.113a7.047 7.047 0 0 1 0 2.228l1.267 1.113a1 1 0 0 1 .206 1.25l-1.18 2.045a1 1 0 0 1-1.187.447l-1.598-.54a6.993 6.993 0 0 1-1.929 1.115l-.33 1.652a1 1 0 0 1-.98.804H8.82a1 1 0 0 1-.98-.804l-.331-1.652a6.993 6.993 0 0 1-1.929-1.115l-1.598.54a1 1 0 0 1-1.186-.447l-1.18-2.044a1 1 0 0 1 .205-1.251l1.267-1.114a7.05 7.05 0 0 1 0-2.227L1.821 7.773a1 1 0 0 1-.206-1.25l1.18-2.045a1 1 0 0 1 1.187-.447l1.598.54A6.993 6.993 0 0 1 7.51 3.456l.33-1.652ZM10 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" clip-rule="evenodd"/>
                                </svg>
                                Administration
                            </a>
                        </div>
                    </AuthorizeView>
                    <div class="py-1">
                        <form method="post" action="/signout">
                            <AntiforgeryToken/>
                            <button type="submit"
                                    class="flex items-center gap-3 w-full text-left px-4 py-2.5 text-sm text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-600 cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                                    <path fill-rule="evenodd" d="M3 4.25A2.25 2.25 0 0 1 5.25 2h5.5A2.25 2.25 0 0 1 13 4.25v2a.75.75 0 0 1-1.5 0v-2a.75.75 0 0 0-.75-.75h-5.5a.75.75 0 0 0-.75.75v11.5c0 .414.336.75.75.75h5.5a.75.75 0 0 0 .75-.75v-2a.75.75 0 0 1 1.5 0v2A2.25 2.25 0 0 1 10.75 18h-5.5A2.25 2.25 0 0 1 3 15.75V4.25Z" clip-rule="evenodd"/>
                                    <path fill-rule="evenodd" d="M6 10a.75.75 0 0 1 .75-.75h9.546l-1.048-.943a.75.75 0 1 1 1.004-1.114l2.5 2.25a.75.75 0 0 1 0 1.114l-2.5 2.25a.75.75 0 1 1-1.004-1.114l1.048-.943H6.75A.75.75 0 0 1 6 10Z" clip-rule="evenodd"/>
                                </svg>
                                Logga ut
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private User? user;
    private string? userId;
    private bool showDropdown;

    protected override async Task OnInitializedAsync()
    {
        WeakReferenceMessenger.Default.Register(this);

        if (AuthState is null) return;
        var state = await AuthState;
        userId = state.User.FindFirst("user_id")?.Value;
        if (userId is null || OrgState.UserId is null) return;
        user = await UserService.GetByIdAsync(userId, OrgState.ToCallerContext());
    }

    public async void Receive(CurrentUserChangedMessage message)
    {
        try
        {
            if (userId is null || OrgState.UserId is null) return;
            user = await UserService.GetByIdAsync(userId, OrgState.ToCallerContext());
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // Fire-and-forget event handler; swallow to prevent crash
        }
    }

    private void ToggleDropdown() => showDropdown = !showDropdown;
    private void CloseDropdown() => showDropdown = false;

    public void Dispose()
    {
        WeakReferenceMessenger.Default.Unregister<CurrentUserChangedMessage>(this);
    }
}
