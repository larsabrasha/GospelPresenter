@inject IJSRuntime JsRuntime

<div class="relative @Class" @onclick:stopPropagation="true" @onfocusout="OnFocusOut">
    <div @ref="triggerRef" @onclick="Toggle">
        @Trigger
    </div>
    @if (isOpen)
    {
        <div class="fixed inset-0 z-[120]" @onclick="Close"></div>
        <div @ref="menuRef" class="@(Portal ? "fixed" : "absolute top-full mt-1") z-[130] bg-white dark:bg-neutral-700 rounded-2xl shadow-lg border-[0.5px] border-neutral-200 dark:border-neutral-600 overflow-hidden @MenuClass">
            <div @onclick="Close">
                @Menu
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? Trigger { get; set; }
    [Parameter] public RenderFragment? Menu { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? MenuClass { get; set; }
    [Parameter] public bool Portal { get; set; }

    private bool isOpen;
    private bool needsPositioning;
    private ElementReference triggerRef;
    private ElementReference menuRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsPositioning)
        {
            needsPositioning = false;
            if (Portal)
            {
                await JsRuntime.InvokeVoidAsync("positionDropdownPortal", menuRef, triggerRef);
            }
            else
            {
                await JsRuntime.InvokeVoidAsync("positionDropdown", menuRef);
            }
        }
    }

    private void Toggle()
    {
        isOpen = !isOpen;
        if (isOpen) needsPositioning = true;
    }

    private void Close()
    {
        if (!isOpen) return;
        isOpen = false;
    }

    private async Task OnFocusOut()
    {
        await Task.Delay(150);
        if (isOpen)
        {
            isOpen = false;
            StateHasChanged();
        }
    }
}
