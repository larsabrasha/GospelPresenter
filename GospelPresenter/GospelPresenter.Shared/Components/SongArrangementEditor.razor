@using GospelPresenter.Shared.State
@using GospelPresenter.Shared.Utils

@implements IDisposable
@inject IJSRuntime JsRuntime

<div class="space-y-4">
@if (Song.Arrangements.Count == 0)
{
    <AppButton Variant="ButtonVariant.Secondary" OnClick="CreateArrangement" Class="flex items-center gap-1.5 self-start">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
        </svg>
        @L["SongEditor.CreateArrangement"]
    </AppButton>
}
else
{
    @foreach (var arrangement in Song.Arrangements)
    {
        var arr = arrangement;
        var arrangedParts = Song.GetArrangedParts(arr.Id);
        <div class="bg-neutral-50 dark:bg-neutral-800 rounded-xl shadow-sm border-t-[0.5px] border-white dark:border-neutral-700 p-4 space-y-3">
            @if (Song.Arrangements.Count > 1)
            {
                <div class="flex gap-4">
                    <FloatingInput Id="@($"arrangement-name-{arr.Id}")"
                                   Value="@(GetEditName(arr.Id, arr.Name))"
                                   Label="@L["SongEditor.ArrangementName"]"
                                   MaxLength="AppConstraints.SongArrangementNameMaxLength"
                                   OnInput="(e) => HandleNameChanged(arr.Id, e.Value?.ToString() ?? string.Empty)"
                                   Class="flex-1" />
                    <div class="flex-1"></div>
                </div>
            }

            <div id="@($"arrangement-chips-{arr.Id}")" class="flex flex-col gap-1 max-w-[50%]">
                @for (var i = 0; i < arrangedParts.Count; i++)
                {
                    var chipIndex = i;
                    var part = arrangedParts[i];
                    <div @key="@($"{arr.Id}-{chipIndex}")" class="flex items-center gap-1.5 bg-white dark:bg-neutral-700 rounded-lg shadow-sm border-t-[0.5px] border-white dark:border-neutral-700 px-2 py-1.5 cursor-grab active:cursor-grabbing drag-handle">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 text-neutral-300 dark:text-neutral-500 shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5"/>
                        </svg>
                        @if (part.LabelColor is not null)
                        {
                            <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold text-white whitespace-nowrap" style="background-color: @part.LabelColor;">@(part.Label ?? TruncateContent(part.Content))</span>
                        }
                        else
                        {
                            <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold bg-neutral-400 text-white whitespace-nowrap">@(part.Label ?? TruncateContent(part.Content))</span>
                        }
                        <span class="flex-1"></span>
                        <button type="button"
                                @onclick="() => RemoveFromArrangement(arr.Id, chipIndex)"
                                @onclick:stopPropagation="true"
                                class="p-0.5 text-neutral-300 hover:text-red-500 dark:text-neutral-500 dark:hover:text-red-400 cursor-pointer shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                            </svg>
                        </button>
                    </div>
                }
            </div>

            <div class="flex items-center justify-between">
                <Dropdown MenuClass="left-0 w-48 max-h-60 overflow-y-auto">
                    <Trigger>
                        <button type="button" class="flex items-center gap-1.5 text-xs text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 cursor-pointer transition-colors">
                            <span class="flex items-center justify-center size-6 rounded-lg border border-dashed border-neutral-300 dark:border-neutral-500">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
                                </svg>
                            </span>
                            @L["SongEditor.InsertPart"]
                        </button>
                    </Trigger>
                    <Menu>
                        @foreach (var part in Song.Parts)
                        {
                            var p = part;
                            <button type="button"
                                    @onclick="() => AppendToArrangement(arr.Id, p.Id)"
                                    class="w-full flex items-center px-3 py-1.5 text-sm text-left cursor-pointer hover:bg-neutral-100 dark:hover:bg-neutral-600">
                                @if (p.LabelColor is not null)
                                {
                                    <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold text-white" style="background-color: @p.LabelColor;">@(p.Label ?? TruncateContent(p.Content))</span>
                                }
                                else
                                {
                                    <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold bg-neutral-400 text-white">@(p.Label ?? TruncateContent(p.Content))</span>
                                }
                            </button>
                        }
                    </Menu>
                </Dropdown>
                <AppButton Variant="ButtonVariant.DangerIcon" OnClick="() => RequestDeleteArrangement(arr.Id)"
                           Class="p-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                    </svg>
                </AppButton>
            </div>
        </div>
    }

    @if (Song.Arrangements.Count < AppConstraints.MaxArrangementsPerSong)
    {
        <AppButton Variant="ButtonVariant.Secondary" OnClick="CreateArrangement" Class="flex items-center gap-1.5 self-start">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
            </svg>
            @L["SongEditor.CreateArrangement"]
        </AppButton>
    }
}
</div>

@if (deleteConfirmArrangementId is not null)
{
    <ConfirmDeleteDialog Message="@(new MarkupString(L["SongEditor.ConfirmDeleteArrangement"]))"
                         IsDeleting="isDeleting"
                         OnConfirm="ExecuteDeleteArrangement"
                         OnClose="CancelDeleteArrangement"/>
}

@code {
    [Parameter, EditorRequired] public Song Song { get; set; } = null!;
    [Parameter] public EventCallback OnArrangementChanged { get; set; }

    private string? deleteConfirmArrangementId;
    private bool isDeleting;
    private DotNetObjectReference<SongArrangementEditor>? dotNetRef;
    private readonly HashSet<string> initializedSortables = [];
    private readonly Debouncer nameDebounce = new();
    private readonly Dictionary<string, string> pendingNames = new();

    private static string TruncateContent(string content)
    {
        var firstLine = content.Split('\n')[0];
        return firstLine.Length > 20 ? firstLine[..20] + "..." : firstLine;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        foreach (var arr in Song.Arrangements)
        {
            var elementId = $"arrangement-chips-{arr.Id}";
            if (!initializedSortables.Contains(arr.Id))
            {
                dotNetRef ??= DotNetObjectReference.Create(this);
                await JsRuntime.InvokeVoidAsync("initArrangementSortable", elementId, dotNetRef, arr.Id);
                initializedSortables.Add(arr.Id);
            }
        }

        // Clean up sortables for removed arrangements
        var currentIds = Song.Arrangements.Select(a => a.Id).ToHashSet();
        foreach (var id in initializedSortables.Where(id => !currentIds.Contains(id)).ToList())
        {
            await JsRuntime.InvokeVoidAsync("destroySortableList", $"arrangement-chips-{id}");
            initializedSortables.Remove(id);
        }
    }

    [JSInvokable]
    public async Task OnArrangementReordered(string arrangementId, int oldIndex, int newIndex)
    {
        var arrangement = Song.Arrangements.FirstOrDefault(a => a.Id == arrangementId);
        if (arrangement is null) return;

        var partIds = arrangement.PartIds.ToList();
        if (oldIndex < 0 || oldIndex >= partIds.Count || newIndex < 0 || newIndex >= partIds.Count) return;

        var item = partIds[oldIndex];
        partIds.RemoveAt(oldIndex);
        partIds.Insert(newIndex, item);

        await OnArrangementChanged.InvokeAsync(new ArrangementAction(ArrangementActionType.Update, arrangementId, arrangement.Name, partIds));
        await InvokeAsync(StateHasChanged);
    }

    private Task CreateArrangement()
    {
        var partIds = Song.Parts.Select(p => p.Id).ToList();
        return OnArrangementChanged.InvokeAsync(new ArrangementAction(ArrangementActionType.Create, null, null, partIds));
    }

    private string GetEditName(string arrangementId, string? serverName)
    {
        return pendingNames.TryGetValue(arrangementId, out var pending) ? pending : serverName ?? "";
    }

    private void HandleNameChanged(string arrangementId, string name)
    {
        pendingNames[arrangementId] = name;
        nameDebounce.Run(SavePendingNames);
    }

    private async Task SavePendingNames()
    {
        foreach (var (arrangementId, name) in pendingNames)
        {
            var arrangement = Song.Arrangements.FirstOrDefault(a => a.Id == arrangementId);
            if (arrangement is null) continue;
            await OnArrangementChanged.InvokeAsync(new ArrangementAction(ArrangementActionType.Update, arrangementId, string.IsNullOrWhiteSpace(name) ? null : name.Trim(), arrangement.PartIds.ToList()));
        }
        pendingNames.Clear();
    }

    private void RemoveFromArrangement(string arrangementId, int index)
    {
        var arrangement = Song.Arrangements.FirstOrDefault(a => a.Id == arrangementId);
        if (arrangement is null) return;
        var partIds = arrangement.PartIds.ToList();
        partIds.RemoveAt(index);
        OnArrangementChanged.InvokeAsync(new ArrangementAction(ArrangementActionType.Update, arrangementId, arrangement.Name, partIds));
    }

    private void AppendToArrangement(string arrangementId, string partId)
    {
        var arrangement = Song.Arrangements.FirstOrDefault(a => a.Id == arrangementId);
        if (arrangement is null) return;
        var partIds = arrangement.PartIds.ToList();
        partIds.Add(partId);
        OnArrangementChanged.InvokeAsync(new ArrangementAction(ArrangementActionType.Update, arrangementId, arrangement.Name, partIds));
    }

    private void RequestDeleteArrangement(string arrangementId)
    {
        deleteConfirmArrangementId = arrangementId;
    }

    private void CancelDeleteArrangement()
    {
        deleteConfirmArrangementId = null;
    }

    private async Task ExecuteDeleteArrangement()
    {
        if (isDeleting || deleteConfirmArrangementId is null) return;
        isDeleting = true;
        try
        {
            var id = deleteConfirmArrangementId;
            deleteConfirmArrangementId = null;
            await OnArrangementChanged.InvokeAsync(new ArrangementAction(ArrangementActionType.Delete, id, null, []));
        }
        finally
        {
            isDeleting = false;
        }
    }

    public void Dispose()
    {
        nameDebounce.Dispose();
        foreach (var id in initializedSortables)
        {
            _ = JsRuntime.InvokeVoidAsync("destroySortableList", $"arrangement-chips-{id}");
        }
        dotNetRef?.Dispose();
    }

    public enum ArrangementActionType { Create, Update, Delete }
    public record ArrangementAction(ArrangementActionType Type, string? ArrangementId, string? Name, List<string> PartIds);
}
