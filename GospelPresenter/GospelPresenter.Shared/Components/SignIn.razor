@using GospelPresenter.Shared.Services
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation
@inject IServiceProvider Services

@if (deviceSignIn is not null)
{
    @* The device app (MAUI): one button that runs the system-browser sign-in flow. *@
    <div class="flex flex-col p-3 w-full sm:w-140 items-center gap-3">
        <AppButton OnClick="SignInOnDeviceAsync" Loading="signingIn" Disabled="signingIn" Filled
                   Class="w-64 px-6 py-3 rounded-full text-lg flex items-center justify-center gap-2">
            @L["SignIn.Device"]
        </AppButton>
        @if (deviceSignInFailed)
        {
            <div class="text-sm text-red-500">@L["SignIn.DeviceFailed"]</div>
        }
    </div>
}
else
{
<div class="flex flex-col p-3 w-full sm:w-140 items-center gap-3">
    @{ var providers = authProviders!.EnabledProviders; }

    @foreach (var provider in providers.Take(1))
    {
        <a href="@SignInUrl(provider.Id)" class="@ButtonClass(provider.Id)">
            @if (provider.Id == "google")
            {
                <svg class="w-5 h-5" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
            }
            @L["SignIn.Provider", provider.DisplayName]
        </a>
    }

    @if (providers.Count > 1)
    {
        @if (showMore)
        {
            @foreach (var provider in providers.Skip(1))
            {
                <a href="@SignInUrl(provider.Id)" class="@ButtonClass(provider.Id)">
                    @if (provider.Id == "google")
                    {
                        <svg class="w-5 h-5" viewBox="0 0 24 24">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        </svg>
                    }
                    @L["SignIn.Provider", provider.DisplayName]
                </a>
            }
        }
        else
        {
            <button class="text-sm text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 cursor-pointer"
                    @onclick="() => showMore = true">
                @L["SignIn.MoreOptions"]
            </button>
        }
    }
</div>
}

@code {
    private bool showMore;
    private bool signingIn;
    private bool deviceSignInFailed;
    private IDeviceSignIn? deviceSignIn;
    private IAuthProviderService? authProviders;

    protected override void OnInitialized()
    {
        // Only one of these exists per host: the MAUI app registers IDeviceSignIn, the web app
        // registers IAuthProviderService. Resolved by hand so neither host needs the other's.
        deviceSignIn = (IDeviceSignIn?)Services.GetService(typeof(IDeviceSignIn));
        authProviders = (IAuthProviderService?)Services.GetService(typeof(IAuthProviderService));
    }

    private async Task SignInOnDeviceAsync()
    {
        signingIn = true;
        deviceSignInFailed = false;
        try
        {
            var success = await deviceSignIn!.SignInAsync();
            deviceSignInFailed = !success;
            // On success the auth state change re-renders the router away from the login page.
        }
        catch (Exception)
        {
            deviceSignInFailed = true;
        }
        finally
        {
            signingIn = false;
        }
    }

    private string SignInUrl(string providerId)
    {
        var uri = new Uri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        var url = $"/signin?provider={providerId}";
        if (query.TryGetValue("ReturnUrl", out var returnUrl) && !string.IsNullOrEmpty(returnUrl))
            url += $"&returnUrl={Uri.EscapeDataString(returnUrl!)}";
        return url;
    }

    private static string ButtonClass(string providerId) => providerId switch
    {
        "google" => "flex items-center justify-center gap-2 w-64 px-6 py-3 rounded-full bg-white text-neutral-700 text-lg cursor-pointer hover:bg-neutral-100 border border-neutral-300",
        _ => "flex items-center justify-center gap-2 w-64 px-6 py-3 rounded-full bg-sky-500 text-white text-lg cursor-pointer hover:bg-sky-600",
    };
}
