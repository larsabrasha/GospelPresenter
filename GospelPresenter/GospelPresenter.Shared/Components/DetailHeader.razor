<div class="relative flex items-center justify-center min-h-10 @Class">
    @if (HasBack)
    {
        <BackButton Href="@BackHref" OnClick="OnBack" Class="absolute left-0"/>
    }

    @if (Title is not null)
    {
        <div class="text-xl font-bold dark:text-neutral-100 truncate max-w-[60%]">
            @Title
        </div>
    }

    <AutoSaveIndicator @ref="saveIndicator" Class="absolute right-0"/>
</div>

@code {
    [Parameter] public string? BackHref { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Class { get; set; }

    private AutoSaveIndicator? saveIndicator;

    private bool HasBack => OnBack.HasDelegate || BackHref is not null;

    public void ShowSaved() => saveIndicator?.Show();
}
