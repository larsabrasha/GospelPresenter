@inject NavigationManager NavigationManager

<div class="relative flex items-center justify-center min-h-10 @Class">
    @if (HasBack)
    {
        <AppButton Variant="ButtonVariant.Cancel"
                   Class="absolute left-0 flex items-center gap-2"
                   OnClick="HandleBack">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
            </svg>
            @L["Common.Back"]
        </AppButton>
    }

    @if (Title is not null)
    {
        <div class="text-xl font-bold dark:text-neutral-100 truncate max-w-[60%]">
            @Title
        </div>
    }

    <AutoSaveIndicator @ref="saveIndicator" Class="absolute right-0"/>
</div>

@code {
    [Parameter] public string? BackHref { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Class { get; set; }

    private AutoSaveIndicator? saveIndicator;

    private bool HasBack => OnBack.HasDelegate || BackHref is not null;

    public void ShowSaved() => saveIndicator?.Show();

    private async Task HandleBack()
    {
        if (OnBack.HasDelegate)
            await OnBack.InvokeAsync();
        else if (BackHref is not null)
            NavigationManager.NavigateTo(BackHref);
    }
}
