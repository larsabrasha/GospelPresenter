@* Renders a localized string whose {0} placeholder is filled with a user-authored value,
   emphasized. The value is rendered as text so the framework HTML-encodes it — keeping the
   markup here instead of inside the translation is what makes that possible, and it keeps
   .resx files free of markup. *@

@{
    var segments = L[Key].Value.Split("{0}");
}
@segments[0]<strong>@Value</strong>@(segments.Length > 1 ? string.Concat(segments.Skip(1)) : "")

@code {
    [Parameter] public required string Key { get; set; }
    [Parameter] public string? Value { get; set; }
}
