@using GospelPresenter.Shared.Services

@inject ToastService ToastService
@inject IJSRuntime JsRuntime

@implements IDisposable

<div @ref="popoverRef"
     popover="manual"
     class="toast-popover">
    @if (current is not null)
    {
        <div class="@(current.Removing ? "toast-item-out" : "toast-item") flex items-center gap-2 px-4 py-3 rounded-xl shadow-lg bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white ring-1 ring-neutral-200 dark:ring-neutral-700 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5 shrink-0 text-green-500 dark:text-green-400">
                <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"/>
            </svg>
            <span>@current.Message</span>
        </div>
    }
</div>

@code {
    private ElementReference popoverRef;
    private ToastItem? current;
    private CancellationTokenSource? dismissCts;
    private bool popoverVisible;
    private int showVersion;

    protected override void OnInitialized()
    {
        ToastService.OnShow += HandleShow;
    }

    private async void HandleShow(string message)
    {
        var version = ++showVersion;
        try
        {
            dismissCts?.Cancel();

            if (current is not null)
            {
                current.Removing = true;
                await InvokeAsync(StateHasChanged);
                if (showVersion != version) return;
                await Task.Delay(200);
                if (showVersion != version) return;
            }

            current = new ToastItem { Message = message };
            await InvokeAsync(StateHasChanged);

            if (!popoverVisible)
            {
                await JsRuntime.InvokeVoidAsync("showPopoverElement", popoverRef);
                popoverVisible = true;
            }

            dismissCts = new CancellationTokenSource();
            _ = DismissAfterDelay(current, dismissCts.Token);
        }
        catch (Exception)
        {
            // Silently handle errors during dispose/circuit disconnect
        }
    }

    private async Task DismissAfterDelay(ToastItem item, CancellationToken token)
    {
        try
        {
            await Task.Delay(3000, token);
            item.Removing = true;
            await InvokeAsync(StateHasChanged);

            await Task.Delay(200, token);
            if (current == item)
            {
                current = null;
                if (popoverVisible)
                {
                    await JsRuntime.InvokeVoidAsync("hidePopoverElement", popoverRef);
                    popoverVisible = false;
                }
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    public void Dispose()
    {
        ToastService.OnShow -= HandleShow;
        dismissCts?.Cancel();
    }

    private class ToastItem
    {
        public string Message { get; init; } = "";
        public bool Removing { get; set; }
    }
}
