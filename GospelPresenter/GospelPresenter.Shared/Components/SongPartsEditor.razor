@using GospelPresenter.Shared.State

@for (var i = 0; i < Parts.Count; i++)
{
    var index = i;
    var part = Parts[i];
    <div class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 p-4 space-y-3">
        <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-1">
                <button class="p-1.5 rounded-lg text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-600 disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
                        disabled="@(index == 0)"
                        @onclick="() => OnMoveUp.InvokeAsync(index)">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"/>
                    </svg>
                </button>
                <button class="p-1.5 rounded-lg text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-600 disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
                        disabled="@(index == Parts.Count - 1)"
                        @onclick="() => OnMoveDown.InvokeAsync(index)">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
                    </svg>
                </button>
            </div>
            <input type="text"
                   value="@part.Label"
                   placeholder="@L["SongParts.LabelPlaceholder"]"
                   @onchange="(e) => OnLabelChanged.InvokeAsync(new PartLabelChange(index, e.Value?.ToString()))"
                   class="flex-1 px-3 py-2 rounded-lg border border-neutral-300 dark:border-neutral-500 dark:bg-neutral-600 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500"/>
            @if (deleteConfirmIndex == index)
            {
                <button class="px-2.5 py-1 rounded-lg text-xs bg-red-500 text-white hover:bg-red-600 cursor-pointer"
                        @onclick="() => ConfirmDelete(index)">
                    @L["SongParts.DeleteConfirm"]
                </button>
                <button class="p-1.5 rounded-lg text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-600 cursor-pointer"
                        @onclick="CancelDelete">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                    </svg>
                </button>
            }
            else
            {
                <button class="p-1.5 rounded-lg text-red-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-900/30 cursor-pointer"
                        @onclick="() => RequestDelete(index)">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                    </svg>
                </button>
            }
        </div>
        <textarea value="@part.Content"
                  @onchange="(e) => OnContentChanged.InvokeAsync(new PartContentChange(index, e.Value?.ToString() ?? string.Empty))"
                  rows="4"
                  placeholder="@L["SongParts.TextPlaceholder"]"
                  class="w-full px-3 py-2 rounded-lg border border-neutral-300 dark:border-neutral-500 dark:bg-neutral-600 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 resize-y"></textarea>
    </div>
}

<button class="px-4 py-2.5 rounded-full text-sm text-sky-600 dark:text-sky-400 cursor-pointer hover:bg-sky-50 dark:hover:bg-sky-900/30 flex items-center gap-1.5 self-start"
        @onclick="() => OnAdd.InvokeAsync()">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
    </svg>
    @L["SongParts.AddPart"]
</button>

@code {
    [Parameter, EditorRequired] public IList<SongPart> Parts { get; set; } = [];
    [Parameter] public EventCallback<int> OnMoveUp { get; set; }
    [Parameter] public EventCallback<int> OnMoveDown { get; set; }
    [Parameter] public EventCallback<PartLabelChange> OnLabelChanged { get; set; }
    [Parameter] public EventCallback<PartContentChange> OnContentChanged { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public EventCallback OnAdd { get; set; }

    private int? deleteConfirmIndex;

    private void RequestDelete(int index) => deleteConfirmIndex = index;
    private void CancelDelete() => deleteConfirmIndex = null;

    private async Task ConfirmDelete(int index)
    {
        deleteConfirmIndex = null;
        await OnDelete.InvokeAsync(index);
    }

    public record PartLabelChange(int Index, string? Label);
    public record PartContentChange(int Index, string Content);
}
