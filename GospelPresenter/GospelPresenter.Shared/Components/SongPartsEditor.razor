@using GospelPresenter.Shared.Models
@using GospelPresenter.Shared.State

@for (var i = 0; i < Parts.Count; i++)
{
    var index = i;
    var part = Parts[i];
    var selectedLabel = !string.IsNullOrEmpty(part.LabelId) ? AvailableLabels.FirstOrDefault(l => l.Id == part.LabelId) : null;
    <div @key="index" id="song-part-@index" class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 p-4 space-y-3">
        <div class="flex items-center gap-2">
            <Dropdown Class="flex-1 max-w-[50%]" MenuClass="left-0 w-full max-h-60 overflow-y-auto">
                <Trigger>
                    <button type="button"
                            class="w-full flex items-center gap-2 rounded-lg border border-neutral-300 dark:border-neutral-600
                                   bg-white dark:bg-neutral-700 text-neutral-900 dark:text-neutral-100
                                   px-3 py-2.5 text-sm text-left cursor-pointer
                                   focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none">
                        @if (selectedLabel is not null)
                        {
                            <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold text-white shrink-0" style="background-color: @selectedLabel.Color;">@selectedLabel.Text</span>
                            <span class="flex-1"></span>
                        }
                        else
                        {
                            <span class="flex-1 truncate text-neutral-400">@L["SongParts.LabelNone"]</span>
                        }
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 text-neutral-400 shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
                        </svg>
                    </button>
                </Trigger>
                <Menu>
                    <button type="button"
                            @onclick="() => SelectLabel(index, null)"
                            class="w-full flex items-center px-3 py-2 text-sm text-left cursor-pointer
                                   text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-600">
                        @L["SongParts.LabelNone"]
                    </button>
                    @foreach (var label in AvailableLabels)
                    {
                        var lbl = label;
                        var isSelected = lbl.Id == part.LabelId;
                        <button type="button"
                                @onclick="() => SelectLabel(index, lbl.Id)"
                                class="@OptionClass(isSelected) w-full flex items-center px-3 py-1.5 text-left cursor-pointer">
                            <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold text-white" style="background-color: @lbl.Color;">@lbl.Text</span>
                        </button>
                    }
                </Menu>
            </Dropdown>
            <div class="flex-1"></div>
            <div class="flex items-center gap-1">
                <AppButton Variant="ButtonVariant.Icon" Disabled="@(index == 0)"
                           OnClick="() => OnMoveUp.InvokeAsync(index)"
                           Class="p-1.5 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"/>
                    </svg>
                </AppButton>
                <AppButton Variant="ButtonVariant.Icon" Disabled="@(index == Parts.Count - 1)"
                           OnClick="() => OnMoveDown.InvokeAsync(index)"
                           Class="p-1.5 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
                    </svg>
                </AppButton>
            </div>
        </div>
        <FloatingTextarea Id="@($"part-content-{index}")"
                          Value="@part.Content" MaxLength="AppConstraints.SongPartContentMaxLength"
                          OnInput="(e) => OnContentChanged.InvokeAsync(new PartContentChange(index, e.Value?.ToString() ?? string.Empty))"
                          Rows="8" Label="" />
        <div class="flex justify-end">
            <AppButton Variant="ButtonVariant.Icon" OnClick="() => RequestDelete(index)"
                       Class="p-1.5 text-red-400 hover:text-red-600">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                </svg>
            </AppButton>
        </div>
    </div>
}

<AppButton Variant="ButtonVariant.Secondary" OnClick="() => OnAdd.InvokeAsync()" Class="flex items-center gap-1.5 self-start">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
    </svg>
    @L["SongParts.AddPart"]
</AppButton>

@if (deleteConfirmMessage is not null)
{
    <ConfirmDeleteDialog Message="deleteConfirmMessage.Value"
                         IsDeleting="isDeleting"
                         OnConfirm="ExecuteDelete"
                         OnClose="CancelDelete"/>
}

@code {
    [Parameter, EditorRequired] public IList<SongPart> Parts { get; set; } = [];
    [Parameter] public IReadOnlyList<DbSongPartLabel> AvailableLabels { get; set; } = [];
    [Parameter] public EventCallback<int> OnMoveUp { get; set; }
    [Parameter] public EventCallback<int> OnMoveDown { get; set; }
    [Parameter] public EventCallback<PartLabelChange> OnLabelChanged { get; set; }
    [Parameter] public EventCallback<PartContentChange> OnContentChanged { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public EventCallback OnAdd { get; set; }

    private int? deleteConfirmIndex;
    private MarkupString? deleteConfirmMessage;
    private bool isDeleting;

    private Task SelectLabel(int index, string? labelId)
    {
        return OnLabelChanged.InvokeAsync(new PartLabelChange(index, labelId));
    }

    private static string OptionClass(bool isSelected) =>
        isSelected
            ? "bg-sky-50 dark:bg-sky-900/30 hover:bg-sky-100 dark:hover:bg-sky-900/50"
            : "hover:bg-neutral-100 dark:hover:bg-neutral-600";

    private string GetCurrentLabel(int index)
    {
        return Parts[index].Label ?? L["SongParts.LabelNone"];
    }

    private void RequestDelete(int index)
    {
        deleteConfirmIndex = index;
        var label = GetCurrentLabel(index);
        deleteConfirmMessage = new MarkupString(L["SongDetail.ConfirmDeletePart", System.Net.WebUtility.HtmlEncode(label)]);
    }

    private void CancelDelete()
    {
        deleteConfirmIndex = null;
        deleteConfirmMessage = null;
    }

    private async Task ExecuteDelete()
    {
        if (isDeleting || deleteConfirmIndex is null) return;
        isDeleting = true;
        try
        {
            var index = deleteConfirmIndex.Value;
            deleteConfirmIndex = null;
            deleteConfirmMessage = null;
            await OnDelete.InvokeAsync(index);
        }
        finally
        {
            isDeleting = false;
        }
    }

    public record PartLabelChange(int Index, string? LabelId);
    public record PartContentChange(int Index, string Content);
}
