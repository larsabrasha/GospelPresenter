@using GospelPresenter.Shared.State

@for (var i = 0; i < Parts.Count; i++)
{
    var index = i;
    var part = Parts[i];
    <div @key="index" id="song-part-@index" class="bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 rounded-xl shadow-sm border-t border-white dark:border-neutral-700 p-4 space-y-3">
        <div class="flex items-center gap-2">
            <FloatingInput Id="@($"part-label-{index}")" Label="@L["SongParts.LabelPlaceholder"]"
                           Class="flex-1" MaxLength="AppConstraints.SongPartLabelMaxLength"
                           Value="@part.Label" OnInput="(e) => HandleLabelInput(index, e.Value?.ToString())"/>
            <div class="flex items-center gap-1">
                <AppButton Variant="ButtonVariant.Icon" Disabled="@(index == 0)"
                           OnClick="() => OnMoveUp.InvokeAsync(index)"
                           Class="p-1.5 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"/>
                    </svg>
                </AppButton>
                <AppButton Variant="ButtonVariant.Icon" Disabled="@(index == Parts.Count - 1)"
                           OnClick="() => OnMoveDown.InvokeAsync(index)"
                           Class="p-1.5 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
                    </svg>
                </AppButton>
            </div>
        </div>
        <FloatingTextarea Id="@($"part-content-{index}")" Label="@L["SongParts.TextPlaceholder"]"
                          Value="@part.Content" MaxLength="AppConstraints.SongPartContentMaxLength"
                          OnInput="(e) => OnContentChanged.InvokeAsync(new PartContentChange(index, e.Value?.ToString() ?? string.Empty))"
                          Rows="8"/>
        <div class="flex justify-end">
            <AppButton Variant="ButtonVariant.Icon" OnClick="() => RequestDelete(index)"
                       Class="p-1.5 text-red-400 hover:text-red-600">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                </svg>
            </AppButton>
        </div>
    </div>
}

<AppButton Variant="ButtonVariant.Secondary" OnClick="() => OnAdd.InvokeAsync()" Class="flex items-center gap-1.5 self-start">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
    </svg>
    @L["SongParts.AddPart"]
</AppButton>

@if (deleteConfirmMessage is not null)
{
    <ConfirmDeleteDialog Message="deleteConfirmMessage.Value"
                         IsDeleting="isDeleting"
                         OnConfirm="ExecuteDelete"
                         OnClose="CancelDelete"/>
}

@code {
    [Parameter, EditorRequired] public IList<SongPart> Parts { get; set; } = [];
    [Parameter] public EventCallback<int> OnMoveUp { get; set; }
    [Parameter] public EventCallback<int> OnMoveDown { get; set; }
    [Parameter] public EventCallback<PartLabelChange> OnLabelChanged { get; set; }
    [Parameter] public EventCallback<PartContentChange> OnContentChanged { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public EventCallback OnAdd { get; set; }

    private int? deleteConfirmIndex;
    private MarkupString? deleteConfirmMessage;
    private bool isDeleting;
    private readonly Dictionary<int, string?> localLabels = new();

    private Task HandleLabelInput(int index, string? value)
    {
        localLabels[index] = value;
        return OnLabelChanged.InvokeAsync(new PartLabelChange(index, value));
    }

    private string GetCurrentLabel(int index)
    {
        if (localLabels.TryGetValue(index, out var local) && !string.IsNullOrWhiteSpace(local))
            return local;
        return Parts[index].Label ?? L["SongParts.LabelPlaceholder"];
    }

    private void RequestDelete(int index)
    {
        deleteConfirmIndex = index;
        var label = GetCurrentLabel(index);
        deleteConfirmMessage = new MarkupString(L["SongDetail.ConfirmDeletePart", System.Net.WebUtility.HtmlEncode(label)]);
    }

    private void CancelDelete()
    {
        deleteConfirmIndex = null;
        deleteConfirmMessage = null;
    }

    private async Task ExecuteDelete()
    {
        if (isDeleting || deleteConfirmIndex is null) return;
        isDeleting = true;
        try
        {
            var index = deleteConfirmIndex.Value;
            deleteConfirmIndex = null;
            deleteConfirmMessage = null;
            await OnDelete.InvokeAsync(index);
        }
        finally
        {
            isDeleting = false;
        }
    }

    public record PartLabelChange(int Index, string? Label);
    public record PartContentChange(int Index, string Content);
}
