@using System.ComponentModel
@using GospelPresenter.Shared.State

@inject AppState AppState
@inject IJSRuntime JsRuntime

@implements IDisposable

<div class="shrink-0 w-[300px] overflow-hidden flex">
    <div class="p-4 space-y-2 overflow-auto w-full">
        @if (AppState.SelectedProject is null)
        {
            <div class="text-sm text-center text-neutral-500 pt-10">No Project selected</div>
        }
        else
        {
            <button
                class="mb-8 font-bold py-3 flex items-center w-full bg-neutral-50 dark:bg-neutral-700 hover:cursor-pointer hover:bg-neutral-100 dark:hover:bg-neutral-600 p-3 rounded-xl group">
                <div class="grow text-left">@AppState.SelectedProject.Name</div>
                <div class="shrink-0 opacity-40 group-hover:opacity-100">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                         stroke="currentColor" class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M8.25 15 12 18.75 15.75 15m-7.5-6L12 5.25 15.75 9"/>
                    </svg>
                </div>
            </button>

            @foreach (var item in AppState.SelectedProject.Items)
            {
                var itemClass = AppState.SelectedProjectItem?.Id == item.Id ? "bg-sky-500 text-white" : "";
                <button @key="item.Id"
                        class="rounded-3xl flex w-full space-x-5 px-3 py-2 items-center hover:cursor-pointer hover:bg-sky-500 hover:text-white @itemClass"
                        @onclick="() => SelectItemAsync(item)">
                    <div class="size-3">
                        @switch (item.Type)
                        {
                            case ProjectItemType.Song:
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                                     class="size-4">
                                    <path fill-rule="evenodd"
                                          d="M19.952 1.651a.75.75 0 0 1 .298.599V16.303a3 3 0 0 1-2.176 2.884l-1.32.377a2.553 2.553 0 1 1-1.403-4.909l2.311-.66a1.5 1.5 0 0 0 1.088-1.442V6.994l-9 2.572v9.737a3 3 0 0 1-2.176 2.884l-1.32.377a2.553 2.553 0 1 1-1.402-4.909l2.31-.66a1.5 1.5 0 0 0 1.088-1.442V5.25a.75.75 0 0 1 .544-.721l10.5-3a.75.75 0 0 1 .658.122Z"
                                          clip-rule="evenodd"/>
                                </svg>

                                break;
                            case ProjectItemType.BibleText:
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                                     class="size-4">
                                    <path
                                        d="M11.25 4.533A9.707 9.707 0 0 0 6 3a9.735 9.735 0 0 0-3.25.555.75.75 0 0 0-.5.707v14.25a.75.75 0 0 0 1 .707A8.237 8.237 0 0 1 6 18.75c1.995 0 3.823.707 5.25 1.886V4.533ZM12.75 20.636A8.214 8.214 0 0 1 18 18.75c.966 0 1.89.166 2.75.47a.75.75 0 0 0 1-.708V4.262a.75.75 0 0 0-.5-.707A9.735 9.735 0 0 0 18 3a9.707 9.707 0 0 0-5.25 1.533v16.103Z"/>
                                </svg>

                                break;
                            case ProjectItemType.Image:
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                                     class="size-4">
                                    <path fill-rule="evenodd"
                                          d="M1.5 6a2.25 2.25 0 0 1 2.25-2.25h16.5A2.25 2.25 0 0 1 22.5 6v12a2.25 2.25 0 0 1-2.25 2.25H3.75A2.25 2.25 0 0 1 1.5 18V6ZM3 16.06V18c0 .414.336.75.75.75h16.5A.75.75 0 0 0 21 18v-1.94l-2.69-2.689a1.5 1.5 0 0 0-2.12 0l-.88.879.97.97a.75.75 0 1 1-1.06 1.06l-5.16-5.159a1.5 1.5 0 0 0-2.12 0L3 16.061Zm10.125-7.81a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Z"
                                          clip-rule="evenodd"/>
                                </svg>
                                break;
                            default:
                                <span></span>
                                break;
                        }
                    </div>
                    <div class="text-left">@item.Title </div>
                </button>
            }

            @* <button *@
            @*     class="mt-8 text-sm text-center w-full bg-neutral-50 dark:bg-neutral-700 p-3 rounded-xl hover:bg-neutral-100 dark:hover:bg-neutral-600 hover:cursor-pointer"> *@
            @*     + Lägg till *@
            @* </button> *@
        }
    </div>
</div>

@code {

    protected override void OnInitialized()
    {
        AppState.PropertyChanged += OnPropertyChanged;
    }

    public void Dispose()
    {
        AppState.PropertyChanged -= OnPropertyChanged;
    }

    private void OnPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName is
            nameof(AppState.SelectedProject) or
            nameof(AppState.SelectedProjectItem))
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private async Task SelectItemAsync(ProjectItem item)
    {
        AppState.SelectedProjectItem = item;
        AppState.IsMenuVisible = false;

        await JsRuntime.InvokeVoidAsync("scrollElementToTop", "main");
    }

}
