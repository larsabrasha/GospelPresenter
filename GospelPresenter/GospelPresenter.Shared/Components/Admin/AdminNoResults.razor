@* The fourth state. "The search matched nothing" is not "the collection is empty", and conflating
   them tells a user with 200 songs that they have none. Always offers the way back out — today the
   only escape is the x inside the search field, which is easy to miss. *@

<div class="flex flex-col items-start gap-2 px-5 py-4">
    <div class="text-neutral-400 text-sm">@(Message ?? L["Common.NoResults"].Value)</div>
    @if (OnClear.HasDelegate)
    {
        <AppButton Variant="ButtonVariant.Cancel" OnClick="OnClear" Class="!px-0 !py-0 text-sky-600 dark:text-sky-400 hover:bg-transparent hover:underline">
            @L["Common.ClearSearch"]
        </AppButton>
    }
</div>

@code {
    /// <summary>Page-specific wording. Falls back to the shared "No matches" line.</summary>
    [Parameter] public string? Message { get; set; }

    [Parameter] public EventCallback OnClear { get; set; }
}
