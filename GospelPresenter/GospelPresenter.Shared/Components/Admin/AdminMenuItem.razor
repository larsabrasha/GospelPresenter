@* One entry in an AdminRowMenu. Destructive entries render red and last, separated by a rule, so a
   delete is never the item your thumb lands on by accident. *@

<button type="button" @onclick="OnClick" disabled="@Disabled"
        class="@($"w-full flex items-center gap-2 px-3 py-2.5 text-sm cursor-pointer disabled:opacity-50 disabled:cursor-default {Palette}")">
    @if (Icon is not null)
    {
        <span class="shrink-0">@Icon</span>
    }
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Red, and separated from what sits above it.</summary>
    [Parameter] public bool Destructive { get; set; }

    private string Palette => Destructive
        ? "text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/40 border-t border-neutral-200 dark:border-neutral-600"
        : "text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-600";
}
