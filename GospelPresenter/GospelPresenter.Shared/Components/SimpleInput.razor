@{
    var hasIcon = Icon is not null || Type is "date" or "time";
}

@* The pill lives on the wrapper rather than on the input, and the icon sits beside the field
   instead of on top of it. WebKit ignores padding-left on date and time inputs — it lays the
   value out from the field's left edge regardless — so an overlaid icon lands on the text in
   Safari and in the device app's webview, while Chrome looks fine. As flex siblings the two
   cannot overlap in any engine. *@
<div class="@($"flex items-center gap-1.5 h-9 rounded-full bg-neutral-100 dark:bg-neutral-700 text-sm focus-within:ring-2 focus-within:ring-sky-500 {(hasIcon ? "pl-3 pr-4" : "px-4")} {Class}")">
    @if (hasIcon)
    {
        <span class="flex items-center shrink-0 pointer-events-none text-neutral-400 dark:text-neutral-500">
            @if (Icon is not null)
            {
                @Icon
            }
            else if (Type == "date")
            {
                <CalendarSymbol Class="size-4"/>
            }
            else
            {
                <ClockSymbol Class="size-4"/>
            }
        </span>
    }
    <input @ref="inputElement" id="@Id" type="@Type" placeholder="@Placeholder"
           value="@Value"
           maxlength="@MaxLength"
           @oninput="OnInput"
           @onkeydown="OnKeyDown"
           class="@($"min-w-0 bg-transparent dark:scheme-dark text-sm text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:outline-none{(Type is "date" or "time" ? " native-picker-hidden" : "")}")"/>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public object? Value { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnInput { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }

    private ElementReference inputElement;
    public ValueTask FocusAsync() => inputElement.FocusAsync();
}
