<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- The desktop app: ASP.NET Core hosting the shared Blazor components on localhost, wrapped in
         Electron. See adr/0003-desktop-host-on-electron.md for why this replaces the Mac Catalyst
         host, and what it retires from adr/0002.

         The shape is closer to GospelPresenter.Web than to the MAUI app — same components, same
         domain services, same render mode — but pointed at the local SQLite database that
         GospelPresenter.Client maintains, and with the device sign-in rather than cookies. -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>GospelPresenter.Desktop</RootNamespace>
    </PropertyGroup>

    <!-- Which installation this build is: which server it talks to, what it is called, where it
         keeps its data and which URL scheme it answers sign-ins on. The same three names the MAUI
         app uses, and selected the same way, so there is one vocabulary for "which environment" —
         but resolved through Directory.Build.$(Scheme).props and assembly metadata rather than
         DefineConstants, because a desktop app can read a value at startup and an iOS bundle
         cannot. See DesktopBuild.cs, which is the reading end of this. -->
    <PropertyGroup>
        <Scheme Condition=" '$(Scheme)' == '' ">$(SCHEME)</Scheme>
        <!-- Local, for the same reason it is the MAUI default: a bare `dotnet run` should not sign
             in against a real server. CI passes -p:Scheme=GospelPresenterProd. -->
        <Scheme Condition=" '$(Scheme)' == '' ">GospelPresenterLocal</Scheme>
    </PropertyGroup>

    <Target Name="PrintScheme" BeforeTargets="Build">
        <Message Importance="high" Text="Scheme: $(Scheme)"/>
    </Target>

    <!-- Precompile to native code at publish time. Without this, a self-contained build still JITs
         the whole ASP.NET Core, EF Core and Blazor stack on every launch, and all of it sits on the
         path before the window can be created: Kestrel does not listen until the host is built, and
         OnElectronReadyAsync does not run until it listens. R2R trades install size for that.

         Conditioned on a RuntimeIdentifier because ReadyToRun requires one — an unqualified
         `dotnet build` or `dotnet run` would otherwise fail with NETSDK1095 rather than quietly
         ignoring the property, and a bare run is the ordinary way to work on this project. It is
         also why this is here rather than in the release workflow: a local `dotnet publish -r` is
         the only way to reproduce what CI ships, and that is worth having produce the same binary.

         Not paired with PublishTrimmed: trimming and this app's reflection over EF Core models and
         Razor components are a separate investigation, and R2R is the half that pays for itself. -->
    <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
        <PublishReadyToRun>true</PublishReadyToRun>
    </PropertyGroup>

    <!-- What is on screen while the app starts. The Electron host shows this from app.ready, before
         it has even spawned the .NET process, and destroys it when the first BrowserWindow is
         created — so it covers exactly the stretch that was previously a blank screen, and none of
         the stretch after it.

         It does not cover all of startup, and cannot: the host destroys the splash on
         browser-window-created, which fires when Program.cs creates the operator window, not when
         that window has painted. The gap between the two is left as a gap on purpose — closing it
         would mean showing the window immediately over a background colour, and there is no colour
         to pick, because the theme is a localStorage value the host cannot read. See
         OnElectronReadyAsync.

         Not conditioned on scheme: a Local build starts through the same slow path and is where the
         startup work is actually measured. -->
    <PropertyGroup>
        <ElectronSplashScreen>splash.html</ElectronSplashScreen>
    </PropertyGroup>

    <!-- A misspelled scheme would otherwise build: the Import below is conditional on the file
         existing, so the app would come out with no server URL, no callback scheme and the data
         directory of whichever installation it fell back to. Nothing about the running app would
         say which scheme it was meant to be. -->
    <Target Name="ValidateScheme" BeforeTargets="Build;Publish">
        <Error Condition="!Exists('Directory.Build.$(Scheme).props')"
               Code="GP0002"
               Text="Unknown scheme '$(Scheme)': there is no Directory.Build.$(Scheme).props next to this project. Expected GospelPresenterProd, GospelPresenterTest or GospelPresenterLocal." />
    </Target>

    <!-- The app claims a URL scheme from the operating system in two places, and both have to name
         the same one. $(DesktopCallbackScheme) is what the app asks for at runtime through
         setAsDefaultProtocolClient and what it tells the server to answer on; the packaging
         config's protocols: block is what becomes the durable registration — CFBundleURLTypes on
         macOS, registry keys from the NSIS installer on Windows, a .desktop file with
         x-scheme-handler on Linux.

         Disagree, and there is no error anywhere: the browser is handed a URL the OS has no owner
         for, or hands it to a different installation of this app, and the sign-in simply waits out
         its five minutes. So the build reads the config and checks.

         Spaces are stripped before matching so indentation and trailing whitespace cannot fail an
         otherwise correct config, and the '|' terminator is what keeps "- gospelpresenter" from
         matching a config that only declares "- gospelpresenter-test". -->
    <!-- Local is excluded because it has no packaging config of its own and is never packaged
         (GP0003). Left in, this target validated ElectronNET's own default instead —
         Properties/electron-builder.json, the template the package writes on every build, which
         declares no protocols at all — and failed a build that was correct: an unpackaged run
         claims its scheme at runtime, with no bundle to declare it. -->
    <Target Name="ValidateCallbackScheme" BeforeTargets="Build;Publish"
            Condition="'$(ElectronBuilderJson)' != '' AND '$(Scheme)' != 'GospelPresenterLocal'">
        <ReadLinesFromFile File="Properties/$(ElectronBuilderJson)">
            <Output TaskParameter="Lines" ItemName="_PackagingConfigLine" />
        </ReadLinesFromFile>
        <PropertyGroup>
            <_PackagingConfig>@(_PackagingConfigLine, '|')</_PackagingConfig>
            <_PackagingConfig>$(_PackagingConfig.Replace(' ', ''))|</_PackagingConfig>
        </PropertyGroup>
        <Error Condition="!$(_PackagingConfig.Contains('-$(DesktopCallbackScheme)|'))"
               Code="GP0004"
               Text="Properties/$(ElectronBuilderJson) does not declare the scheme '$(DesktopCallbackScheme)' that this build signs in on. Add it to the protocols: block, or the packaged app will never receive its sign-in callback." />
    </Target>

    <!-- Local has no packaging config and is not meant to have one: it is the scheme you run from
         a terminal, its server URL comes from GP_API_BASE_URL, and Electron claims its callback
         scheme at runtime rather than out of a bundle. Publishing it would leave
         ElectronBuilderJson unset and fall through to ElectronNET's own default,
         Properties/electron-builder.json — the template the package writes there on every build,
         which declares a portable exe and a tarball, neither of which electron-updater can update
         and neither of which anything here supports. Refused rather than given a fourth config
         file: nobody wants an installer for this scheme. -->
    <Target Name="RefuseToPackageLocal" BeforeTargets="Publish">
        <Error Condition="'$(Scheme)' == 'GospelPresenterLocal'"
               Code="GP0003"
               Text="The GospelPresenterLocal scheme cannot be packaged. Build and run it instead, or publish with -p:Scheme=GospelPresenterTest or -p:Scheme=GospelPresenterProd." />
    </Target>

    <PropertyGroup>
        <!-- ELECTRON003 insists on Properties/electron-builder.json. Its check reads the path
             literally and never consults ElectronBuilderJson, which each scheme's props file sets,
             so the warning fires at every build for a file the build is configured not to use. Suppressed here rather than
             satisfied: adding an empty .json would be a second, silently ignored config file.
             ElectronNET.MigrationChecks.targets(174) if the check ever learns about the property. -->
        <NoWarn>$(NoWarn);ELECTRON003</NoWarn>

        <!-- The parts of the app's identity that do not depend on which server it talks to.
             ElectronPackageId and Title do, and are set per scheme below — nothing here should be
             read as the whole story about what the packaged app calls itself. -->
        <Company>Gospel Presenter</Company>
        <Description>Presentation software for churches: songs, Bible passages and slides.</Description>
        <ProjectUrl>https://www.gospelpresenter.com</ProjectUrl>
    </PropertyGroup>

    <!-- The server, the identity, the data directory and the callback scheme for this build. Same
         file-naming convention as the MAUI app's schemes, and imported here rather than
         auto-imported so it wins over the PropertyGroup above. -->
    <Import Project="Directory.Build.$(Scheme).props"
            Condition="Exists('Directory.Build.$(Scheme).props')" />

    <ItemGroup>
        <!-- What the app calls itself where a person reads it: the window title bar. $(Title) is
             already the name electron-builder puts in the Dock and the installer, so this carries
             the same value inward rather than letting the two drift. -->
        <AssemblyMetadata Include="ProductName" Value="$(Title)" />

        <!-- Whether to register IAppUpdater, per adr/0002 (19): where a feed exists and nowhere
             else. Derived from which packaging config the scheme selected rather than set beside
             it, because the two would otherwise be separate claims about the same fact — a scheme
             could say it has a feed while its config names no publish provider, and nothing would
             notice until an update silently never arrived. electron-builder.yml is the only config
             with a provider; see the publish: block there. -->
        <AssemblyMetadata Include="HasUpdateFeed" Value="true"
                          Condition="'$(ElectronBuilderJson)' == 'electron-builder.yml'" />
    </ItemGroup>

    <ItemGroup>
        <!-- The app icon, as a 1024px source electron-builder converts per platform. Copied to the
             output rather than referenced in place, because electron-builder runs from the publish
             root and resolves the path in electron-builder.yml relative to it. Without this the
             build says "default Electron icon is used" and ships one.

             $(DesktopIconFile) is set per scheme, and lands in the output under one name so the
             packaging config does not have to know which scheme built it.

             Both icons are generated by scripts/generate-desktop-icons.sh from the MAUI icon
             sources — run it after changing either SVG. They are committed because
             electron-builder needs a PNG at package time, and the geometry is not arbitrary:
             electron-builder scales this file straight into the .icns without applying the macOS
             mask, so the rounded tile and the inset have to be in the source. The script carries
             the measurements and the reasoning. -->
        <Content Include="$(DesktopIconFile)" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- ElectronNET.Core, not ElectronNET.API: the latter is the pre-2024 package line and its
             newest stable release ships only lib/net6.0 with a DLL dated 2024-02-15. The Core line
             is where the project actually lives now — 0.5.2, August 2026, with lib/net10.0. -->
        <PackageReference Include="ElectronNET.Core" Version="0.5.2" />
        <PackageReference Include="ElectronNET.Core.AspNet" Version="0.5.2" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Serilog" Version="4.3.1" />
        <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
        <!-- Pinned above what EF Core's SQLite provider resolves transitively: GHSA-2m69-gcr7-jv3q. -->
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
        <!-- DPAPI for the device token on Windows. It compiles everywhere and throws off Windows,
             which is why DesktopSecureTokenStore only reaches it behind an OS check. -->
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GospelPresenter.Shared\GospelPresenter.Shared.csproj" />
        <ProjectReference Include="..\GospelPresenter.Client\GospelPresenter.Client.csproj" />
    </ItemGroup>

    <!-- Electron is downloaded by npm and unpacked by the electron package's own install script.
         That script can report success and unpack nothing — seen on Node 26, where the zip lands in
         ~/.cache/electron intact and dist/ is left empty. Nothing notices until the app starts and
         fails with "No such file or directory" naming a binary, which reads like a broken path
         rather than a download that never came out of its archive. Fail here instead, where the
         cause is still in view. -->
    <Target Name="VerifyElectronUnpacked" AfterTargets="Build">
        <PropertyGroup>
            <!-- ElectronConfigureApp is skipped on an up-to-date build, and so is anything hung off
                 it, but the unpacking can have failed on the build that did run. Hook Build and
                 look at what is on disk instead. -->
            <_ElectronPackageDir Condition="'$(_ElectronPackageDir)' == ''">$(ElectronOutDir)node_modules/electron/</_ElectronPackageDir>
            <_ElectronPackageDir Condition="'$(ElectronOutDir)' == ''">$(OutDir).electron/node_modules/electron/</_ElectronPackageDir>
        </PropertyGroup>
        <ItemGroup Condition="Exists('$(_ElectronPackageDir)')">
            <_ElectronDistFiles Include="$(_ElectronPackageDir)dist/**/*" />
        </ItemGroup>
        <!-- path.txt is written by install.js once it has unpacked, and names the binary for the
             platform; index.js reads it to find what to launch. A failed unpack leaves neither it
             nor a populated dist — a stray file or two can survive, hence the count rather than a
             plain emptiness check. -->
        <Error Condition="Exists('$(_ElectronPackageDir)') AND !Exists('$(_ElectronPackageDir)path.txt') AND @(_ElectronDistFiles->Count()) &lt; 10"
               Code="GP0001"
               Text="Electron was downloaded but never unpacked: $(_ElectronPackageDir) has no path.txt and its dist holds only @(_ElectronDistFiles->Count()) file(s). The zip in ~/.cache/electron is usually intact — see the README (Troubleshooting) for the commands that unpack it by hand." />
    </Target>

</Project>
