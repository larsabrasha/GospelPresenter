<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- The desktop app: ASP.NET Core hosting the shared Blazor components on localhost, wrapped in
         Electron. See adr/0003-desktop-host-on-electron.md for why this replaces the Mac Catalyst
         host, and what it retires from adr/0002.

         The shape is closer to GospelPresenter.Web than to the MAUI app — same components, same
         domain services, same render mode — but pointed at the local SQLite database that
         GospelPresenter.Client maintains, and with the device sign-in rather than cookies. -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>GospelPresenter.Desktop</RootNamespace>
        <!-- YAML rather than the template's JSON so the packaging decisions can be commented where
             they are made — electron-builder validates strictly and rejects a "//" key. -->
        <ElectronBuilderJson>electron-builder.yml</ElectronBuilderJson>

        <!-- ELECTRON003 insists on Properties/electron-builder.json. Its check reads the path
             literally and never consults ElectronBuilderJson above, so the warning fires at every
             build for a file the build is configured not to use. Suppressed here rather than
             satisfied: adding an empty .json would be a second, silently ignored config file.
             ElectronNET.MigrationChecks.targets(174) if the check ever learns about the property. -->
        <NoWarn>$(NoWarn);ELECTRON003</NoWarn>

        <!-- Who the packaged app says it is. Left at the ElectronNET defaults, all of this was
             derived from the project file name: the bundle identifier was "gospelpresenter-desktop"
             and the app called itself "GospelPresenter.Desktop" in the Dock, the menu bar and the
             installer.

             The identifier is the one that matters beyond appearances. Apple requires a reverse-DNS
             bundle identifier, and it is what a Developer ID certificate is issued against, what
             notarization records, and what macOS keys the gospelpresenter:// registration on — so
             the value below has to be settled before the certificate is bought, not after.
             com.gospelpresenter.app per adr/0002 (13); the Catalyst app that held it is retired. -->
        <ElectronPackageId>com.gospelpresenter.app</ElectronPackageId>
        <Title>Gospel Presenter</Title>
        <Company>Gospel Presenter</Company>
        <Description>Presentation software for churches: songs, Bible passages and slides.</Description>
        <ProjectUrl>https://www.gospelpresenter.com</ProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <!-- The app icon, as a 1024px source electron-builder converts per platform. Copied to the
             output rather than referenced in place, because electron-builder runs from the publish
             root and resolves the path in electron-builder.yml relative to it. Without this the
             build says "default Electron icon is used" and ships one. -->
        <Content Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- ElectronNET.Core, not ElectronNET.API: the latter is the pre-2024 package line and its
             newest stable release ships only lib/net6.0 with a DLL dated 2024-02-15. The Core line
             is where the project actually lives now — 0.5.2, August 2026, with lib/net10.0. -->
        <PackageReference Include="ElectronNET.Core" Version="0.5.2" />
        <PackageReference Include="ElectronNET.Core.AspNet" Version="0.5.2" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Serilog" Version="4.3.1" />
        <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
        <!-- Pinned above what EF Core's SQLite provider resolves transitively: GHSA-2m69-gcr7-jv3q. -->
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
        <!-- DPAPI for the device token on Windows. It compiles everywhere and throws off Windows,
             which is why DesktopSecureTokenStore only reaches it behind an OS check. -->
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GospelPresenter.Shared\GospelPresenter.Shared.csproj" />
        <ProjectReference Include="..\GospelPresenter.Client\GospelPresenter.Client.csproj" />
    </ItemGroup>

    <!-- Electron is downloaded by npm and unpacked by the electron package's own install script.
         That script can report success and unpack nothing — seen on Node 26, where the zip lands in
         ~/.cache/electron intact and dist/ is left empty. Nothing notices until the app starts and
         fails with "No such file or directory" naming a binary, which reads like a broken path
         rather than a download that never came out of its archive. Fail here instead, where the
         cause is still in view. -->
    <Target Name="VerifyElectronUnpacked" AfterTargets="Build">
        <PropertyGroup>
            <!-- ElectronConfigureApp is skipped on an up-to-date build, and so is anything hung off
                 it, but the unpacking can have failed on the build that did run. Hook Build and
                 look at what is on disk instead. -->
            <_ElectronPackageDir Condition="'$(_ElectronPackageDir)' == ''">$(ElectronOutDir)node_modules/electron/</_ElectronPackageDir>
            <_ElectronPackageDir Condition="'$(ElectronOutDir)' == ''">$(OutDir).electron/node_modules/electron/</_ElectronPackageDir>
        </PropertyGroup>
        <ItemGroup Condition="Exists('$(_ElectronPackageDir)')">
            <_ElectronDistFiles Include="$(_ElectronPackageDir)dist/**/*" />
        </ItemGroup>
        <!-- path.txt is written by install.js once it has unpacked, and names the binary for the
             platform; index.js reads it to find what to launch. A failed unpack leaves neither it
             nor a populated dist — a stray file or two can survive, hence the count rather than a
             plain emptiness check. -->
        <Error Condition="Exists('$(_ElectronPackageDir)') AND !Exists('$(_ElectronPackageDir)path.txt') AND @(_ElectronDistFiles->Count()) &lt; 10"
               Code="GP0001"
               Text="Electron was downloaded but never unpacked: $(_ElectronPackageDir) has no path.txt and its dist holds only @(_ElectronDistFiles->Count()) file(s). The zip in ~/.cache/electron is usually intact — see the README (Troubleshooting) for the commands that unpack it by hand." />
    </Target>

</Project>
