# Required
POSTGRES_PASSWORD=change-me-to-a-strong-password

# S3-compatible storage (Garage)
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
# S3_BUCKET_NAME=gospelpresenter
# S3_ADMIN_TOKEN=gospelpresenter-admin-token

# Web port (default 8082)
# WEB_PORT=8082

# OpenID Connect (at least one auth provider is required)
# OIDC_AUTHORITY=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
