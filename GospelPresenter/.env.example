# Required
POSTGRES_PASSWORD=change-me-to-a-strong-password

# S3-compatible storage (Garage)
# Access key: starts with "GK" followed by 24 hex characters
# Secret key: 64 hex characters
# These are created with `garage key create` — see https://garagehq.deuxfleurs.fr/documentation/quick-start/
S3_ACCESS_KEY=GK881013861324c22156c5f3f6
S3_SECRET_KEY=7e810979b9b599935fa54b936660b2a34e688777180f043fcc2c3d107ac63ce6
# S3_BUCKET_NAME=gospelpresenter
# S3_ADMIN_TOKEN=gospelpresenter-admin-token

# Web port (default 8082)
# WEB_PORT=8082

# OpenID Connect (at least one auth provider is required)
# OIDC_AUTHORITY=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
