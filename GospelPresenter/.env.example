# Which images to run. Unset means the newest release.
# Production pins an exact version so an upgrade is a deliberate edit and a rollback is the
# same edit backwards; a test environment tracks the trunk instead.
#   GP_VERSION=1.4.0   a released version
#   GP_VERSION=main    the latest build of the main branch (test environments)
# GP_VERSION=latest

# Required
POSTGRES_PASSWORD=change-me-to-a-strong-password

# S3-compatible storage (Garage)
# Access key: starts with "GK" followed by 24 hex characters
# Secret key: 64 hex characters
# These are created with `garage key create` — see https://garagehq.deuxfleurs.fr/documentation/quick-start/
S3_ACCESS_KEY=GK881013861324c22156c5f3f6
S3_SECRET_KEY=7e810979b9b599935fa54b936660b2a34e688777180f043fcc2c3d107ac63ce6
# S3_BUCKET_NAME=gospelpresenter
# S3_ADMIN_TOKEN=gospelpresenter-admin-token

# Web port (default 8082)
# WEB_PORT=8082

# OpenID Connect (at least one auth provider is required)
# OIDC_AUTHORITY=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Backup (see backup/README.md)
# Where the backup job writes. A NAS pulls from here; keep it on a path the pulling
# user can read, and watch the free space — these files share the database's disk.
# BACKUP_DIR=./backups
# How many snapshots to keep on the server. The long history belongs on the NAS.
# BACKUP_KEEP=7
# Ping this on every successful run so a job that stops running gets noticed
# (healthchecks.io and Uptime Kuma push monitors both work).
# BACKUP_HEALTHCHECK_URL=
