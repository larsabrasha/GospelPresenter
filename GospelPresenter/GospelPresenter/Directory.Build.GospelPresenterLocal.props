<Project>
    <Import Project="Directory.Build.GospelPresenter.props"
            Condition="Exists('Directory.Build.GospelPresenter.props')" />

    <!-- No server at all: Settings.ApiBaseUrl is empty for this scheme, which is what selects the
         fixed developer identity instead of the sign-in flow. It exists so that "no server" is a
         choice rather than something you fall into when a URL is missing — see the ADR (15).
         Point it at a running server with GP_API_BASE_URL when you want one. -->
    <PropertyGroup>
        <!-- App Identifier -->
        <ApplicationId>com.gospelpresenter.app.local</ApplicationId>
        <!-- Its own name and identifier so it never overwrites an installed Prod or Test build. -->
        <ApplicationTitle>GospelPresenter Local</ApplicationTitle>
    </PropertyGroup>

    <ItemGroup>
        <!-- Shares the test icon; a fourth piece of icon art buys nothing for a developer build. -->
        <MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'"
                  Include="Resources\AppIcon\appicon.svg"
                  ForegroundFile="Resources\AppIcon\appiconfg-test.svg"
                  Color="#ffffff"/>
        <MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'"
                  Include="Resources\AppIcon\appicon.svg"
                  ForegroundFile="Resources\AppIcon\appiconfg-test.svg"
                  Color="#ffffff"
                  ForegroundScale="0.65" />
    </ItemGroup>
</Project>
