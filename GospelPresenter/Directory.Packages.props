    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.2" />
    <!-- Pinned above the version EF Core resolves transitively: GHSA-2m69-gcr7-jv3q. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <!-- Same advisory as SQLitePCLRaw.lib.e_sqlite3. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.12" />
    <!-- Same advisory as SQLitePCLRaw.lib.e_sqlite3. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3.ios" Version="2.1.12" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <PackageVersion Include="Tailwind.MSBuild" Version="2.0.2" />
    <PackageVersion Include="Testcontainers" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="USFMToolsSharp" Version="1.18.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

</Project>
