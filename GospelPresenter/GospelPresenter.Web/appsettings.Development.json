{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "GospelPresenter": "Debug",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '/health%'"
        }
      },
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '/version%'"
        }
      }
    ]
  },
  "DetailedErrors": true,
  "Authentication": {
    "Google": {
      "Enabled": true,
      "ClientId": "",
      "ClientSecret": ""
    },
    "OpenIdConnect": {
      "Enabled": false,
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "DisplayName": ""
    }
  },
  "Settings": {
    "BiblesPath": "",
    "SongsPath": ""
  }
}
