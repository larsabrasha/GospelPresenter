@using System.Globalization

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" class="h-dvh overscroll-none overflow-hidden bg-neutral-100 dark:bg-neutral-900">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["_content/GospelPresenter.Shared/tailwind-output.css"]" />
    <link rel="stylesheet" href="@Assets["_content/GospelPresenter.Shared/app.css"]" />
    <link rel="stylesheet" href="GospelPresenter.Web.styles.css" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" href="/images/favicon-57.png" sizes="57x57">
    <link rel="icon" type="image/png" href="/images/favicon-76.png" sizes="76x76">
    <link rel="apple-touch-icon" type="image/png" href="/images/favicon-120.png" sizes="120x120">
    <link rel="apple-touch-icon" type="image/png" href="/images/favicon-152.png" sizes="152x152">
    <link rel="apple-touch-icon" type="image/png" href="/images/favicon-180.png" sizes="180x180">
    <link rel="icon" type="image/png" href="/images/favicon-196.png" sizes="196x196">
    <link rel="manifest" href="manifest.json">
    <meta name="apple-mobile-web-app-title" content="Gospel Presenter">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>Gospel Presenter</title>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body class="flex flex-col h-full">
    <Routes @rendermode="InteractiveServer" />
    <script src="_content/GospelPresenter.Shared/viewport-monitor.js"></script>
    <script src="_content/GospelPresenter.Shared/utils.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
