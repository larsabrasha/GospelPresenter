{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Part of `pnpm lint`: files, exports and dependencies that nothing uses. Most entries come from the
  // packages' own `exports` and from knip's plugins (Vite, Vitest, Playwright, Wrangler).
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"]
    },
    "apps/web": {
      // The service worker is built by a Vite plugin of our own (vite.config.ts), which knip cannot see.
      "entry": ["sw/sw.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "sw/**/*.ts", "test/**/*.ts"]
    },
    "apps/server": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/desktop": {
      // The Electron main process, its preload and the plain-Node server, built by build.mjs.
      "entry": ["src/main.ts", "src/serve.ts", "src/preload.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "e2e/**/*.ts"],
      // Not imported: listed so turbo builds the web app before the desktop's e2e runs it.
      "ignoreDependencies": ["@gp/web"]
    },
    "apps/legacy": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/core": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/sync": {
      "project": ["src/**/*.ts"]
    },
    "packages/architecture": {
      "project": ["test/**/*.ts"]
    }
  },
  // `cloudflare:workers` is the Workers runtime's own module, not a package.
  "ignoreDependencies": ["cloudflare"],
  // The tests and the desktop host make their self-signed certificates with the system's openssl.
  "ignoreBinaries": ["openssl"]
}
