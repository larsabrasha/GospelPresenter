# The static app's headers on Cloudflare, set by Cloudflare's own asset serving so the Worker does not start for
# them (wrangler.toml `run_worker_first = ["/api/*"]`). The same as the Node server's (apps/server/src/static.ts),
# which apps/server/test/static-headers.test.ts checks.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cache-Control: no-cache

# Hashed files never change under their name: kept as long as a browser likes.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
