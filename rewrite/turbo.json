{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^typecheck"
      ],
      "env": [
        "GP_REAL_BIBLE_ZIP"
      ]
    },
    "e2e": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "cache": false
    }
  }
}
