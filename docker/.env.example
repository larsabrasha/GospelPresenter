# Copy to .env beside docker-compose.yml and fill in (docs/self-hosting.md).

# The address the app is used at. Its DNS must point at this machine, with ports 80 and 443 open to the internet, so
# Caddy can get a certificate.
GP_DOMAIN=presenter.example.org

# What first-run setup asks for. Leave it empty and the app makes one and prints it (docker compose logs app).
GP_SETUP_TOKEN=

# Sign-in with Google (optional; passkeys work without it). The client's redirect URI is
# https://<GP_DOMAIN>/api/auth/google/callback.
GP_GOOGLE_CLIENT_ID=
GP_GOOGLE_CLIENT_SECRET=

# E-mail through Resend (optional): invitations by mail and "Glömt hur du loggar in?". Both, or neither.
GP_RESEND_API_KEY=
GP_MAIL_FROM=

# The Superadmins' addresses, comma-separated (optional). Without them the one who did setup is Superadmin.
GP_SUPER_ADMINS=
