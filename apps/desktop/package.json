{
  "name": "@gp/desktop",
  "productName": "Gospel Presenter",
  "version": "2.0.0-beta.1",
  "description": "Gospel Presenter: songs, Bible texts and pictures on the church's screens",
  "author": "Gospel Presenter",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "serve": "node build.mjs && node dist/serve.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "e2e": "playwright test",
    "release": "node release.mjs"
  },
  "devDependencies": {
    "@gp/core": "workspace:*",
    "@gp/rust-core": "workspace:*",
    "@gp/server": "workspace:*",
    "@gp/web": "workspace:*",
    "@playwright/test": "1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  }
}
