<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the generated Info.plist cannot say: plain http to a desktop host on the LAN (GP_LAN=1 without GP_TLS) is
     allowed, as on the web, and only there (NSAllowsLocalNetworking: local addresses and .local names). -->
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The app's texts are Swedish and English (apps/web/src/i18n.ts): the system's own words follow the device in them. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>sv</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>sv</string>
		<string>en</string>
	</array>
	<!-- The commit built, for Om (apple.sh passes git's as GP_COMMIT, as the web's). -->
	<key>GPCommit</key>
	<string>$(GP_COMMIT)</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Gospel Presenter synkar med kyrkans dator i det lokala nätverket.</string>
	<!-- Several windows on an iPad, each with its own page, selection and slide made ready (Model, one per window). -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<!-- An external display (a cable, or AirPlay as a second screen) shows the output (ExternalOutput.swift). -->
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleExternalDisplayNonInteractive</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>External</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).ExternalSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
