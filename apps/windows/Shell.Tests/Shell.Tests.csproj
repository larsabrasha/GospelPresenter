<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Shell library's tests, against the core built for this machine (build/core.sh puts it in native/<rid>) and
       the demo data (crates/gp-core/parity/.out/fixtures/demo.sqlite, made by crates/gp-core/build.sh). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GospelPresenter.Shell.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shell/Shell.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The core for the machine the tests build on (osx-arm64, win-x64, …), beside them. -->
    <None Include="../native/$(NETCoreSdkRuntimeIdentifier)/*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../crates/gp-core/parity/.out/fixtures/demo.sqlite" Link="demo.sqlite"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../../crates/gp-core/parity/.out/fixtures/demo.sqlite')" />
  </ItemGroup>
</Project>
