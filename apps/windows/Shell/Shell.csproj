<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app's shell without its UI (docs/windows-app.md): SQLite for the Rust core, the core's calls, its
       views decoded, the texts. Plain .NET, so its tests run on a Mac and Linux too, against the core built there. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GospelPresenter.Shell</RootNamespace>
    <AssemblyName>GospelPresenter.Shell</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The generated bindings (Ffi/, by build/core.sh or build/build.ps1) pin and copy buffers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- The generated bindings are UniFFI's, not held to this project's warnings. -->
    <Compile Remove="Ffi/**" />
    <Compile Include="Ffi/**/*.cs" WarningLevel="0" NoWarn="$(NoWarn);CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0108;CS0114;CS0162;CS0168;CS0219" />
    <EmbeddedResource Include="texts.json" LogicalName="texts.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- SQLite's own API with its library for every platform (e_sqlite3: Windows x64 and ARM64, macOS, Linux). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
  </ItemGroup>
</Project>
