<Project Sdk="Microsoft.NET.Sdk">
  <!-- A picture of a window as it is on the screen (docs/windows-app.md, "Pictures"): Windows.Graphics.Capture, which
       reads what the compositor draws of the window, behind other windows too. Run by build/build.ps1 capture. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>GospelPresenter.Capture</RootNamespace>
    <AssemblyName>gp-capture</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
