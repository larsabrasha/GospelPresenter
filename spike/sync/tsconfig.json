{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "@cloudflare/workers-types"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["packages/*/src", "apps/server/src", "apps/desktop/src", "apps/web/src", "apps/web/serve.ts", "test"]
}
