{
  "$defs": {
    "AutoSaveEffect": {
      "description": "What the shell does after an autosave step, in order.",
      "oneOf": [
        {
          "description": "Run this change, then tell `done` how it went.",
          "properties": {
            "args": true,
            "command": {
              "type": "string"
            },
            "type": {
              "const": "run",
              "type": "string"
            }
          },
          "required": [
            "type",
            "command",
            "args"
          ],
          "type": "object"
        },
        {
          "description": "After `ms`, tell `timer`; one set before is replaced.",
          "properties": {
            "ms": {
              "format": "int64",
              "type": "integer"
            },
            "type": {
              "const": "timer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "ms"
          ],
          "type": "object"
        },
        {
          "description": "The timer set before is not wanted.",
          "properties": {
            "type": {
              "const": "cancelTimer",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Say \"Sparad\".",
          "properties": {
            "type": {
              "const": "saved",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Say \"Kunde inte spara\".",
          "properties": {
            "type": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "AutoSaveEvent": {
      "description": "What happened to an autosaved field.",
      "oneOf": [
        {
          "description": "It got the focus.",
          "properties": {
            "type": {
              "const": "focus",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Typed in: its whole value now.",
          "properties": {
            "type": {
              "const": "input",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "It lost the focus (or the page closes): what waits is written now.",
          "properties": {
            "type": {
              "const": "blur",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The half second after the last key ran out.",
          "properties": {
            "type": {
              "const": "timer",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The stored value as now read (after a write, a sync, each time the page reads it).",
          "properties": {
            "type": {
              "const": "stored",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "The write the step asked for ran: `ok`, or refused.",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "type": {
              "const": "done",
              "type": "string"
            }
          },
          "required": [
            "type",
            "ok"
          ],
          "type": "object"
        },
        {
          "description": "A clash chosen: the user's own text kept, and written.",
          "properties": {
            "type": {
              "const": "keepMine",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A clash chosen: the other device's text taken.",
          "properties": {
            "type": {
              "const": "takeTheirs",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "AutoSaveKind": {
      "description": "What an autosaved field holds, and so what is written of it.",
      "oneOf": [
        {
          "const": "text",
          "description": "Any text, an empty one too.",
          "type": "string"
        },
        {
          "const": "required",
          "description": "A text that may not be left blank (a name): a blank one is not written.",
          "type": "string"
        },
        {
          "const": "year",
          "description": "A year, 0 to 9999, written as a number; empty is none; anything else is not written.",
          "type": "string"
        }
      ]
    },
    "AutoSaveState": {
      "description": "A field saved as it is typed (the web's AutoSaveField): what it writes to, its rule, and where its typing stands.",
      "properties": {
        "args": true,
        "clash": {
          "description": "The other device's text while a clash waits for the user's choice.",
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "description": "The change that writes it, and its arguments but the field's (the row's id).",
          "type": "string"
        },
        "draft": {
          "description": "What the user has typed, shown in place of the stored value; none shows the stored one.",
          "type": [
            "string",
            "null"
          ]
        },
        "field": {
          "description": "The argument the field's value goes in.",
          "type": "string"
        },
        "focused": {
          "description": "The field has the focus.",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/AutoSaveKind",
          "description": "What it holds."
        },
        "lastOver": {
          "description": "The stored value the last write was made over.",
          "type": [
            "string",
            "null"
          ]
        },
        "lastWritten": {
          "description": "The value last written and the stored one it was written over: typed back to it, nothing is written.",
          "type": [
            "string",
            "null"
          ]
        },
        "max": {
          "description": "Its most characters.",
          "format": "int64",
          "type": "integer"
        },
        "own": {
          "description": "The values written since the focus came: coming back as the stored value, they are no clash.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pending": {
          "description": "A value waiting for its half second, to be written.",
          "type": [
            "string",
            "null"
          ]
        },
        "refused": {
          "description": "The last value was not to be written (a blank name): shown as stored again once left.",
          "type": "boolean"
        },
        "stored": {
          "description": "The value as stored, last told.",
          "type": "string"
        },
        "typed": {
          "description": "Typed in since it got the focus.",
          "type": "boolean"
        },
        "warnOnClash": {
          "description": "Another device's change while typing is a clash to choose over (a song part's text, D18).",
          "type": "boolean"
        }
      },
      "required": [
        "command",
        "args",
        "field",
        "kind",
        "max",
        "warnOnClash",
        "stored",
        "focused",
        "typed",
        "own",
        "refused"
      ],
      "type": "object"
    },
    "AutoSaveStep": {
      "description": "`autoSaveStepView`'s answer: the state to give back, the text to show, the clash to ask about, what to do.",
      "properties": {
        "clash": {
          "description": "The other device's text, while the user is asked to keep theirs or take it.",
          "type": [
            "string",
            "null"
          ]
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/AutoSaveEffect"
          },
          "type": "array"
        },
        "shown": {
          "description": "The field's text now.",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/AutoSaveState"
        }
      },
      "required": [
        "state",
        "shown",
        "effects"
      ],
      "type": "object"
    },
    "DateLine": {
      "description": "`dateLineView`'s answer.",
      "properties": {
        "parts": {
          "items": {
            "$ref": "#/$defs/LinePart"
          },
          "type": "array"
        }
      },
      "required": [
        "parts"
      ],
      "type": "object"
    },
    "DetailsAction": {
      "description": "A button of the dialog: its id, its text's key, its role (cancel or confirm), its text's key while it works.",
      "properties": {
        "busyText": {
          "description": "Its text's key while it works, where it says so.",
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "description": "Whether it may be pressed now.",
          "type": "boolean"
        },
        "id": {
          "description": "What it is: cancel or save.",
          "type": "string"
        },
        "role": {
          "description": "Its role: cancel or confirm.",
          "type": "string"
        },
        "text": {
          "description": "Its text's key.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "role",
        "enabled"
      ],
      "type": "object"
    },
    "DetailsEffect": {
      "description": "What the shell does after a details step, in order.",
      "oneOf": [
        {
          "description": "Run this change (a mutator and its arguments), then tell `done` how it went.",
          "properties": {
            "args": true,
            "command": {
              "type": "string"
            },
            "type": {
              "const": "run",
              "type": "string"
            }
          },
          "required": [
            "type",
            "command",
            "args"
          ],
          "type": "object"
        },
        {
          "description": "Close the dialog.",
          "properties": {
            "type": {
              "const": "close",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Open this presentation's page (one just made).",
          "properties": {
            "presentationId": {
              "type": "string"
            },
            "type": {
              "const": "open",
              "type": "string"
            }
          },
          "required": [
            "type",
            "presentationId"
          ],
          "type": "object"
        }
      ]
    },
    "DetailsEvent": {
      "description": "What happened in the details dialog.",
      "oneOf": [
        {
          "description": "A field typed in or chosen: kept, cut to its most characters.",
          "properties": {
            "field": {
              "$ref": "#/$defs/DetailsField"
            },
            "type": {
              "const": "set",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "field",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "↵ in a field: in the name it saves, as the confirming button (`id` as Save's).",
          "properties": {
            "field": {
              "$ref": "#/$defs/DetailsField"
            },
            "id": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "enter",
              "type": "string"
            }
          },
          "required": [
            "type",
            "field"
          ],
          "type": "object"
        },
        {
          "description": "The confirming button (Spara, Skapa). `id`: a new id from the shell, for a presentation made.",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "save",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Avbryt, ✕ or Esc: closed, nothing sent.",
          "properties": {
            "type": {
              "const": "cancel",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The change the step asked for ran: `ok`, or refused (the dialog stays, for another try).",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "type": {
              "const": "done",
              "type": "string"
            }
          },
          "required": [
            "type",
            "ok"
          ],
          "type": "object"
        }
      ]
    },
    "DetailsField": {
      "description": "A field of the details dialog, by the name its mutators take.",
      "oneOf": [
        {
          "const": "name",
          "description": "The presentation's name.",
          "type": "string"
        },
        {
          "const": "eventDate",
          "description": "Its date, `YYYY-MM-DD`, empty for none.",
          "type": "string"
        },
        {
          "const": "time",
          "description": "Its time, `HH:MM`, empty for none.",
          "type": "string"
        },
        {
          "const": "location",
          "description": "Where it is.",
          "type": "string"
        },
        {
          "const": "description",
          "description": "What it is about.",
          "type": "string"
        },
        {
          "const": "themeId",
          "description": "Its theme's id, empty for the default.",
          "type": "string"
        }
      ]
    },
    "DetailsMode": {
      "description": "What a presentation's details dialog is for.",
      "oneOf": [
        {
          "const": "edit",
          "description": "Redigera detaljer of a presentation there.",
          "type": "string"
        },
        {
          "const": "create",
          "description": "Skapa presentation, blank.",
          "type": "string"
        },
        {
          "const": "template",
          "description": "Skapa presentation from a template: its name, next date, time and place prefilled, its items copied.",
          "type": "string"
        }
      ]
    },
    "DetailsState": {
      "description": "The details dialog as the core keeps it between steps: each field as typed, empty for cleared.",
      "properties": {
        "description": {
          "description": "The description.",
          "type": "string"
        },
        "eventDate": {
          "description": "The date, `YYYY-MM-DD`, empty for none.",
          "type": "string"
        },
        "initialThemeId": {
          "description": "The theme it had: only a theme changed is sent, so a shell without the theme's field never clears it.",
          "type": "string"
        },
        "location": {
          "description": "The place.",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/DetailsMode",
          "description": "What the dialog is for."
        },
        "name": {
          "description": "The name.",
          "type": "string"
        },
        "presentationId": {
          "description": "The presentation edited (Redigera detaljer).",
          "type": [
            "string",
            "null"
          ]
        },
        "saving": {
          "description": "A new one is being made: the button says so, and nothing is sent twice.",
          "type": "boolean"
        },
        "templateId": {
          "description": "The template a new one is made from.",
          "type": [
            "string",
            "null"
          ]
        },
        "themeId": {
          "description": "The theme's id, empty for the default.",
          "type": "string"
        },
        "time": {
          "description": "The time, `HH:MM`, empty for none.",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "name",
        "eventDate",
        "time",
        "location",
        "description",
        "themeId",
        "initialThemeId",
        "saving"
      ],
      "type": "object"
    },
    "DetailsStep": {
      "description": "`detailsStepView`'s answer: the state to give back, what the dialog shows, and what to do.",
      "properties": {
        "effects": {
          "items": {
            "$ref": "#/$defs/DetailsEffect"
          },
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/DetailsState"
        },
        "view": {
          "$ref": "#/$defs/DetailsView"
        }
      },
      "required": [
        "state",
        "view",
        "effects"
      ],
      "type": "object"
    },
    "DetailsView": {
      "description": "What the details dialog shows: its title's key, its fields in their groups, its buttons, and each field's most\ncharacters.",
      "properties": {
        "actions": {
          "description": "The buttons, Avbryt then the confirming one.",
          "items": {
            "$ref": "#/$defs/DetailsAction"
          },
          "type": "array"
        },
        "descriptionMax": {
          "description": "The description's most characters.",
          "format": "int64",
          "type": "integer"
        },
        "groups": {
          "description": "The fields in their groups, in order.",
          "items": {
            "items": {
              "$ref": "#/$defs/DetailsField"
            },
            "type": "array"
          },
          "type": "array"
        },
        "locationMax": {
          "description": "The place's most characters.",
          "format": "int64",
          "type": "integer"
        },
        "nameMax": {
          "description": "The name's most characters.",
          "format": "int64",
          "type": "integer"
        },
        "title": {
          "description": "The title's key.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "groups",
        "actions",
        "nameMax",
        "locationMax",
        "descriptionMax"
      ],
      "type": "object"
    },
    "FadeStep": {
      "description": "Tona ut at a moment (`fadeOutView`): the volume now, whether it is done, and when to ask again.",
      "properties": {
        "done": {
          "type": "boolean"
        },
        "nextMs": {
          "format": "int64",
          "type": "integer"
        },
        "volume": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "volume",
        "done",
        "nextMs"
      ],
      "type": "object"
    },
    "LinePart": {
      "description": "A part of a date line (`dateLineView`): one of the app's texts by key (Idag, Imorgon, LIVE), or a text as it is.",
      "properties": {
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "of": {
          "description": "What it is: live, date, time or place.",
          "type": "string"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "of"
      ],
      "type": "object"
    },
    "LiveControl": {
      "description": "The session driven from here.",
      "properties": {
        "pending": {
          "description": "The command sent and not yet echoed."
        },
        "sessionId": {
          "description": "Its id.",
          "type": "string"
        },
        "warned": {
          "description": "\"Not confirmed\" was said.",
          "type": "boolean"
        }
      },
      "required": [
        "sessionId",
        "pending",
        "warned"
      ],
      "type": "object"
    },
    "LiveEffect": {
      "description": "What the shell does after a `liveStepView` step, in order.",
      "oneOf": [
        {
          "description": "Open the socket (`/api/live/socket`, the credentials as subprotocols); its first send gone, tell `socketOpened`.",
          "properties": {
            "type": {
              "const": "openSocket",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Close it, and tell `socketClosed`.",
          "properties": {
            "type": {
              "const": "closeSocket",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Send this message as JSON text.",
          "properties": {
            "message": true,
            "type": {
              "const": "send",
              "type": "string"
            }
          },
          "required": [
            "type",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "After `ms`, tell `timer` with this name; one of the same name set before is replaced.",
          "properties": {
            "ms": {
              "format": "int64",
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "const": "timer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name",
            "ms"
          ],
          "type": "object"
        },
        {
          "description": "A controller's command taken: change this device's live state by it, as a change of its own.",
          "properties": {
            "change": true,
            "type": {
              "const": "apply",
              "type": "string"
            }
          },
          "required": [
            "type",
            "change"
          ],
          "type": "object"
        },
        {
          "description": "A controller's audio command for what this device plays.",
          "properties": {
            "command": true,
            "type": {
              "const": "audio",
              "type": "string"
            }
          },
          "required": [
            "type",
            "command"
          ],
          "type": "object"
        },
        {
          "description": "A controller's video command for what this device plays.",
          "properties": {
            "command": true,
            "type": {
              "const": "video",
              "type": "string"
            }
          },
          "required": [
            "type",
            "command"
          ],
          "type": "object"
        },
        {
          "description": "Show the session driven from here at this live state.",
          "properties": {
            "pointer": true,
            "type": {
              "const": "mirror",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pointer"
          ],
          "type": "object"
        },
        {
          "description": "The session driven from here is gone: stop driving it.",
          "properties": {
            "type": {
              "const": "lost",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A command was not confirmed in 2 s: say so, once.",
          "properties": {
            "type": {
              "const": "unconfirmed",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "LiveEvent": {
      "description": "What happened to a device's live socket (`liveStepView`'s `event`), as the shell tells it. Its time is `now` beside\nit (ms), at the top or in the event.",
      "oneOf": [
        {
          "description": "Signed in: the socket wanted.",
          "properties": {
            "type": {
              "const": "start",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Signed out: the socket closed, not opened again.",
          "properties": {
            "type": {
              "const": "stop",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The socket opened (its first send went out).",
          "properties": {
            "type": {
              "const": "socketOpened",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The socket closed or could not open.",
          "properties": {
            "type": {
              "const": "socketClosed",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A message the server sent, as it came.",
          "properties": {
            "message": true,
            "type": {
